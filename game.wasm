Economy.prototype.claimMission = function (id) {
  const M = this.missions(), m = M.list.find(x => x.id === id), def = MISSIONS.find(x => x.id === id);
  if (!m || m.claimed || m.prog < def.goal) return 0;
  m.claimed = true; if (!UNLIMITED) this.d.money += def.reward; this.changed(); return def.reward;
};
Economy.prototype.claimBonus = function () {
  const M = this.missions(); if (M.bonus || !M.list.every(m => m.claimed)) return 0;
  M.bonus = true; if (!UNLIMITED) this.d.keys += MISSION_KEYS; this.changed(); return MISSION_KEYS;
};

const fmt = (n) => n === Infinity ? '∞' : Math.floor(n).toLocaleString('ar-SA');

return { UNLIMITED, CAR_PRICE, GOLD_PACKS, MONEY_PACKS, SUBS, ACHIEVEMENTS, Economy, MISSIONS, MISSION_KEYS, fmt };
