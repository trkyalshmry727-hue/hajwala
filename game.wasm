  buildCones() {
    const orange = new Material({ name: 'cone', color: [0.95, 0.35, 0.08, 1], roughness: 0.55, doubleSided: true });
    const white = new Material({ name: 'coneStripe', color: [0.95, 0.95, 0.92, 1], roughness: 0.5, doubleSided: true });
    const cone = coneMeshes(orange, white);
    this.cones = [];
    const spots = []; for (let i = 0; i < 17; i++) spots.push([0, 0]);
    for (const [x, z] of spots) {
      const n = new Node('cone'); n.mesh = cone; this.scene.add(n);
      this.cones.push({ node: n, pos: new V3(x, 0, z), home: new V3(x, 0, z), vel: new V3(), q: new Q(), ang: new V3(), rest: true });
    }
    this.syncCones();
  }
  syncCones() { for (const c of this.cones) { c.node.pos.copy(c.pos); c.node.rot.copy(c.q); } }

  buildSpectators() {
    this.npcs = [];
    const spots = []; for (let i = 0; i < 34; i++) spots.push([0, 0, 0]); // (spectators + people walking the pavements)
    for (const [x, z, yaw] of spots) {
      const c = new Character(cloneCharacter(this.manSrc));
      const y = this.world.heightAt(x, z, 5);
      c.pos.set(x, y, z); c.yaw = yaw; c.home = c.pos.clone(); c.homeYaw = yaw;
      c.state = 'idle'; c.t = Math.random() * 10; c.stateT = 0; c.vel = new V3(); c.pitch = 0;
      this.scene.add(c.root); this.npcs.push(c);
    }
  }

  // the caravan (camper) sitting in the Shas bed: white box with windows, an AC unit, a ladder, a rear door with a
  // glowing "كرفان" sign above it. Walk to the yellow spot at its door to go inside.
  // (any pickup can carry it — tune: «الكرفان»; the Shas has it by default; cars with no bed can't)
  caravanFrame(car) {
    const d = car.def;
    if (car.key === 'shas' || (d.interior && d.interior.rearWall !== undefined)) return { zb: d.zMin - 0.06, zf: (d.interior && d.interior.rearWall !== undefined ? d.interior.rearWall : -0.36) - 0.04, y0: (d.interior ? d.interior.floorY : 0.7) + 0.26, y1: 2.32, hw: d.halfWidth + 0.08 };
    // pickups from model files: the cab's back wall and the bed rails from the body's own shape (highest point per slice along the car)
    const NB = 160, z0 = d.zMin, dz = (d.zMax - d.zMin) / NB, H = new Float32Array(NB).fill(-1), HR = new Float32Array(NB).fill(-1);
    car.bodyNode.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (p.material && (p.material.glass || p.material.alphaMode === 'BLEND')) continue; const a = p.attrs.position.data;
      for (let i = 0; i < a.length; i += 3) { const ax = Math.abs(a[i]), b = Math.floor((a[i + 2] - z0) / dz); if (b < 0 || b >= NB) continue;
        if (ax <= d.halfWidth * 0.6) { if (a[i + 1] > H[b]) H[b] = a[i + 1]; } else if (ax < d.halfWidth + 0.05 && a[i + 1] > HR[b]) HR[b] = a[i + 1]; } } }); // (middle strip: roof; sides: the bed rails)
    const Hs = new Float32Array(NB); for (let b = 0; b < NB; b++) { const w = []; for (let k = Math.max(0, b - 3); k <= Math.min(NB - 1, b + 3); k++) w.push(H[k]); w.sort((a, b) => a - b); Hs[b] = w[w.length >> 1]; } // (no antennas / mirrors)
    let hmax = 0; for (const h of Hs) hmax = Math.max(hmax, h);
    let zf;
    if (!d.auto && d.profile) { // hand-made cars: their outline says where the cab ends
      const P = [...d.profile].sort((a, b) => b[0] - a[0]), top = Math.max(...P.map(q => q[1])); let i = P.findIndex(q => q[1] > top - 0.05); while (i < P.length - 1 && P[i + 1][1] > top - 0.2) i++;
      zf = (P[Math.min(i + 1, P.length - 1)][0]) - 0.02;
    } else {
      let r = -1; for (let b = 0; b < NB; b++) if (Hs[b] > hmax - 0.12) { r = b; break; } // rear end of the roof (z grows to the front)
      if (r < 0) return null;
      let c = r; while (c > 0 && Hs[c] > hmax - 0.35) c--;
