  const base = boxPrim(0.42, 0.04, 0.42, orange); for (let i = 1; i < base.attrs.position.data.length; i += 3) base.attrs.position.data[i] += 0.02; computeBounds(base);
  return { prims: [body, stripe, base] };
}

