    this.meta.wheels.forEach((w, i) => { const p = new V3(...w.pos).sub(this.com); p.x *= 1.02; p.r = this.meta.wheelRadius * 0.82; p.tyre = true; this.spheres.push(p); if (this.wheels && this.wheels[i]) this.wheels[i].sphere = p; });
  }

  // cars converted from a single-mesh model have no separate doors: cut the front doors out of the body
  // (outer skin + window + door card between the A and B pillars) and hinge them at the front edge
  carveDoors(def, meta) {
    const body = this.bodyNode; if (!body.mesh) return;
    const R = meta.wheelRadius, fa = Math.max(...meta.wheels.map(w => w.pos[2]));
    const sz = def.wheelPos ? def.wheelPos.z : meta.steer ? meta.steer.center[2] : def.interior ? def.interior.wheel[0] : fa - 1.05;
    const seatZ = def.seat ? def.seat.z : def.interior ? def.interior.seatZ : sz - 0.6;
    const zF = Math.min(fa - R - 0.1, sz + 0.42), zB = Math.max(seatZ - 0.5, zF - 1.25);
    const top = Math.max(...(def.profile || [[0, 1.5]]).map(q => q[1])) - 0.07, y0 = def.lowY - 0.08;
    for (const sg of [1, -1]) {
      // outer skin width per 5 cm of height inside the door's length (the sides lean in towards the roof)
      const bins = new Map(); const bk = (y) => Math.floor(y / 0.05);
      for (const p of body.mesh.prims) { const P = p.attrs.position.data; for (let i = 0; i < P.length; i += 3) { const x = P[i] * sg, y = P[i + 1], z = P[i + 2]; if (x <= 0 || z < zB + 0.08 || z > zF - 0.38 || y < y0 || y > top) continue; const k = bk(y); if (!(bins.get(k) >= x)) bins.set(k, x); } }
      if (bins.size < 4) continue;
      const edge = (y) => { let m = 0; for (let k = bk(y) - 1; k <= bk(y) + 1; k++) m = Math.max(m, bins.get(k) || 0); return m; };
      const doorPrims = []; let hx = 0;
      const out = [];
      // clip planes of the door opening (value >= 0 inside); triangles crossing a line are cut exactly on it
      const planes = [(v) => v[2] - zB, (v) => zF - v[2], (v) => v[1] - y0, (v) => (top - 0.05) - v[1]];
      for (const p of body.mesh.prims) {
        if (!p.index || !p.attrs.position || p.shadowOnly) { out.push(p); continue; }
        const names = Object.keys(p.attrs).filter(k => p.attrs[k] && p.attrs[k].data);
        const src = {}; for (const k of names) src[k] = Array.from(p.attrs[k].data);
        const P = p.attrs.position.data, I = p.index, keep = [], take = [];
