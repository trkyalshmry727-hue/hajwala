};
Economy.prototype.unpaid = function () { return (this.d.fines || []).filter(f => !f.paid); };
Economy.prototype.payFine = function (id) {
  const f = (this.d.fines || []).find(x => x.id === id); if (!f || f.paid) return '';
  if (this.money < f.amount) return 'money';
  if (!UNLIMITED) this.d.money -= f.amount;
  f.paid = Date.now(); this.changed(); return '';
};

// ---- daily missions (مهمات): five a day, money for each, keys for finishing all of them
const MISSIONS = [
  { id: 'drifts', name: 'فحّط ٥ تفحيطات', goal: 5, reward: 400 },
  { id: 'driftPts', name: 'اجمع ٥٬٠٠٠ نقطة تفحيط', goal: 5000, reward: 800 },
  { id: 'bigDrift', name: 'تفحيطة وحدة فوق ٢٬٠٠٠ نقطة', goal: 2000, reward: 1000 },
  { id: 'km', name: 'امش ٥ كيلو', goal: 5, reward: 500 },
  { id: 'speed', name: 'وصّل السرعة ١٤٠ كم/س', goal: 140, reward: 400 },
  { id: 'caravan', name: 'ادخل الكرفان مع الشاص', goal: 1, reward: 300 },
  { id: 'check', name: 'مر على نقطة تفتيش', goal: 1, reward: 300 },
  { id: 'cars', name: 'سوق ٣ سيارات مختلفة', goal: 3, reward: 600 },
  { id: 'drone', name: 'صوّر بالدرون', goal: 1, reward: 300 },
  { id: 'crash', name: 'اصدم بقوة (فوق ٦٠ كم/س)', goal: 1, reward: 300 },
