    if (gTab === 'cars') { const st = carState(selected); if (!st.owned) $('startBtn2').innerHTML = st.store ? 'اذهب إلى المتجر' : st.needLevel ? 'مستوى ' + st.needLevel.toLocaleString('ar-SA') + ' 🔒' : 'اشترها ' + priceHTML(st); }
    strip.hidden = gTab !== 'cars'; mstrip.hidden = gTab !== 'maps';
    $('gName').textContent = gTab === 'cars' ? CAR_DEFS[selected].name : MAPS[mapWant || mapSel].name;
    $('gSpec').textContent = gTab === 'cars' ? specs[selected] || '' : MAPS[mapWant || mapSel].sp;
  };
  if (mapSel !== 'city') { if (LAZY_FOR[mapSel]) { mapWant = mapSel; mapSel = 'city'; mapLoadP = loadWantedMap(); } else game.loadMap(mapSel); }

  let screen = 'menu';
  const dropDrone = () => { game.drone = null; $('shotBtn').hidden = true; $('droneBtn').classList.remove('on'); };
  const goMenu = () => { if (window.__x) { try { window.__x.fleetClear(); window.__x.endMode(); } catch (e) { } } if (game.event) game.event.stop(); game.chal = null; game.tuneView = false; show('tune', false); show('chars', false); game.menuHold = false; dropDrone(); if (game.net) game.net.leaveSession(); screen = 'menu'; game.paused = false; game.showroom(selected); show('menu', true); show('garage', false); $('hud').classList.remove('on'); show('pause', false); };
  const goGarage = (tab) => { if (window.__x) { try { window.__x.fleetClear(); window.__x.endMode(); } catch (e) { } } if (game.event) game.event.stop(); dropDrone(); if (game.net) game.net.leaveSession(); gTab = tab === 'maps' ? 'maps' : 'cars'; screen = 'garage'; game.paused = false; game.showroom(selected); game.mode = 'garage'; refreshCards(); show('menu', false); show('pause', false); $('hud').classList.remove('on'); show('garage', true); };
  let skipModes = false;
  const goPlay = () => {
    if (window.__x) { try { window.__x.fleetClear(); window.__x.endMode(); } catch (e) { } }
    if (typeof carState === 'function' && !carState(selected).owned) selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas';
    game.tuneView = false; show('tune', false); show('chars', false); screen = 'play'; unlockAudio(); show('menu', false); show('garage', false); show('pause', false); $('hud').classList.add('on');
    $('wheel').innerHTML = wheelSVG(CAR_DEFS[selected].wheelStyle);
    game.showroom(selected); game.start();
    try { const wu = game.wheelImage(selected); if (wu) $('wheel').innerHTML = '<image href="' + wu + '" x="0" y="0" width="200" height="200"/>'; } catch (e) { console.warn(e); } // the on-screen wheel = this car's own steering wheel
    try { econ.misCar(selected); } catch (e) { }
    // checkpoints: fetch the uniformed officer model in the background, then put the officers in uniform
    try { if (game.map.traffic && game.map.traffic.checks.length && !assets.hero) ensureMapAssets('hero', () => { }).then(() => { try { game.placeOfficers(); } catch (e) { } }).catch(() => { }); } catch (e) { }
    hud.toast(mapSel === 'highway' ? 'انتبه لساهر فوق ١٢٠!' : 'دوس بنزين وتوكل على الله', 2200);
    try { const T = (window.__tunes || {})[selected]; if (T && T.plate) applyPlate(game.car, T.plate); applyOutfit(game.player, (window.__wear || {}).wear || {}); } catch (e) { console.warn(e); }
    if (window.__x && !game.event && !skipModes && !(game.net && game.net.me && game.net.me.sess)) setTimeout(() => { if (screen === 'play' && !game.event) window.__x.openModes(true); }, 700);
    skipModes = false;
    try { navigator.wakeLock && navigator.wakeLock.request('screen').catch(() => { }); } catch (e) { }
  };
  hud.flash = () => { const f = $('flash'); f.classList.add('on'); requestAnimationFrame(() => requestAnimationFrame(() => f.classList.remove('on'))); };
  $('carsBtn').addEventListener('click', () => { garageFrom = 'menu'; goGarage('cars'); });
  $('backBtn').addEventListener('click', () => { if (gTab === 'maps' && garageFrom === 'cars') { gTab = 'cars'; refreshCards(); } else goMenu(); });
  let garageFrom = 'menu';
  $('startBtn').addEventListener('click', () => { if (!carState(selected).owned) { selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas'; } garageFrom = 'menu'; goGarage('maps'); });
  let startWait = false;
  $('startBtn2').addEventListener('click', () => {
    if (gTab === 'cars') {
      const st = carState(selected);
      if (!st.owned) {
        if (st.store) { openStore('cars'); return; }
        if (st.needLevel) { hud.toast('توصل المستوى ' + st.needLevel.toLocaleString('ar-SA') + ' وتقدر تشتريها', 2000); return; }
        const why = UNLIMITED ? (econ.grant(selected), '') : econ.buyCar(selected);
        if (why === 'money') { hud.toast('فلوسك ما تكفي — اشتر فلوس من المتجر', 2200); return; }
        if (why === 'keys') { hud.toast('مفاتيحك ما تكفي — المتجر فيه مفاتيح', 2200); return; }
        refreshCards(); showGift(selected); return;
      }
      garageFrom = 'cars'; gTab = 'maps'; refreshCards();
    } else if (!game.cars[selected] || mapLoadP) { // wait for the car AND the map that were picked (not the old ones)
