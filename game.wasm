    sp.pillow(0, -0.01, 0.02, 0.15, 0.12, 0.06, 0.03);
  } else if (style === 'hilux' || style === 'avanza' || style === 'camry') {
    arc(rim, 0, Math.PI * 2, style === 'camry' ? 0.019 : 0.021);
    spoke(sp, -0.08, 0.1, 0.05); spoke(sp, Math.PI + 0.08, 0.1, 0.05); spoke(sp, -Math.PI / 2, 0.1, style === 'avanza' ? 0.055 : 0.04);
    if (style !== 'avanza') { spoke(sv, -0.08, 0.08, 0.008, 0.024, 0.06); spoke(sv, Math.PI + 0.08, 0.08, 0.008, 0.024, 0.06); }
    if (style === 'hilux') for (const x of [-0.11, 0.11]) sv.push().translate(x, -0.01, -0.004).rotate(0, 1, 0, Math.PI / 2).discX(0, 0.008, 10).pop();
    sp.pillow(0, -0.01, 0.02, style === 'avanza' ? 0.14 : 0.12, 0.11, 0.06, 0.03);
  } else if (style === 'changan') {
    arc(rim, 0, Math.PI * 2, 0.02);
    spoke(sp, -0.05, 0.1, 0.045); spoke(sp, Math.PI + 0.05, 0.1, 0.045); spoke(sp, -Math.PI / 2 - 0.35, 0.1, 0.03); spoke(sp, -Math.PI / 2 + 0.35, 0.1, 0.03);
    spoke(sv, -Math.PI / 2 - 0.35, 0.09, 0.008, 0.026, 0.06); spoke(sv, -Math.PI / 2 + 0.35, 0.09, 0.008, 0.026, 0.06);
    sp.pillow(0, 0.0, 0.02, 0.13, 0.11, 0.06, 0.035);
  } else if (style === 'sport' || style === 'elantra') {
    arc(rim, 0, Math.PI * 2, 0.021);
    spoke(sp, 0, 0.1, 0.05); spoke(sp, Math.PI, 0.1, 0.05);
    for (const x of [-0.05, 0.05]) { sp.box(x, -0.12, 0.012, 0.022, 0.11, 0.022); sv.box(x, -0.12, 0.0, 0.006, 0.1, 0.024); }
    sp.pillow(0, 0.0, 0.02, 0.13, 0.1, 0.06, 0.03);
  } else {
    arc(rim, 0, Math.PI * 2, 0.02); spoke(sp, -0.05, 0.1, 0.045); spoke(sp, Math.PI + 0.05, 0.1, 0.045); spoke(sp, -Math.PI / 2, 0.1, 0.035); sp.pillow(0, -0.01, 0.02, 0.12, 0.1, 0.06, 0.03);
  }
  logo();
  const woodM = new Material({ name: 'wheelWood', map: woodTexture(), color: [1, 1, 1, 1], roughness: 0.2, envBoost: 1.0 });
  const out = [rim.prim(lea), sp.prim(pad), sv.prim(sil)]; if (wd.I.length) out.push(wd.prim(woodM));
  return out.filter(p => p.index.length);
}
// live instrument cluster drawn on a canvas (redrawn while you drive); one look per real car
function clusterCanvas(style) {
  const c = document.createElement('canvas'); c.width = 512; c.height = 168; const g = c.getContext('2d');
  const tex = { image: c, wrapS: 33071, wrapT: 33071, srgb: true, gl: null, dirty: true };
  const A0 = 0.75 * Math.PI, AR = 1.5 * Math.PI;
  const dial = (cx, cy, r, v, max, labels, o = {}) => {
    const face = o.face || '#0b0b0b', ink = o.ink || '#f2efe6', ring = o.ring || '#9a9a9a', needle = o.needle || '#ff6a1a';
    g.fillStyle = face; g.beginPath(); g.arc(cx, cy, r + 6, 0, Math.PI * 2); g.fill();
    g.strokeStyle = ring; g.lineWidth = o.ringW || 3; g.beginPath(); g.arc(cx, cy, r + 4, 0, Math.PI * 2); g.stroke();
    if (o.glow) { g.strokeStyle = o.glow; g.lineWidth = 3; g.beginPath(); g.arc(cx, cy, r + 0.5, A0, A0 + AR); g.stroke(); }
    const n = o.ticks || 20;
    for (let i = 0; i <= n; i++) { const a = A0 + i / n * AR; const big = i % 2 === 0; g.strokeStyle = o.red && i >= n * 0.8 ? '#e0402a' : ink; g.lineWidth = big ? 3 : 1.5; g.beginPath(); g.moveTo(cx + Math.cos(a) * r * (big ? 0.78 : 0.86), cy + Math.sin(a) * r * (big ? 0.78 : 0.86)); g.lineTo(cx + Math.cos(a) * r * 0.97, cy + Math.sin(a) * r * 0.97); g.stroke(); }
    g.fillStyle = ink; g.font = `bold ${o.font || 15}px Arial`; g.textAlign = 'center'; g.textBaseline = 'middle';
    labels.forEach((t, i) => { const a = A0 + i / (labels.length - 1) * AR; g.fillText(t, cx + Math.cos(a) * r * 0.6, cy + Math.sin(a) * r * 0.6); });
    const a = A0 + Math.min(1, v / max) * AR;
    g.strokeStyle = needle; g.lineWidth = 4; g.beginPath(); g.moveTo(cx - Math.cos(a) * 8, cy - Math.sin(a) * 8); g.lineTo(cx + Math.cos(a) * r * 0.9, cy + Math.sin(a) * r * 0.9); g.stroke();
    g.fillStyle = o.cap || '#333'; g.beginPath(); g.arc(cx, cy, 8, 0, Math.PI * 2); g.fill();
  };
  const txt = (t, x, y, size, col, bold = true) => { g.fillStyle = col; g.font = `${bold ? 'bold ' : ''}${size}px Arial`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(t, x, y); };
  const K = ['0', '40', '80', '120', '160', '200'], RPM = ['0', '2', '4', '6', '8'];
  const draw = (kmh, rpm, gear) => {
    g.fillStyle = '#030303'; g.fillRect(0, 0, 512, 168);
    const v = Math.round(kmh);
    if (style === 'lc') {            // Land Cruiser 70: two big white-on-black dials with chrome bezels + fuel/temp
      dial(120, 86, 72, rpm / 1000, 5, ['0', '1', '2', '3', '4', '5'], { ring: '#c8c8c8', ringW: 5, red: true, needle: '#ff5a1a' });
      dial(392, 86, 72, kmh, 180, ['0', '40', '80', '120', '160'], { ring: '#c8c8c8', ringW: 5, needle: '#ff5a1a' });
      g.fillStyle = '#111'; g.fillRect(222, 40, 68, 90); txt('E    F', 256, 60, 13, '#ddd'); txt(String(gear), 256, 96, 30, '#ffb347'); txt('C    H', 256, 120, 13, '#ddd');
    } else if (style === 'hilux') {  // Hilux: blue-rimmed dials with a centre info screen
      dial(116, 86, 72, rpm / 1000, 8, RPM, { ring: '#44484e', glow: '#2f7fe0', red: true, needle: '#ff3b2b' });
      dial(396, 86, 72, kmh, 200, K, { ring: '#44484e', glow: '#2f7fe0', needle: '#ff3b2b' });
      g.fillStyle = '#0a1a2c'; g.fillRect(212, 34, 88, 100); g.strokeStyle = '#2f7fe0'; g.strokeRect(212, 34, 88, 100);
      txt(String(gear), 256, 66, 30, '#e8f4ff'); txt(v + ' km/h', 256, 106, 15, '#9fd0ff');
    } else if (style === 'changan') { // Changan: two dials with a digital centre (speed + gear)
      dial(110, 86, 66, rpm / 1000, 8, RPM, { ring: '#707780', glow: '#27c3c9', red: true, needle: '#ff4a2a', font: 13 });
      dial(402, 86, 66, kmh, 220, ['0', '60', '120', '180', '220'], { ring: '#707780', glow: '#27c3c9', needle: '#ff4a2a', font: 13 });
      g.fillStyle = '#071114'; g.fillRect(196, 30, 120, 108); txt(String(v), 256, 72, 38, '#e8ffff'); txt('km/h', 256, 100, 13, '#7fd6da'); txt('D ' + gear, 256, 122, 16, '#35e07a');
    } else if (style === 'elantra') { // Elantra 2024: fully digital, teal arcs and big numbers
      const gr = g.createLinearGradient(0, 0, 512, 0); gr.addColorStop(0, '#02080b'); gr.addColorStop(0.5, '#061016'); gr.addColorStop(1, '#02080b'); g.fillStyle = gr; g.fillRect(0, 0, 512, 168);
      for (const [cx, val, mx] of [[110, rpm, 8000], [402, kmh, 220]]) { g.strokeStyle = '#123'; g.lineWidth = 10; g.beginPath(); g.arc(cx, 90, 62, 0.8 * Math.PI, 2.2 * Math.PI); g.stroke(); g.strokeStyle = '#2de0d0'; g.beginPath(); g.arc(cx, 90, 62, 0.8 * Math.PI, 0.8 * Math.PI + Math.min(1, val / mx) * 1.4 * Math.PI); g.stroke(); }
      txt(String(Math.round(rpm / 100) / 10), 110, 92, 30, '#e8ffff'); txt('x1000rpm', 110, 122, 11, '#7fbfc0'); txt(String(v), 402, 92, 36, '#e8ffff'); txt('km/h', 402, 122, 12, '#7fbfc0');
      txt(String(gear), 256, 84, 34, '#2de0d0'); txt('D', 256, 120, 16, '#9ad');
    } else if (style === 'camry') {  // Camry 2025: blue ECO/POWER arc with a big digital speed
      g.fillStyle = '#01040a'; g.fillRect(0, 0, 512, 168);
      g.strokeStyle = '#0e2a55'; g.lineWidth = 12; g.beginPath(); g.arc(210, 120, 95, Math.PI, 2 * Math.PI); g.stroke();
      const f = Math.min(1, rpm / 7000); g.strokeStyle = '#2a7cff'; g.beginPath(); g.arc(210, 120, 95, Math.PI, Math.PI + f * Math.PI); g.stroke();
      txt('ECO', 140, 60, 11, '#8fb4e6'); txt('POWER', 285, 60, 11, '#8fb4e6'); txt(String(v), 210, 96, 44, '#ffffff'); txt('km/h', 210, 124, 12, '#9ab'); txt(String(gear), 210, 148, 18, '#fff');
      g.strokeStyle = '#ddd'; g.lineWidth = 2; g.beginPath(); g.arc(470, 84, 60, 0.6 * Math.PI, 1.4 * Math.PI); g.stroke(); txt('F', 440, 36, 12, '#ddd'); txt('E', 440, 132, 12, '#ddd');
    } else if (style === 'avanza') { // Avanza: big central speedometer, small tacho on the left, fuel on the right
      dial(256, 88, 76, kmh, 180, ['0', '40', '80', '120', '160'], { face: '#101010', ring: '#8a8a8a', needle: '#ff6a1a' });
      dial(92, 92, 52, rpm / 1000, 8, RPM, { face: '#101010', ring: '#8a8a8a', red: true, font: 12 });
      g.fillStyle = '#101010'; g.beginPath(); g.arc(420, 92, 56, 0, Math.PI * 2); g.fill(); txt('E     F', 420, 70, 13, '#ddd'); txt(String(gear), 420, 104, 28, '#ffb347');
    } else if (style === 'digital') {
      const gr = g.createLinearGradient(0, 0, 512, 168); gr.addColorStop(0, '#0d1b2a'); gr.addColorStop(1, '#030608'); g.fillStyle = gr; g.fillRect(8, 8, 496, 152);
      g.strokeStyle = '#2a9df4'; g.lineWidth = 6; g.beginPath(); g.arc(130, 84, 62, A0, A0 + Math.min(1, rpm / 7000) * AR); g.stroke();
      txt(String(v), 330, 78, 64, '#e8f4ff'); txt('km/h', 330, 124, 18, '#8fb8d8', false); txt(String(gear), 130, 86, 34, '#2a9df4');
    } else {
      dial(118, 84, 70, rpm / 1000, 8, RPM, { red: true }); dial(394, 84, 70, kmh, 200, K);
      g.fillStyle = '#0b0b0b'; g.fillRect(222, 50, 68, 68); g.strokeStyle = '#555'; g.lineWidth = 2; g.strokeRect(222, 50, 68, 68);
      txt(String(gear), 256, 76, 34, '#ffb347'); txt(String(v), 256, 104, 14, '#ddd', false);
    }
    tex.dirty = true;
  };
  draw(0, 800, 'N');
  return { tex, draw };
}

// ---------------- number plate ----------------
function plateNode(plateGltf, front) {
  const src = plateGltf.root.children[0];
  const n = new Node(front ? 'plate_front' : 'plate_rear');
  const m = new Node('plate_mesh'); m.mesh = src.mesh; m.pos.set(0, -0.08, 0); // mesh origin is at bottom edge
  n.add(m);
  if (!front) n.rot.setAxisAngle(new V3(0, 1, 0), Math.PI);
  n.castShadow = false;
  return n;
}

// embossed maker's lettering for tailgates (e.g. TOYOTA on the Hilux / Land Cruiser)
function badgeNode(text, width) {
  const tex = canvasTex('badge_' + text, 1024, 160, (g, w, h) => {
    g.clearRect(0, 0, w, h); g.font = 'bold 128px Arial Black, Arial'; g.textAlign = 'center'; g.textBaseline = 'middle';
    const gr = g.createLinearGradient(0, 20, 0, h - 20); gr.addColorStop(0, '#f4f6f8'); gr.addColorStop(0.5, '#9aa0a6'); gr.addColorStop(1, '#e2e5e8');
    g.lineWidth = 8; g.strokeStyle = 'rgba(20,20,22,0.85)'; g.strokeText(text.split('').join(String.fromCharCode(8202)), w / 2, h / 2 + 4);
    g.fillStyle = gr; g.fillText(text.split('').join(String.fromCharCode(8202)), w / 2, h / 2 + 4);
  });
  const mat = new Material({ name: 'badge', map: tex, roughness: 0.25, metalness: 0.6, alphaMode: 'MASK', alphaCutoff: 0.4, doubleSided: true, envBoost: 1.3 });
  const mb = new MB(); const hw = width / 2, hh = width * 160 / 1024 / 2;
  const a = mb.v(-hw, -hh, 0, 0, 0, -1, 1, 1), b = mb.v(hw, -hh, 0, 0, 0, -1, 0, 1), cc = mb.v(hw, hh, 0, 0, 0, -1, 0, 0), d = mb.v(-hw, hh, 0, 0, 0, -1, 1, 0);
  mb.I.push(a, b, cc, a, cc, d);
  const n = new Node('rear_badge'); n.mesh = { prims: [mb.prim(mat)] }; n.castShadow = false;
  return n;
}

// chassis seen when the car is on its roof: frame rails, axles, diff, driveshaft, exhaust, tank, springs
function buildUnderbody(def, meta) {
  const truck = !!def.procWheels && def.mass > 1700;
  const metal = new Material({ name: 'chassis', color: truck ? [0.05, 0.045, 0.04, 1] : [0.06, 0.06, 0.065, 1], roughness: 0.75, metalness: 0.3, envBoost: 0.4 });
  const pan = new Material({ name: 'floorpan', color: [0.03, 0.03, 0.032, 1], roughness: 0.9, envBoost: 0.2, doubleSided: true });
  const pipe = new Material({ name: 'exhaust', color: [0.07, 0.07, 0.075, 1], roughness: 0.55, metalness: 0.7, envBoost: 0.6 });
  const W = meta.wheels, R = meta.wheelRadius;
  const fz = W.find(w => w.front).pos[2], rz = W.find(w => !w.front).pos[2], tx = Math.abs(W[0].pos[0]);
  const lowBody = meta.bmin ? meta.bmin[1] : R;
  const yPan = Math.max(lowBody + 0.03, R * 0.8), yRail = Math.min(yPan - 0.02, R + 0.06);
  const zA = (def.zMin ?? meta.bmin[2]) + 0.35, zB = (def.zMax ?? meta.bmax[2]) - 0.35, hw = (def.halfWidth || 0.85) - 0.12;
  const m = new MB(), p = new MB(), e = new MB();
  // floor pan between the axles (closes the underside), wheel arches stay open
  p.box(0, yPan + 0.01, (fz + rz) / 2, hw * 2, 0.012, (fz - rz) - R * 2.3);
  p.box(0, yPan + 0.03, fz + R * 1.2 + (zB - fz - R * 1.2) / 2, hw * 1.6, 0.012, Math.max(0.1, zB - fz - R * 1.2));
  p.box(0, yPan + 0.03, rz - R * 1.2 - (rz - R * 1.2 - zA) / 2, hw * 1.7, 0.012, Math.max(0.1, rz - R * 1.2 - zA));
  // frame rails and cross members
  for (const sx of [-1, 1]) m.box(sx * (truck ? 0.44 : 0.5), yRail, (zA + zB) / 2, 0.08, truck ? 0.16 : 0.07, zB - zA);
  for (const z of [zB - 0.1, fz - 0.45, (fz + rz) / 2, rz + 0.5, zA + 0.1]) m.box(0, yRail + 0.02, z, truck ? 0.9 : 1.0, 0.06, 0.07);
  // axles / subframes and suspension
  m.push().translate(0, R, rz).rotate(0, 0, 1, Math.PI / 2); m.cylY(0, 0, 0, 0.045, tx * 2 - 0.2, 12); m.pop();
  if (truck) { m.push().translate(0, R, fz).rotate(0, 0, 1, Math.PI / 2); m.cylY(0, 0, 0, 0.045, tx * 2 - 0.2, 12); m.pop(); }
  else m.box(0, R + 0.02, fz, tx * 2 - 0.3, 0.07, 0.25);
  m.pillow(0.08, R, rz, 0.28, 0.24, 0.26, 0.06);                                             // differential
  for (const sx of [-1, 1]) for (const z of [fz, rz]) { m.cylY(sx * (tx - 0.25), R + 0.12, z, 0.05, 0.28, 10); m.cylY(sx * (tx - 0.25), R + 0.12, z, 0.07, 0.03, 10); }
  // gearbox + driveshaft to the rear axle
  m.pillow(0, R + 0.08, fz - 0.55, 0.3, 0.26, 0.6, 0.06);
  m.push().translate(0, R + 0.02, (fz - 0.85 + rz) / 2).rotate(1, 0, 0, Math.PI / 2); m.cylY(0, 0, 0, 0.035, fz - 0.85 - rz, 10); m.pop();
  // fuel tank
  m.pillow(-0.35, yPan - 0.1, rz + 0.55, 0.55, 0.2, 0.6, 0.05);
  // exhaust: pipe along the right, muffler, tail pipe
  e.push().translate(-0.3, yPan - 0.07, (fz - 0.4 + zA) / 2).rotate(1, 0, 0, Math.PI / 2); e.cylY(0, 0, 0, 0.03, fz - 0.4 - zA, 10); e.pop();
  e.push().translate(-0.3, yPan - 0.08, (fz + rz) / 2 - 0.2).rotate(1, 0, 0, Math.PI / 2); e.cylY(0, 0, 0, 0.09, 0.5, 14); e.pop();
  const n = new Node('underbody'); n.mesh = { prims: [m.prim(metal), p.prim(pan), e.prim(pipe)] }; n.castShadow = false;
  return n;
}

// night: glowing head / tail lamp discs (unlit), shown only in night mode
// centre-stack face for cars whose own model has only a blank dash: radio, screen, climate dials
function stackTexture(style) {
  return canvasTex('stack_' + style, 256, 288, (g, w, h) => {
    const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, '#1d1d20'); gr.addColorStop(1, '#0e0e10'); g.fillStyle = gr; g.fillRect(0, 0, w, h);
    g.strokeStyle = '#8d8a84'; g.lineWidth = 4; g.strokeRect(4, 4, w - 8, h - 8);
    // vents
    for (const vx of [20, 146]) { g.fillStyle = '#060607'; g.fillRect(vx, 14, 90, 46); g.strokeStyle = '#2c2c30'; g.lineWidth = 2; for (let i = 0; i < 5; i++) { g.beginPath(); g.moveTo(vx + 4, 20 + i * 9); g.lineTo(vx + 86, 20 + i * 9); g.stroke(); } }
    // radio: display + knobs + buttons
    g.fillStyle = '#0a0c0c'; g.fillRect(24, 74, 208, 104);
    const lc = g.createLinearGradient(0, 88, 0, 128); lc.addColorStop(0, '#6fd3ff'); lc.addColorStop(1, '#2b86c2'); g.fillStyle = lc; g.fillRect(70, 86, 116, 40);
    g.fillStyle = '#062033'; g.font = 'bold 20px Arial'; g.textAlign = 'center'; g.fillText('FM1 101.5', 128, 113);
    for (const kx of [44, 212]) { g.fillStyle = '#2a2a2d'; g.beginPath(); g.arc(kx, 106, 15, 0, 7); g.fill(); g.fillStyle = '#9a9690'; g.beginPath(); g.arc(kx, 106, 5, 0, 7); g.fill(); }
    for (let i = 0; i < 6; i++) { g.fillStyle = '#3a3a3e'; g.fillRect(34 + i * 32, 142, 26, 20); g.fillStyle = '#cfcac0'; g.font = '11px Arial'; g.fillText(String(i + 1), 47 + i * 32, 156); }
    // climate dials
    for (const [kx, col] of [[56, '#3d7dff'], [128, '#bbbbbb'], [200, '#ff4b3d']]) {
      g.fillStyle = '#222226'; g.beginPath(); g.arc(kx, 230, 30, 0, 7); g.fill(); g.strokeStyle = col; g.lineWidth = 4; g.beginPath(); g.arc(kx, 230, 24, 2.4, 7.0); g.stroke();
      g.fillStyle = '#e8e3da'; g.fillRect(kx - 2, 206, 4, 16);
    }
  });
}

function lampGlow(color, r) {
  const mb = new MB(); mb.rotate(0, 1, 0, -Math.PI / 2).discX(0, r, 20, false);
  const n = new Node('lamp_glow'); n.mesh = { prims: [mb.prim(new Material({ name: 'glow', color, unlit: true, doubleSided: true }))] }; n.castShadow = false; n.visible = false;
  return n;
}

// the engine bay for cars whose model is only a shell: engine block with its rocker cover, air box, radiator and fan,
// battery. It sits hidden under the bonnet; in a hard front crash the torn-off skin shows it (and not an empty hole).
function buildEngineBay(def, meta, body) {
  const W = meta.wheels, R = meta.wheelRadius; if (!W || !W.length) return null;
  const fz = W.find(w => w.front).pos[2], zN = def.zMax ?? meta.bmax[2], hw = def.halfWidth || 0.85;
  const P = [...(def.profile || [])].sort((a, b) => b[0] - a[0]);
  const profAt = (z) => { for (let i = 0; i < P.length - 1; i++) { const [z0, y0] = P[i], [z1, y1] = P[i + 1]; if (z <= z0 && z >= z1) return y0 + (y1 - y0) * (z - z0) / (z1 - z0); } return P.length ? P[0][1] : 1.0; };
  // the bonnet's real height along the car (from the model itself), so nothing pokes out through a low sloping nose
  const NB = 40, zA = zN - 2.0, dzb = 2.0 / NB, Hb = new Float32Array(NB).fill(-1);
  if (body) body.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (!p.attrs || !p.attrs.position || p.shadowOnly) continue; const A = p.attrs.position.data;
    for (let i = 0; i < A.length; i += 3) { if (Math.abs(A[i]) > hw * 0.55) continue; const k = Math.floor((A[i + 2] - zA) / dzb); if (k >= 0 && k < NB && A[i + 1] > Hb[k]) Hb[k] = A[i + 1]; } } });
  const topAt = (z) => { let t = profAt(z); const k = Math.floor((z - zA) / dzb); for (let j = k - 1; j <= k + 1; j++) if (j >= 0 && j < NB && Hb[j] > 0) t = Math.min(t, Hb[j]); return t; };
  const y0 = Math.max(R * 0.75, (def.lowY ?? 0.5) - 0.05), zr = zN - 0.3, ze = Math.min(fz + 0.1, zr - 0.55);
  const yTopE = topAt(ze + 0.3) - 0.12; if (yTopE - y0 < 0.28) return null;
  const metal = new Material({ name: 'engineMetal', color: [0.34, 0.34, 0.36, 1], roughness: 0.45, metalness: 0.6, envBoost: 0.5 });
  const dark = new Material({ name: 'engineDark', color: [0.035, 0.035, 0.038, 1], roughness: 0.7, metalness: 0.1 });
  const red = new Material({ name: 'engineRed', color: [0.5, 0.06, 0.05, 1], roughness: 0.4, metalness: 0.3 });
  const a = new MB(), b = new MB(), c = new MB();
  const hE = Math.min(0.5, yTopE - y0 - 0.06), yc = y0 + hE / 2;
  a.pillow(0, yc, ze, Math.min(0.56, hw * 0.62), hE, 0.7, 0.04);                       // engine block
  c.pillow(0.04, y0 + hE + 0.03, ze, Math.min(0.42, hw * 0.48), 0.07, 0.62, 0.03);     // rocker cover
