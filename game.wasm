    place(BX + 62 + r() * 30, z, 24 + r() * 18, 22 + r() * 16, r() < 0.45 ? 40 + r() * 90 : 9 + r() * 12, 0);
    if (Math.abs(z) > 520) place(BX - 62 - r() * 30, z, 24 + r() * 18, 22 + r() * 16, r() < 0.4 ? 35 + r() * 70 : 8 + r() * 10, 0);
    if (Math.abs(z) > 520 && Math.abs(z) < 1380) place(-300 - r() * 40, z, 26 + r() * 16, 24 + r() * 14, 8 + r() * 14, 0);
  }
