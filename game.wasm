// ---------------- number plate ----------------
function plateNode(plateGltf, front) {
  const src = plateGltf.root.children[0];
  const n = new Node(front ? 'plate_front' : 'plate_rear');
  const m = new Node('plate_mesh'); m.mesh = src.mesh; m.pos.set(0, -0.08, 0); // mesh origin is at bottom edge
  n.add(m);
  if (!front) n.rot.setAxisAngle(new V3(0, 1, 0), Math.PI);
  n.castShadow = false;
  return n;
}

// embossed maker's lettering for tailgates (e.g. TOYOTA on the Hilux / Land Cruiser)
function badgeNode(text, width) {
  const tex = canvasTex('badge_' + text, 1024, 160, (g, w, h) => {
    g.clearRect(0, 0, w, h); g.font = 'bold 128px Arial Black, Arial'; g.textAlign = 'center'; g.textBaseline = 'middle';
    const gr = g.createLinearGradient(0, 20, 0, h - 20); gr.addColorStop(0, '#f4f6f8'); gr.addColorStop(0.5, '#9aa0a6'); gr.addColorStop(1, '#e2e5e8');
    g.lineWidth = 8; g.strokeStyle = 'rgba(20,20,22,0.85)'; g.strokeText(text.split('').join(String.fromCharCode(8202)), w / 2, h / 2 + 4);
    g.fillStyle = gr; g.fillText(text.split('').join(String.fromCharCode(8202)), w / 2, h / 2 + 4);
  });
  const mat = new Material({ name: 'badge', map: tex, roughness: 0.25, metalness: 0.6, alphaMode: 'MASK', alphaCutoff: 0.4, doubleSided: true, envBoost: 1.3 });
  const mb = new MB(); const hw = width / 2, hh = width * 160 / 1024 / 2;
  const a = mb.v(-hw, -hh, 0, 0, 0, -1, 1, 1), b = mb.v(hw, -hh, 0, 0, 0, -1, 0, 1), cc = mb.v(hw, hh, 0, 0, 0, -1, 0, 0), d = mb.v(-hw, hh, 0, 0, 0, -1, 1, 0);
  mb.I.push(a, b, cc, a, cc, d);
  const n = new Node('rear_badge'); n.mesh = { prims: [mb.prim(mat)] }; n.castShadow = false;
  return n;
}

// chassis seen when the car is on its roof: frame rails, axles, diff, driveshaft, exhaust, tank, springs
function buildUnderbody(def, meta) {
  const truck = !!def.procWheels && def.mass > 1700;
