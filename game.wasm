  const mats = { jersey: concrete, pole: metal, lamp: lampMat, trunk: trunkMat, frond: frondMat, kc: kcGlass, fz: fzGlass, rj: rjGlass, steel, gold, b0: bldGlass[0], b1: bldGlass[1], b2: bldGlass[2], stone };
  { const n = new Node('riyadh_props'); const prims = []; for (const k in mb) if (mb[k].I.length) prims.push(mb[k].prim(mats[k])); n.mesh = { prims }; root.add(n); }
  let si = 0;
