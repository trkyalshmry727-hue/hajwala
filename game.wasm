    box.append(el('div', 'q', 'تحب تفحط في أي وزنية؟')); const r2 = el('div', 'chips'); r2.append(chip('الوزنية القديمة', F.hand === 'old', () => { F.hand = 'old'; this.renderScreen(); }), chip('الوزنية الجديدة', F.hand === 'new', () => { F.hand = 'new'; this.renderScreen(); })); box.append(r2);
    box.append(el('div', 'q', 'أي ماب تبي هجولتك فيه؟')); const r3 = el('div', 'chips');
    for (const m of [...MAPS3, 'any']) r3.append(chip(m === 'any' ? '🎲 أي ماب' : MAP_NAME[m], (F.map || 'any') === m, () => { F.map = m; this.renderScreen(); })); box.append(r3);
    box.append(el('div', 'q', 'متى تبي هجولتك؟ (بعد ما تنجح في الاختبار)')); const r4 = el('div', 'chips');
