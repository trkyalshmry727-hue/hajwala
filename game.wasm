  makeBot() {
    const g = this.game, keys = ['hilux', 'camry', 'changan', 'shas', 'avanza'], key = keys.find(k => k !== g.carKey && CAR_DEFS[k] && g.pristine[k]) || keys.find(k => g.pristine[k]) || Object.keys(g.pristine)[0];
    const pr = g.pristine[key];
