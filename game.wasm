          (ok ? take : keep).push(I[i], I[i + 1], I[i + 2]); }
        if (!take.length) return p;
        const NN = p.attrs.normal ? p.attrs.normal.data : null, UV = p.attrs.uv ? p.attrs.uv.data : null, PP = [], NO = [], UU = [], II = [], map = new Map();
        for (const v of take) { let j = map.get(v); if (j === undefined) { j = PP.length / 3; map.set(v, j); const L = toLoc(P[v * 3] + o.x, P[v * 3 + 1] + o.y, P[v * 3 + 2] + o.z); PP.push(...L);
          if (NN) { const nx = NN[v * 3], ny = NN[v * 3 + 1], nz = NN[v * 3 + 2]; NO.push(nx, ny * ct + nz * st, -ny * st + nz * ct); } else NO.push(0, 0, -1); UU.push(UV ? UV[v * 2] : 0, UV ? UV[v * 2 + 1] : 0); } II.push(j); }
        add.push(makePrim(PP, NO, UU, II, p.material));
