    const o = (yy * 128 + xx) * 4; img.data[o] = img.data[o + 1] = img.data[o + 2] = 235 + 20 * Math.min(1, n * 0.3); img.data[o + 3] = Math.min(255, a * 255);
  }
  x.putImageData(img, 0, 0);
