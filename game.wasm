          const a = tri[0] * 3, b = tri[1] * 3, c = tri[2] * 3;
          const x = (P[a] + P[b] + P[c]) / 3 * sg, y = (P[a + 1] + P[b + 1] + P[c + 1]) / 3, e = edge(Math.min(Math.max(y, y0), top));
          if (!(x > 0 && e > 0 && x > e - 0.24)) { keep.push(...tri); continue; }
          let poly = tri;
          for (const f of planes) {
            const inP = [], outP = [];
            for (let q = 0; q < poly.length; q++) {
              const A = poly[q], B = poly[(q + 1) % poly.length], fa2 = f(V(A)), fb = f(V(B));
              if (fa2 >= 0) inP.push(A); else outP.push(A);
              if ((fa2 >= 0) !== (fb >= 0)) { const m = mix(A, B, fa2 / (fa2 - fb)); inP.push(m); outP.push(m); }
            }
