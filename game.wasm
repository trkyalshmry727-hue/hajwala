#xRadial .it b{display:block;font-size:24px;line-height:1}
#xRadial .it.on{background:#7a5a12;border-color:#f5c24b}
#xRadial .mid{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#f5c24b;font-weight:900;font-size:15px;text-align:center;pointer-events:none;max-width:30%}
#xPanel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:41;width:min(560px,92vw);max-height:88vh;overflow:auto;background:rgba(20,18,13,.96);border:1px solid rgba(245,194,75,.4);border-radius:18px;padding:14px;color:#f3e6c8;direction:rtl;box-shadow:0 12px 40px #000c}
#xPanel h3{margin:0 0 8px;color:#f5c24b;font-size:19px} #xPanel p{margin:6px 0;line-height:1.6;font-size:15px}
#xPanel .row{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0} #xPanel .note{opacity:.75;font-size:13px}
#xPanel button{font:800 15px inherit;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:9px 14px;touch-action:manipulation}
#xPanel button.go{background:#1f7a3f;border-color:#7ce29f} #xPanel button.red{background:#9b231b;border-color:#ff8a7a} #xPanel button.on{outline:2px solid #f5c24b}
#xPanel .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
