      const o = R.car, ob = o.body;
      if (b.pos.dist(ob.pos) > 9) continue;
      for (const s of my.spheres) {
        const c1 = new V3().copy(s).applyQ(b.q).add(b.pos);
        for (const t of o.spheres) {
          const c2 = new V3().copy(t).applyQ(ob.q).add(ob.pos);
          const d = c1.dist(c2), rr = s.r + t.r; if (d >= rr || d < 1e-4) continue;
          const n = c1.clone().sub(c2).scale(1 / d), depth = rr - d;
          b.pos.addS(n, Math.min(depth * 0.5, 0.05));
          const cp = c2.clone().addS(n, t.r);
          const rel = b.velAt(cp, new V3()).sub(ob.vel); const vn = rel.dot(n);
          if (vn < 0) {
            const k = b.invMassAt(cp, n) + (R.isBot ? ob.invMassAt(cp, n) : 1 / o.def.mass);
            const j = -(1.15) * vn / k; b.applyImpulse(n.clone().scale(j), cp);
            if (R.isBot) { ob.applyImpulse(n.clone().scale(-j), cp); ob.pos.addS(n, -Math.min(depth * 0.5, 0.05)); if (-vn > 2.5) o.impacts.push({ point: cp.clone(), normal: n.clone().scale(-1), speed: -vn, tag: 7 }); }
            if (-vn > 2.5) my.impacts.push({ point: cp, normal: n.clone(), speed: -vn, tag: 7 });
          }
        }
      }
    }
  }
}

return { BOT_ID, randomName, normName, peerIdFor, Net };
})();
__M['economy'] = (() => {
// Money (silver), keys (gold), levels, cars you own, profile and achievements — all kept on the phone (localStorage).
// No real payments yet (no prices shown): the store's paid items are given as if paid, as the owner asked, until payments are set up.

// the owner's test build: unlimited money and keys (set to false for the public release)
const UNLIMITED = true;

// how each car is unlocked: own (free from the start) · money (silver) · keys (gold) · level (needed first) · store (paid in the store)
const CAR_PRICE = {
  shas: { own: true },
  hilux: { money: 1000 },
  hilux2: { money: 1500 },
  rub: { money: 2000 },
  changan: { level: 5, money: 1000 },
  camry: { level: 10, keys: 100 },
  tahoe: { level: 9, money: 5000 },
  datsun: { money: 1200 },
  caprice: { level: 11, money: 6000 },
  hilux07: { keys: 300 },
  hilux07s: { level: 12, money: 10000 },
  fortuner: { keys: 350 },
  sierra: { keys: 700 },
  lcold: { level: 13, money: 5000 },
  camry20: { level: 13, money: 10000 },
  avanza: { level: 14, money: 3000 },
  yukon: { money: 4000 },
  fj40: { money: 2500 },
  // the store's cars
  elantra: { store: true },
  prado: { store: true },
  gmcold: { store: true },
  lexus: { store: true },
};

const GOLD_PACKS = [
  { keys: 50 }, { keys: 120 }, { keys: 300 }, { keys: 800 },
];
const MONEY_PACKS = [
  { money: 1000, keys: 10 }, { money: 5000, keys: 45 }, { money: 12000, keys: 100 }, { money: 30000, keys: 230 },
];
const SUBS = [{ id: 'noads', name: 'بدون إعلانات', desc: 'تلعب بدون أي إعلان' }];

const ACHIEVEMENTS = [
  { id: 'firstDrift', name: 'أول هجولة', desc: 'سجّل أول تفحيطة', icon: '🔥' },
  { id: 'drift1k', name: 'تفحيطة ألف', desc: 'تفحيطة وحدة فوق ١٬٠٠٠ نقطة', icon: '💨' },
  { id: 'drift5k', name: 'ملك الطارة', desc: 'تفحيطة وحدة فوق ٥٬٠٠٠ نقطة', icon: '👑' },
  { id: 'pts10k', name: 'مجموع ١٠ آلاف', desc: 'اجمع ١٠٬٠٠٠ نقطة', icon: '⭐' },
  { id: 'pts100k', name: 'مجموع ١٠٠ ألف', desc: 'اجمع ١٠٠٬٠٠٠ نقطة', icon: '🌟' },
  { id: 'lvl5', name: 'مستوى ٥', desc: 'وصلت المستوى ٥', icon: '🏅' },
  { id: 'lvl10', name: 'مستوى ١٠', desc: 'وصلت المستوى ١٠', icon: '🥇' },
  { id: 'buy1', name: 'أول سيارة', desc: 'اشتريت أول سيارة', icon: '🚙' },
  { id: 'own5', name: 'كراج صغير', desc: 'عندك ٥ سيارات', icon: '🏠' },
  { id: 'own10', name: 'كراج كبير', desc: 'عندك ١٠ سيارات', icon: '🏢' },
  { id: 'km10', name: '١٠ كيلو', desc: 'مشيت ١٠ كيلومتر', icon: '🛣️' },
  { id: 'km100', name: '١٠٠ كيلو', desc: 'مشيت ١٠٠ كيلومتر', icon: '🗺️' },
  { id: 'crash', name: 'حادث قوي', desc: 'صدمت فوق ١٥٠ كم/س', icon: '💥' },
];

const KEY = 'hajwala.profile';
const xpFor = (lvl) => Math.round(1000 * Math.pow(Math.max(0, lvl - 1), 1.6)); // total xp needed to reach a level

class Economy {
  constructor() {
    let d = null;
    try { d = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { d = null; }
    const fresh = !d;
    d = d || {};
    this.d = {
      money: 500, keys: 10, xp: 0, owned: ['shas'], fav: 'shas', name: null, avatar: null,
      id: null, noAds: false, ach: [], pts: 0, bestDrift: 0, km: 0, bought: 0, ...d,
    };
    if (!this.d.id) this.d.id = String(10000000 + Math.floor(Math.random() * 89999999));
    if (!Array.isArray(this.d.owned) || !this.d.owned.length) this.d.owned = ['shas'];
    for (const k in CAR_PRICE) if (CAR_PRICE[k].own && !this.d.owned.includes(k)) this.d.owned.push(k);
    this.listeners = new Set();
    if (fresh) this.save();
    // keep the save safe when the app goes to the background or closes
    try { document.addEventListener('visibilitychange', () => { if (document.hidden) this.save(); }); window.addEventListener('pagehide', () => this.save()); } catch (e) { }
  }
  save() { try { localStorage.setItem(KEY, JSON.stringify(this.d)); } catch (e) { } }
  changed() { this.save(); for (const f of this.listeners) try { f(); } catch (e) { } }
  on(f) { this.listeners.add(f); }

  get money() { return UNLIMITED ? Infinity : this.d.money; }
  get keys() { return UNLIMITED ? Infinity : this.d.keys; }
  get level() { let l = 1; while (this.d.xp >= xpFor(l + 1)) l++; return l; }
  levelProgress() { const l = this.level, a = xpFor(l), b = xpFor(l + 1); return { level: l, xp: this.d.xp, from: a, to: b, t: (this.d.xp - a) / Math.max(1, b - a) }; }

  owns(k) { return this.d.owned.includes(k); }
  // what the player sees about a car: { owned, locked (level too low), price text, store }
  carState(k) {
    const P = CAR_PRICE[k] || { own: true };
    if (this.owns(k) || P.own) return { owned: true };
    if (P.store) return { owned: false, store: true, label: 'اذهب إلى المتجر' };
    if (P.level && this.level < P.level) return { owned: false, needLevel: P.level, label: 'مستوى ' + P.level.toLocaleString('ar-SA') };
    if (P.keys) return { owned: false, keys: P.keys, label: P.keys.toLocaleString('ar-SA') };
    return { owned: false, money: P.money || 0, label: (P.money || 0).toLocaleString('ar-SA') };
  }
  // buy with silver or gold; returns '' or the reason it failed
  buyCar(k) {
    const s = this.carState(k);
    if (s.owned) return '';
    if (s.store) return 'store';
    if (s.needLevel) return 'level';
    if (s.keys) { if (this.keys < s.keys) return 'keys'; if (!UNLIMITED) this.d.keys -= s.keys; }
    else { if (this.money < s.money) return 'money'; if (!UNLIMITED) this.d.money -= s.money; }
    this.grant(k); return '';
  }
  grant(k) { if (!this.d.owned.includes(k)) this.d.owned.push(k); this.d.bought++; this.checkAch(); this.changed(); }
  addKeys(n) { if (!UNLIMITED) this.d.keys += n; this.changed(); }
  buyMoney(pack) { if (this.keys < pack.keys) return 'keys'; if (!UNLIMITED) { this.d.keys -= pack.keys; this.d.money += pack.money; } this.changed(); return ''; }
  setSub(id, on) { if (id === 'noads') this.d.noAds = on; this.changed(); }

  // play: drift points give xp and a little money
  onDrift(pts) {
    const before = this.level;
    this.d.xp += pts; this.d.pts += pts; this.d.bestDrift = Math.max(this.d.bestDrift, pts);
    if (!UNLIMITED) this.d.money += Math.round(pts / 20);
    this.checkAch(); this.changed();
    return this.level > before ? this.level : 0;
  }
  onDistance(m) { this.d.km += m / 1000; if (Math.floor(this.d.km) !== Math.floor(this.d.km - m / 1000)) { this.checkAch(); this.changed(); } }
  onCrash(kmh) { if (kmh >= 150 && !this.d.ach.includes('crash')) { this.d.ach.push('crash'); this.changed(); return true; } return false; }
  checkAch() {
    const A = this.d.ach, add = (id, ok) => { if (ok && !A.includes(id)) { A.push(id); this.newAch = id; } };
    add('firstDrift', this.d.pts > 0); add('drift1k', this.d.bestDrift >= 1000); add('drift5k', this.d.bestDrift >= 5000);
    add('pts10k', this.d.pts >= 10000); add('pts100k', this.d.pts >= 100000);
    add('lvl5', this.level >= 5); add('lvl10', this.level >= 10);
    add('buy1', this.d.bought >= 1); add('own5', this.d.owned.length >= 5); add('own10', this.d.owned.length >= 10);
    add('km10', this.d.km >= 10); add('km100', this.d.km >= 100);
  }
}

const fmt = (n) => n === Infinity ? '∞' : Math.floor(n).toLocaleString('ar-SA');

return { UNLIMITED, CAR_PRICE, GOLD_PACKS, MONEY_PACKS, SUBS, ACHIEVEMENTS, Economy, fmt };
})();
