  e.push().translate(-0.3, yPan - 0.07, (fz - 0.4 + zA) / 2).rotate(1, 0, 0, Math.PI / 2); e.cylY(0, 0, 0, 0.03, fz - 0.4 - zA, 10); e.pop();
  e.push().translate(-0.3, yPan - 0.08, (fz + rz) / 2 - 0.2).rotate(1, 0, 0, Math.PI / 2); e.cylY(0, 0, 0, 0.09, 0.5, 14); e.pop();
  const n = new Node('underbody'); n.mesh = { prims: [m.prim(metal), p.prim(pan), e.prim(pipe)] }; n.castShadow = false;
  return n;
}

// night: glowing head / tail lamp discs (unlit), shown only in night mode
// centre-stack face for cars whose own model has only a blank dash: radio, screen, climate dials
function stackTexture(style) {
  return canvasTex('stack_' + style, 256, 288, (g, w, h) => {
    const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, '#1d1d20'); gr.addColorStop(1, '#0e0e10'); g.fillStyle = gr; g.fillRect(0, 0, w, h);
    g.strokeStyle = '#8d8a84'; g.lineWidth = 4; g.strokeRect(4, 4, w - 8, h - 8);
    // vents
    for (const vx of [20, 146]) { g.fillStyle = '#060607'; g.fillRect(vx, 14, 90, 46); g.strokeStyle = '#2c2c30'; g.lineWidth = 2; for (let i = 0; i < 5; i++) { g.beginPath(); g.moveTo(vx + 4, 20 + i * 9); g.lineTo(vx + 86, 20 + i * 9); g.stroke(); } }
    // radio: display + knobs + buttons
    g.fillStyle = '#0a0c0c'; g.fillRect(24, 74, 208, 104);
    const lc = g.createLinearGradient(0, 88, 0, 128); lc.addColorStop(0, '#6fd3ff'); lc.addColorStop(1, '#2b86c2'); g.fillStyle = lc; g.fillRect(70, 86, 116, 40);
    g.fillStyle = '#062033'; g.font = 'bold 20px Arial'; g.textAlign = 'center'; g.fillText('FM1 101.5', 128, 113);
    for (const kx of [44, 212]) { g.fillStyle = '#2a2a2d'; g.beginPath(); g.arc(kx, 106, 15, 0, 7); g.fill(); g.fillStyle = '#9a9690'; g.beginPath(); g.arc(kx, 106, 5, 0, 7); g.fill(); }
    for (let i = 0; i < 6; i++) { g.fillStyle = '#3a3a3e'; g.fillRect(34 + i * 32, 142, 26, 20); g.fillStyle = '#cfcac0'; g.font = '11px Arial'; g.fillText(String(i + 1), 47 + i * 32, 156); }
    // climate dials
    for (const [kx, col] of [[56, '#3d7dff'], [128, '#bbbbbb'], [200, '#ff4b3d']]) {
      g.fillStyle = '#222226'; g.beginPath(); g.arc(kx, 230, 30, 0, 7); g.fill(); g.strokeStyle = col; g.lineWidth = 4; g.beginPath(); g.arc(kx, 230, 24, 2.4, 7.0); g.stroke();
      g.fillStyle = '#e8e3da'; g.fillRect(kx - 2, 206, 4, 16);
    }
  });
}

function lampGlow(color, r) {
  const mb = new MB(); mb.rotate(0, 1, 0, -Math.PI / 2).discX(0, r, 20, false);
  const n = new Node('lamp_glow'); n.mesh = { prims: [mb.prim(new Material({ name: 'glow', color, unlit: true, doubleSided: true }))] }; n.castShadow = false; n.visible = false;
  return n;
}

