    ir.box(sx, gy + 2.45, sz2, 0.1, 0.1, 3.4);
    for (const dz of [-0.8, 0.8]) { ir.box(sx - 0.2, gy + 1.5, sz2 + dz, 0.03, 1.9, 0.03); ir.box(sx + 0.2, gy + 1.5, sz2 + dz, 0.03, 1.9, 0.03); w.box(sx, gy + 0.55, sz2 + dz, 0.55, 0.06, 0.4); }
    colBox(world, sx, gy + 1.2, sz2, 1.6, 2.5, 3.4, 0, 7);
    for (const [bx, bz] of [[px - 6, pz + 3], [px + 6, pz - 3], [px - 3, pz - 7]]) { w.box(bx, gy + 0.45, bz, 1.8, 0.08, 0.5); w.box(bx, gy + 0.22, bz, 0.08, 0.44, 0.45); }
    const n = new Node('park'); n.mesh = { prims: [g.prim(grass), w.prim(wood), l.prim(leaf), ir.prim(iron), pa.prim(path)] }; root.add(n);
    signs.push({ c: px + 23, z: pz, yaw: -Math.PI / 2, lines: ['حديقة', 'مراجيح'], small: true, y: 2.6 });
  }
  // ---- mall (مول) east of the road
  if (assets.mall) {
    const src = assets.mall.root; const mx = BX + 250, mz = -1150;
    let y0 = 1e9, x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; src.updateWorld();
    src.traverse(nn => { if (!nn.mesh) return; for (const p of nn.mesh.prims) { const a = p.attrs.position.data; const v = new V3(); for (let i = 0; i < a.length; i += 30) { v.set(a[i], a[i + 1], a[i + 2]).applyM4(nn.world); y0 = Math.min(y0, v.y); x0 = Math.min(x0, v.x); x1 = Math.max(x1, v.x); z0 = Math.min(z0, v.z); z1 = Math.max(z1, v.z); } } });
