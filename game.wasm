      this.plates.push({ node: n, home: n.pos.clone(), rot: n.rot.clone(), off: new V3() });
    }
  }

  // z of the windscreen glass at height y (centre of the car), so the rear-view mirror hangs just inside it
  windscreenZ(y) {
    let best = -1e9; const src = this.bodyNode || this.model;
    src.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (!p.material || !p.material.glass) continue; const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { if (Math.abs(a[i]) < 0.35 && Math.abs(a[i + 1] - y) < 0.06 && a[i + 2] > 0.1 && a[i + 2] > best) best = a[i + 2]; } } });
    return best > -1e8 ? best - 0.07 : undefined;
  }

  // lowest roof-skin height above the cabin at a given z (scan cars have no inner roof, so the liner must stay under this)
  roofY(z, minY) {
    let best = 1e9; const src = this.bodyNode || this.model;
    src.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (!p.material || p.material.glass) continue; const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { if (Math.abs(a[i]) < 0.45 && Math.abs(a[i + 2] - z) < 0.09 && a[i + 1] > minY && a[i + 1] < best) best = a[i + 1]; } } });
    return best < 1e8 ? best : undefined;
  }

  // night: the car's OWN lamp geometry lights up (head-lamp lenses white, tail lamps red); the small glow discs
  // are only a fallback for scanned cars whose lamps aren't separate materials
  lampMats() {
    if (this._lampMats) return this._lampMats;
    const head = new Set(), tail = new Set();
    this.model.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { const m = p.material; if (!m || m.glass) continue;
      const nm = (m.name || '').toLowerCase();
      if (m.tail || /tail|brake|red_light|rglass|eglass/.test(nm)) tail.add(m);
      else if (m.head || /head|_lamp$|lamp_0|lights_16|glass1\.001|rvglass/.test(nm)) head.add(m); } });
    for (const m of [...head, ...tail]) m._emis0 = m.emissive.slice();
    return (this._lampMats = { head: [...head], tail: [...tail] });
  }
  setNight(on) {
    this.night = on; const L = this.lampMats(), own = L.head.length > 0;
    for (const l of this.lamps || []) l.node.visible = on && (!own || !l.head) && (!L.tail.length || l.head);
    for (const m of L.head) m.emissive = on ? [2.2, 2.1, 1.9] : m._emis0;
    this.updateTailGlow();
  }
  updateTailGlow() {
    const L = this._lampMats; if (!L) return; const b = this.brakeIn || 0;
    for (const m of L.tail) m.emissive = this.night ? [0.9 + 1.6 * b, 0.02, 0.01] : b > 0.1 ? [1.2 * b, 0.01, 0.005] : m._emis0;
  }
  // world-space lights this car casts at night: two headlight spots + a red glow behind
  pushLights(out) {
    this.updateTailGlow();
    const f = this.forward(_n).clone(); const down = this.up(new V3()).scale(-0.12); const dir = f.clone().add(down).norm();
    for (const l of this.lamps || []) {
      const p = this.localToWorld(l.local, new V3());
      if (l.head) out.push({ pos: p, range: 55, dir, cos: 0.86, color: [7, 6.6, 5.8] });
    }
    const rear = this.localToWorld(new V3(0, 0.35, this.def.zMin - 1.1), new V3());
    out.push({ pos: rear, range: 3.2, color: [0.35 + 0.9 * (this.brakeIn || 0), 0.012, 0.008] });
  }

  // live gauges and a centre stack on models whose own dash is a blank shell
  addDecor(D) {
    const node = new Node('decor'); const prims = [];
    const panel = (mat, c, w, h, tilt) => { const mb = new MB(); mb.push().translate(c[0], c[1], c[2]).rotate(1, 0, 0, tilt);
      const a = mb.v(w / 2, -h / 2, 0, 0, 0, -1, 0, 1), b = mb.v(-w / 2, -h / 2, 0, 0, 0, -1, 1, 1), cc = mb.v(-w / 2, h / 2, 0, 0, 0, -1, 1, 0), dd = mb.v(w / 2, h / 2, 0, 0, 0, -1, 0, 0); mb.quad(a, b, cc, dd); mb.pop(); prims.push(mb.prim(mat)); };
    const bezel = new Material({ name: 'decor_bezel', color: [0.04, 0.04, 0.045, 1], roughness: 0.5 });
    if (D.cluster) { const C = D.cluster; this.cluster = clusterCanvas(C.style || 'analog2');
      const bz = new MB(); bz.push().translate(C.pos[0], C.pos[1], C.pos[2] + 0.012).rotate(1, 0, 0, C.tilt || 0); bz.box(0, 0, 0, C.w + 0.04, C.h + 0.04, 0.02); bz.pop(); prims.push(bz.prim(bezel));
      panel(new Material({ name: 'cluster', map: this.cluster.tex, unlit: true, doubleSided: true }), C.pos, C.w, C.h, C.tilt || 0); }
    if (D.dash) { // a moulded dashboard for models that have none: top pad, face, glovebox line and a centre console
      const [x0, x1, y0, y1, z0, z1] = D.dash, plast = new Material({ name: 'decor_dash', color: [...(D.dashColor || [0.07, 0.07, 0.075]), 1], roughness: 0.7 }), soft = new Material({ name: 'decor_pad', color: [...(D.padColor || [0.12, 0.11, 0.1]), 1], roughness: 0.85 });
      const mb = new MB(), pad = new MB(); const W = x1 - x0, cx = (x0 + x1) / 2;
      mb.box(cx, (y0 + y1) / 2 - 0.03, (z0 + z1) / 2 + 0.03, W, y1 - y0 - 0.06, z1 - z0 - 0.06);          // body of the dash
      pad.pillow(cx, y1 - 0.03, (z0 + z1) / 2, W + 0.02, 0.07, z1 - z0, 0.03);                            // soft top pad
      mb.box(cx, y0 + 0.05, z0 + 0.02, W - 0.1, 0.02, 0.02);                                              // lower lip
      mb.box(0, y0 - 0.12, z0 + 0.25, 0.26, 0.3, 0.5);                                                     // centre console
      for (const vx of [x0 + 0.1, x1 - 0.1, -0.08, 0.08]) mb.box(vx, y1 - 0.14, z0 - 0.005, 0.09, 0.05, 0.02); // air vents
      prims.push(mb.prim(plast), pad.prim(soft));
    }
    if (D.stack) { const C = D.stack; panel(new Material({ name: 'stack', map: stackTexture(C.style || 'gm'), roughness: 0.5, doubleSided: true }), C.pos, C.w, C.h, C.tilt || 0); }
    node.mesh = { prims }; node.castShadow = false; this.model.add(node);
  }

  // a real cabin (dash, seats, steering wheel) cut from another model file, fitted into this car at load time:
  // E = { asset, cut: [{ box: [x0,x1,y0,y1,z0,z1], nodes: /re/, mat: /re/, flat: true }], doubleSided: /re/ }
  fitCabin(E, meta) {
    const ig = Car.assets && Car.assets[E.asset]; if (!ig) return;
    // the model's own (fixed) steering wheel goes: the new cabin brings a turning one
    for (const n of this.model.findAll(n => n.name === 'steering' || n.name === 'interior')) if (n.parent) n.parent.remove(n);
    const root = ig.root.children[0];
    const off = E.offset || [0, 0, 0];
    for (const c of root.children) { const k = c.clone(true); k.pos.x += off[0]; k.pos.y += off[1]; k.pos.z += off[2]; this.model.add(k); }
    if (ig.json && ig.json.extras && ig.json.extras.steer) { const st = ig.json.extras.steer; meta.steer = { ...st, center: [st.center[0] + off[0], st.center[1] + off[1], st.center[2] + off[2]] }; }
    // clear the model's own cabin clutter / a bed cover / a bit of the new cabin (single cab)
    for (const R of E.cut || []) {
      const [x0, x1, y0, y1, z0, z1] = R.box, nre = R.nodes || /^(body|door_[lr])$/;
      for (const n of this.model.children) {
        if (!n.mesh || !nre.test(n.name)) continue; const o = n.pos;
        n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => {
          if (R.mat && !(p.material && R.mat.test(p.material.name))) return p;
          if (p.material && (p.material.glass || p.material.alphaMode === 'BLEND') && !R.glass) return p;
          const P = p.attrs.position.data, I = p.index, keep = [];
          for (let i = 0; i < I.length; i += 3) {
            const a = I[i] * 3, b = I[i + 1] * 3, c = I[i + 2] * 3;
            const x = (P[a] + P[b] + P[c]) / 3 + o.x, y = (P[a + 1] + P[b + 1] + P[c + 1]) / 3 + o.y, z = (P[a + 2] + P[b + 2] + P[c + 2]) / 3 + o.z;
            let inside = x > x0 && x < x1 && y > y0 && y < y1 && z > z0 && z < z1;
            if (inside && R.flat) { const ux = P[b] - P[a], uy = P[b + 1] - P[a + 1], uz = P[b + 2] - P[a + 2], vx = P[c] - P[a], vy = P[c + 1] - P[a + 1], vz = P[c + 2] - P[a + 2];
              const nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx; inside = Math.abs(ny) > 0.7 * Math.hypot(nx, ny, nz); }
            if (!inside) keep.push(I[i], I[i + 1], I[i + 2]);
          }
          if (keep.length === I.length) return p;
          return { ...p, index: I instanceof Uint32Array ? new Uint32Array(keep) : new Uint16Array(keep), gpu: null };
        }) };
      }
    }
    if (E.doubleSided) this.model.traverse(n => { if (n.mesh) for (const p of n.mesh.prims) if (p.material && E.doubleSided.test(p.material.name)) { p.material.doubleSided = true; if (!p.material.backColor) p.material.backColor = this.def.backColor || [0.13, 0.12, 0.115, 1]; } });
    if (E.bed) this.addBed(E.bed, meta);
    if (E.desat) for (const n of this.model.children) if (n.name === 'interior' || n.name === 'steering') n.traverse(k => { if (k.mesh) for (const p of k.mesh.prims) { const m = p.material; if (!m || m._desat || m.map) continue; const c = m.color, l = c[0] * 0.3 + c[1] * 0.55 + c[2] * 0.15; m.color = [l * 0.95, l * 0.93, l * 0.9, c[3]]; m._desat = true; } });
    if (E.mats) this.model.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { const o = p.material && E.mats[p.material.name]; if (!o || p.material._recol) continue;
      if (o.color) p.material.color = [...o.color, 1]; if (o.noMap) p.material.map = null; if (o.rough !== undefined) p.material.roughness = o.rough; p.material._recol = true; } });
    if (E.beams) { // trim strips (pillars) along a line, mirrored to both sides: [ax, ay, az, bx, by, bz, wx, wy, wz, thick]
      const mb = new MB(), V = (x, y, z) => new V3(x, y, z);
      for (const B of E.beams) for (const sx of [1, -1]) {
        const a = V(B[0] * sx, B[1], B[2]), b = V(B[3] * sx, B[4], B[5]), w = V(B[6] * sx, B[7], B[8]).scale(0.5), d = b.clone().sub(a);
        const nrm = d.clone().cross(w).norm().scale(B[9] / 2);
        const P = []; for (const e of [a, b]) for (const sw of [-1, 1]) for (const sn of [-1, 1]) P.push(e.clone().addS(w, sw).addS(nrm, sn));
        const q = (i, j, k, l) => { const f = [P[i], P[j], P[k], P[l]]; const nn = f[1].clone().sub(f[0]).cross(f[2].clone().sub(f[0])).norm(); const ix = f.map(v => mb.v(v.x, v.y, v.z, nn.x, nn.y, nn.z, 0, 0)); mb.quad(ix[0], ix[1], ix[2], ix[3]); };
        q(0, 1, 3, 2); q(4, 6, 7, 5); q(0, 4, 5, 1); q(2, 3, 7, 6); q(0, 2, 6, 4); q(1, 5, 7, 3);
      }
      const n = new Node('cabin_beams'); n.mesh = { prims: [mb.prim(new Material({ name: 'cabinBeam', color: [...(E.beamColor || [0.1, 0.095, 0.09]), 1], roughness: 0.85, doubleSided: true }))] }; n.castShadow = false; this.model.add(n);
    }
    if (E.fill) { // dark panels that close gaps in the new cabin (so the engine bay / white body skin can't be seen through them)
      const mb = new MB(); for (const [x0, x1, y0, y1, z0, z1] of E.fill) mb.box((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2, x1 - x0, y1 - y0, z1 - z0);
      const n = new Node('cabin_fill'); n.mesh = { prims: [mb.prim(new Material({ name: 'cabinFill', color: [...(E.fillColor || [0.035, 0.035, 0.04]), 1], roughness: 0.8, doubleSided: true }))] }; n.castShadow = false; this.model.add(n);
    }
  }

  // a clean pickup bed (liner tub): floor with ribs, inner walls, wheel humps. Everything the model had inside the
  // bed volume (hollow shell, a cover's leftovers, rods, the cabin's back seats poking through) is cut away first.
  addBed(B, meta) {
    const { x, y0, y1, z0, z1 } = B;
    for (const n of this.model.children) {
      if (!n.mesh || /^wheel_|^steering$|^shadow_proxy$/.test(n.name)) continue; const o = n.pos;
      n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => {
        const P = p.attrs.position.data, I = p.index; if (!I) return p; const keep = [];
        for (let i = 0; i < I.length; i += 3) {
          const a = I[i] * 3, b = I[i + 1] * 3, c = I[i + 2] * 3;
          const cx = (P[a] + P[b] + P[c]) / 3 + o.x, cy = (P[a + 1] + P[b + 1] + P[c + 1]) / 3 + o.y, cz = (P[a + 2] + P[b + 2] + P[c + 2]) / 3 + o.z;
          if (!(Math.abs(cx) < x - 0.015 && cy > y0 - 0.25 && cy < y1 + 0.5 && cz > z0 + 0.015 && cz < z1 - 0.015)) keep.push(I[i], I[i + 1], I[i + 2]);
        }
        if (keep.length === I.length) return p;
        return { ...p, index: I instanceof Uint32Array ? new Uint32Array(keep) : new Uint16Array(keep), gpu: null };
      }) };
    }
    const liner = new Material({ name: 'bedLiner', color: [...(B.color || [0.1, 0.1, 0.105]), 1], roughness: 0.88, doubleSided: true });
    const mb = new MB(), t = 0.025, L = z1 - z0, zc = (z0 + z1) / 2, H = y1 - y0;
    mb.box(0, y0 - t / 2, zc, x * 2, t, L);                                  // floor
    for (const s of [-1, 1]) mb.box(s * (x - t / 2), y0 + H / 2, zc, t, H, L); // side walls
    mb.box(0, y0 + H / 2, z1 - t / 2, x * 2, H, t);                          // front wall (behind the cab)
    mb.box(0, y0 + H / 2, z0 + t / 2, x * 2, H, t);                          // inside of the tailgate
    for (let k = -3; k <= 3; k++) mb.box(k * x / 4, y0 + 0.008, zc, 0.05, 0.016, L - 0.06); // floor ribs
    const rw = (meta.wheels || []).filter(w => !w.front);
    const wz = rw.length ? rw.reduce((a, w) => a + w.pos[2], 0) / rw.length : null;
    if (wz !== null && wz > z0 + 0.3 && wz < z1 - 0.3) for (const s of [-1, 1]) {           // rear wheel humps
      mb.box(s * (x - 0.13), y0 + 0.11, wz, 0.26, 0.22, 0.86); mb.box(s * (x - 0.13), y0 + 0.23, wz, 0.22, 0.03, 0.8);
    }
    const n = new Node('bed'); n.mesh = { prims: [mb.prim(liner)] }; n.castShadow = true; this.model.add(n);
  }

  // the model's 'steering' piece is only part of the wheel (e.g. just the leather): pull the rest of the wheel (spokes,
  // hub, buttons) out of the body inside a disc around the column, so the whole wheel turns together
  grabSteerParts(G, sn, ms) {
    const c = ms.center, t = ms.tilt, ct = Math.cos(t), st = Math.sin(t), R = G.r || 0.2, dep = G.depth || 0.07;
    const toLoc = (x, y, z) => { const dx = x - c[0], dy = y - c[1], dz = z - c[2]; return [dx, dy * ct + dz * st, -dy * st + dz * ct]; }; // rotate by -tilt about x
    const add = [];
    for (const n of this.model.children) {
      if (!n.mesh || !/^(body|interior)$/.test(n.name)) continue; const o = n.pos;
      n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => {
        if (p.material && (p.material.glass || p.material.alphaMode === 'BLEND')) return p;
        if (G.mat && !(p.material && G.mat.test(p.material.name))) return p;
        const P = p.attrs.position.data, I = p.index; if (!I) return p; const keep = [], take = [];
        const inside = v => { const L = toLoc(P[v * 3] + o.x, P[v * 3 + 1] + o.y, P[v * 3 + 2] + o.z); if (L[2] < (G.a0 ?? -dep) || L[2] > (G.a1 ?? dep) || Math.hypot(L[0], L[1]) > R) return false;
          if (G.out) for (const b of G.out) if (Math.abs(L[0]) > b[0] && L[2] > b[1]) return false; return true; };
        if (G.whole) { // whole loose pieces only: a piece is taken when every vertex of it is in the wheel's disc
          const nv = P.length / 3, par = new Int32Array(nv), wm = new Map(); for (let v = 0; v < nv; v++) par[v] = v;
          const f = v => { while (par[v] !== v) { par[v] = par[par[v]]; v = par[v]; } return v; }, u = (a, b) => { a = f(a); b = f(b); if (a !== b) par[a] = b; };
          for (let v = 0; v < nv; v++) { const k = Math.round(P[v * 3] * 4000) + ',' + Math.round(P[v * 3 + 1] * 4000) + ',' + Math.round(P[v * 3 + 2] * 4000); const w = wm.get(k); if (w === undefined) wm.set(k, v); else u(v, w); }
          for (let i = 0; i < I.length; i += 3) { u(I[i], I[i + 1]); u(I[i], I[i + 2]); }
          const bad = new Uint8Array(nv); for (let v = 0; v < nv; v++) if (!inside(v)) bad[f(v)] = 1;
          for (let i = 0; i < I.length; i += 3) (bad[f(I[i])] ? keep : take).push(I[i], I[i + 1], I[i + 2]);
        } else for (let i = 0; i < I.length; i += 3) { let ok = true;
