    two: [null, { index: 0, middle: 0, ring: 1, pinky: 1, thumb: 1 }], pump: [null, { index: 1, middle: 1, ring: 1, pinky: 1, thumb: 0.8 }],
    whistle: [null, { index: 0.35, middle: 0.35, ring: 1, pinky: 1, thumb: 0.7 }], shout: [{ index: 0.25, middle: 0.25, ring: 0.25, pinky: 0.25, thumb: 0.1 }, { index: 0.25, middle: 0.25, ring: 0.25, pinky: 0.25, thumb: 0.1 }],
