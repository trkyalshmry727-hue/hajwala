        await ensureMapAssets(key, (p) => { if (mapWant === key && screen !== 'play') $('gSpec').textContent = `نحمّل ${MAPS[key].name}… ${Math.round(p * 100).toLocaleString('ar-SA')}٪`; });
        if (mapWant !== key) continue;
        if (screen !== 'play') $('gSpec').textContent = 'نجهّز الخريطة…';
        await new Promise(r => setTimeout(r, 40));
