const MAP_NAME = { furusiya: 'الفروسية (تصنيعي)', highway: 'الخط السريع', riyadh: 'الرياض' };
const NAMES = ['أبو كاتم', 'شنب نجد', 'الذيب', 'ملك الطارة', 'أبو سطام', 'السهم', 'الصقر', 'برق الشمال', 'ولد الديرة', 'أبو تركي', 'الكابرس الأبيض', 'دخان'];
