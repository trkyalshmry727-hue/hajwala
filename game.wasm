  if (truck) { m.push().translate(0, R, fz).rotate(0, 0, 1, Math.PI / 2); m.cylY(0, 0, 0, 0.045, tx * 2 - 0.2, 12); m.pop(); }
  else m.box(0, R + 0.02, fz, tx * 2 - 0.3, 0.07, 0.25);
  m.pillow(0.08, R, rz, 0.28, 0.24, 0.26, 0.06);                                             // differential
  for (const sx of [-1, 1]) for (const z of [fz, rz]) { m.cylY(sx * (tx - 0.25), R + 0.12, z, 0.05, 0.28, 10); m.cylY(sx * (tx - 0.25), R + 0.12, z, 0.07, 0.03, 10); }
  // gearbox + driveshaft to the rear axle
  m.pillow(0, R + 0.08, fz - 0.55, 0.3, 0.26, 0.6, 0.06);
  m.push().translate(0, R + 0.02, (fz - 0.85 + rz) / 2).rotate(1, 0, 0, Math.PI / 2); m.cylY(0, 0, 0, 0.035, fz - 0.85 - rz, 10); m.pop();
  // fuel tank
  m.pillow(-0.35, yPan - 0.1, rz + 0.55, 0.55, 0.2, 0.6, 0.05);
