  const metal = new Material({ name: 'pole', color: [0.55, 0.57, 0.6, 1], roughness: 0.45, metalness: 0.7 });
  const lampMat = new Material({ name: 'lamp', color: [0.95, 0.9, 0.75, 1], emissive: [0.6, 0.55, 0.4], roughness: 0.3 });
  const trunkMat = new Material({ name: 'palmTrunk', color: [0.42, 0.32, 0.22, 1], roughness: 1 });
  const frondMat = new Material({ name: 'palmFrond', color: [0.28, 0.42, 0.16, 1], roughness: 0.85, doubleSided: true });
  const kcGlass = new Material({ name: 'kcGlass', map: glassTexture([70, 96, 118], 'kc'), roughness: 0.08, metalness: 0.55, envBoost: 1.7, clearcoat: 0.6 });
  const fzGlass = new Material({ name: 'fzGlass', map: glassTexture([92, 104, 96], 'fz'), roughness: 0.1, metalness: 0.5, envBoost: 1.6, clearcoat: 0.5 });
  const rjGlass = new Material({ name: 'rjGlass', map: glassTexture([54, 92, 96], 'rj'), roughness: 0.1, metalness: 0.5, envBoost: 1.6, clearcoat: 0.5 });
  const steel = new Material({ name: 'steel', color: [0.72, 0.74, 0.77, 1], roughness: 0.35, metalness: 0.8, envBoost: 1.2 });
  const gold = new Material({ name: 'gold', color: [0.95, 0.72, 0.3, 1], roughness: 0.18, metalness: 0.9, envBoost: 1.8, emissive: [0.12, 0.08, 0.02] });
  const bldGlass = [glassTexture([80, 92, 104], 'b1'), glassTexture([110, 104, 92], 'b2'), glassTexture([60, 78, 84], 'b3')].map((t, i) => new Material({ name: 'bld' + i, map: t, roughness: 0.2, metalness: 0.35, envBoost: 1.2 }));
  const stone = new Material({ name: 'stone', map: stuccoTexture([214, 196, 164]), roughness: 0.9, uvScale: [0.2, 0.2] });
  const mb = { jersey: new MB(), pole: new MB(), lamp: new MB(), trunk: new MB(), frond: new MB(), kc: new MB(), fz: new MB(), rj: new MB(), steel: new MB(), gold: new MB(), b0: new MB(), b1: new MB(), b2: new MB(), stone: new MB() };
  const r = rng(2030);
