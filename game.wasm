  $('stL').innerHTML = arrowIcon(-1); $('stR').innerHTML = arrowIcon(1);

  let muted = false;
  try { muted = localStorage.getItem('hajwala.mute') === '1'; } catch (e) { }
  const setMute = (m) => { muted = m; window.__muted = m; audio.setMuted(m); $('soundBtn').innerHTML = m ? ICON.mute : ICON.sound; try { localStorage.setItem('hajwala.mute', m ? '1' : '0'); } catch (e) { } };
  setMute(muted);
