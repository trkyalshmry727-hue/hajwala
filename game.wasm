    let doorBox = null;
    if (this.doorNode) { let z0 = 1e9, z1 = -1e9, xi = 1e9; const dp = this.doorNode.pos;
      this.doorNode.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { const z = a[i + 2] + dp.z, x = Math.abs(a[i] + dp.x), y = a[i + 1] + dp.y; if (y < I.floorY + 0.05 || y > I.floorY + 0.75) continue; z0 = Math.min(z0, z); z1 = Math.max(z1, z); xi = Math.min(xi, x); } } });
      if (z1 > z0) doorBox = { z0: z0 + 0.04, z1: z1 - 0.04, x: xi - 0.025 }; }
    const node = buildInterior({ ...I, linerY, linerZ, xs, cluster: d.cluster, wheelStyle: d.wheelStyle, mirrorZ: mz !== undefined ? mz - 0.03 : undefined, mirrorY, doorBox });
    this.cluster = node.userData.cluster;
    this.model.add(node);
    // hang the door cards on the doors
    const dcs = node.userData.doorCards || {};
