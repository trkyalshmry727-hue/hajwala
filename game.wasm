      thigh_l: [0.02, 0, 0.04 - sh], thigh_r: [0.02, 0, -0.04 - sh], calf_l: [0.05 + Math.max(0, sh) * 1.5, 0, 0], calf_r: [0.05 + Math.max(0, -sh) * 1.5, 0, 0],
      spine_01: [br * 0.5, -sh * 0.4, -sh * 0.8], spine_02: [br, 0, 0], spine_03: [br * 0.5, 0, 0], neck_01: [-br * 0.6, sw, 0], head: [0.03, sw * 0.8, 0],
      clavicle_l: [0, 0, 0.05], clavicle_r: [0, 0, -0.05],
      upperarm_l: [0.03 + sw * 0.3, 0.12, -1.07 - br * 0.4], upperarm_r: [0.03 - sw * 0.3, -0.12, 1.07 + br * 0.4],
