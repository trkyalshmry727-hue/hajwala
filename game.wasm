  // ---- two-bone arm IK: target in character-model space ----
  armIK(pose, side, target, pole) {
    const up = 'upperarm_' + side, lo = 'lowerarm_' + side, ha = 'hand_' + side;
    if (!this.bones[up] || !this.bones[lo] || !this.bones[ha]) return pose;
    // current (posed) shoulder position & parent rotation, with arm deltas cleared
    const p2 = { ...pose }; p2[up] = [0, 0, 0]; p2[lo] = [0, 0, 0];
    this.applyPose(p2); this.root.updateWorld(this.root.parent ? this.root.parent.world : null);
