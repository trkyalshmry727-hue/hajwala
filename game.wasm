  collectDeformables() {
    this.deform = [];
    const add = (node) => { if (!node || !node.mesh) return; for (const p of node.mesh.prims) { if (p.shadowOnly) continue; p.dynamic = true; this.deform.push({ node, prim: p, orig: null, adj: null, dirty: false }); } };
    if (this.bodyNode) add(this.bodyNode);
    if (this.doorNode) add(this.doorNode);
    if (this.doorNodeR) add(this.doorNodeR);
  }

  place(x, y, z, yaw) {
    const b = this.body;
    b.q.setAxisAngle(UP, yaw);
    b.pos.copy(this.com).applyQ(b.q).add(_a.set(x, y, z));
    b.vel.set(0, 0, 0); b.ang.set(0, 0, 0); b.updateInertia();
    for (const w of this.wheels) { w.springLen = w.prevLen = this.def.susTop; w.spinVel = 0; }
    this.gear = 1; this.reverse = false; this.rpm = 900;
    this.syncNode();
  }

  // local (model) point -> world
  localToWorld(l, out) { return out.copy(l).sub(this.com).applyQ(this.body.q).add(this.body.pos); }
  worldToLocal(wp, out) { return out.copy(wp).sub(this.body.pos).applyInvQ(this.body.q).add(this.com); }
  forward(out) { return out.set(0, 0, 1).applyQ(this.body.q); }
  up(out) { return out.set(0, 1, 0).applyQ(this.body.q); }

  // tuning: engine cylinders, drive type, low range (دبل), diff locks, stance, paint
  applyTune(T) {
    const d = this.def; this.tune = T = T || {};
    const base = d.cyl || (d.engineVoice && d.engineVoice.cyl) || 4;
    const cyl = T.cyl || base; this.tuneTorque = (cyl / base) ** 0.85 * (T.turbo ? 1.3 : 1);
    this.tuneRear = T.drive === 'fwd' ? 0.02 : T.drive === 'rwd' ? 0.98 : T.drive === 'awd' ? 0.5 : undefined;
    // 4x4 trucks run in 2H (rear only) until the transfer case is engaged: 4H splits 50/50, 4L also gears everything down
    this.fourWD = d.fourWD ?? d.lowY >= 0.62;
    // (default 4H = the car's own split, the feel it always had; 2H = pure rear drive for drifting)
    this.dblMode = T.dbl === 'low' ? 'low' : T.dbl === '2h' || T.dbl === 'off' ? '2h' : T.dbl === 'high' || this.fourWD ? 'high' : '2h';
    if (this.dblMode !== '2h') { if (this.tuneRear === undefined || this.tuneRear > 0.9) this.tuneRear = this.fourWD ? Math.min(d.rearBias, 0.75) : 0.5; }
    else if (this.fourWD && this.tuneRear === undefined) this.tuneRear = 1;
    this.tuneDiff = T.diff === 'rear' ? [false, true] : T.diff === 'both' ? [true, true] : T.diff === 'front' ? [true, false] : null;
    for (const w of this.wheels) { const h = (w.front ? T.hf : T.hr) || 0; w.rideAdj = h; }
    this.voice = { ...(d.engineVoice || {}), cyl, base: (d.engineVoice ? d.engineVoice.base : 1) * (cyl >= 8 ? 0.82 : cyl >= 6 ? 0.92 : 1) };
    const dp = d.defaultParts && !T.color ? { ...d.defaultParts, ...(T.parts || {}) } : T.parts;
    if (T.color || dp || T.hide || this.parts) { splitParts(this, this.key); applyPaint(this, T.color || null, dp || null); applyHidden(this, T.hide || null); }
  }
  torqueAt(rpm) {
    const x = rpm / this.def.redline;
    const shape = x < 0.55 ? 0.62 + 0.38 * (x / 0.55) : 1 - Math.max(0, (x - 0.55)) * 0.55;
    return this.def.torque * clamp(shape, 0.3, 1);
  }

  step(dt, input) {
    const d = this.def, b = this.body;
    if (this.dblMode === undefined) this.applyTune(this.tune || {});
    this.throttle = input.throttle; this.brakeIn = input.brake; this.handbrake = input.handbrake;
    // steering smoothing & speed sensitivity
    const fwd = this.forward(_a); const vF = b.vel.dot(fwd);
    this.forwardSpeed = vF; this.speed = b.vel.len();
    const maxSteer = d.maxSteer * lerp(1, 0.55, clamp((Math.abs(vF) - 10) / 35, 0, 1));
    // allow counter-steer freedom while drifting
    let target = clamp(input.steer * (Math.abs(this.driftAngle) > 0.25 ? d.maxSteer * 0.95 : maxSteer) + this.steerBias, -d.maxSteer, d.maxSteer);
    const NEW = Car.handling === 'new';
    // new handling: like a sim with a pad — when the tail slides out and you ease off the wheel, the front wheels
    // follow the slide (counter-steer) so the drift can be held and steered with the throttle
    if (NEW && Math.abs(vF) > 5 && Math.abs(this.driftAngle) > 0.1) target = lerp(target, clamp(-this.driftAngle * 1.1, -d.maxSteer, d.maxSteer), 0.55 * (1 - Math.min(1, Math.abs(input.steer) * 1.4)));
    this.steer += (target - this.steer) * (1 - Math.exp(-dt * (NEW ? 11 : 8)));

    // gear logic (automatic with reverse)
    let driveCmd = 0, brakeCmd = 0;
    if (!this.reverse) {
      driveCmd = this.throttle; brakeCmd = this.brakeIn;
      if (this.brakeIn > 0.3 && vF < 1.6 && this.throttle < 0.05 && !this.handbrake) { this.revTimer = (this.revTimer || 0) + dt; if (this.revTimer > 0.12) { this.reverse = true; this.revTimer = 0; } } // keep the brake held: it goes straight into reverse, even still rolling
      else this.revTimer = 0;
    } else {
      driveCmd = -this.brakeIn; brakeCmd = this.throttle;
      if (this.throttle > 0.05 && vF > -0.8) { this.reverse = false; brakeCmd = 0; driveCmd = this.throttle; }
    }
    if (!this.engineOn || this.noFuel) driveCmd = 0;
    if (this.dblMode === 'low') driveCmd = Math.sign(driveCmd) * Math.abs(driveCmd) ** 1.6; // crawler: the first half of the pedal is gentle

    // engine rpm: road speed through the gearbox, clutch slip at launch, flare when the tyres spin
    const gr = this.reverse ? 3.6 : d.gears[this.gear - 1];
    const T = this.tune || {}; const low = T.dbl === 'low' ? 2.6 : 1;
    const ratio = gr * d.final * low;
    const toRpm = ratio * 60 / (2 * Math.PI);
    this.wheelVmax = d.redline / toRpm * this.wheelRadius;
