  const LOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="#ecdcbc" stroke-width="2.2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
  const COIN = '<svg viewBox="0 0 24 24" width="18" height="18" style="vertical-align:-3px"><circle cx="12" cy="12" r="10.5" fill="#2e9e4f" stroke="#1d6b34" stroke-width="1.2"/><text x="12" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="900" font-size="15" fill="#fff">$</text></svg>';
  const KEYI = '<svg viewBox="0 0 24 24" width="18" height="18" style="vertical-align:-3px"><circle cx="7" cy="12" r="4.6" fill="#f4c542"/><circle cx="7" cy="12" r="1.8" fill="#3a2a05"/><rect x="10.5" y="10.6" width="11.5" height="2.8" rx="1" fill="#f4c542"/><rect x="16" y="13" width="2.4" height="4" fill="#f4c542"/><rect x="19.4" y="13" width="2.4" height="3" fill="#f4c542"/></svg>';
