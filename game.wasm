    const grass = new Material({ name: 'parkGrass', color: [0.24, 0.5, 0.18, 1], roughness: 1 }), wood = new Material({ name: 'parkWood', color: [0.45, 0.28, 0.14, 1], roughness: 0.8 }), leaf = new Material({ name: 'parkLeaf', color: [0.18, 0.42, 0.15, 1], roughness: 0.9 }), iron = new Material({ name: 'parkIron', color: [0.85, 0.2, 0.15, 1], roughness: 0.5, metalness: 0.4 }), path = new Material({ name: 'parkPath', color: [0.72, 0.66, 0.56, 1], roughness: 1 });
    const g = new MB(), w = new MB(), l = new MB(), ir = new MB(), pa = new MB();
    g.box(px, gy + 0.03, pz, 44, 0.06, 44); pa.box(px, gy + 0.07, pz, 3, 0.04, 44); pa.box(px, gy + 0.07, pz, 44, 0.04, 3);
    const r = rng(77);
    for (let i = 0; i < 18; i++) { const a = r() * Math.PI * 2, d = 8 + r() * 12, x = px + Math.cos(a) * d, z = pz + Math.sin(a) * d; if (Math.abs(x - px) < 3 || Math.abs(z - pz) < 3) continue; const h = 2.6 + r() * 1.5;
      w.box(x, gy + h / 2, z, 0.35, h, 0.35); sphere(l, x, gy + h + 1.2, z, 1.8 + r() * 0.8, 10); colCyl(world, x, gy, z, 0.3, h, 7); }
    // swing: A-frames + top bar + two seats on chains
    const sx = px + 10, sz2 = pz - 10;
