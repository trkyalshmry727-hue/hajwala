#xRadial .ring{position:relative;width:min(78vh,340px);height:min(78vh,340px);border-radius:50%;background:radial-gradient(circle,rgba(25,22,16,.9) 0 34%,rgba(25,22,16,.75) 35% 100%);border:2px solid rgba(245,194,75,.45);box-shadow:0 10px 40px #000a}
