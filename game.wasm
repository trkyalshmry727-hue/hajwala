      calf_l: [0.55, 0, 0], calf_r: [0.62, 0, 0],
      foot_l: [0.45, 0, 0], foot_r: [0.4, 0, 0],
      spine_01: [0.04, 0, 0], spine_02: [0.02, 0, 0], spine_03: [0.02, 0, 0], neck_01: [0.08, 0, 0], head: [0.04, 0, 0],
      upperarm_l: [-0.7, 0.3, -0.85], upperarm_r: [-0.7, -0.3, 0.85],
