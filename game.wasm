const MISSION_KEYS = 25;
const today = () => { const d = new Date(); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); };
Economy.prototype.missions = function () {
  const day = today();
  if (!this.d.mis || this.d.mis.day !== day) {
    // the same five for everyone on the same day
    let h = 0; for (const c of day) h = (h * 31 + c.charCodeAt(0)) >>> 0;
    const pool = MISSIONS.map(m => m.id), pick = [];
    while (pick.length < 5) { h = (h * 1103515245 + 12345) >>> 0; const i = h % pool.length; pick.push(pool.splice(i, 1)[0]); }
    this.d.mis = { day, list: pick.map(id => ({ id, prog: 0, claimed: false })), bonus: false, cars: [] };
    this.save();
  }
  return this.d.mis;
};
// progress: add (or with max=true, keep the biggest value)
Economy.prototype.misProg = function (id, v, max) {
  const M = this.missions(), m = M.list.find(x => x.id === id); if (!m || m.claimed) return;
  const def = MISSIONS.find(x => x.id === id); const before = m.prog;
  m.prog = Math.min(def.goal, max ? Math.max(m.prog, v) : m.prog + v);
  if (m.prog !== before) { this.save(); if (m.prog >= def.goal && before < def.goal && this.onMissionDone) this.onMissionDone(def); }
};
