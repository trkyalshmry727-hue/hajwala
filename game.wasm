(function(){document.head.insertAdjacentHTML('beforeend',"<title>هجولة الشاص</title>\n<meta name=\"theme-color\" content=\"#16140f\">\n<link rel=\"apple-touch-icon\" href=\"data:image/png;base64,\">\n<link rel=\"icon\" type=\"image/png\" href=\"data:image/png;base64,\">\n<meta name=\"apple-mobile-web-app-title\" content=\"هجولة\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Lalezar&family=Readex+Pro:wght@400;600;700&display=swap\">\n<style>\n  :root {\n    color-scheme: dark;\n    --asphalt: #16140f;\n    --asphalt-2: #221f18;\n    --sand: #ecdcbc;\n    --sand-dim: #b9a888;\n    --amber: #f5a524;\n    --amber-deep: #c9780f;\n    --brake: #d4412f;\n    --glass: rgba(22, 20, 15, 0.58);\n    --glass-edge: rgba(236, 220, 188, 0.22);\n    --display: 'Lalezar', 'Readex Pro', 'Geeza Pro', 'Al Nile', Tahoma, sans-serif;\n    --ui: 'Readex Pro', 'Geeza Pro', 'SF Arabic', Tahoma, system-ui, sans-serif;\n  }\n  [hidden] { display: none !important; }\n  html, body { height: 100%; margin: 0; overflow: hidden; background: var(--asphalt); color: var(--sand); }\n  body { font-family: var(--ui); -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; touch-action: none; overscroll-behavior: none; }\n  #game { position: fixed; inset: 0; }\n  #view { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }\n  button { font-family: var(--ui); color: inherit; -webkit-tap-highlight-color: transparent; }\n  button:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }\n  .layer { position: absolute; inset: 0; pointer-events: none; }\n  .layer > * { pointer-events: auto; }\n\n  /* ---------- loading ---------- */\n  #loading { position: absolute; inset: 0; display: grid; place-items: center; background:\n    radial-gradient(120% 80% at 50% 110%, #3a2a17 0%, transparent 60%), var(--asphalt); z-index: 30; padding-inline: 16px; }\n  #loading .box { width: min(460px, 100%); text-align: center; display: grid; gap: 14px; }\n  .brand { font-family: var(--display); font-size: clamp(56px, 13vw, 112px); line-height: .95; color: var(--sand); letter-spacing: 0; text-shadow: 0 4px 0 #0008; }\n  .brand small { display: block; font-family: var(--ui); font-size: 14px; font-weight: 600; color: var(--amber); letter-spacing: .02em; margin-top: 14px; }\n  .skid { height: 14px; border-radius: 3px; background: #0006; overflow: hidden; position: relative; border: 1px solid var(--glass-edge); }\n  .skid i { position: absolute; inset: 0 auto 0 0; width: 0%; background: repeating-linear-gradient(90deg, #2b2821 0 7px, #3b372d 7px 11px); box-shadow: inset 0 0 0 1px #0004; transition: width .2s; }\n  .skid i::after { content: ''; position: absolute; right: -2px; top: -6px; width: 10px; height: 26px; border-radius: 50%; background: radial-gradient(#f5a52466, transparent 70%); }\n  #loadText { font-size: 13px; color: var(--sand-dim); font-variant-numeric: tabular-nums; }\n  #loadErr { color: #ffb4a8; font-size: 14px; line-height: 1.6; }\n\n  /* ---------- menu ---------- */\n  #menu .title { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 18px); inset-inline: 0; text-align: center; pointer-events: none; }\n  #menu .title .brand { font-size: clamp(44px, 9vh, 88px); }\n  .dock { position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 22px); inset-inline: 0; display: flex; justify-content: center; gap: 14px; padding-inline: 16px; }\n  .btn { border: 0; border-radius: 14px; padding: 14px 30px; font-size: 20px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; min-height: 56px; transition: transform .08s; }\n  .btn:active, .btn.down { transform: translateY(2px) scale(.98); }\n  .btn svg { width: 26px; height: 26px; }\n  .btn.primary { background: linear-gradient(180deg, #ffbd45, var(--amber) 55%, var(--amber-deep)); color: #2a1a04; box-shadow: 0 5px 0 #7a4707, 0 10px 24px #0007; font-family: var(--display); font-size: 30px; font-weight: 400; padding: 10px 42px 14px; }\n  .btn.ghost { background: var(--glass); border: 1px solid var(--glass-edge); color: var(--sand); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 8px 20px #0006; }\n  .corner { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); display: flex; gap: 10px; }\n  .corner.left { left: 16px; } .corner.right { right: 16px; }\n  .icon-btn { width: 48px; height: 48px; border-radius: 14px; border: 1px solid var(--glass-edge); background: var(--glass); display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  .icon-btn svg { width: 26px; height: 26px; }\n  .icon-btn.down { background: #f5a52455; }\n\n  /* ---------- garage ---------- */\n  #garage .tabs { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); left: 50%; transform: translateX(-50%); display: flex; gap: 4px; padding: 4px; border-radius: 14px; background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  #garage .tabs button { border: 0; background: none; border-radius: 10px; padding: 8px 18px; font-size: 16px; font-weight: 600; cursor: pointer; min-height: 40px; }\n  #garage .tabs button.on { background: var(--amber); color: #2a1a04; }\n  #gTitle { padding: 8px 22px; font-size: 18px; font-weight: 700; min-height: 40px; display: flex; align-items: center; color: var(--amber); }\n  #garage .bottom { position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 10px); inset-inline: 0; display: flex; align-items: flex-end; gap: 12px; padding-inline: 16px; }\n  #garage .strip { flex: 1; min-width: 0; display: flex; gap: 10px; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding: 6px 2px 2px; }\n  #garage .strip::-webkit-scrollbar { display: none; }\n  #garage .strip > :first-child { margin-inline-start: auto; } #garage .strip > :last-child { margin-inline-end: auto; }\n  #garage .strip > * { flex: none; }\n  #garage .strip { touch-action: pan-x; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }\n  input, textarea { -webkit-user-select: text; user-select: text; touch-action: manipulation; }\n  #onMain { touch-action: pan-y; }\n  #garage .btn.primary { flex: none; }\n  .card { flex: none; width: min(128px, 26vw); border-radius: 12px; background: var(--glass); border: 2px solid var(--glass-edge); padding: 4px 4px 5px; cursor: pointer; display: grid; gap: 2px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transition: transform .12s, border-color .12s; }\n  .card img, .card .art { width: 100%; aspect-ratio: 36 / 20; object-fit: cover; border-radius: 8px; background: linear-gradient(#c9d5e0, #e7dcc6); display: block; }\n  .card .nm { font-family: var(--display); font-size: 19px; text-align: center; line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .card.sel { border-color: var(--amber); transform: translateY(-4px); box-shadow: 0 8px 20px #0008, 0 0 0 3px #f5a52433; }\n  #garage .info { background: var(--glass); border: 1px solid var(--glass-edge); border-radius: 14px; padding: 6px 18px 8px; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); position: absolute; top: calc(env(safe-area-inset-top, 0px) + 78px); left: calc(env(safe-area-inset-left, 0px) + 16px); max-width: 30vw; text-align: start; pointer-events: none; }\n  #garage .info .n { font-family: var(--display); font-size: clamp(30px, 6vh, 46px); line-height: 1; text-shadow: 0 3px 0 #0008; }\n  #garage .info .s { font-size: 13px; color: var(--sand); text-shadow: 0 1px 3px #000, 0 0 8px #000; }\n  #garage .info .n { text-shadow: 0 3px 0 #0008, 0 0 14px #000a; }\n\n  /* ---------- HUD ---------- */\n  #hud { display: none; }\n  #hud.on { display: block; }\n  .gauge { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 8px); right: calc(env(safe-area-inset-right, 0px) + 12px); width: min(27vh, 124px); pointer-events: none; display: grid; justify-items: center; gap: 4px; }\n  .gauge svg { width: 100%; height: auto; display: block; filter: drop-shadow(0 6px 12px #0009); }\n  .gauge .chip { font-size: 11px; color: var(--sand-dim); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: 10px; padding: 2px 10px; white-space: nowrap; }\n  .gauge .chip b { color: var(--sand); font-variant-numeric: tabular-nums; }\n  #driftBox { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 10px); left: 50%; transform: translateX(-50%); text-align: center; pointer-events: none; transition: opacity .25s; opacity: 0; }\n  #driftBox.on { opacity: 1; }\n  #driftBox .lbl { font-family: var(--display); font-size: 30px; color: var(--amber); text-shadow: 0 3px 0 #0009; line-height: 1; }\n  #driftBox .pts { font-family: var(--display); font-size: 40px; color: var(--sand); text-shadow: 0 3px 0 #0009; font-variant-numeric: tabular-nums; line-height: 1; }\n  #driftBox .x { font-size: 15px; font-weight: 700; color: var(--asphalt); background: var(--amber); border-radius: 8px; padding: 1px 8px; display: inline-block; margin-top: 4px; }\n  #driftBox.fail .lbl { color: var(--brake); }\n  #toast { position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%); background: var(--glass); border: 1px solid var(--glass-edge); padding: 10px 18px; border-radius: 12px; font-weight: 600; opacity: 0; transition: opacity .3s; pointer-events: none; white-space: nowrap; }\n  #toast.on { opacity: 1; }\n\n  /* steering wheel */\n  #wheelWrap { position: absolute; left: calc(env(safe-area-inset-left, 0px) + 18px); bottom: calc(env(safe-area-inset-bottom, 0px) + 14px); width: min(42vh, 210px); height: min(42vh, 210px); }\n  #wheel { width: 100%; height: 100%; touch-action: none; cursor: grab; filter: drop-shadow(0 8px 12px #0008); }\n  /* pedals */\n  .pedal { position: absolute; border: 0; background: none; padding: 0; cursor: pointer; touch-action: none; filter: drop-shadow(0 8px 10px #0009); transform-origin: 50% 100%; }\n  .pedal svg { display: block; }\n  #gas { right: calc(env(safe-area-inset-right, 0px) + 18px); bottom: calc(env(safe-area-inset-bottom, 0px) + 14px); }\n  #brake { right: calc(env(safe-area-inset-right, 0px) + min(15vh, 78px) + 32px); bottom: calc(env(safe-area-inset-bottom, 0px) + 14px); }\n  #gas svg { width: min(15vh, 78px); height: min(30vh, 150px); }\n  #brake svg { width: min(22vh, 112px); height: min(19vh, 96px); }\n  #arrows { position: absolute; left: calc(env(safe-area-inset-left, 0px) + 18px); bottom: calc(env(safe-area-inset-bottom, 0px) + 18px); display: flex; gap: 16px; direction: ltr; }\n  .arrow { width: min(24vh, 104px); height: min(24vh, 104px); border-radius: 22px; border: 1px solid var(--glass-edge); background: var(--glass); touch-action: none; display: grid; place-items: center; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  .arrow svg { width: 55%; height: 55%; }\n  .arrow.down { background: #f5a52466; }\n  /* button layout editor */\n  #hud.layout [data-lay] { outline: 2px dashed var(--amber); outline-offset: 4px; cursor: move; pointer-events: auto !important; }\n  #layoutBar { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 26; display: grid; gap: 8px; background: var(--glass); border: 1px solid var(--glass-edge); border-radius: 16px; padding: 12px 14px; text-align: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }\n  #layoutBar p { margin: 0; font-size: 13px; color: var(--sand-dim); }\n  #layoutBar .row { display: flex; gap: 8px; }\n  #layoutBar .btn { min-height: 46px; padding: 8px 16px; font-size: 16px; }\n  #layoutBar .btn.primary { font-size: 20px; padding: 6px 22px 10px; }\n  #handbrake { position: absolute; right: calc(env(safe-area-inset-right, 0px) + 18px); bottom: calc(env(safe-area-inset-bottom, 0px) + min(33vh, 170px)); width: min(15vh, 78px); height: min(15vh, 78px); border-radius: 18px; border: 1px solid var(--glass-edge); background: var(--glass); display: grid; place-items: center; touch-action: none; cursor: pointer; }\n  #handbrake svg { width: 70%; height: 70%; }\n  #handbrake.down { background: #d4412f88; }\n  #doorBtn { position: absolute; right: calc(env(safe-area-inset-right, 0px) + min(15vh, 78px) + 30px); bottom: calc(env(safe-area-inset-bottom, 0px) + min(33vh, 170px)); }\n  .round { width: min(15vh, 64px); height: min(15vh, 64px); border-radius: 50%; border: 1px solid var(--glass-edge); background: var(--glass); display: grid; place-items: center; cursor: pointer; touch-action: none; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  .round svg { width: 58%; height: 58%; }\n  .round.down { background: #f5a52466; }\n  .round.hot { box-shadow: 0 0 0 3px var(--amber), 0 0 18px #f5a52499; }\n  /* on-foot */\n  #joy { position: absolute; left: calc(env(safe-area-inset-left, 0px) + 22px); bottom: calc(env(safe-area-inset-bottom, 0px) + 18px); width: min(38vh, 170px); height: min(38vh, 170px); border-radius: 50%; background: radial-gradient(circle, #0000 55%, #0005 56%), var(--glass); border: 1px solid var(--glass-edge); touch-action: none; }\n  #joyKnob { position: absolute; left: 50%; top: 50%; width: 42%; height: 42%; margin: -21% 0 0 -21%; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #fff4dc, var(--sand) 45%, var(--sand-dim)); box-shadow: 0 6px 14px #0008; pointer-events: none; }\n  #footBtns { position: absolute; right: calc(env(safe-area-inset-right, 0px) + 22px); bottom: calc(env(safe-area-inset-bottom, 0px) + 22px); display: grid; grid-template-columns: auto auto; gap: 16px; align-items: end; }\n  #footBtns .round { width: min(19vh, 84px); height: min(19vh, 84px); }\n  .mode-foot #carCtl { display: none; }\n  .mode-car #footCtl { display: none; }\n  .mode-seq #carCtl, .mode-seq #footCtl { display: none; }\n  .card.loading { position: relative; } .card.loading img { opacity: .15; } .card.loading::after { content: 'يحمّل…'; position: absolute; left: 0; right: 0; top: 38%; text-align: center; font-size: 13px; opacity: .8; }\n  .mode-ride #footCtl { display: none; }\n  .mode-drone #carCtl { display: none; } .mode-drone #footBtns { display: none; } #droneUD { display: none; }\n  .mode-drone #droneUD { display: grid; position: absolute; right: calc(env(safe-area-inset-right, 0px) + 26px); bottom: calc(env(safe-area-inset-bottom, 0px) + 24px); gap: 14px; }\n  #droneUD .round { width: min(18vh, 78px); height: min(18vh, 78px); font-size: 26px; color: #f4d27a; }\n  .mode-ride #carCtl > :not(#doorBtn) { display: none; }\n\n  /* pause */\n  .sheet { position: absolute; inset: 0; display: grid; place-items: center; background: #0a0907aa; z-index: 20; padding-inline: 16px; overflow-y: auto; -webkit-overflow-scrolling: touch; }\n  .sheet .panel { background: var(--asphalt-2); border: 1px solid var(--glass-edge); border-radius: 20px; padding: 22px 22px 18px; width: min(340px, 100%); display: grid; gap: 12px; box-shadow: 0 20px 50px #000a; }\n  .sheet h2 { font-family: var(--display); font-weight: 400; font-size: 34px; margin: 0 0 4px; text-align: center; }\n  .sheet .btn { justify-content: center; width: 100%; }\n  .seg { display: flex; gap: 8px; flex-wrap: wrap; }\n  .seg button { flex: 1; min-width: 90px; border-radius: 12px; border: 1px solid var(--glass-edge); background: #0003; padding: 12px 8px; font-size: 15px; cursor: pointer; min-height: 48px; }\n  .seg button.on { background: var(--amber); color: #2a1a04; border-color: var(--amber); font-weight: 700; }\n  /* settings */\n\n  .namechip { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); right: max(16px, env(safe-area-inset-right, 0px)); border: 1px solid var(--glass-edge); background: var(--glass); color: var(--text, #ecdcbc); border-radius: 999px; padding: 8px 14px; font: 600 14px inherit; font-family: inherit; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); cursor: pointer; }\n  .badge { display: inline-grid; place-items: center; min-width: 20px; height: 20px; border-radius: 10px; background: #d4412f; color: #fff; font-size: 12px; padding: 0 5px; margin-inline-start: 6px; }\n\n  #rotate { display: none; position: fixed; inset: 0; z-index: 60; background: #0e0c09; color: #ecdcbc; place-items: center; text-align: center; }\n  #rotate p { font-size: 24px; font-weight: 700; margin: 14px 0 4px; }\n  #rotate small { opacity: .7; }\n  #rotate svg { animation: rot 2.2s ease-in-out infinite; }\n  @keyframes rot { 0%, 30% { transform: rotate(0); } 60%, 100% { transform: rotate(-90deg); } }\n  @media (orientation: portrait) and (max-width: 900px) { #rotate { display: grid; } }\n  #online { position: absolute; inset: 0; z-index: 23; background: radial-gradient(90% 80% at 50% 0%, #2a2519 0%, #12100c 70%); display: grid; grid-template-rows: auto auto 1fr; padding: calc(env(safe-area-inset-top, 0px) + 12px) max(16px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 12px) max(16px, env(safe-area-inset-left, 0px)); gap: 10px; color: #ecdcbc; }\n  #online header { display: flex; align-items: center; gap: 14px; }\n  #online header h2 { margin: 0; font-size: 22px; }\n  #online header .me { flex: 1; font-size: 14px; opacity: .9; }\n  #online .lnk { background: none; border: 0; color: #f5a524; font: inherit; cursor: pointer; text-decoration: underline; }\n  #onNav { display: flex; gap: 6px; flex-wrap: wrap; }\n  #onNav button { border: 1px solid #ffffff22; background: #ffffff0d; color: inherit; border-radius: 12px; padding: 9px 16px; font: 600 15px inherit; font-family: inherit; cursor: pointer; min-height: 42px; }\n  #onNav button.on { background: #f5a524; color: #2a1a04; border-color: #f5a524; }\n  #onMain { overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }\n  #onMain .row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: #ffffff0d; border: 1px solid #ffffff14; }\n  #onMain .row .nm { flex: 1; font-weight: 600; }\n  #onMain .row .sub { font-size: 12px; opacity: .7; font-weight: 400; display: block; }\n  #onMain .dot { width: 9px; height: 9px; border-radius: 50%; background: #666; flex: none; }\n  #onMain .dot.on { background: #35d06a; box-shadow: 0 0 6px #35d06a; }\n  #onMain .sbtn, #store .sbtn, #profile .sbtn { border: 0; border-radius: 10px; padding: 8px 14px; font: 600 14px inherit; font-family: inherit; cursor: pointer; background: #f5a524; color: #2a1a04; min-height: 38px; }\n  #onMain .sbtn.ghost, #store .sbtn.ghost, #profile .sbtn.ghost { background: #ffffff1a; color: #ecdcbc; }\n  #onMain .sbtn:disabled { opacity: .5; }\n  #onMain input { width: 100%; box-sizing: border-box; border-radius: 12px; border: 1px solid #ffffff2a; background: #0006; color: #fff; padding: 12px 14px; font-size: 16px; font-family: inherit; }\n  #onMain .empty { opacity: .7; padding: 18px 4px; line-height: 1.7; }\n  #onMain textarea { width: 100%; box-sizing: border-box; border-radius: 12px; border: 1px solid #ffffff2a; background: #0006; color: #fff; padding: 10px 12px; font-size: 16px; line-height: 1.4; font-family: ui-monospace, monospace; direction: ltr; min-height: 64px; resize: vertical; word-break: break-all; }\n  #onMain .step { display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 12px; background: #ffffff0a; border: 1px solid #ffffff14; }\n  #onMain .step h4 { margin: 0; font-size: 15px; color: #f5a524; }\n  #onMain .step p { margin: 0; font-size: 13px; opacity: .85; line-height: 1.6; }\n  #onMain .btns { display: flex; gap: 8px; flex-wrap: wrap; }\n  #onMain .ok { color: #35d06a; font-weight: 700; }\n  #onMain .maps { display: flex; gap: 6px; flex-wrap: wrap; width: 100%; }\n  .netlabel { position: fixed; left: 0; top: 0; z-index: 9; pointer-events: none; background: #000a; color: #fff; border-radius: 8px; padding: 3px 9px; font: 600 13px Tahoma, sans-serif; white-space: nowrap; display: none; }\n  #settings, #store, #profile { position: absolute; inset: 0; z-index: 22; background: radial-gradient(90% 80% at 50% 0%, #2a2519 0%, #12100c 70%); display: grid; grid-template-columns: minmax(150px, 22%) 1fr; grid-template-rows: auto 1fr; padding: calc(env(safe-area-inset-top, 0px) + 12px) max(16px, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 12px) max(16px, env(safe-area-inset-left, 0px)); gap: 12px 18px; }\n  #settings header, #store header, #profile header { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; }\n  #settings header h2, #store header h2, #profile header h2 { font-family: var(--display); font-weight: 400; font-size: 32px; margin: 0; }\n  #settings nav, #store nav { display: grid; align-content: start; gap: 8px; }\n  #settings nav button, #store nav button { display: flex; align-items: center; gap: 10px; border: 1px solid var(--glass-edge); background: #0003; border-radius: 14px; padding: 12px 14px; font-size: 17px; font-weight: 600; cursor: pointer; min-height: 54px; text-align: start; }\n  #settings nav button svg, #store nav button svg { width: 24px; height: 24px; flex: none; }\n  #settings nav button.on, #store nav button.on { background: var(--amber); color: #2a1a04; border-color: var(--amber); }\n  #settings nav button.on svg * { stroke: #2a1a04; }\n  #settings main, #store main, #profile main { overflow-y: auto; background: #0003; border: 1px solid var(--glass-edge); border-radius: 18px; padding: 16px 18px; display: grid; align-content: start; gap: 16px; }\n  #settings main h3 { margin: 0; font-size: 14px; color: var(--sand-dim); font-weight: 600; }\n  .opt { display: grid; gap: 8px; }\n  .opt .row { display: flex; justify-content: space-between; align-items: baseline; }\n  .opt .row b { font-family: var(--display); font-weight: 400; font-size: 22px; color: var(--amber); font-variant-numeric: tabular-nums; }\n  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 34px; background: transparent; direction: ltr; }\n  input[type=range]::-webkit-slider-runnable-track { height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--amber) var(--p, 50%), #ffffff22 var(--p, 50%)); }\n  input[type=range]::-moz-range-track { height: 8px; border-radius: 4px; background: #ffffff22; }\n  input[type=range]::-moz-range-progress { height: 8px; border-radius: 4px; background: var(--amber); }\n  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; background: var(--sand); margin-top: -10px; box-shadow: 0 3px 8px #000a; border: 3px solid var(--amber); }\n  input[type=range]::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: var(--sand); border: 3px solid var(--amber); }\n  .camgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 10px; }\n  .camgrid button { border: 1px solid var(--glass-edge); background: #0003; border-radius: 14px; padding: 10px 6px 8px; cursor: pointer; display: grid; justify-items: center; gap: 4px; font-size: 15px; font-weight: 600; min-height: 90px; }\n  .camgrid button svg { width: 64px; height: 40px; }\n  .camgrid button.on { border-color: var(--amber); background: #f5a52422; box-shadow: 0 0 0 2px var(--amber) inset; }\n  .camgrid button small { font-size: 11px; color: var(--sand-dim); font-weight: 400; }\n  .wide { justify-content: center; width: 100%; font-size: 17px !important; }\n  .note { font-size: 12px; color: var(--sand-dim); line-height: 1.7; }\n  /* camera editor */\n  #camEdit { position: absolute; inset: 0; z-index: 24; pointer-events: none; }\n  #camEdit > * { pointer-events: auto; }\n  #camEdit .top { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 8px); left: calc(env(safe-area-inset-left, 0px) + 12px); width: min(300px, 42vw); background: var(--glass); border: 1px solid var(--glass-edge); border-radius: 14px; padding: 6px 12px 4px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); display: grid; gap: 0; }\n  #camEdit .big { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n  #camEdit .big .v { font-family: var(--display); font-size: 28px; line-height: 1; color: var(--sand); font-variant-numeric: tabular-nums; text-align: center; }\n  #camEdit .big .v small { font-size: 14px; color: var(--sand-dim); }\n  #camEdit .step { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--glass-edge); background: #0004; font-size: 22px; font-weight: 700; cursor: pointer; display: grid; place-items: center; }\n  #camEdit .lbl { text-align: center; font-size: 11px; color: var(--sand-dim); }\n  #camEdit input[type=range] { height: 26px; }\n  #camEdit .hrow { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--sand-dim); }\n  #camEdit .hrow input { flex: 1; }\n  #camEdit .bar { position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 10px); inset-inline: 0; display: flex; justify-content: center; gap: 8px; padding-inline: 16px; flex-wrap: wrap; }\n  #camEdit .bar .btn { min-height: 44px; padding: 6px 14px; font-size: 15px; }\n  #camEdit .bar .btn.primary { font-size: 20px; padding: 4px 22px 8px; }\n  #camEdit .close { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 12px); right: 16px; }\n  #camEdit.comparing .top .v { color: var(--amber); }\n  #camEdit .cmpTag { position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%); background: var(--amber); color: #2a1a04; font-weight: 700; padding: 8px 16px; border-radius: 12px; pointer-events: none; display: none; }\n  #camEdit.comparing .cmpTag { display: block; }\n  #camList { z-index: 30; }\n  #camList .panel { width: min(420px, 100%); max-height: 80vh; overflow-y: auto; }\n  .camItem { display: flex; align-items: center; gap: 10px; border: 1px solid var(--glass-edge); border-radius: 14px; padding: 8px 10px; background: #0003; }\n  .camItem .t { flex: 1; font-size: 15px; font-weight: 600; }\n  .camItem .t small { display: block; font-size: 12px; color: var(--sand-dim); font-weight: 400; }\n  .camItem button { border: 1px solid var(--glass-edge); background: #0003; border-radius: 10px; padding: 8px 12px; cursor: pointer; font-size: 14px; min-height: 44px; }\n  .camItem button.use { background: var(--amber); color: #2a1a04; border-color: var(--amber); font-weight: 700; }\n  #flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; z-index: 15; transition: opacity .5s ease-out; }\n  #flash.on { opacity: .85; transition: none; }\n  @media (max-height: 420px) { #settings nav button { min-height: 44px; padding: 8px 12px; font-size: 15px; } #camEdit .big .v { font-size: 36px; } }\n  .help { font-size: 12px; color: var(--sand-dim); line-height: 1.7; text-align: center; }\n  /* short screens (a phone in landscape inside a browser with its bars showing): everything must still fit or scroll */\n  @media (max-height: 470px) {\n    .sheet { place-items: start center; padding-block: 8px; }\n    .sheet .panel { grid-template-columns: 1fr 1fr; width: min(520px, 100%); padding: 12px; gap: 8px; }\n    .sheet h2 { grid-column: 1 / -1; font-size: 24px; }\n    .sheet .btn { min-height: 44px; padding: 8px 12px; font-size: 16px; }\n    .btn { min-height: 46px; padding: 10px 20px; font-size: 17px; }\n    #menu .title .brand { font-size: 38px; }\n    .dock { bottom: calc(env(safe-area-inset-bottom, 0px) + 8px); gap: 10px; }\n    #online { overflow-y: auto; grid-template-rows: auto auto auto; align-content: start; padding-top: 8px; padding-bottom: 8px; gap: 8px; }\n    #onMain { overflow: visible; }\n    #online header h2 { font-size: 18px; }\n    #onNav button { min-height: 36px; padding: 6px 12px; font-size: 14px; }\n    #settings, #store, #profile { overflow-y: auto; }\n  }\n\n\n  /* wallet (silver money, gold keys), level, profile, store, gift */\n  #wallet { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 62px); right: max(16px, env(safe-area-inset-right, 0px)); display: flex; gap: 8px; z-index: 3; }\n  .wchip { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px 0 8px; border-radius: 12px; background: var(--glass); border: 1px solid var(--glass-edge); font-weight: 700; font-size: 17px; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }\n  .wchip svg { width: 24px; height: 24px; flex: none; }\n  .wchip.money b { color: #d9dde2; } .wchip.keys b { color: #f4c542; } .wchip.lvl b { color: var(--amber); }\n  #profileBtn { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 14px); right: calc(max(16px, env(safe-area-inset-right, 0px)) + var(--nameW, 170px) + 8px); height: 40px; }\n  #peopleBtn { font-size: 20px; }\n  #profile { grid-template-columns: 1fr; }\n  .pf-top { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }\n  .pf-av { width: 96px; height: 96px; border-radius: 50%; background: #0005 center/cover no-repeat; border: 3px solid var(--amber); display: grid; place-items: center; font-size: 44px; cursor: pointer; position: relative; flex: none; }\n  .pf-av small { position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%); font-size: 11px; background: var(--amber); color: #2a1a04; border-radius: 8px; padding: 1px 6px; white-space: nowrap; }\n  .pf-name { font-family: var(--display); font-size: 30px; }\n  .pf-id { font-size: 15px; color: var(--sand-dim); direction: ltr; unicode-bidi: plaintext; }\n  .pf-bar { height: 12px; border-radius: 8px; background: #0006; overflow: hidden; border: 1px solid var(--glass-edge); min-width: 200px; }\n  .pf-bar i { display: block; height: 100%; background: linear-gradient(90deg, #ffbd45, #e8871c); }\n  .pf-sec h3 { margin: 0 0 8px; font-size: 16px; color: var(--sand-dim); }\n  .pf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }\n  .ach { border: 1px solid var(--glass-edge); border-radius: 12px; padding: 10px; background: #0003; opacity: .38; }\n  .ach.on { opacity: 1; border-color: var(--amber); }\n  .ach b { display: block; font-size: 16px; } .ach span { font-size: 13px; color: var(--sand-dim); } .ach i { font-style: normal; font-size: 26px; }\n  .mycars { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; }\n  .mycars .card { width: 130px; }\n  .mycars .card.fav { border-color: var(--amber); }\n  .store-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }\n  .sitem { border: 1px solid var(--glass-edge); border-radius: 14px; background: #0004; padding: 12px; display: grid; gap: 8px; justify-items: center; text-align: center; }\n  .sitem img { width: 100%; border-radius: 10px; }\n  .sitem .big { font-family: var(--display); font-size: 30px; }\n  .sitem .sbtn { width: 100%; }\n  .card .lock { position: absolute; inset: 4px 4px auto 4px; aspect-ratio: 360/220; border-radius: 9px; background: #000a; display: grid; place-items: center; align-content: center; gap: 2px; font-size: 13px; font-weight: 700; text-align: center; }\n  .card .lock svg { width: 22px; height: 22px; }\n  .card { position: relative; }\n  #gift { position: absolute; inset: 0; z-index: 40; display: grid; place-items: center; background: radial-gradient(circle at 50% 45%, #3a2a0cdd, #000e 70%); overflow: hidden; }\n  #gift .box { width: 150px; height: 150px; position: relative; animation: gshake .5s ease-in-out 3; }\n  #gift .box .b { position: absolute; left: 10px; right: 10px; bottom: 0; height: 100px; background: linear-gradient(90deg, #c2261c, #e8453a 50%, #c2261c); border-radius: 8px; }\n  #gift .box .l { position: absolute; left: 0; right: 0; top: 30px; height: 30px; background: linear-gradient(90deg, #d13126, #ff5a4d 50%, #d13126); border-radius: 6px; transition: transform .6s cubic-bezier(.3,1.6,.5,1); }\n  #gift .box .r1 { position: absolute; left: 50%; top: 30px; bottom: 0; width: 22px; margin-left: -11px; background: #f4c542; }\n  #gift.open .box .l { transform: translateY(-160px) rotate(-25deg); }\n  #gift .reveal { position: absolute; display: grid; justify-items: center; gap: 10px; opacity: 0; transform: scale(.5); transition: all .6s .3s cubic-bezier(.3,1.6,.5,1); }\n  #gift.open .reveal { opacity: 1; transform: scale(1); }\n  #gift .reveal img { width: min(420px, 80vw); border-radius: 16px; box-shadow: 0 0 60px #ffbd4588; }\n  #gift .reveal h2 { font-family: var(--display); font-weight: 400; font-size: 40px; margin: 0; color: #ffd27a; }\n  #gift .conf { position: absolute; top: -20px; width: 10px; height: 16px; border-radius: 2px; animation: gfall 2.4s linear forwards; }\n  @keyframes gshake { 0%,100% { transform: rotate(0) } 25% { transform: rotate(-8deg) } 75% { transform: rotate(8deg) } }\n  @keyframes gfall { to { transform: translateY(110vh) rotate(720deg); } }\n\n  /* tuning / character screens */\n  #tune, #chars { position: absolute; inset: 0; z-index: 12; pointer-events: none; }\n  #tune > *, #chars > * { pointer-events: auto; }\n  #tune .tpanel { position: absolute; top: calc(env(safe-area-inset-top,0px) + 70px); bottom: calc(env(safe-area-inset-bottom,0px) + 10px); right: max(12px, env(safe-area-inset-right,0px)); width: min(46vw, 420px); background: #16140fe8; border: 1px solid var(--glass-edge); border-radius: 18px; padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; color: var(--sand); touch-action: pan-y; }\n  #tune .ttabs, #chars .ttabs { position: absolute; top: calc(env(safe-area-inset-top,0px) + 12px); right: max(12px, env(safe-area-inset-right,0px)); display: flex; gap: 6px; flex-wrap: wrap; max-width: calc(100% - 90px); }\n  .ttabs button, .tpanel .chip2 { border: 1px solid #ffffff22; background: #16140fd0; color: var(--sand); border-radius: 12px; padding: 8px 14px; font: 600 15px var(--ui); min-height: 40px; cursor: pointer; }\n  .ttabs button.on, .tpanel .chip2.on { background: var(--amber); color: #2a1a04; border-color: var(--amber); }\n  .tpanel h4 { margin: 4px 0 0; color: var(--amber); font-size: 15px; }\n  .tpanel-lite h4 { margin: 4px 0 0; color: var(--amber); font-size: 15px; } .tpanel-lite .row2 { display: flex; flex-wrap: wrap; gap: 6px; } .tpanel-lite .note { font-size: 13px; opacity: .8; }\n  .tpanel-lite .chip2 { border: 1px solid #ffffff22; background: #16140fd0; color: var(--sand); border-radius: 12px; padding: 8px 14px; font: 600 15px var(--ui); min-height: 40px; cursor: pointer; } .tpanel-lite .chip2.on { background: var(--amber); color: #2a1a04; }\n  .tpanel .row2 { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }\n  .tpanel .chip2.lock { opacity: .45; }\n  .tpanel .note { font-size: 13px; opacity: .8; line-height: 1.6; }\n  .tpanel .sw { width: 38px; height: 38px; border-radius: 50%; border: 2px solid #fff4; cursor: pointer; }\n  .tpanel .sw.on { border-color: #fff; box-shadow: 0 0 0 3px var(--amber); }\n  .tpanel input[type=range] { width: 100%; }\n  #tBack, #cBack { position: absolute; top: calc(env(safe-area-inset-top,0px) + 12px); left: max(12px, env(safe-area-inset-left,0px)); }\n  #sprayHint { position: absolute; left: 12px; bottom: 12px; background: #000a; padding: 8px 12px; border-radius: 10px; font-size: 13px; }\n  #chars .bottom { position: absolute; bottom: calc(env(safe-area-inset-bottom,0px) + 10px); inset-inline: 0; display: flex; justify-content: center; gap: 12px; align-items: flex-end; padding: 0 16px; }\n  #chars .card { width: 150px; }\n  #chars .card .pic { height: 90px; display: grid; place-items: center; font-size: 54px; background: #0005; border-radius: 12px 12px 0 0; }\n  #mapBtn { }\n  #fuelBar { position: absolute; top: calc(env(safe-area-inset-top,0px) + 76px); left: calc(env(safe-area-inset-left,0px) + 18px); width: 140px; height: 16px; border-radius: 8px; background: #0008; border: 1px solid var(--glass-edge); overflow: hidden; }\n  #fuelBar i { position: absolute; inset: 0; width: 100%; background: linear-gradient(90deg, #d4412f, #f5a524 30%, #35d06a); transform-origin: 0 50%; }\n  #fuelBar b { position: absolute; inset: 0; display: grid; place-items: center; font-size: 11px; color: #fff; text-shadow: 0 1px 2px #000; }\n  #mapView { position: absolute; inset: 0; z-index: 25; background: #0c0b09; display: grid; place-items: center; }\n  #mapView canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; }\n  #mapView .zoom { position: absolute; bottom: calc(env(safe-area-inset-bottom,0px) + 16px); left: 16px; display: flex; flex-direction: column; gap: 10px; }\n  #mapView .zoom button { width: 52px; height: 52px; border-radius: 14px; border: 1px solid #fff3; background: #000a; color: #fff; font: bold 28px sans-serif; }\n  #mapView .hint { position: absolute; bottom: calc(env(safe-area-inset-bottom,0px) + 16px); right: 16px; background: #000a; padding: 6px 12px; border-radius: 10px; font-size: 13px; color: #ecdcbc; max-width: 60vw; }\n  #mapView .legend { position: absolute; top: calc(env(safe-area-inset-top,0px) + 12px); right: 16px; background: #000a; padding: 8px 12px; border-radius: 10px; font-size: 14px; line-height: 1.9; }\n  #mapView .x { position: absolute; top: calc(env(safe-area-inset-top,0px) + 12px); left: 16px; }\n  #chal { position: absolute; top: calc(env(safe-area-inset-top,0px) + 76px); left: 50%; transform: translateX(-50%); background: #000b; border: 1px solid var(--glass-edge); padding: 6px 14px; border-radius: 12px; font-size: 15px; white-space: nowrap; }\n  @media (prefers-reduced-motion: reduce) { .btn, .pedal, .card { transition: none; } #shots img { transition: none; } }\n  /* loading slideshow */\n  #shots { position: absolute; inset: 0; overflow: hidden; }\n  #shots img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s; }\n  #shots img.on { opacity: 1; }\n  #shots::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #16140f55 0%, #16140faa 55%, #16140fee 100%); }\n  #loading .box { position: relative; z-index: 1; }\n</style>\n\n");document.body.insertAdjacentHTML('afterbegin',"<div id=\"game\" dir=\"rtl\">\n  <canvas id=\"view\"></canvas>\n\n  <div id=\"loading\">\n    <div id=\"shots\"></div>\n    <div class=\"box\">\n      <div class=\"brand\">هجولة<small>شاص · ربع · هايلكس · النترا · شانجان</small></div>\n      <div class=\"skid\" aria-hidden=\"true\"><i id=\"loadBar\"></i></div>\n      <div id=\"loadText\">نحمّل السيارات والمدينة…</div>\n      <div id=\"loadErr\" hidden></div>\n    </div>\n  </div>\n\n  <!-- main menu -->\n  <div id=\"menu\" class=\"layer\" hidden>\n    <div class=\"title\"><div class=\"brand\">هجولة<small>تفحيط · هجولة · حوادث</small></div></div>\n    <div class=\"corner left\">\n      <button class=\"icon-btn\" id=\"soundBtn\" aria-label=\"الصوت\"></button>\n      <button class=\"icon-btn\" id=\"settingsBtn\" aria-label=\"الإعدادات\"></button>\n      <button class=\"icon-btn\" id=\"fsBtn\" aria-label=\"ملء الشاشة\" hidden></button>\n      <button class=\"icon-btn\" id=\"peopleBtn\" aria-label=\"الناس\">👥</button>\n    </div>\n    <button class=\"namechip\" id=\"myName\" aria-label=\"اسمك\"></button>\n    <div id=\"wallet\"><span class=\"wchip lvl\" id=\"wLvl\">⭐ <b id=\"wLevel\">١</b></span><span class=\"wchip money\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#b8bec6\" stroke=\"#6d737b\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"6.5\" fill=\"none\" stroke=\"#e9edf2\" stroke-width=\"1.4\"/><path d=\"M12 8v8M9.5 10.5h5\" stroke=\"#6d737b\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg><b id=\"wMoney\">٠</b></span><span class=\"wchip keys\"><svg viewBox=\"0 0 24 24\"><circle cx=\"8\" cy=\"12\" r=\"5\" fill=\"none\" stroke=\"#f4c542\" stroke-width=\"2.6\"/><path d=\"M12.5 12H22M18.5 12v3.5M21 12v2.5\" stroke=\"#f4c542\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg><b id=\"wKeys\">٠</b></span></div>\n    <button class=\"btn ghost\" id=\"profileBtn\" style=\"min-height:44px;padding:6px 14px;font-size:16px\">الملف الشخصي</button>\n    <div class=\"dock\">\n      <button class=\"btn ghost\" id=\"onlineBtn\">الدعوات <b class=\"badge\" id=\"onBadge\" hidden></b></button>\n      <button class=\"btn ghost\" id=\"carsBtn\"></button>\n      <button class=\"btn ghost\" id=\"tuneBtn\">التعديل</button>\n      <button class=\"btn ghost\" id=\"charBtn\">الشخصية</button>\n      <button class=\"btn ghost\" id=\"storeBtn\">المتجر</button>\n      <button class=\"btn primary\" id=\"startBtn\">ابدأ</button>\n    </div>\n  </div>\n\n  <!-- garage -->\n  <div id=\"garage\" class=\"layer\" hidden>\n    <div class=\"corner right\"><button class=\"icon-btn\" id=\"backBtn\" aria-label=\"رجوع\"></button></div>\n    <div class=\"tabs\"><div id=\"gTitle\">السيارات</div></div>\n    <div class=\"info\"><div class=\"n\" id=\"gName\"></div><div class=\"s\" id=\"gSpec\"></div></div>\n    <div class=\"bottom\">\n      <div class=\"strip\" id=\"carStrip\"></div>\n      <div class=\"strip\" id=\"mapStrip\" hidden></div>\n      <button class=\"btn primary\" id=\"startBtn2\">ابدأ</button>\n    </div>\n  </div>\n\n  <!-- in-game HUD -->\n  <div id=\"hud\" class=\"layer mode-car\">\n    <div class=\"corner left\">\n      <button class=\"icon-btn\" id=\"pauseBtn\" aria-label=\"القائمة\"></button>\n      <button class=\"icon-btn\" id=\"resetBtn\" aria-label=\"عدّل السيارة\"></button>\n      <button class=\"icon-btn\" id=\"hornBtn\" aria-label=\"البوري\"></button>\n      <button class=\"icon-btn\" id=\"repairBtn\" aria-label=\"صلّح السيارة\"></button>\n      <button class=\"icon-btn\" id=\"camBtn2\" aria-label=\"الكاميرا\"></button>\n      <button class=\"icon-btn\" id=\"droneBtn\" aria-label=\"درون\"></button>\n      <button class=\"icon-btn\" id=\"mapBtn\" aria-label=\"الخريطة\"></button>\n      <button class=\"icon-btn\" id=\"pwrBtn\" aria-label=\"الدبل\" style=\"font:800 15px/1 inherit;color:#f4d27a;width:auto;min-width:48px;padding:0 8px\">4H</button>\n    </div>\n    <div class=\"gauge\" id=\"gauge\" data-lay=\"gauge\"><svg id=\"speedo\" viewBox=\"0 0 200 200\" aria-label=\"عداد السرعة\"></svg><div class=\"chip\">نقاط <b id=\"score\">0</b></div></div>\n    <div id=\"fuelBar\"><i id=\"fuelFill\"></i><b id=\"fuelTxt\">بنزين</b></div>\n    <div id=\"chal\" hidden></div>\n    <div id=\"driftBox\"><div class=\"lbl\" id=\"driftLbl\">هجولة!</div><div class=\"pts\" id=\"driftPts\">0</div><div class=\"x\" id=\"driftX\">×1</div></div>\n    <div id=\"toast\"></div>\n\n    <div id=\"carCtl\">\n      <div id=\"wheelWrap\" data-lay=\"wheel\"><svg id=\"wheel\" viewBox=\"0 0 200 200\" aria-label=\"الدركسون\"></svg></div>\n      <div id=\"arrows\" data-lay=\"arrows\" hidden><button class=\"arrow\" id=\"stL\" aria-label=\"يسار\"></button><button class=\"arrow\" id=\"stR\" aria-label=\"يمين\"></button></div>\n      <button class=\"round\" id=\"doorBtn\" data-lay=\"door\" aria-label=\"انزل من السيارة\"></button>\n      <div id=\"handbrake\" data-lay=\"handbrake\" aria-label=\"هاند بريك\"></div>\n      <button class=\"pedal\" id=\"brake\" data-lay=\"brake\" aria-label=\"فرامل\"></button>\n      <button class=\"pedal\" id=\"gas\" data-lay=\"gas\" aria-label=\"بنزين\"></button>\n    </div>\n    <div id=\"footCtl\">\n      <div id=\"joy\"><div id=\"joyKnob\"></div></div>\n      <div id=\"droneUD\"><button class=\"round\" id=\"dUp\" aria-label=\"فوق\">▲</button><button class=\"round\" id=\"dDown\" aria-label=\"تحت\">▼</button></div>\n      <div id=\"footBtns\">\n        <button class=\"round\" id=\"enterBtn\" aria-label=\"اركب السيارة\"></button>\n        <button class=\"round\" id=\"kickBtn\" aria-label=\"ركلة\"></button>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"pwrPanel\" hidden style=\"position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:30;width:min(560px,92vw);max-height:86vh;overflow:auto;background:rgba(22,20,15,.94);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:14px 16px\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:6px\"><b style=\"font-size:18px;color:#f4d27a\">الدبل والدفلوك</b><button class=\"btn ghost\" id=\"pwrClose\" style=\"padding:6px 16px\">تم</button></div>\n    <div id=\"pwrBox\" class=\"tpanel-lite\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n  </div>\n  <div id=\"layoutBar\" hidden><p>اسحب أي زر وحطه وين تبي</p><div class=\"row\"><button class=\"btn primary\" id=\"laySave\">حفظ</button><button class=\"btn ghost\" id=\"layReset\">الأماكن الأصلية</button></div></div>\n  <div id=\"flash\"></div>\n  <button class=\"btn ghost\" id=\"tyreBtn\" hidden style=\"position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 110px);transform:translateX(-50%);z-index:6\">🛞 تنسيم الكفر</button>\n  <div id=\"tyrePanel\" class=\"sheet\" hidden><div class=\"panel\" style=\"text-align:center\">\n    <h2>تنسيم الكفر</h2>\n    <div style=\"font-size:52px;font-weight:800;color:var(--amber)\" id=\"psiVal\">30</div><div style=\"opacity:.8;margin-top:-6px\">رطل هواء</div>\n    <p style=\"font-size:14px;line-height:1.7;margin:4px 0;opacity:.9\">إذا تبي تطلع السيارة من التغريز، نسّم الكفر من ٢٠ إلى ١٠. لا تنسّم أقل من ١٠، وإذا وصل صفر ينفشّ.</p>\n    <button class=\"btn primary\" id=\"deflateBtn\" style=\"touch-action:none\">اضغط مطوّل: تنسيم</button>\n    <button class=\"btn ghost\" id=\"tyreClose\">خلاص</button>\n  </div></div>\n  <button class=\"round\" id=\"moveCarBtn\" hidden style=\"position:absolute;left:calc(50% + 70px);bottom:calc(env(safe-area-inset-bottom,0px) + 30px);z-index:6;width:auto;padding:0 16px;border-radius:30px\">انقل السيارة هنا</button>\n  <button class=\"round\" id=\"shotBtn\" hidden aria-label=\"صوّر\" style=\"position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 24px);transform:translateX(-50%);z-index:6;width:72px;height:72px\"></button>\n\n  <div id=\"tune\" hidden>\n    <button class=\"icon-btn\" id=\"tBack\" aria-label=\"رجوع\"></button>\n    <div class=\"ttabs\" id=\"tTabs\"><button data-t=\"parts\">القطع</button><button data-t=\"engine\">المكينة</button><button data-t=\"paint\">الألوان</button><button data-t=\"stance\">الوزنية</button><button data-t=\"power\">القوة</button></div>\n    <div class=\"tpanel\" id=\"tPanel\"></div>\n    <div id=\"sprayHint\" hidden>البخاخ: اسحب بإصبعك على السيارة عشان تبخ</div>\n  </div>\n  <div id=\"chars\" hidden>\n    <button class=\"icon-btn\" id=\"cBack\" aria-label=\"رجوع\"></button>\n    <div class=\"ttabs\"><button class=\"on\">الشخصية</button></div>\n    <div class=\"bottom\" id=\"charStrip\"></div>\n  </div>\n  <div id=\"mapView\" hidden><canvas id=\"mapCanvas\"></canvas><div class=\"legend\">🟣 ورشة (بنشر / تصليح)<br>🟡 محطة بنزين<br>⚪ مدينة<br>🔵 أنت<br>🟠 خويك</div><div class=\"zoom\"><button id=\"mapZin\">+</button><button id=\"mapZout\">−</button><button id=\"mapMe\" style=\"font-size:20px\">◎</button></div><div class=\"hint\">اسحب الخريطة عشان تحركها · اضغط على بنزين أو ورشة أو مدينة وتنتقل لها على طول</div><button class=\"icon-btn x\" id=\"mapClose\" aria-label=\"سكّر\"></button></div>\n  <div id=\"fade\" style=\"position:absolute;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .4s;z-index:30\"></div>\n  <div id=\"rotate\"><div><svg viewBox=\"0 0 64 64\" width=\"72\" height=\"72\" fill=\"none\" stroke=\"#f5a524\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"20\" y=\"8\" width=\"24\" height=\"44\" rx=\"4\"/><path d=\"M48 44a18 18 0 0 1-18 14M26 54l4 4-4 4\"/></svg><p>دوّر الجوال بالعرض</p><small>اللعبة تنلعب والجوال بالعرض</small></div></div>\n  <div id=\"pause\" class=\"sheet\" hidden>\n    <div class=\"panel\">\n      <h2>استراحة</h2>\n      <button class=\"btn primary\" id=\"resumeBtn\">كمّل</button>\n      <button class=\"btn ghost\" id=\"toSettingsBtn\">الإعدادات</button>\n      <button class=\"btn ghost\" id=\"toOnlineBtn\">الدعوات</button>\n      <button class=\"btn ghost\" id=\"toGarageBtn\">الكراج</button>\n    </div>\n  </div>\n\n  <div id=\"online\" hidden>\n    <header><h2>الأونلاين</h2><div class=\"me\">اسمك: <b id=\"onName\"></b> <button class=\"lnk\" id=\"onRename\">غيّر</button></div><button class=\"icon-btn\" id=\"onClose\" aria-label=\"رجوع\"></button></header>\n    <nav id=\"onNav\"><button data-t=\"search\">بحث</button><button data-t=\"inv\">الدعوات <b class=\"badge\" hidden></b></button><button data-t=\"friends\">الأصدقاء</button><button data-t=\"req\">الطلبات <b class=\"badge\" hidden></b></button></nav>\n    <main id=\"onMain\"></main>\n  </div>\n\n  <div id=\"store\" hidden>\n    <header><h2>المتجر</h2><button class=\"icon-btn\" id=\"storeClose\" aria-label=\"رجوع\"></button></header>\n    <nav id=\"storeNav\">\n      <button data-tab=\"gold\">🔑 الذهب</button>\n      <button data-tab=\"money\">🪙 الفلوس</button>\n      <button data-tab=\"subs\">⭐ الاشتراكات</button>\n      <button data-tab=\"cars\">🚙 السيارات</button>\n    </nav>\n    <main id=\"storeMain\"></main>\n  </div>\n  <div id=\"profile\" hidden>\n    <header><h2>الملف الشخصي</h2><button class=\"icon-btn\" id=\"profileClose\" aria-label=\"رجوع\"></button></header>\n    <main id=\"profileMain\"></main>\n    <input type=\"file\" id=\"avatarPick\" accept=\"image/*\" hidden>\n  </div>\n  <div id=\"gift\" hidden><div class=\"box\"><div class=\"b\"></div><div class=\"r1\"></div><div class=\"l\"></div></div><div class=\"reveal\"><h2>مبروك!</h2><img id=\"giftImg\" alt=\"\"><div class=\"pf-name\" id=\"giftName\"></div><button class=\"btn primary\" id=\"giftOk\">يا سلام</button></div></div>\n\n  <div id=\"settings\" hidden