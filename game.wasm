  try { if (localStorage.getItem('hajwala.ride') === 'off') game.rideAnim = false; if (localStorage.getItem('hajwala.voice') === 'off') window.__voiceOn = false; } catch (e) { }
  try { Car.handling = localStorage.getItem('hajwala.handling') === 'new' ? 'new' : 'old'; } catch (e) { }

