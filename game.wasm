      else { car.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: false, surfaceGrip: 1, water: null }); if (car.speed < 0.5) { this.aiStop(k); this.race = null; } }
    }
  }
  // ======================================================== update hooks
  update(dt) {
    const g = this.g; this.t += dt; if (g.mode !== 'play') return;
