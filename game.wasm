    const chip = (t, on, f) => { const b = el('button', 'btn ghost' + (on ? ' on' : ''), t); b.addEventListener('click', f); return b; };
    box.append(el('div', 'q', 'اسمك اللي في اللعبة:')); const inp = el('input'); inp.value = F.name || ''; inp.addEventListener('input', () => { F.name = inp.value; }); box.append(inp);
