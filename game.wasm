      foot_l: [-0.4 * crouch, 0, 0], foot_r: [-0.4 * crouch, 0, 0],
      spine_01: [-0.5 * crouch, 0, 0], upperarm_l: [-0.6 * crouch, 0, -1.1], upperarm_r: [-0.2 * crouch, 0, 1.1],
