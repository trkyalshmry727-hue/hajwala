  for (let gx = -820; gx <= 820; gx += 36) for (let gz = -L + 40; gz <= L - 40; gz += 36) {
    if (r() < 0.4) continue;
    const x = gx + (r() - 0.5) * 6, z = gz + (r() - 0.5) * 6;
    if (Math.abs(x - BX) < 60 || (x > -290 && x < BX && Math.abs(z) < 520) || Math.abs(z - 470) < 30 || Math.abs(z + 470) < 30 || Math.abs(z - 1400) < 30 || Math.abs(z + 1400) < 30 || Math.abs(x + 236) < 32) continue;
    if (Math.hypot(x - BX, z - (-1560)) < 120) continue;
    const far = Math.abs(x - BX) > 500;
    const w = 13 + r() * 8, d = 13 + r() * 8, h = 6.5 + (r() < 0.3 ? 3.5 : 0) + (r() < 0.1 ? 8 : 0);
    const pts = [[-w / 2, -d / 2], [w / 2, -d / 2], [w / 2, d / 2], [-w / 2, d / 2]];
