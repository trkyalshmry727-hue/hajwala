      r.append(t, info, lft);
      if (att && left <= OPEN) r.append(btn('ادخل الهجولة', () => this.enter({ role: 'fan', map: e.map, start: e.start, name: e.name, car: e.car })));
      else if (att) r.append(btn('✔ بتحضرها', () => { d.attend = null; this.save(); this.renderScreen(); }, 'btn ghost'));
      else r.append(btn('أحضرها', () => { d.attend = e.id; this.save(); this.renderScreen(); if (this.api.hud) this.api.hud.toast('بنذكّرك: الدخول يفتح قبل الموعد بخمس دقايق', 2200); }, 'btn ghost'));
      S.append(r);
    }
  }
  renderForm(box) {
