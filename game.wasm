  const strip = (b0, b1) => { for (let i = 0; i < seg; i++) I.push(b0 + i, b1 + i, b0 + i + 1, b0 + i + 1, b1 + i, b1 + i + 1); };
  const o = { P: [], N: [], U: [], I: [] };
  const r0 = ring(0.04, 0.17), r1 = ring(0.32, 0.105); strip(r0, r1);
  const r2 = ring(0.44, 0.08), r3 = ring(0.7, 0.028); strip(r2, r3);
  const body = makePrim(P, N, U, I, orange);
  const P2 = [], N2 = [], U2 = [], I2 = [];
  const ring2 = (y, r) => { const b = P2.length / 3; for (let i = 0; i <= seg; i++) { const a = i / seg * Math.PI * 2; P2.push(Math.cos(a) * r, y, Math.sin(a) * r); N2.push(Math.cos(a), 0.18, Math.sin(a)); U2.push(0, 0); } return b; };
  const a0 = ring2(0.32, 0.105), a1 = ring2(0.44, 0.08); for (let i = 0; i < seg; i++) I2.push(a0 + i, a1 + i, a0 + i + 1, a0 + i + 1, a1 + i, a1 + i + 1);
