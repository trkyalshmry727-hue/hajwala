    const tl = swing(ph), tr = swing(ph + Math.PI);
    // knee: flexes during swing, small flex at heel strike (loading response)
    const knee = (x) => { const cx = Math.cos(x); return 0.1 + K * Math.max(0, cx) ** 1.7 + 0.18 * Math.max(0, Math.sin(x - 0.4)) ** 3; };
    const cl = knee(ph), cr = knee(ph + Math.PI);
