  }

  addInterior() {
    const d = this.def;
    if (d.ownInterior) {
      this.seatPos = new V3(d.seat.x, d.seat.top, d.seat.z);
      const ms = this.meta.steer, sn = this.model.find('steering');
      if (ms && sn) { // the model's own steering wheel, spun about its column
        sn.rot.setAxisAngle(new V3(1, 0, 0), ms.tilt); this.steeringNode = sn; this.steerBase = sn.rot.clone();
        this.steerCenter = new V3(...ms.center); this.steerTilt = ms.tilt; sn.castShadow = false;
        { let r = 0; for (const p of sn.mesh ? sn.mesh.prims : []) { const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) r = Math.max(r, Math.hypot(a[i], a[i + 1])); } if (r > 0.12) this.rimR = r - 0.018; if (d.rimR) this.rimR = d.rimR; }
        if (d.decor) this.addDecor(d.decor);
        return;
      }
      this.steerCenter = new V3(d.wheelPos.x, d.wheelPos.y, d.wheelPos.z); this.steerTilt = d.wheelPos.tilt;
      if (d.swapWheel) {
        // cut the model's fixed steering wheel out of the body and put a real, turning one in its place
        const c = this.steerCenter, tq = new Q().setAxisAngle(new V3(1, 0, 0), this.steerTilt), nrm = new V3(0, 0, 1).applyQ(tq);
        this.bodyNode.traverse(n => { if (!n.mesh) return; n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => {
          const P = p.attrs.position.data, I = p.index, keep = [];
          for (let i = 0; i < I.length; i += 3) {
            let x = 0, y = 0, z = 0; for (let k = 0; k < 3; k++) { const j = I[i + k] * 3; x += P[j]; y += P[j + 1]; z += P[j + 2]; }
            x = x / 3 - c.x; y = y / 3 - c.y; z = z / 3 - c.z;
            const dn = x * nrm.x + y * nrm.y + z * nrm.z, r2 = x * x + y * y + z * z - dn * dn;
            if (!(Math.abs(dn) < d.swapWheel.depth && r2 < d.swapWheel.r * d.swapWheel.r)) keep.push(I[i], I[i + 1], I[i + 2]);
          }
          if (keep.length === I.length) return p;
          const np = { ...p, index: I instanceof Uint32Array ? new Uint32Array(keep) : new Uint16Array(keep), gpu: null }; return np;
        }) }; });
        const sw = new Node('steering'); sw.pos.copy(c); sw.rot.copy(tq); sw.mesh = { prims: steeringWheelPrims(d.wheelStyle) }; sw.castShadow = false;
        this.model.add(sw); this.steeringNode = sw; this.steerBase = sw.rot.clone();
        if (d.column) { // the steering column from the wheel hub down into the dash
          const mb = new MB(); mb.push().translate(c.x, c.y, c.z).rotate(1, 0, 0, this.steerTilt).rotate(1, 0, 0, Math.PI / 2);
          mb.cylY(0, d.column / 2 + 0.03, 0, 0.034, d.column, 14); mb.cylY(0, 0.05, 0, 0.055, 0.07, 14); mb.pop();
          const col = new Node('column'); col.mesh = { prims: [mb.prim(new Material({ name: 'column', color: [0.05, 0.05, 0.055, 1], roughness: 0.55, doubleSided: true }))] }; col.castShadow = false; this.model.add(col);
        }
        if (d.decor) this.addDecor(d.decor);
      }
      return;
    }
    const I = d.interior; const h = this.doorHinge;
    const xs = Math.min(Math.abs(h.x) - 0.42, I.halfW - 0.4);
    // keep the headliner, sun visors and mirror under the real roof skin (they used to poke out as a rectangle on top)
    const minY = I.seatTop + 0.68, rMid = this.roofY((I.linerZ[0] + I.linerZ[1]) / 2, minY);
    const linerY = rMid !== undefined ? Math.min(I.linerY, rMid - 0.04) : I.linerY;
    const wsTop = this.windscreenZ(linerY - 0.03);
    let zf = wsTop !== undefined ? Math.min(I.linerZ[1], wsTop - 0.02) : I.linerZ[1];
    for (let k = 0; k < 30; k++) { const r = this.roofY(zf, minY); if (r === undefined || r >= linerY + 0.035) break; zf -= 0.04; }
    const linerZ = [I.linerZ[0], zf];
    const mz = this.windscreenZ(linerY - 0.12), rM = mz !== undefined ? this.roofY(mz, minY) : undefined;
    const mirrorY = Math.min(linerY - 0.12, rM !== undefined ? rM - 0.07 : 1e9);
