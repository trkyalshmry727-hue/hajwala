#evTalk{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 70px);transform:translateX(-50%);z-index:10;width:min(620px,88vw);background:rgba(16,13,9,.94);border:1px solid rgba(245,194,75,.45);border-radius:16px;padding:12px 14px;direction:rtl;color:#f3e8cf}
