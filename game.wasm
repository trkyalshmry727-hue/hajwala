  p.box(0, yPan + 0.03, fz + R * 1.2 + (zB - fz - R * 1.2) / 2, hw * 1.6, 0.012, Math.max(0.1, zB - fz - R * 1.2));
  p.box(0, yPan + 0.03, rz - R * 1.2 - (rz - R * 1.2 - zA) / 2, hw * 1.7, 0.012, Math.max(0.1, rz - R * 1.2 - zA));
  // frame rails and cross members
  for (const sx of [-1, 1]) m.box(sx * (truck ? 0.44 : 0.5), yRail, (zA + zB) / 2, 0.08, truck ? 0.16 : 0.07, zB - zA);
  for (const z of [zB - 0.1, fz - 0.45, (fz + rz) / 2, rz + 0.5, zA + 0.1]) m.box(0, yRail + 0.02, z, truck ? 0.9 : 1.0, 0.06, 0.07);
