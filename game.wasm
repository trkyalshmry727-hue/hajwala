    const rearW = this.wheels.filter(w => !w.front);
    let wheelOmega = 0; for (const w of rearW) wheelOmega += Math.abs(w.spinVel); wheelOmega /= rearW.length;
    const rpmWheel = wheelOmega * toRpm;
    const launch = 1000 + Math.abs(driveCmd) * 2600;
