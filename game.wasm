  datsun: autoDef({ name: 'ددسن ١٩٨٥', file: 'datsun.glb', spec: 'نيسان ددسن · غمارة', len: 4.9, h: 1.58, w: 2.08, fa: 1.63, ra: -1.26, truck: true, mass: 1450, torque: 190, cyl: 4, steer: [0.43, 0.945, 0.555] }),
  gmcold: autoDef({ name: 'بهبهاني ١٩٨٨', file: 'gmcold.glb', spec: 'جمس بهبهاني ١٩٨٨', len: 5.6, h: 1.96, w: 2.56, fa: 1.86, ra: -1.47, truck: true, mass: 2400, torque: 420, cyl: 8, rear: 0.85, steer: [0.608, 1.252, 0.728], seat: [0.88, 0.06] }),
  caprice: autoDef({ name: 'كابرس ٢٠١٣', file: 'caprice.glb', spec: 'شفروليه كابرس ٢٠١٣', len: 5.15, h: 1.66, w: 2.09, fa: 1.72, ra: -1.3, mass: 1850, torque: 450, cyl: 8, rear: 0.95, steer: [0.41, 0.914, 0.636], seat: [0.5, 0.0], floor: 0.3, headroom: 1.4 , extInt: { asset: 'int_cap13' } }),
  hilux07: autoDef({ name: 'هايلكس غمارتين ٢٠٠٧', file: 'hilux07.glb', spec: 'تويوتا هايلكس ٢٠٠٧', len: 5.0, h: 1.81, w: 2.16, fa: 1.61, ra: -1.23, truck: true, mass: 1750, torque: 260, cyl: 4, steer: [0.40, 0.986, 0.774], seat: [0.73, 0.1], backColor: [0.3, 0.29, 0.27, 1] , extInt: { asset: 'int_hx07i', cut: [{ box: [-0.74, 0.74, 0.42, 1.5, -0.45, 1.25] }] } }),
  fortuner: autoDef({ name: 'فورتشنر ٢٠٢١', file: 'fortuner.glb', spec: 'تويوتا فورتشنر ٢٠٢١', len: 4.8, h: 1.82, w: 2.07, fa: 1.4, ra: -1.35, truck: true, mass: 2150, torque: 420, cyl: 4, rear: 0.7, steer: [0.375, 1.147, 0.597], seat: [0.8, -0.1], rimR: 0.185 }),
  prado: autoDef({ name: 'برادو ٢٠٢٤', file: 'prado.glb', spec: 'تويوتا برادو ٢٠٢٤', len: 4.92, h: 1.92, w: 2.11, fa: 1.52, ra: -1.33, truck: true, mass: 2300, torque: 450, cyl: 4, rear: 0.6, steer: [0.38, 1.242, 0.418], seat: [0.85, -0.14] }),
  sierra: autoDef({ name: 'جمس سييرا ٢٠٢٦', file: 'sierra.glb', spec: 'جمس سييرا ٢٠٢٦ · غمارتين', len: 5.9, h: 1.84, w: 2.54, fa: 2.06, ra: -1.64, truck: true, mass: 2500, torque: 520, cyl: 8, rear: 0.8, steer: [0.432, 1.265, 1.066], seat: [1.02, 0.42] }),
  lcold: autoDef({ name: 'لاند قديم ١٩٨٨', file: 'lcold.glb', spec: 'تويوتا لاندكروزر (قديم)', len: 4.6, h: 1.73, w: 2.03, fa: 1.63, ra: -1.14, truck: true, mass: 2100, torque: 330, cyl: 6, rear: 0.7, steer: [0.405, 1.2, 0.47], seat: [0.9, -0.2] , extInt: { asset: 'int_fj' } }), // the old Land Cruiser dash (from the FJ file)
  camry20: autoDef({ name: 'كامري ٢٠٢٠', file: 'camry20.glb', spec: 'تويوتا كامري ٢٠٢٠', len: 4.88, h: 1.47, w: 2.14, fa: 1.48, ra: -1.36, mass: 1550, torque: 250, cyl: 4, rear: 0.15, wheelStyle: 'camry', steer: [0.388, 0.836, 0.465], seat: [0.5, -0.22], decor: { cluster: { pos: [0.43, 0.99, 0.78], w: 0.36, h: 0.12, tilt: 0.35 }, stack: { pos: [0, 0.93, 0.74], w: 0.24, h: 0.2, tilt: 0.4 } } }),
  hilux07s: autoDef({ name: 'هايلكس غمارة ٢٠٠٧', file: 'hilux07s.glb', spec: 'تويوتا هايلكس ٢٠٠٧ · غمارة', len: 5.26, h: 1.77, w: 2.0, fa: 1.76, ra: -1.37, truck: true, mass: 1650, torque: 260, cyl: 4, steer: [0.356, 1.156, 0.833], seat: [0.95, 0.06], backColor: [0.46, 0.45, 0.42, 1] }),
  fj40: autoDef({ name: 'ربع قديم ١٩٨٠', file: 'fj40.glb', spec: 'تويوتا لاندكروزر FJ40 ١٩٨٠ · ربع قديم', len: 3.84, h: 1.94, w: 1.78, fa: 1.32, ra: -0.98, truck: true, mass: 1600, torque: 280, cyl: 6, rear: 0.75, steer: [0.405, 1.356, 0.101], seat: [0.98, -0.5] }),
  lexus: autoDef({ name: 'لكزس LX ٢٠٢٦', file: 'lexus.glb', spec: 'لكزس LX600 ٢٠٢٦', len: 5.1, h: 1.87, w: 2.25, fa: 1.49, ra: -1.36, truck: true, mass: 2600, torque: 650, cyl: 6, rear: 0.6, steer: [0.439, 1.281, 0.488], seat: [0.95, -0.12] }),
  avanza: {
    name: 'أفانزا ٢٠١٥', file: 'avanza.glb', mass: 1150, com: [0, 0.62, 0.1],
    profile: [[2.0, 1.0], [1.1, 1.1], [0.6, 1.64], [-2.05, 1.64], [-2.15, 1.2]],
    halfWidth: 0.84, zMin: -2.15, zMax: 2.0, sphereR: 0.38, lowY: 0.6,
    susTop: 0.28, travel: 0.13, zeta: 0.3, tyreMu: 1.05, rearMu: 0.97,
    torque: 150, redline: 6200, gears: [3.8, 2.2, 1.45, 1.0, 0.8], final: 4.3, rearBias: 1.0,
    maxSteer: 0.62, brake: 10500, dragCdA: 0.85, engineVoice: { cyl: 4, base: 1.0 }, driverScale: 0.92, procWheels: { rim: '#b9bcc0', width: 0.19 },
    ownInterior: true, extInt: { asset: 'int_x20', cut: [{ box: [-0.72, 0.72, 0.3, 1.45, -0.6, 1.1] }] }, seat: { x: 0.35, top: 0.6, z: -0.12 }, headroomY: 1.56, // cabin from the user's interior file
    plates: [{ front: true, x: 0, y: 0.45 }, { front: false, x: 0, y: 0.62 }],
    spec: 'تويوتا أفانزا ٢٠١٥', wheelStyle: 'avanza', cluster: 'avanza', rearBadge: { text: 'TOYOTA', y: 0.95, w: 0.4 },
  },
};

const UP = new V3(0, 1, 0);
const _a = new V3(), _b = new V3(), _c = new V3(), _d = new V3(), _e = new V3(), _j = new V3(), _p = new V3();
const _hit = {};

class Car {
  constructor(def, gltf, world) {
    this.def = def; this.world = world;
    this.node = new Node('car_' + def.name);
    const src = gltf.root.children[0];
    this.model = src; this.node.add(src);
    const meta = src.userData && src.userData.wheels ? src.userData : gltf.json.extras;
    this.meta = meta;
    if (meta && !meta.steer && gltf.json && gltf.json.extras && gltf.json.extras.steer) meta.steer = gltf.json.extras.steer; // (a transplanted cabin keeps its wheel data in the file extras)
    this.wheelRadius = meta.wheelRadius;
    // body parts
    this.bodyNode = src.find('body');
    this.doorNode = src.find('door_l'); this.doorNodeR = src.find('door_r'); this.doorAngleR = 0;
    if (!this.doorNode && def.auto && this.bodyNode) this.carveDoors(def, meta);
    const shadow = src.find('shadow_proxy');
    if (shadow) { shadow.mesh.prims.forEach(p => { p.shadowOnly = true; }); this.bodyNode.traverse(n => n.mesh && n.mesh.prims.forEach(p => p.noShadow = true)); if (this.doorNode) this.doorNode.mesh.prims.forEach(p => p.noShadow = false); }
    // car paint materials: doubleSided dark interior for the cabin shell
    this.node.traverse(n => { if (n.mesh) for (const p of n.mesh.prims) { const m = p.material; if (m.carPaint && !def.singleSided) { m.doubleSided = true; if (!m.backColor && !def.backSame) m.backColor = def.backColor || [0.13, 0.12, 0.115, 1]; } } });
    this.doorAngle = 0; this.doorTarget = 0;
    this.doorHinge = this.doorNode ? this.doorNode.pos.clone() : new V3(0.9, 1.1, 0.8);
    for (const n of [this.doorNode, this.doorNodeR]) if (n) n.homePos = n.pos.clone();
    if (this.doorNode) {
      // door bounds in local space (relative to hinge)
      let zmin = 0, ymin = 1e9, ymax = -1e9;
      for (const p of this.doorNode.mesh.prims) { zmin = Math.min(zmin, p.min[2]); ymin = Math.min(ymin, p.min[1]); ymax = Math.max(ymax, p.max[1]); }
      this.doorLen = -zmin; this.doorYmin = ymin; this.doorYmax = ymax;
    }
    if (def.hideMats) src.traverse(n => { if (n.mesh) n.mesh = { ...n.mesh, prims: n.mesh.prims.filter(p => !def.hideMats.test(p.material.name)) }; });
    if (def.extInt) this.fitCabin(def.extInt, meta);
    this.addInterior();

    // wheels
    this.wheels = meta.wheels.map(w => {
      let node = src.find(w.name);
      const pos = new V3(...w.pos);
      if (def.procWheels && node) {
        // replace the scanned wheel with a clean high-detail steel wheel
        node.mesh = null; node.children.length = 0;
        const pw = steelWheel(meta.wheelRadius * 0.985, def.procWheels.width, def.procWheels.rim, w.side, def.procWheels.alloy);
        node.add(pw);
      }
      return {
        node, pos, front: w.front, side: w.side, steer: 0, spin: 0, spinVel: 0, springLen: def.susTop, prevLen: def.susTop,
        onGround: false, slip: 0, slipLong: 0, load: 0, contact: new V3(), normal: new V3(0, 1, 0), tag: 0, rest: node ? node.rot.clone() : new Q(),
        skid: 0, brk: 0, sink: 0, psi: 30, dmgOff: new V3(), camber: 0, toe: 0, detached: false, homeParent: node ? node.parent : null,
      };
    });
    const m = def.mass;
    const L = def.zMax - def.zMin, W = def.halfWidth * 2, H = 1.6;
    const inertia = new V3(m * (H * H + L * L) / 12, m * (W * W + L * L) / 12 * 1.05, m * (W * W + H * H) / 12);
    this.body = new RigidBody(m, inertia);
    this.com = new V3(...def.com);
    this.k = m * 9.81 / 4 / def.travel;
    this.c = 2 * def.zeta * Math.sqrt(this.k * m / 4);
    this.buildSpheres();
    // drivetrain
    this.gear = 1; this.rpm = 900; this.reverse = false; this.shiftTimer = 0; this.clutch = 1;
    this.throttle = 0; this.brakeIn = 0; this.steerIn = 0; this.handbrake = false; this.steer = 0;
    this.speed = 0; this.forwardSpeed = 0; this.driftAngle = 0; this.impacts = []; this.damage = 0;
    this.engineOn = true;
    this.scrape = 0; this.airTime = 0;
    this.collectDeformables();
    this.steerBias = 0; this.engineHealth = 1;
    this.underbody = buildUnderbody(def, meta); this.underbody.visible = false; this.model.add(this.underbody);
  }

  addPlates(plateGltf) {
    if (!plateGltf || !this.def.plates) return;
    for (const pd of this.def.plates) {
      // find the bumper surface at the plate position
      let best = pd.front ? -1e9 : 1e9;
      const scan = (n, off) => { if (!n || !n.mesh) return; for (const p of n.mesh.prims) { const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { const x = a[i] + off.x, y = a[i + 1] + off.y, z = a[i + 2] + off.z; if (Math.abs(x - pd.x) < 0.14 && Math.abs(y - pd.y) < 0.06) best = pd.front ? Math.max(best, z) : Math.min(best, z); } } };
      scan(this.bodyNode, new V3());
      if (!isFinite(best) || Math.abs(best) > 5) best = pd.front ? this.def.zMax : this.def.zMin;
      const n = plateNode(plateGltf, pd.front);
      n.pos.set(pd.x, pd.y, best + (pd.front ? 0.012 : -0.012));
      this.model.add(n);
      (this.plates || (this.plates = [])).push({ node: n, home: n.pos.clone(), rot: n.rot.clone(), off: new V3() });
    }
    // lamp positions (for night mode): scan the body surface at the usual lamp height
    const d = this.def; this.lamps = [];
    const surf = (x, y, front) => { let best = front ? -1e9 : 1e9; this.bodyNode.traverse(nn => { if (!nn.mesh) return; for (const p of nn.mesh.prims) { const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) if (Math.abs(a[i] - x) < 0.1 && Math.abs(a[i + 1] - y) < 0.06) best = front ? Math.max(best, a[i + 2]) : Math.min(best, a[i + 2]); } }); return isFinite(best) && Math.abs(best) < 5 ? best : (front ? d.zMax : d.zMin); };
    const hy = d.headY ?? d.lowY + 0.2, ty = d.tailY ?? d.lowY + 0.3;
    for (const sx of [1, -1]) {
      const hx = sx * (d.halfWidth - 0.27), hz = surf(hx, hy, true);
      const g = lampGlow([1, 0.97, 0.9, 1], 0.075); g.pos.set(hx, hy, hz + 0.01); this.model.add(g); this.lamps.push({ node: g, head: true, local: new V3(hx, hy, hz + 0.05) });
      const tx = sx * (d.halfWidth - 0.14), tz = surf(tx, ty, false);
      const t = lampGlow([1, 0.05, 0.03, 1], 0.06); t.rot.setAxisAngle(UP, Math.PI); t.pos.set(tx, ty, tz - 0.01); this.model.add(t); this.lamps.push({ node: t, head: false, local: new V3(tx, ty, tz - 0.05) });
    }
    const rb = this.def.rearBadge;
    if (rb) {
      let best = 1e9;
      this.bodyNode.traverse(nn => { if (!nn.mesh) return; for (const p of nn.mesh.prims) { if (p.material && (p.material.glass || p.material.alphaMode === 'BLEND')) continue; const d = p.attrs.position.data; for (let i = 0; i < d.length; i += 3) if (Math.abs(d[i]) < 0.12 && Math.abs(d[i + 1] - rb.y) < 0.04) best = Math.min(best, d[i + 2]); } });
      if (!isFinite(best) || best > 0) best = this.def.zMin;
      const n = badgeNode(rb.text, rb.w);
      n.pos.set(0, rb.y, best - 0.006);
      this.model.add(n);
      this.plates.push({ node: n, home: n.pos.clone(), rot: n.rot.clone(), off: new V3() });
    }
  }

  // z of the windscreen glass at height y (centre of the car), so the rear-view mirror hangs just inside it
  windscreenZ(y) {
    let best = -1e9; const src = this.bodyNode || this.model;
    src.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (!p.material || !p.material.glass) continue; const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { if (Math.abs(a[i]) < 0.35 && Math.abs(a[i + 1] - y) < 0.06 && a[i + 2] > 0.1 && a[i + 2] > best) best = a[i + 2]; } } });
    return best > -1e8 ? best - 0.07 : undefined;
  }

  // lowest roof-skin height above the cabin at a given z (scan cars have no inner roof, so the liner must stay under this)
  roofY(z, minY) {
    let best = 1e9; const src = this.bodyNode || this.model;
    src.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { if (!p.material || p.material.glass) continue; const a = p.attrs.position.data; for (let i = 0; i < a.length; i += 3) { if (Math.abs(a[i]) < 0.45 && Math.abs(a[i + 2] - z) < 0.09 && a[i + 1] > minY && a[i + 1] < best) best = a[i + 1]; } } });
    return best < 1e8 ? best : undefined;
  }

  // night: the car's OWN lamp geometry lights up (head-lamp lenses white, tail lamps red); the small glow discs
  // are only a fallback for scanned cars whose lamps aren't separate materials
  lampMats() {
    if (this._lampMats) return this._lampMats;
    const head = new Set(), tail = new Set();
    this.model.traverse(n => { if (!n.mesh) return; for (const p of n.mesh.prims) { const m = p.material; if (!m || m.glass) continue;
      const nm = (m.name || '').toLowerCase();
      if (m.tail || /tail|brake|red_light|rglass|eglass/.test(nm)) tail.add(m);
      else if (m.head || /head|_lamp$|lamp_0|lights_16|glass1\.001|rvglass/.test(nm)) head.add(m); } });
    for (const m of [...head, ...tail]) m._emis0 = m.emissive.slice();
    return (this._lampMats = { head: [...head], tail: [...tail] });
  }
  setNight(on) {
    this.night = on; const L = this.lampMats(), own = L.head.length > 0;
    for (const l of this.lamps || []) l.node.visible = on && (!own || !l.head) && (!L.tail.length || l.head);
    for (const m of L.head) m.emissive = on ? [2.2, 2.1, 1.9] : m._emis0;
    this.updateTailGlow();
  }
  updateTailGlow() {
    const L = this._lampMats; if (!L) return; const b = this.brakeIn || 0;
    for (const m of L.tail) m.emissive = this.night ? [0.9 + 1.6 * b, 0.02, 0.01] : b > 0.1 ? [1.2 * b, 0.01, 0.005] : m._emis0;
  }
  // world-space lights this car casts at night: two headlight spots + a red glow behind
  pushLights(out) {
    this.updateTailGlow();
    const f = this.forward(_n).clone(); const down = this.up(new V3()).scale(-0.12); const dir = f.clone().add(down).norm();
    for (const l of this.lamps || []) {
      const p = this.localToWorld(l.local, new V3());
      if (l.head) out.push({ pos: p, range: 55, dir, cos: 0.86, color: [7, 6.6, 5.8] });
    }
    const rear = this.localToWorld(new V3(0, 0.35, this.def.zMin - 1.1), new V3());
    out.push({ pos: rear, range: 3.2, color: [0.35 + 0.9 * (this.brakeIn || 0), 0.012, 0.008] });
  }

  // live gauges and a centre stack on models whose own dash is a blank shell
  addDecor(D) {
    const node = new Node('decor'); const prims = [];
    const panel = (mat, c, w, h, tilt) => { const mb = new MB(); mb.push().translate(c[0], c[1], c[2]).rotate(1, 0, 0, tilt);
      const a = mb.v(w / 2, -h / 2, 0, 0, 0, -1, 0, 1), b = mb.v(-w / 2, -h / 2, 0, 0, 0, -1, 1, 1), cc = mb.v(-w / 2, h / 2, 0, 0, 0, -1, 1, 0), dd = mb.v(w / 2, h / 2, 0, 0, 0, -1, 0, 0); mb.quad(a, b, cc, dd); mb.pop(); prims.push(mb.prim(mat)); };
    const bezel = new Material({ name: 'decor_bezel', color: [0.04, 0.04, 0.045, 1], roughness: 0.5 });
    if (D.cluster) { const C = D.cluster; this.cluster = clusterCanvas(C.style || 'analog2');
      const bz = new MB(); bz.push().translate(C.pos[0], C.pos[1], C.pos[2] + 0.012).rotate(1, 0, 0, C.tilt || 0); bz.box(0, 0, 0, C.w + 0.04, C.h + 0.04, 0.02); bz.pop(); prims.push(bz.prim(bezel));
      panel(new Material({ name: 'cluster', map: this.cluster.tex, unlit: true, doubleSided: true }), C.pos, C.w, C.h, C.tilt || 0); }
    if (D.dash) { // a moulded dashboard for models that have none: top pad, face, glovebox line and a centre console
      const [x0, x1, y0, y1, z0, z1] = D.dash, plast = new Material({ name: 'decor_dash', color: [...(D.dashColor || [0.07, 0.07, 0.075]), 1], roughness: 0.7 }), soft = new Material({ name: 'decor_pad', color: [...(D.padColor || [0.12, 0.11, 0.1]), 1], roughness: 0.85 });
      const mb = new MB(), pad = new MB(); const W = x1 - x0, cx = (x0 + x1) / 2;
      mb.box(cx, (y0 + y1) / 2 - 0.03, (z0 + z1) / 2 + 0.03, W, y1 - y0 - 0.06, z1 - z0 - 0.06);          // body of the dash
      pad.pillow(cx, y1 - 0.03, (z0 + z1) / 2, W + 0.02, 0.07, z1 - z0, 0.03);                            // soft top pad
      mb.box(cx, y0 + 0.05, z0 + 0.02, W - 0.1, 0.02, 0.02);                                              // lower lip
      mb.box(0, y0 - 0.12, z0 + 0.25, 0.26, 0.3, 0.5);                                                     // centre console
      for (const vx of [x0 + 0.1, x1 - 0.1, -0.08, 0.08]) mb.box(vx, y1 - 0.14, z0 - 0.005, 0.09, 0.05, 0.02); // air vents
      prims.push(mb.prim(plast), pad.prim(soft));
    }
    if (D.stack) { const C = D.stack; panel(new Material({ name: 'stack', map: stackTexture(C.style || 'gm'), roughness: 0.5, doubleSided: true }), C.pos, C.w, C.h, C.tilt || 0); }
    node.mesh = { prims }; node.castShadow = false; this.model.add(node);
  }

  // a real cabin (dash, seats, steering wheel) cut from another model file, fitted into this car at load time:
  // E = { asset, cut: [{ box: [x0,x1,y0,y1,z0,z1], nodes: /re/, mat: /re/, flat: true }], doubleSided: /re/ }
  fitCabin(E, meta) {
    const ig = Car.assets && Car.assets[E.asset]; if (!ig) return;
    // the model's own (fixed) steering wheel goes: the new cabin brings a turning one
    for (const n of this.model.findAll(n => n.name === 'steering' || n.name === 'interior')) if (n.parent) n.parent.remove(n);
    const root = ig.root.children[0];
    for (const c of root.children) this.model.add(c.clone(true));
    if (ig.json && ig.json.extras && ig.json.extras.steer) meta.steer = ig.json.extras.steer;
    // clear the model's own cabin clutter / a bed cover / a bit of the new cabin (single cab)
    for (const R of E.cut || []) {
      const [x0, x1, y0, y1, z0, z1] = R.box, nre = R.nodes || /^(body|door_[lr])$/;
      for (const n of this.model.children) {
        if (!n.mesh || !nre.test(n.name)) continue; const o = n.pos;
        n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => {
          if (R.mat && !(p.material && R.mat.test(p.material.name))) return p;
          if (p.material && (p.material.glass || p.material.alphaMode === 'BLEND') && !R.glass) return p;
          const P = p.attrs.position.data, I = p.index, keep = [];
          for (let i = 0; i < I.length; i += 3) {
            const a = I[i] * 3, b = I[i + 1] * 3, c = I[i + 2] * 3;
            const x = (P[a] + P[b] + P[c]) / 3 + o.x, y = (P[a + 1] + P[b + 1] + P[c + 1]) / 3 + o.y, z = (P[a + 2] + P[b + 2] + P[c + 2]) / 3 + o.z;
            let inside = x > x0 && x < x1 && y > y0 && y < y1 && z > z0 && z < z1;
            if (inside && R.flat) { const ux = P[b] - P[a], uy = P[b + 1] - P[a + 1], uz = P[b + 2] - P[a + 2], vx = P[c] - P[a], vy = P[c + 1] - P[a + 1], vz = P[c + 2] - P[a + 2];
              const nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx; inside = Math.abs(ny) > 0.7 * Math.hypot(nx, ny, nz); }
