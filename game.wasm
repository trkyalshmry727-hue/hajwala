// live instrument cluster drawn on a canvas (redrawn while you drive); one look per real car
function clusterCanvas(style) {
  const c = document.createElement('canvas'); c.width = 512; c.height = 168; const g = c.getContext('2d');
  const tex = { image: c, wrapS: 33071, wrapT: 33071, srgb: true, gl: null, dirty: true };
  const A0 = 0.75 * Math.PI, AR = 1.5 * Math.PI;
  const dial = (cx, cy, r, v, max, labels, o = {}) => {
    const face = o.face || '#0b0b0b', ink = o.ink || '#f2efe6', ring = o.ring || '#9a9a9a', needle = o.needle || '#ff6a1a';
    g.fillStyle = face; g.beginPath(); g.arc(cx, cy, r + 6, 0, Math.PI * 2); g.fill();
    g.strokeStyle = ring; g.lineWidth = o.ringW || 3; g.beginPath(); g.arc(cx, cy, r + 4, 0, Math.PI * 2); g.stroke();
    if (o.glow) { g.strokeStyle = o.glow; g.lineWidth = 3; g.beginPath(); g.arc(cx, cy, r + 0.5, A0, A0 + AR); g.stroke(); }
    const n = o.ticks || 20;
    for (let i = 0; i <= n; i++) { const a = A0 + i / n * AR; const big = i % 2 === 0; g.strokeStyle = o.red && i >= n * 0.8 ? '#e0402a' : ink; g.lineWidth = big ? 3 : 1.5; g.beginPath(); g.moveTo(cx + Math.cos(a) * r * (big ? 0.78 : 0.86), cy + Math.sin(a) * r * (big ? 0.78 : 0.86)); g.lineTo(cx + Math.cos(a) * r * 0.97, cy + Math.sin(a) * r * 0.97); g.stroke(); }
    g.fillStyle = ink; g.font = `bold ${o.font || 15}px Arial`; g.textAlign = 'center'; g.textBaseline = 'middle';
    labels.forEach((t, i) => { const a = A0 + i / (labels.length - 1) * AR; g.fillText(t, cx + Math.cos(a) * r * 0.6, cy + Math.sin(a) * r * 0.6); });
    const a = A0 + Math.min(1, v / max) * AR;
    g.strokeStyle = needle; g.lineWidth = 4; g.beginPath(); g.moveTo(cx - Math.cos(a) * 8, cy - Math.sin(a) * 8); g.lineTo(cx + Math.cos(a) * r * 0.9, cy + Math.sin(a) * r * 0.9); g.stroke();
    g.fillStyle = o.cap || '#333'; g.beginPath(); g.arc(cx, cy, 8, 0, Math.PI * 2); g.fill();
  };
  const txt = (t, x, y, size, col, bold = true) => { g.fillStyle = col; g.font = `${bold ? 'bold ' : ''}${size}px Arial`; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(t, x, y); };
  const K = ['0', '40', '80', '120', '160', '200'], RPM = ['0', '2', '4', '6', '8'];
  const draw = (kmh, rpm, gear) => {
    g.fillStyle = '#030303'; g.fillRect(0, 0, 512, 168);
    const v = Math.round(kmh);
    if (style === 'lc') {            // Land Cruiser 70: two big white-on-black dials with chrome bezels + fuel/temp
      dial(120, 86, 72, rpm / 1000, 5, ['0', '1', '2', '3', '4', '5'], { ring: '#c8c8c8', ringW: 5, red: true, needle: '#ff5a1a' });
      dial(392, 86, 72, kmh, 180, ['0', '40', '80', '120', '160'], { ring: '#c8c8c8', ringW: 5, needle: '#ff5a1a' });
      g.fillStyle = '#111'; g.fillRect(222, 40, 68, 90); txt('E    F', 256, 60, 13, '#ddd'); txt(String(gear), 256, 96, 30, '#ffb347'); txt('C    H', 256, 120, 13, '#ddd');
    } else if (style === 'hilux') {  // Hilux: blue-rimmed dials with a centre info screen
      dial(116, 86, 72, rpm / 1000, 8, RPM, { ring: '#44484e', glow: '#2f7fe0', red: true, needle: '#ff3b2b' });
      dial(396, 86, 72, kmh, 200, K, { ring: '#44484e', glow: '#2f7fe0', needle: '#ff3b2b' });
      g.fillStyle = '#0a1a2c'; g.fillRect(212, 34, 88, 100); g.strokeStyle = '#2f7fe0'; g.strokeRect(212, 34, 88, 100);
      txt(String(gear), 256, 66, 30, '#e8f4ff'); txt(v + ' km/h', 256, 106, 15, '#9fd0ff');
    } else if (style === 'changan') { // Changan: two dials with a digital centre (speed + gear)
      dial(110, 86, 66, rpm / 1000, 8, RPM, { ring: '#707780', glow: '#27c3c9', red: true, needle: '#ff4a2a', font: 13 });
      dial(402, 86, 66, kmh, 220, ['0', '60', '120', '180', '220'], { ring: '#707780', glow: '#27c3c9', needle: '#ff4a2a', font: 13 });
      g.fillStyle = '#071114'; g.fillRect(196, 30, 120, 108); txt(String(v), 256, 72, 38, '#e8ffff'); txt('km/h', 256, 100, 13, '#7fd6da'); txt('D ' + gear, 256, 122, 16, '#35e07a');
    } else if (style === 'elantra') { // Elantra 2024: fully digital, teal arcs and big numbers
      const gr = g.createLinearGradient(0, 0, 512, 0); gr.addColorStop(0, '#02080b'); gr.addColorStop(0.5, '#061016'); gr.addColorStop(1, '#02080b'); g.fillStyle = gr; g.fillRect(0, 0, 512, 168);
      for (const [cx, val, mx] of [[110, rpm, 8000], [402, kmh, 220]]) { g.strokeStyle = '#123'; g.lineWidth = 10; g.beginPath(); g.arc(cx, 90, 62, 0.8 * Math.PI, 2.2 * Math.PI); g.stroke(); g.strokeStyle = '#2de0d0'; g.beginPath(); g.arc(cx, 90, 62, 0.8 * Math.PI, 0.8 * Math.PI + Math.min(1, val / mx) * 1.4 * Math.PI); g.stroke(); }
      txt(String(Math.round(rpm / 100) / 10), 110, 92, 30, '#e8ffff'); txt('x1000rpm', 110, 122, 11, '#7fbfc0'); txt(String(v), 402, 92, 36, '#e8ffff'); txt('km/h', 402, 122, 12, '#7fbfc0');
      txt(String(gear), 256, 84, 34, '#2de0d0'); txt('D', 256, 120, 16, '#9ad');
    } else if (style === 'camry') {  // Camry 2025: blue ECO/POWER arc with a big digital speed
      g.fillStyle = '#01040a'; g.fillRect(0, 0, 512, 168);
      g.strokeStyle = '#0e2a55'; g.lineWidth = 12; g.beginPath(); g.arc(210, 120, 95, Math.PI, 2 * Math.PI); g.stroke();
      const f = Math.min(1, rpm / 7000); g.strokeStyle = '#2a7cff'; g.beginPath(); g.arc(210, 120, 95, Math.PI, Math.PI + f * Math.PI); g.stroke();
      txt('ECO', 140, 60, 11, '#8fb4e6'); txt('POWER', 285, 60, 11, '#8fb4e6'); txt(String(v), 210, 96, 44, '#ffffff'); txt('km/h', 210, 124, 12, '#9ab'); txt(String(gear), 210, 148, 18, '#fff');
      g.strokeStyle = '#ddd'; g.lineWidth = 2; g.beginPath(); g.arc(470, 84, 60, 0.6 * Math.PI, 1.4 * Math.PI); g.stroke(); txt('F', 440, 36, 12, '#ddd'); txt('E', 440, 132, 12, '#ddd');
    } else if (style === 'avanza') { // Avanza: big central speedometer, small tacho on the left, fuel on the right
      dial(256, 88, 76, kmh, 180, ['0', '40', '80', '120', '160'], { face: '#101010', ring: '#8a8a8a', needle: '#ff6a1a' });
      dial(92, 92, 52, rpm / 1000, 8, RPM, { face: '#101010', ring: '#8a8a8a', red: true, font: 12 });
      g.fillStyle = '#101010'; g.beginPath(); g.arc(420, 92, 56, 0, Math.PI * 2); g.fill(); txt('E     F', 420, 70, 13, '#ddd'); txt(String(gear), 420, 104, 28, '#ffb347');
    } else if (style === 'digital') {
      const gr = g.createLinearGradient(0, 0, 512, 168); gr.addColorStop(0, '#0d1b2a'); gr.addColorStop(1, '#030608'); g.fillStyle = gr; g.fillRect(8, 8, 496, 152);
      g.strokeStyle = '#2a9df4'; g.lineWidth = 6; g.beginPath(); g.arc(130, 84, 62, A0, A0 + Math.min(1, rpm / 7000) * AR); g.stroke();
      txt(String(v), 330, 78, 64, '#e8f4ff'); txt('km/h', 330, 124, 18, '#8fb8d8', false); txt(String(gear), 130, 86, 34, '#2a9df4');
    } else {
      dial(118, 84, 70, rpm / 1000, 8, RPM, { red: true }); dial(394, 84, 70, kmh, 200, K);
      g.fillStyle = '#0b0b0b'; g.fillRect(222, 50, 68, 68); g.strokeStyle = '#555'; g.lineWidth = 2; g.strokeRect(222, 50, 68, 68);
      txt(String(gear), 256, 76, 34, '#ffb347'); txt(String(v), 256, 104, 14, '#ddd', false);
    }
