    mb.pole.box(BX - 13.5, 4, zs, 0.35, 8, 0.35); mb.pole.box(BX + 13.5, 4, zs, 0.35, 8, 0.35); mb.pole.box(BX, 7.6, zs, 27, 0.3, 0.3);
    colCyl(world, BX - 13.5, 0, zs, 0.25, 8, 5); colCyl(world, BX + 13.5, 0, zs, 0.25, 8, 5);
