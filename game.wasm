    if (inBlock(x, z) || onRoad(x, z)) return;
    const tall = h > 30; const m = tall ? mb['b' + ((r() * 3) | 0)] : mb.stone;
    const pts = [[-w / 2, -d / 2], [w / 2, -d / 2], [w / 2, d / 2], [-w / 2, d / 2]];
    const rings = [{ y: 0, pts: tf(pts, x, z, yaw) }, { y: h, pts: tf(pts, x, z, yaw) }];
    if (tall && r() < 0.5) rings.push({ y: h + 6, pts: tf(pts.map(([a, b]) => [a * 0.7, b * 0.7]), x, z, yaw) });
    loft(m, rings, true);
    if (!tall) { mb.stone.push().translate(x, 0, z).rotate(0, 1, 0, yaw); for (let i = -w / 2 + 0.6; i < w / 2; i += 1.2) { mb.stone.box(i, h + 0.35, d / 2 - 0.15, 0.5, 0.7, 0.3); mb.stone.box(i, h + 0.35, -d / 2 + 0.15, 0.5, 0.7, 0.3); } mb.stone.pop(); }
    colBox(world, x, h / 2, z, w, h, d, yaw, 4);
  };
