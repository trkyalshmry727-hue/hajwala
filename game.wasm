      const dc = dcs[side]; if (!dc || !door) continue;
      node.remove(dc); dc.pos.set(-door.pos.x, -door.pos.y, -door.pos.z); door.add(dc);
    }
    this.steeringNode = node.userData.steering; this.steerBase = this.steeringNode.rot.clone();
    this.steerCenter = node.userData.wheelCenter; this.steerTilt = node.userData.wheelTilt;
    this.seatPos = new V3(xs, I.seatTop, I.seatZ);
  }

  buildSpheres() {
    const d = this.def, r = d.sphereR, spheres = [];
    const topAt = (z) => { const p = d.profile; for (let i = 0; i < p.length - 1; i++) { if (z <= p[i][0] && z >= p[i + 1][0]) { const t = (z - p[i][0]) / (p[i + 1][0] - p[i][0]); return lerp(p[i][1], p[i + 1][1], t); } } return p[p.length - 1][1]; };
    const n = Math.ceil((d.zMax - d.zMin - 2 * r) / 0.7);
    for (let i = 0; i <= n; i++) {
      const z = d.zMax - r - (d.zMax - d.zMin - 2 * r) * i / n;
      const top = topAt(z);
      for (const sx of [-1, 1]) {
        const x = sx * (d.halfWidth - r);
        spheres.push(new V3(x, d.lowY, z));
        const yTop = top - r; if (yTop > d.lowY + 0.3) spheres.push(new V3(x, yTop, z));
        if (yTop > d.lowY + 0.75) spheres.push(new V3(x, (yTop + d.lowY) / 2, z));
      }
      // the nose and tail also get a middle column: a pole or a post hit dead centre can't slip in between the two sides
      if (i <= 1 || i >= n - 1) { spheres.push(new V3(0, d.lowY, z)); const yTop = top - r; if (yTop > d.lowY + 0.3) spheres.push(new V3(0, Math.min(yTop, d.lowY + 0.35), z)); }
    }
    // relative to COM
    this.spheres = spheres.map(s => { const p = s.sub(this.com); p.r = r; return p; });
