    a.box(0, y1 - 0.18, zf + 0.28, hw * 2 - 0.06, 0.34, 0.56);              // over-cab nose
    st.box(0, y0 + 0.45, zc, hw * 2 + 0.012, 0.1, L + 0.012);               // side stripe
    for (const s of [1, -1]) for (const zz of [zc + L * 0.22, zc - L * 0.22]) g.box(s * (hw + 0.005), y0 + 0.9, zz, 0.012, 0.42, 0.62); // side windows
    g.box(0, y0 + 0.95, zb - 0.005, 0.46, 0.34, 0.012);                     // door window
    t.box(0.02, (y0 + y1) / 2 - 0.05, zb - 0.004, 0.66, y1 - y0 - 0.3, 0.01); // rear door
    t.box(0.28, y0 + 0.62, zb - 0.03, 0.04, 0.16, 0.04);                    // handle
    t.box(0, y1 + 0.16, zc + 0.3, 0.75, 0.22, 0.6);                          // AC unit
    for (const x of [-hw + 0.14, -hw + 0.46]) t.box(x, (y0 + y1) / 2 - 0.1, zb - 0.06, 0.035, y1 - y0 + 0.1, 0.035); // ladder rails
    for (let y = y0 + 0.1; y < y1; y += 0.28) t.box(-hw + 0.3, y, zb - 0.06, 0.32, 0.03, 0.03);
    const sg = new MB(); sg.box(0, y1 - 0.12, zb - 0.02, 0.7, 0.2, 0.01);
    const n = new Node('caravan'); n.mesh = { prims: [a.prim(white), t.prim(trim), g.prim(glass), st.prim(stripe), sg.prim(sign)] };
    car.model.add(n); car.caravanNode = n;
  }
  setPeople(on) { this.people = !!on; const m = this.map; if (m) this.npcs.forEach((n, i) => { const sp = on ? m.npcs && m.npcs[i] : null; n.root.visible = !!sp; n.active = !!sp; if (sp) { const y = this.world.heightAt(sp[0], sp[1], 5); n.pos.set(sp[0], y, sp[1]); n.home = n.pos.clone(); n.yaw = n.homeYaw = sp[2]; n.state = 'idle'; } }); }
  get car() { return this.cars[this.carKey]; }
  // build a car once its model has been loaded (at start only the chosen car loads; the others follow in the background)
  addCar(key) {
    if (this.cars[key] || !this.assets[key]) return this.cars[key] || null;
    const assets = this.assets;
    // untouched copy of the model for other players' cars (online), taken before our own car is built from it
    const src0 = assets[key].root.children[0];
    if (src0) { const c = src0.clone(true); c.traverse(n => { if (n.mesh && /^(body|door_l|door_r)$/.test(n.name)) n.mesh = { ...n.mesh, prims: n.mesh.prims.map(p => ({ ...p, attrs: { ...p.attrs, position: { ...p.attrs.position, data: new Float32Array(p.attrs.position.data) }, normal: p.attrs.normal ? { ...p.attrs.normal, data: new Float32Array(p.attrs.normal.data) } : undefined }, gpu: null })) }; }); this.pristine[key] = { root: { children: [c] }, json: assets[key].json }; }
    const car = new Car(CAR_DEFS[key], assets[key], this.world);
    car.key = key; if (assets.plate) car.addPlates(assets.plate); car.snapshotNormals(); if (car.def.defaultParts) car.applyTune({});
    if (this.world) car.world = this.world; car.setNight && car.setNight(this.weather === 'night' || this.weather === 'dusk' || !!this.night);
    this.cars[key] = car; return car;
  }

  // ---------------- modes ----------------
  showroom(key) {
    if (!this.cars[key]) key = this.cars.shas ? 'shas' : Object.keys(this.cars)[0];
    // menu / garage view: car parked in the crossroads, slowly orbiting camera
    for (const k in this.cars) if (this.cars[k].node.parent) this.scene.remove(this.cars[k].node);
    this.carKey = key;
    const car = this.car; this.scene.add(car.node); this.attachCaravan(car);
    if (car.damage > 0 || car.deform.some(d => d.orig) || car.wheels.some(w => w.detached)) { this.clearDebris(); car.repair(this.r); } // the garage always shows a fixed car
    const sr = this.map.showroom; car.place(sr.x, this.world.heightAt(sr.x, sr.z, 5) + 0.02, sr.z, sr.yaw);
    for (let i = 0; i < 60; i++) car.step(1 / 120, { throttle: 0, brake: 1, steer: 0, handbrake: true });
    car.reverse = false; car.revTimer = 0;
    for (const c of [this.player, this.baseChar, this._heroChar]) if (c && c.root.parent) c.root.parent.remove(c.root);
    this.mode = 'menu';
  }

  start() {
    const car = this.car;
    this.fx.skids.clear();
    this.clearDebris();
    car.repair(this.r);
    const sp = this.map.spawn; car.place(sp.x, this.world.heightAt(sp.x, sp.z, 5) + 0.05, sp.z, sp.yaw);
    this.mode = 'play';
    // player sits in the car
    this.enterSeatNow();
    this.score = 0; this.driftPts = 0;
    this.placeMapActors();
    this.camYawOff = 0;
    this.placeCameraBehind();
  }

  seatRoot(car) {
    const s = car.seatPos, k = car.def.driverScale || 1;
    return new V3(s.x, s.y + 0.1 - 0.915 * k - (car.seatDrop || 0) + (car.seatRaise || 0), s.z + 0.04 + (car.seatShiftZ || 0));
  }
  // sit the driver low enough that the head stays under the roof lining (tall drivers slouch into the seat)
  fitHeadroom(car) {
    if (car.seatDrop !== undefined) return;
    car.seatDrop = 0;
    const p = this.player, hb = p.bones.head; if (!hb) return;
    const roof = car.def.interior ? car.def.interior.linerY : car.def.headroomY; if (!roof) return;
    car.node.updateWorld(null);
    const inv = M4.invert(M4.create(), car.node.world); const head = hb.worldPos(new V3()).applyM4(inv);
    const k = car.def.driverScale || 1, top = head.y + 0.2 * k, lim = roof - 0.05;
    if (top > lim) { car.seatDrop = Math.min(0.2, top - lim); p.root.pos.copy(this.seatRoot(car)); }
  }
  // feet must stay on the cabin floor (a low seat / slouched driver used to push the shins out under the car)
  fitLegs(car) {
    if (car.legLift !== undefined) return;
    car.legLift = 0; car.seatRaise = 0;
    const p = this.player, d = car.def; if (!p.bones.foot_l) return;
    const floor = d.floorY ?? (d.interior ? d.interior.floorY : d.lowY - 0.1);
    const inv = M4.invert(M4.create(), car.node.world);
    const lowFoot = () => { p.root.pos.copy(this.seatRoot(car)); p.applyPose(this.legFix(car, p.poseDrive(0))); car.node.updateWorld(null); let low = 1e9; for (const k of ['foot_l', 'foot_r', 'ball_l', 'ball_r']) { const b = p.bones[k]; if (b) low = Math.min(low, b.worldPos(new V3()).applyM4(inv).y); } return low; };
    // 1) sit higher until the feet reach the floor (only as far as the roof allows), 2) then tuck the legs for the rest
    const roof = d.interior ? d.interior.linerY : d.headroomY;
    let need = floor + 0.03 - lowFoot();
    if (need > 0) {
      let room = 0.35; const hb = p.bones.head;
      if (hb && roof) { const head = hb.worldPos(new V3()).applyM4(inv); room = Math.max(0, Math.min(room, roof - 0.05 - (head.y + 0.2 * (d.driverScale || 1)))); }
      car.seatRaise = Math.min(need, room);
    }
    for (let lift = 0; lift <= 1.2; lift += 0.1) { car.legLift = lift; if (lowFoot() >= floor + 0.02) break; }
    this.legDbg = { floor, low: lowFoot(), raise: car.seatRaise, lift: car.legLift };
  }
  legFix(car, pose) {
    const L = car.legLift || 0; if (!L) return pose;
    const o = { ...pose };
    for (const sd of ['l', 'r']) { const th = o['thigh_' + sd] || [0, 0, 0], ca = o['calf_' + sd] || [0, 0, 0], ft = o['foot_' + sd] || [0, 0, 0];
      // knee up a little and the leg stretched forward (a straighter knee lifts the foot), sole kept flat
      o['thigh_' + sd] = [th[0] - L * 0.3, th[1], th[2]]; o['calf_' + sd] = [Math.max(0.05, ca[0] - L * 0.9), ca[1], ca[2]]; o['foot_' + sd] = [ft[0] + L * 0.25, ft[1], ft[2]]; }
    return o;
  }
  enterSeatNow() {
    const car = this.car, p = this.player;
    car.node.add(p.root);
    p.root.pos.copy(this.seatRoot(car)); p.root.rot.identity();
    const k = car.def.driverScale || 1; p.root.scl.set(k, k, k);
    p.applyPose(this.drivePose(car, p.poseDrive(0)));
    this.fitHeadroom(car); this.fitLegs(car); this.fitReach(car); p.applyPose(this.drivePose(car, p.poseDrive(0)));
    this.playerMode = 'car'; car.doorAngle = 0; car.engineOn = true;
  }
  // car-local point -> character model space (root is a child of the car node)
  toChar(p, carLocal) { const r = p.root; const k = r.scl.x; return carLocal.clone().sub(r.pos).applyInvQ(r.rot).scale(1 / k); }
  // hands on the steering wheel rim (two-bone IK), following the wheel as it turns
  drivePose(car, base, weight = 1) {
    const p = this.player; base = this.legFix(car, base); if (!car.steerCenter) return base;
    if (car.def.recline) { base = { ...base }; const pv = base.pelvis || [0, 0, 0]; base.pelvis = [pv[0] + car.def.recline, pv[1], pv[2]]; const th = base.thigh_l; base.thigh_l = [th[0] - car.def.recline, th[1], th[2]]; const tr = base.thigh_r; base.thigh_r = [tr[0] - car.def.recline, tr[1], tr[2]]; }
    // each hand holds the rim and turns WITH the wheel; at the end of its reach it stops and the rim slides
    // through the palm (no jumping, no letting go), and it drifts back to its home spot when the wheel centres
    // both hands are locked to the rim and turn with the wheel one-to-one (the wheel turns about 225 degrees each way,
    // a range the arms can follow); only in the last bit of full lock does the rim slide through the palms. Smoothed so
    // the hands never jump, and they settle back at 9-and-3 when the wheel is centred.
    const spin = car.wheelSpin();
    const H = this.hands && this.hands.car === car && this.hands.v === 3 ? this.hands : (this.hands = { v: 3, car, l: 0, r: 0, t: performance.now() });
    const now = performance.now(), hdt = clamp((now - H.t) / 1000, 0, 0.1); H.t = now;
    // each hand can ride up and over the top of the rim, but only a little way down (the bottom of the wheel is out of reach)
    const kk = 1 - Math.exp(-hdt * 25);
    H.l += (clamp(-spin, -2.2, 0.9) - H.l) * kk; H.r += (clamp(-spin, -0.9, 2.2) - H.r) * kk;
    // never let a hand float off the rim: if the grip spot is out of the arm's reach, the hand stays on the nearest
    // reachable spot between its 9/3 home and the wanted spot (the rim slides through the palm there)
    if (!car.reach || car.reach.p !== p) {
      p.applyPose(base); car.node.updateWorld(null); const inv = M4.invert(M4.create(), car.node.world); const k = p.root.scl.x;
      const len = (s) => (p.rest['upperarm_' + s].wpos.dist(p.rest['lowerarm_' + s].wpos) + p.rest['lowerarm_' + s].wpos.dist(p.rest['hand_' + s].wpos)) * k;
      car.reach = { p, l: p.bones.upperarm_l.worldPos(new V3()).applyM4(inv), r: p.bones.upperarm_r.worldPos(new V3()).applyM4(inv), ll: len('l'), lr: len('r') };
    }
    const fitA = (home, off, sh, al) => { const lim = Math.max(al * 1.2, this.gripPoint(car, home, 0.55).dist(sh) * 1.04), ok = (o) => this.gripPoint(car, home + o, 0.55).dist(sh) <= lim; if (ok(off)) return off; let lo = 0, hi = 1; for (let it = 0; it < 12; it++) { const m = (lo + hi) / 2; if (ok(off * m)) lo = m; else hi = m; } return off * lo; };
    const offL = fitA(1.35, H.l, car.reach.l, car.reach.ll), offR = fitA(-1.35, H.r, car.reach.r, car.reach.lr);
    const L = this.toChar(p, this.gripPoint(car, 1.35 + offL, 0.85)), Rr = this.toChar(p, this.gripPoint(car, -1.35 + offR, 0.85)); // wrist just outside the rim: the palm wraps it instead of the fingers going through
    let pose = p.armIK(base, 'l', L, new V3(0.7, -1, -0.2));
    pose = p.armIK(pose, 'r', Rr, new V3(-0.7, -1, -0.2));
    // cruising fast in a straight line: one hand on the wheel, the right hand rests on the lap (back on the wheel to steer)
    const cruise = car.speed > 27.8 && Math.abs(spin) < 0.9 && !car.handbrake;
    H.one = (H.one || 0) + ((cruise ? 1 : 0) - (H.one || 0)) * (1 - Math.exp(-hdt * (cruise ? 1.5 : 8)));
    if (H.one > 0.01) { // the right hand rests on the right thigh (not stuck out in the air)
      const sp = car.seatPos, lap = this.toChar(p, new V3(sp.x - 0.12, sp.y + 0.17, sp.z + 0.32));
      const rest = p.armIK(pose, 'r', lap, new V3(-0.9, -0.6, -0.4));
      for (const k of ['upperarm_r', 'lowerarm_r', 'hand_r']) { const a2 = pose[k] || [0, 0, 0], b2 = rest[k] || [0, 0, 0]; pose[k] = [lerp(a2[0], b2[0], H.one), lerp(a2[1], b2[1], H.one), lerp(a2[2], b2[2], H.one)]; }
    }
    return weight >= 1 ? pose : Character.blend(base, pose, weight);
  }
  gripPoint(car, ang, wrist = 0) {
    const R = (car.rimR || 0.185) + wrist * 0.075, tilt = new Q().setAxisAngle(new V3(1, 0, 0), car.steerTilt || -0.42);
    return new V3(Math.sin(ang) * R, Math.cos(ang) * R, -0.025 - wrist * 0.035).applyQ(tilt).add(car.steerCenter);
  }
  // fingers wrap the rim: which way each rig's finger joints bend is found once, by trying the three axes and keeping
  // the one that brings the fingertips round onto the rim
  gripFingers(car) {
    const p = this.player; if (!car.steerCenter) return;
    const F = p.fingerChains(); if (!F.l.length && !F.r.length) return;
    if (!p._fingerAx) {
      p.setGrip(0); car.node.updateWorld(null); const inv = M4.invert(M4.create(), car.node.world); const ax = {};
      const AX = [new V3(1, 0, 0), new V3(0, 1, 0), new V3(0, 0, 1)];
      for (const side of ['l', 'r']) {
        const rim = this.gripPoint(car, side === 'l' ? 1.35 : -1.35, 0); ax[side] = {};
        for (const [fname, key] of [['middle', 'finger'], ['thumb', 'thumb']]) {
          const ch = [1, 2, 3].map(k => F[side].find(b => b.f === fname && b.k === k)); if (ch.some(b => !b)) continue;
          const tip = () => { car.node.updateWorld(null); const a = ch[1].n.worldPos(new V3()).applyM4(inv), b = ch[2].n.worldPos(new V3()).applyM4(inv); return b.clone().add(b.clone().sub(a).scale(0.9)); };
          let best = null;
          for (const A of AX) for (const sg of [1, -1]) {
            for (const b of ch) b.n.rot.copy(b.rest).mul(new Q().setAxisAngle(A, sg * (fname === 'thumb' ? 0.4 : 0.9)));
            const d = tip().dist(rim); if (!best || d < best.d) best = { d, a: [A, sg] };
            for (const b of ch) b.n.rot.copy(b.rest);
          }
          if (best) ax[side][key] = best.a;
        }
      }
      p._fingerAx = ax;
    }
    p.setGrip(0.85, p._fingerAx);
  }
  // make sure the driver can actually reach the rim: slide the seat forward / pull the wheel back when arms are too short
  fitReach(car) {
    if (car.reachFitted || !car.steerCenter) return; car.reachFitted = true;
    const p = this.player, ub = p.bones.upperarm_l, lb = p.bones.lowerarm_l, hb = p.bones.hand_l; if (!ub || !lb || !hb) return;
    p.applyPose(p.poseDrive(0)); car.node.updateWorld(null);
    const S = ub.worldPos(new V3()), k = p.root.scl.x;
    const armLen = (p.rest.upperarm_l.wpos.dist(p.rest.lowerarm_l.wpos) + p.rest.lowerarm_l.wpos.dist(p.rest.hand_l.wpos)) * k;
    // the left hand must reach round the top of the rim (it rides over the top when steering), not only its 9 o'clock spot
    let far = 0; for (const a of [1.35, 0.6, 0]) far = Math.max(far, S.dist(this.gripPoint(car, a, 0.55).applyM4(car.node.world)));
    const need = far - 1.08 * armLen; // (1.15: the hand grips a little in front of its bone; measured on the Shas, whose reach is right)
    if (need <= 0) return;
    const seatMove = Math.min(need * 1.05, 0.15), pull = Math.min(Math.max(0, need * 1.05 - seatMove), 0.06);
    car.seatShiftZ = seatMove;
    if (pull > 0 && car.steeringNode) { car.steeringNode.pos.z -= pull; car.steerCenter.z -= pull; }
    p.root.pos.copy(this.seatRoot(car));
  }
  doorHandle(car, outside) {
    const L = car.doorLen || 1;
    const local = outside ? new V3(0.07, -0.12, -L + 0.14) : new V3(-0.1, -0.1, -L * 0.55);
    return local.applyQ(new Q().setAxisAngle(new V3(0, 1, 0), -car.doorAngle)).add(car.doorHinge);
  }

  // ---------------- per-frame ----------------
  // move the player (car, driver, camera) by a wrap offset: endless maps
  shiftWorld(w) {
    const car = this.car, b = car.body, q = new Q().setAxisAngle(new V3(0, 1, 0), w.dyaw || 0);
    const piv = b.pos.clone();
    const mv = (v) => { v.sub(piv).applyQ(q).add(piv); v.x += w.dx; v.z += w.dz; };
    b.q.premul(q); b.vel.applyQ(q); mv(b.pos); b.updateInertia();
    mv(this.camPos); mv(this.camLook); if (this.player) { mv(this.player.pos); }
    if (this.fx && this.fx.skids) this.fx.skids.clear();
    car.syncNode();
  }
  fixedStep(dt) {
    const car = this.car, inp = this.input;
    let ci = { throttle: 0, brake: 0, steer: 0, handbrake: true };
    if (this.playerMode === 'car') {
      ci = { throttle: inp.throttle, brake: inp.brake, steer: inp.steer, handbrake: inp.handbrake };
      if (this.drone) ci = { throttle: 0, brake: 0.3, steer: 0, handbrake: true };
      if (this.wantExit) { ci = { throttle: 0, brake: car.forwardSpeed > 0.5 ? 1 : 0, steer: inp.steer, handbrake: true }; }
    } // parked (getting out / on foot): handbrake on, no brake pedal (the pedal held at a stop engages reverse and spun the front wheels)
    const sm = this.surfaceUnder(car);
    ci.surfaceGrip = sm;
    ci.water = null;
    if (this.map.water) { const b = car.body.pos; for (const w of this.map.water) if (b.x > w.x0 - 1 && b.x < w.x1 + 1 && b.z > w.z0 - 8 && b.z < w.z1 + 8) ci.water = w.level; }
    { // soft sand: how easily tyres dig in here
      const m = this.map, b = car.body.pos; let k = m.bogAt ? m.bogAt(b.x, b.z) : m.name === 'desert' ? 1 : m.name === 'test' ? 0.8 : 0.4;
      for (const z of m.deepSand || []) if (b.x > z.x0 && b.x < z.x1 && b.z > z.z0 && b.z < z.z1) k = z.k;
      car.bogSand = k;
    }
    if (!this.inRoom) { const sub = car.speed > 60 ? 3 : car.speed > 28 ? 2 : 1; for (let i = 0; i < sub; i++) car.step(dt / sub, ci); } // fast: smaller steps so posts and walls can't be jumped through
    if (this.map.wrap && this.playerMode === 'car') { const b = car.body.pos, w = this.map.wrap(b.x, b.z); if (w) this.shiftWorld(w); }
    if (this.net) { this.net.stepBot(dt); this.net.collide(dt); }
    this.stepCones(dt);
  }

  surfaceUnder(car) {
    let sand = 0, n = 0;
    for (const w of car.wheels) if (w.onGround) { n++; if (w.tag === 3) sand++; }
    this.onSand = n && sand / n > 0.5;
    return 1;
  }

  update(dt) {
    this.time += dt; this.r.env.time = this.time;
    // night: headlights of every car in the scene light the road
    const L = this.r.lights || (this.r.lights = []); L.length = 0;
    if (this.night || this.weather === 'dusk') { if (this.car.node.parent) this.car.pushLights(L); if (this.net) this.net.pushLights(L); }
    const inp = this.input, car = this.car;
    if (this.mode !== 'play') { this.updateMenu(dt); return; }

    // one-shot actions
    if (inp.take('camera')) { const n = this.camCustom ? 5 : 4; this.camMode = (this.camMode + 1) % n; this.hud.toast(['كاميرا قريبة', 'كاميرا بعيدة', 'على الكبوت', 'داخلية', 'كاميرتك'][this.camMode], 900); }
    if (inp.take('reset')) this.resetCar();
    if (inp.take('repair')) { this.clearDebris(); this.car.repair(this.r); this.hud.toast('صلّحنا السيارة', 1200); if (this.net) this.net.repaired(); }
    if (inp.take('horn')) { this.audio.horn(true); this.hornT = 0.5; }
    if (inp.take('hornUp')) this.hornT = 0;
    if (this.hornT !== undefined) { this.hornT -= dt; if (this.hornT <= 0 && !inp.keys.has('KeyH')) { this.audio.horn(false); this.hornT = undefined; } }
    if (inp.take('door')) this.onDoorButton();
    if (inp.take('kick')) this.startKick();

    this.syncCharacter();
    // player
    if (this.playerMode === 'car') {
      this.player.applyPose(this.drivePose(car, this.player.poseDrive(car.steer / car.def.maxSteer)));
      this.gripFingers(car);
      if (this.wantExit && car.speed < 1.2) { this.wantExit = false; this.startExit(); }
    } else if (this.playerMode === 'seq') this.updateSeq(dt);
    else if (this.playerMode === 'ride') { const r = this.ride; if (!r || !r.car.node.parent) this.endRide(); else { const p = this.player; p.t += dt; const pose = p.poseSit(); pose.head = [0.02, Math.sin(p.t * 0.3) * 0.25, 0]; p.applyPose(this.legFix(r.car, pose)); } }
    else this.updateFoot(dt);
    if (this.playerMode !== 'car' && this.player._grip) this.player.setGrip(0);
    // first-person: collapse the driver's head (ghutra) so it never blocks the view
    { const hb = this.player.bones.head; if (hb) { const k = this.camMode === 3 && this.playerMode === 'car' ? 0.001 : 1; hb.scl.set(k, k, k); } }

    this.updateNPCs(dt);
    this.handleImpacts(dt);
    this.updateDebris(dt);
    if (this.net) this.net.update(dt);
    this.updateEffects(dt);
    this.updateScore(dt);
    this.updateCamera(dt);
    this.updateAudio(dt);
    this.updateSaher(dt);
    if (car.flooded && !car.floodMsg) { car.floodMsg = true; this.hud.toast('المويه دخلت المكينة — طفت السيارة!', 2200); }
    if (car.flooded && car.submerge < 0.02) { car.dryT = (car.dryT || 0) + dt; if (car.dryT > 3) { car.flooded = false; car.floodMsg = false; car.dryT = 0; car.engineOn = true; this.hud.toast('نشّفت واشتغلت السيارة', 1600); } }
    if (car.submerge > 0.05 && car.speed > 2) { const b = car.body; for (const w of car.wheels) if (Math.random() < 0.5) this.fx.splash(w.contact.clone().add(new V3(0, 0.3, 0)), b.vel, clamp(car.speed / 8, 0, 1)); }
    if (car.cluster && this.playerMode !== 'foot') { this.clT = (this.clT || 0) + dt; if (this.clT > 0.08) { this.clT = 0; car.cluster.draw(Math.abs(car.forwardSpeed) * 3.6, car.engineOn ? car.rpm : 0, car.reverse ? 'R' : car.speed < 0.3 && car.throttle < 0.05 ? 'N' : car.gear); } }
    this.r.shadowFocus.copy(this.playerMode === 'foot' ? this.player.pos : this.ride ? this.ride.car.body.pos : car.body.pos);
    // on foot next to a tyre -> the tyre-pressure button
    this.nearWheel = -1;
    if (this.playerMode === 'foot') { let best = 1.5; car.wheels.forEach((w, i) => { if (w.detached || !w.node) return; const wp = car.localToWorld(w.pos.clone(), new V3()); const d = Math.hypot(wp.x - this.player.pos.x, wp.z - this.player.pos.z); if (d < best) { best = d; this.nearWheel = i; } }); }
    if (this.deflating && this.nearWheel >= 0) { const w = car.wheels[this.nearWheel]; const was = w.psi; w.psi = Math.max(0, w.psi - dt * 4); if (was > 0.5 && w.psi <= 0.5) this.hud.toast('انفشّ الكفر! روح للورشة', 2500); }
    // challenge target pillar
    if (this.chal && this.chal.target) {
      const T = this.chal.target;
      if (!this.chalNode) { const mat = new Material({ name: 'chalGlow', color: [1, 0.85, 0.1, 0.5], unlit: true, alphaMode: 'BLEND', doubleSided: true }); this.chalNode = new Node('chal'); this.chalNode.mesh = { prims: [boxPrim(3, 60, 3, mat)] }; this.chalNode.castShadow = false; }
      if (this.chalNode.parent !== this.scene) this.scene.add(this.chalNode);
      this.chalNode.pos.set(T.x, this.world.heightAt(T.x, T.z, 50) + 30, T.z);
      const b = car.body.pos; if (!this.chal.done && Math.hypot(b.x - T.x, b.z - T.z) < 7) { this.chal.done = true; this.chal.mine = performance.now(); if (this.onChalDone) this.onChalDone(); }
    } else if (this.chalNode && this.chalNode.parent) this.chalNode.parent.remove(this.chalNode);
    // fuel: burns with the throttle; park on a yellow pad to fill up
    if (this.playerMode === 'car' && car.engineOn) { car.fuel = Math.max(0, (car.fuel ?? 100) - dt * (0.035 + 0.16 * car.throttle * (car.tuneTorque || 1))); if (car.fuel <= 0 && !car.noFuel) { car.noFuel = true; this.hud.toast('خلص البنزين! شوف الخريطة وروح للمحطة الصفرا (أو دز السيارة بالدرون)', 3500); } }
    if (this.fuelPads && this.playerMode === 'car') { const b = car.body.pos; const on = this.fuelPads.some(f => Math.hypot(b.x - f.x, b.z - f.z) < f.r) && Math.abs(car.speed) < 0.8;
      if (on && (car.fuel ?? 100) < 100) { car.fuel = Math.min(100, (car.fuel ?? 100) + dt * 20); car.noFuel = false; if (car.fuel >= 100) this.hud.toast('تعبّى البنزين ⛽', 1500); } }
    // walk-in caravan: yellow spot behind the parked Shas / exit spot inside
    if (this.playerMode === 'foot' && !this.roomBusy) {
      let pt = null;
      if (this.inRoom) pt = this.map.exit; else if (this.carKey === 'shas') { const q = car.localToWorld(new V3(0, 0, car.def.zMin - 1.2), new V3()); pt = { x: q.x, z: q.z }; }
      if (pt) { if (!this.roomDot) { const m = new Material({ name: 'roomDot', color: [1, 0.85, 0.1, 0.7], unlit: true, alphaMode: 'BLEND', doubleSided: true }); const P = [], N = [], U = [], I = []; for (let i = 0; i <= 20; i++) { const a = i / 20 * Math.PI * 2; P.push(Math.cos(a) * 0.8, 0.05, Math.sin(a) * 0.8); N.push(0, 1, 0); U.push(0, 0); } P.push(0, 0.05, 0); N.push(0, 1, 0); U.push(0, 0); for (let i = 0; i < 20; i++) I.push(21, i, i + 1); this.roomDot = new Node('roomDot'); this.roomDot.mesh = { prims: [makePrim(P, N, U, I, m)] }; this.roomDot.castShadow = false; }
        if (this.roomDot.parent !== this.scene) this.scene.add(this.roomDot); this.roomDot.pos.set(pt.x, this.world.heightAt(pt.x, pt.z, this.player.pos.y + 1.5), pt.z);
        if (Math.hypot(this.player.pos.x - pt.x, this.player.pos.z - pt.z) < 0.9 && this.onRoom) { this.roomBusy = true; this.onRoom(!this.inRoom); } }
      else if (this.roomDot && this.roomDot.parent) this.roomDot.parent.remove(this.roomDot);
    } else if (this.roomDot && this.roomDot.parent && this.playerMode !== 'foot') this.roomDot.parent.remove(this.roomDot);
    if (this.workshop && this.playerMode === 'car' && !this.drone) {
      const b0 = car.body.pos, W = (this.workshops || [this.workshop]).reduce((a, w) => Math.hypot(b0.x - w.x, b0.z - w.z) < Math.hypot(b0.x - a.x, b0.z - a.z) ? w : a, this.workshop), b = b0;
      if (Math.hypot(b.x - W.x, b.z - W.z) < W.r && Math.abs(car.speed) < 0.6) {
        const t0 = this.wsT || 0; this.wsT = t0 + dt;
        if (Math.floor(t0) !== Math.floor(this.wsT) && this.wsT < 10) this.hud.toast('الورشة: ' + (10 - Math.floor(this.wsT)).toLocaleString('ar-SA') + '…', 900);
        if (t0 < 10 && this.wsT >= 10) { for (const w of car.wheels) { w.psi = 30; w.sink = 0; } car.repair(this.r); this.clearDebris && this.clearDebris(); if (this.net) this.net.repaired(); this.hud.toast('خلاص تعبّت الكفرات وكل شي مضبوط ✅', 2500); }
      } else this.wsT = 0;
    }
    if (!this.map._follow) { this.map._follow = []; this.map.root.traverse(n => { if (n.userData && n.userData.followZ) this.map._follow.push(n); }); }
    for (const n of this.map._follow) n.pos.z = this.r.shadowFocus.z;
  }

  // ---------------- door sequences ----------------
  doorPoints(car) {
    const H = car.doorHinge, L = car.doorLen || 1;
    return {
      A: new V3(H.x + 0.78, 0, H.z - L - 0.05),    // stand beside the door, near the handle
      B: new V3(H.x + 0.28, 0, H.z - L * 0.5),     // in the doorway
      S: this.seatRoot(car),
      handle: new V3(H.x + 0.05, 1.05, H.z - L + 0.12),
    };
  }
  onDoorButton() {
    const car = this.car;
    if (this.playerMode === 'car') {
      if (car.speed > 1.2) { this.wantExit = true; this.hud.toast('وقف السيارة للنزول...'); }
      else this.startExit();
    } else if (this.playerMode === 'foot') {
      const fr = this.nearFriendCar();
      if (fr && (!this.nearDoor() || fr.d < this.doorDist())) this.startRide(fr.R);
      else if (this.nearDoor()) this.startEnter();
      else this.hud.toast('قرّب من باب السواق');
    } else if (this.playerMode === 'ride') this.endRide();
  }
  nearDoor() {
    const car = this.car; const pts = this.doorPoints(car);
    const wa = car.node.world; const A = pts.A.clone().applyM4(wa);
    const d = Math.hypot(A.x - this.player.pos.x, A.z - this.player.pos.z);
    const c = car.body.pos, dc = Math.hypot(c.x - this.player.pos.x, c.z - this.player.pos.z);
    return (d < 4.5 || dc < 5) && this.carUpright();
  }
  carUpright() { return this.car.up(new V3()).y > 0.6; }
  doorDist() { const A = this.doorPoints(this.car).A.clone().applyM4(this.car.node.world); return Math.hypot(A.x - this.player.pos.x, A.z - this.player.pos.z); }
  // ---- riding with a friend: sit in the passenger seat of their car (they drive, you ride) ----
  nearFriendCar() {
    if (!this.net) return null; let best = null;
    const list = [...this.net.remotes.values()]; if (this.net.bot) list.push(this.net.bot);
    for (const R of list) { const c = R.car; if (!c.node.parent) continue; const lp = c.worldToLocal(this.player.pos.clone().add(new V3(0, 0.9, 0)), new V3());
      const d = Math.hypot(Math.abs(lp.x) - c.def.halfWidth, lp.z - (c.doorHinge ? c.doorHinge.z - 0.5 : 0));
      if (d < 2.2 && (!best || d < best.d)) best = { R, d }; }
    return best;
  }
  passengerSeat(car) { const s = this.seatRoot(car); s.x = -Math.abs(s.x); return s; }
  startRide(R) {
    const c = R.car, p = this.player; this.ride = { R, car: c, t: 0 };
    c.node.add(p.root); p.root.pos.copy(this.passengerSeat(c)); p.root.rot.identity(); const k = c.def.driverScale || 1; p.root.scl.set(k, k, k);
    p.applyPose(p.poseSit()); this.playerMode = 'ride'; this.camYawOff = 0;
    this.audio.door(true); setTimeout(() => this.audio.door(false), 700);
    this.hud.toast('ركبت مع ' + (R.name || 'خويك') + ' — اضغط الباب عشان تنزل', 2200);
  }
  endRide() {
    const r = this.ride; if (!r) return; const c = r.car, p = this.player;
    const side = c.localToWorld(new V3(-(c.def.halfWidth + 0.8), 0, (c.doorHinge ? c.doorHinge.z : 0.5) - 0.6), new V3());
    if (p.root.parent) p.root.parent.remove(p.root); this.scene.add(p.root); p.root.scl.set(1, 1, 1);
    p.pos.copy(side); p.pos.y = this.world.heightAt(side.x, side.z, side.y + 2); p.yaw = this.carYawOf(c) - Math.PI / 2; p.vel.set(0, 0, 0);
    p.setTransform(p.pos, p.yaw); this.playerMode = 'foot'; this.ride = null; this.audio.door(false);
  }
  carYawOf(c) { const f = c.forward(new V3()); return Math.atan2(f.x, f.z); }

  startEnter() {
    const car = this.car, p = this.player;
    // convert player to car-local space
    const inv = M4.invert(M4.create(), car.node.world);
    const lp = p.pos.clone().applyM4(inv);
    const carYaw = this.carYaw();
    car.node.add(p.root);
    this.seq = { type: 'enter', stage: 'walk', t: 0, from: lp, yaw: angleWrap(p.yaw - carYaw), pts: this.doorPoints(car) };
    this.playerMode = 'seq';
  }
  // is there room to stand on this side of the car? (side 1 = driver/left, -1 = passenger/right)
  sideFree(side) {
    const car = this.car; let blocked = false;
    for (const dz of [-0.2, -0.7]) {
      const lp = new V3(side * (car.def.halfWidth + 0.5), 0.95, car.doorHinge.z + dz);
      const wp = car.localToWorld(lp, new V3());
      this.world.sphere(wp, 0.38, (nx, ny, nz, depth, px, py, pz, tag) => { if (tag !== 9 && ny < 0.75 && depth > 0.04) blocked = true; });
    }
    return !blocked;
  }
  startExit() {
    const car = this.car;
    let side = 1;
    if (!this.sideFree(1)) { if (this.sideFree(-1)) { side = -1; this.hud.toast('باب السواق مسدود — ننزل من الباب الثاني', 1600); } }
    this.seq = { type: 'exit', stage: side > 0 ? 'open' : 'slide', t: 0, pts: this.doorPoints(car), yaw: 0, side };
    this.playerMode = 'seq';
  }
  carYaw() { const f = this.car.forward(new V3()); return Math.atan2(f.x, f.z); }

  updateSeq(dt) {
    const s = this.seq, car = this.car, p = this.player, P = s.pts;
    s.t += dt; p.t += dt;
    const floorY = 0.02; // local car ground
    const k = car.def.driverScale || 1;
    const setLocal = (pos, yaw, sc = 1) => { p.root.pos.copy(pos); p.root.rot.setAxisAngle(UP, yaw); p.root.scl.set(sc, sc, sc); };
    const Ayaw = -Math.PI / 2; // facing the car's side
    const reachIK = (pose, side, target, w, pole) => w <= 0.001 ? pose : Character.blend(pose, p.armIK(pose, side, this.toChar(p, target), pole), clamp(w, 0, 1));
    if (s.type === 'enter') {
      if (s.stage === 'walk') {
        const to = P.A.clone(); to.y = floorY;
        // walk around the car (never through it) when coming from the passenger side / front / back
        if (!s.path) {
          const hw = car.def.halfWidth + 0.75, zf = car.def.zMax + 0.7, zb = car.def.zMin - 0.7, f = s.from.clone(); f.y = floorY;
          s.path = [f];
          // walk AROUND the car to the driver's door, never through it
          const inLen = f.z < zf && f.z > zb, zc = Math.abs(f.z - zf) < Math.abs(f.z - zb) ? zf : zb;
          if (inLen) {
            if (f.x >= 0) { if (f.x < hw) s.path.push(new V3(hw, floorY, f.z)); } // driver side, close to the body: step out first
            else { s.path.push(new V3(-hw, floorY, f.z)); s.path.push(new V3(-hw, floorY, zc)); s.path.push(new V3(hw, floorY, zc)); } // passenger side: round the nearer end
          } else if (f.x < hw) { const ze = f.z >= zf ? zf : zb; s.path.push(new V3(f.x, floorY, ze)); s.path.push(new V3(hw, floorY, ze)); } // in front / behind
          s.path.push(to);
          for (let i = s.path.length - 2; i > 0; i--) if (s.path[i].dist(s.path[i - 1]) < 0.05) s.path.splice(i, 1);
          s.segL = []; s.pathL = 0; for (let i = 1; i < s.path.length; i++) { const l = s.path[i].dist(s.path[i - 1]); s.segL.push(l); s.pathL += l; }
        }
        const dist = s.pathL;
        const dur = Math.max(0.35, dist / 1.6);
        const u = clamp(s.t / dur, 0, 1);
        let dd = (ease(u) * 0.3 + u * 0.7) * dist, seg = 0; while (seg < s.segL.length - 1 && dd > s.segL[seg]) { dd -= s.segL[seg]; seg++; }
        const pos = s.path[seg].clone().lerp(s.path[seg + 1], clamp(dd / (s.segL[seg] || 1), 0, 1)); pos.y = lerp(s.from.y, floorY, u);
        const d = new V3().subVecs(s.path[seg + 1], s.path[seg]); d.y = 0;
        const walkYaw = Math.atan2(d.x, d.z);
        const yaw = u < 0.75 ? lerpAngle(s.yaw, walkYaw, clamp(s.t * 5, 0, 1)) : lerpAngle(walkYaw, Ayaw, ease((u - 0.75) / 0.25));
        s.phase = (s.phase || 0) + dt * 7.2 * (1 - ease((u - 0.85) / 0.15));
        setLocal(pos, yaw);
        p.pelvisOffset.set(0, p.gaitBob(s.phase) * (1 - u), 0);
        { const pose = Character.blend(p.poseWalk(s.phase, 0), p.poseIdle(p.t), ease((u - 0.8) / 0.2));
          if (p.isHero) { p.clipT += dt * (1 - ease((u - 0.85) / 0.15)); p.applyPoseClip(pose, p.clipT, 1 - ease((u - 0.7) / 0.3)); } else p.applyPose(pose); }
        if (dist < 0.05 || u >= 1) { s.stage = 'open'; s.t = 0; p.pelvisOffset.set(0, 0, 0); }
      } else if (s.stage === 'open') {
        const u = clamp(s.t / 1.25, 0, 1);
        const H = this.doorHandle(car, true);
        const hy = Math.atan2(H.x - P.A.x, H.z - P.A.z);
        const yaw = lerpAngle(Ayaw, hy + 0.35, ease(u * 2.5));
        const pos = P.A.clone(); pos.y = floorY; pos.x += 0.18 * ease((u - 0.45) / 0.55); pos.z += 0.12 * ease((u - 0.45) / 0.55);
        setLocal(pos, yaw);
        if (u > 0.3 && !s.opened) { s.opened = true; this.audio.door(true); }
        car.doorAngle = 1.15 * ease((u - 0.32) / 0.68);
        let pose = p.poseIdle(p.t); pose.spine_01 = [-0.1 * Math.sin(u * Math.PI), 0.15, 0];
        const w = u < 0.3 ? ease(u / 0.3) : u < 0.8 ? 1 : 1 - ease((u - 0.8) / 0.2);
        pose = reachIK(pose, 'r', this.doorHandle(car, true), w, new V3(-1, -0.6, -0.3));
        p.applyPose(pose);
        if (u >= 1) { s.stage = 'in'; s.t = 0; }
      } else if (s.stage === 'in') {
        const u = clamp(s.t / 1.9, 0, 1);
        const a = P.A.clone(); a.y = floorY; a.x += 0.18; a.z += 0.12;
        const bb = P.B.clone(); bb.y = floorY + 0.2;
        const S = P.S;
        let pos;
        if (u < 0.45) pos = a.clone().lerp(bb, ease(u / 0.45));
        else pos = bb.clone().lerp(S, ease((u - 0.45) / 0.55));
        pos.y += Math.sin(clamp(u / 0.6, 0, 1) * Math.PI) * 0.035;
        const yaw = u < 0.35 ? lerpAngle(Ayaw + 0.2, Ayaw - 0.35, ease(u / 0.35)) : lerpAngle(Ayaw - 0.35, 0, ease((u - 0.35) / 0.55));
        setLocal(pos, yaw, lerp(1, k, ease((u - 0.4) / 0.6)));
        const lift = Math.sin(clamp(u / 0.5, 0, 1) * Math.PI);
        const stepLeg = { thigh_l: [-1.25 * lift, 0, 0.25], calf_l: [1.35 * lift, 0, 0], spine_01: [0.25 * lift, 0, 0], neck_01: [-0.2 * lift, 0, 0] };
        const inside = 1 - clamp((pos.x - (car.def.halfWidth - 0.05)) / 0.4, 0, 1);
        let base = Character.blend(p.poseIdle(p.t), p.poseSit(), Math.max(ease((u - 0.3) / 0.6), inside));
        base = Character.add(base, stepLeg, 1 - ease((u - 0.45) / 0.3));
        // left hand grabs the A-pillar / wheel while climbing in
        base = reachIK(base, 'l', car.steerCenter ? car.steerCenter.clone().add(new V3(0.12, 0.1, 0)) : this.doorHandle(car, false), Math.sin(clamp(u, 0, 1) * Math.PI) * 0.9, new V3(1, -0.5, 0));
        p.applyPose(base);
        if (u >= 1) { s.stage = 'close'; s.t = 0; }
      } else if (s.stage === 'close') {
        const u = clamp(s.t / 0.9, 0, 1);
        setLocal(P.S, 0, k);
        car.doorAngle = 1.15 * (1 - ease((u - 0.25) / 0.55));
        const reach = u < 0.25 ? ease(u / 0.25) : u < 0.8 ? 1 : 1 - ease((u - 0.8) / 0.2);
        let pose = p.poseSit(); pose.spine_01 = [0.1 * reach, 0.3 * reach, 0.05 * reach];
        pose = reachIK(pose, 'l', this.doorHandle(car, false), reach, new V3(0.4, -1, 0.3));
        pose = Character.blend(pose, this.drivePose(car, p.poseDrive(0)), ease((u - 0.8) / 0.2));
        p.applyPose(pose);
        if (u >= 0.8 && !s.closed) { s.closed = true; this.audio.door(false); car.doorAngle = 0; this.shake = Math.max(this.shake, 0.08); }
        if (u >= 1) { this.playerMode = 'car'; this.seq = null; car.engineOn = true; this.audio.thump(60, 0.2, 0.12); }
      }
    } else { // exit (mirrored to the passenger door when the driver side is blocked)
      const side = s.side || 1;
      if (side < 0) {
        const mirrorPose = (po) => { const o = {}; for (const kk in po) { const v = po[kk]; const nk = kk.endsWith('_l') ? kk.slice(0, -2) + '_r' : kk.endsWith('_r') ? kk.slice(0, -2) + '_l' : kk; o[nk] = [v[0], -v[1], -v[2]]; } return o; };
        const mv = (v) => new V3(-v.x, v.y, v.z);
        const setL0 = setLocal;
        const setLocalM = (pos, yaw, sc = 1) => setL0(mv(pos), -yaw, sc);
        const applyM = (po) => p.applyPose(mirrorPose(po));
        if (s.stage === 'slide') { // shuffle across the bench to the passenger seat
          const u = clamp(s.t / 1.0, 0, 1);
          const pos = P.S.clone().lerp(mv(P.S), ease(u)); pos.y += Math.sin(u * Math.PI) * 0.05;
          setLocal(pos, 0, k);
          p.applyPose(p.poseSit());
          if (u >= 1) { s.stage = 'open'; s.t = 0; }
          return;
        }
        if (s.stage === 'open') {
          const u = clamp(s.t / 0.8, 0, 1); setLocalM(P.S, 0, k);
          const reach = u < 0.3 ? ease(u / 0.3) : 1 - ease((u - 0.6) / 0.4);
          const pose = p.poseSit(); pose.spine_01 = [0.05, 0.25 * reach, 0]; pose.upperarm_l = [-0.9 * reach, 0.3 * reach, -0.9 + 0.4 * reach];
          if (u > 0.25 && !s.opened) { s.opened = true; this.audio.door(true); }
          car.doorAngleR = 1.15 * ease((u - 0.25) / 0.75); applyM(pose);
          if (u >= 1) { s.stage = 'out'; s.t = 0; }
        } else if (s.stage === 'out') {
          const u = clamp(s.t / 1.45, 0, 1);
          const S = P.S, bb = P.B.clone(); bb.y = 0.02 + 0.2; const a = new V3(P.A.x + 0.1, 0.02, P.A.z + 0.35);
          let pos = u < 0.5 ? S.clone().lerp(bb, ease(u / 0.5)) : bb.clone().lerp(a, ease((u - 0.5) / 0.5));
          pos.y += Math.sin(clamp((u - 0.3) / 0.5, 0, 1) * Math.PI) * 0.08;
          setLocalM(pos, lerpAngle(0, Math.PI / 2, ease(u / 0.6)), lerp(k, 1, ease(u / 0.6)));
          const lift = Math.sin(clamp(u / 0.55, 0, 1) * Math.PI);
          const outside = clamp((pos.x - (car.def.halfWidth - 0.05)) / 0.4, 0, 1);
          let base = Character.blend(p.poseSit(), p.poseIdle(p.t), Math.min(ease((u - 0.2) / 0.6), outside));
          base = Character.add(base, { thigh_l: [-1.0 * lift, 0, 0.25], calf_l: [1.1 * lift, 0, 0], spine_01: [0.3 * lift, 0, 0], neck_01: [-0.25 * lift, 0, 0] }, 1 - ease((u - 0.55) / 0.3));
          applyM(base);
          if (u >= 1) { s.stage = 'close'; s.t = 0; s.pos = a; }
        } else if (s.stage === 'close') {
          const u = clamp(s.t / 1.0, 0, 1);
          const yaw = lerpAngle(Math.PI / 2, -Math.PI * 0.8, ease(u / 0.45));
          setLocalM(s.pos, yaw);
          car.doorAngleR = 1.15 * (1 - ease((u - 0.4) / 0.4));
          const reach = u < 0.3 ? 0 : u < 0.45 ? ease((u - 0.3) / 0.15) : u < 0.8 ? 1 : 1 - ease((u - 0.8) / 0.2);
          const pose = p.poseIdle(p.t); pose.spine_01 = [-0.12 * reach, -0.2 * reach, 0]; pose.upperarm_r = [-1.1 * reach, -0.2 * reach, 1.2 - 0.6 * reach];
          applyM(pose);
          if (u >= 0.8 && !s.closed) { s.closed = true; car.doorAngleR = 0; this.audio.door(false); }
          if (u >= 1) this.finishExit(mv(s.pos), -yaw);
        }
        return;
      }
      if (s.stage === 'open') {
        const u = clamp(s.t / 0.8, 0, 1);
        setLocal(P.S, 0, k);
        const reach = u < 0.3 ? ease(u / 0.3) : 1 - ease((u - 0.6) / 0.4);
        let pose = p.poseSit(); pose.spine_01 = [0.05, 0.25 * reach, 0];
        if (u > 0.25 && !s.opened) { s.opened = true; this.audio.door(true); }
        car.doorAngle = 1.15 * ease((u - 0.25) / 0.75);
        pose = reachIK(pose, 'l', this.doorHandle(car, false), reach, new V3(0.4, -1, 0.3));
        p.applyPose(pose);
        if (u >= 1) { s.stage = 'out'; s.t = 0; }
      } else if (s.stage === 'out') {
        const u = clamp(s.t / 1.45, 0, 1);
        const S = P.S, bb = P.B.clone(); bb.y = 0.02 + 0.2;
        const a = new V3(P.A.x + 0.1, 0.02, P.A.z + 0.35);
        let pos;
        if (u < 0.5) pos = S.clone().lerp(bb, ease(u / 0.5)); else pos = bb.clone().lerp(a, ease((u - 0.5) / 0.5));
        pos.y += Math.sin(clamp((u - 0.3) / 0.5, 0, 1) * Math.PI) * 0.08;
        const yaw = lerpAngle(0, Math.PI / 2, ease(u / 0.6));
        setLocal(pos, yaw, lerp(k, 1, ease(u / 0.6)));
        const lift = Math.sin(clamp(u / 0.55, 0, 1) * Math.PI);
        const stepLeg = { thigh_l: [-1.0 * lift, 0, 0.25], calf_l: [1.1 * lift, 0, 0], spine_01: [0.3 * lift, 0, 0], neck_01: [-0.25 * lift, 0, 0] };
        const outside = clamp((pos.x - (car.def.halfWidth - 0.05)) / 0.4, 0, 1);  // stand up only once clear of the door frame
        let base = Character.blend(p.poseSit(), p.poseIdle(p.t), Math.min(ease((u - 0.2) / 0.6), outside));
        base = Character.add(base, stepLeg, 1 - ease((u - 0.55) / 0.3));
        p.applyPose(base);
        if (u >= 1) { s.stage = 'close'; s.t = 0; s.pos = a; }
      } else if (s.stage === 'close') {
        const u = clamp(s.t / 1.0, 0, 1);
        const turn = ease(u / 0.45);
        const yaw = lerpAngle(Math.PI / 2, -Math.PI * 0.8, turn);
        setLocal(s.pos, yaw);
        car.doorAngle = 1.15 * (1 - ease((u - 0.4) / 0.4));
        const reach = u < 0.3 ? 0 : u < 0.45 ? ease((u - 0.3) / 0.15) : u < 0.8 ? 1 : 1 - ease((u - 0.8) / 0.2);
        let pose = p.poseIdle(p.t); pose.spine_01 = [-0.12 * reach, -0.2 * reach, 0];
        pose = reachIK(pose, 'r', this.doorHandle(car, true), reach, new V3(-1, -0.6, 0));
        p.applyPose(pose);
        if (u >= 0.8 && !s.closed) { s.closed = true; car.doorAngle = 0; this.audio.door(false); }
        if (u >= 1) this.finishExit(s.pos, yaw);
      }
    }
  }
  finishExit(localPos, localYaw) {
    const car = this.car, p = this.player;
    const wp = localPos.clone().applyM4(car.node.world);
    car.node.remove(p.root); this.scene.add(p.root); p.root.scl.set(1, 1, 1);
    p.pos.copy(wp); p.pos.y = this.world.heightAt(wp.x, wp.z, wp.y + 1.5);
    p.yaw = localYaw + this.carYaw();
    this.playerMode = 'foot'; this.seq = null;
    p.setTransform(p.pos, p.yaw);
    car.engineOn = true;
    this.camYawOff = 0;
  }

  // ---------------- on foot ----------------
  updateFoot(dt) {
    const p = this.player, inp = this.input, car = this.car;
    p.t += dt;
    // camera-relative movement
    const camYaw = Math.atan2(this.camLook.x - this.camPos.x, this.camLook.z - this.camPos.z);
    const mx = this.drone ? 0 : inp.moveX, my = this.drone ? 0 : inp.moveY; const mag = Math.min(1, Math.hypot(mx, my)); // the stick flies the drone
    const run = mag > 0.85 || inp.keys.has('ShiftLeft');
    const speed = this.kick ? 0 : mag < 0.08 ? 0 : run ? 5.2 : 1.7 * Math.max(0.5, mag / 0.85);
    let targetVel = new V3();
    if (speed > 0) {
      const a = camYaw + Math.atan2(-mx, my); // joystick right -> screen right
      targetVel.set(Math.sin(a) * speed, 0, Math.cos(a) * speed);
      p.yaw = lerpAngle(p.yaw, a, 1 - Math.exp(-dt * 10));
    }
    p.vel.x = smooth(p.vel.x, targetVel.x, 10, dt); p.vel.z = smooth(p.vel.z, targetVel.z, 10, dt);
    p.pos.x += p.vel.x * dt; p.pos.z += p.vel.z * dt;
    // walls
    const c = new V3(p.pos.x, p.pos.y + 0.95, p.pos.z);
    this.world.sphere(c, 0.33, (nx, ny, nz, depth) => { if (ny < 0.6) { p.pos.x += nx * depth; p.pos.z += nz * depth; } });
    this.pushOutOfCar(p.pos, 0.35);
    for (const oc of this.otherCars()) this.pushOutOfCar(p.pos, 0.35, oc); // friends' cars are solid too
    // ground
    const gy = this.world.heightAt(p.pos.x, p.pos.z, p.pos.y + 0.6);
    if (gy > p.pos.y - 0.5) p.pos.y = smooth(p.pos.y, gy, 18, dt); else { p.vy = (p.vy || 0) - 9.8 * dt; p.pos.y = Math.max(gy, p.pos.y + p.vy * dt); if (p.pos.y === gy) p.vy = 0; }
    const hs = Math.hypot(p.vel.x, p.vel.z);
    p.walkBlend = smooth(p.walkBlend, hs > 0.15 ? 1 : 0, 7, dt);
    p.runBlend = smooth(p.runBlend || 0, clamp((hs - 2.2) / 2.6, 0, 1), 5, dt);
    const prevPh = p.phase;
    // cadence: ~1.8 steps/s walking, ~2.8 steps/s running; stride grows with speed
    p.phase += dt * Math.PI * lerp(1.7 + hs * 0.12, 2.6 + hs * 0.07, p.runBlend) * clamp(hs / 1.2, 0, 1);
    if (Math.floor(prevPh / Math.PI) !== Math.floor(p.phase / Math.PI) && hs > 0.5) this.audio.step();
    let pose = Character.blend(p.poseIdle(p.t), p.poseWalk(p.phase, p.runBlend), p.walkBlend);
    p.pelvisOffset.set(0, p.gaitBob(p.phase, p.runBlend) * p.walkBlend, 0);
    // lean into turns and with acceleration
    const turnRate = angleWrap(p.yaw - (p.prevYaw ?? p.yaw)) / Math.max(dt, 1e-3); p.prevYaw = p.yaw;
    p.lean = smooth(p.lean || 0, clamp(-turnRate * hs * 0.03, -0.25, 0.25), 6, dt);
    const acc = (hs - (p.prevHs ?? hs)) / Math.max(dt, 1e-3); p.prevHs = hs;
    p.pitchLean = smooth(p.pitchLean || 0, clamp(acc * 0.02, -0.12, 0.15), 5, dt);
    if (this.kick) {
      this.kick.t += dt; const u = this.kick.t / 0.8;
      pose = Character.blend(pose, p.poseKick(u), Math.min(1, u * 8, (1 - u) * 8));
      if (u > 0.42 && !this.kick.hit) { this.kick.hit = true; this.kickHit(); }
      if (u >= 1) this.kick = null;
    }
    if (p.isHero) { if (hs > 0.15) p.clipT += dt * clamp(hs / 1.45, 0.55, 2.4); p.applyPoseClip(pose, p.clipT, p.walkBlend * (1 - 0.65 * p.runBlend) * (this.kick ? 0 : 1)); }
    else p.applyPose(pose);
    p.setTransform(p.pos, p.yaw, p.pitchLean, p.lean);
    this.hud.setNearDoor(this.nearDoor() || !!this.nearFriendCar());
  }
  otherCars() { const n = this.net, out = []; if (!n) return out; for (const R of n.remotes.values()) if (R.car.node.parent) out.push(R.car); if (n.bot && n.bot.car.node.parent) out.push(n.bot.car); return out; }
  pushOutOfCar(pos, rad, car = this.car) {
    const d = car.def;
    const lp = car.worldToLocal(pos.clone().add(new V3(0, 0.9, 0)), new V3());
    const hx = d.halfWidth + rad, z0 = d.zMin - rad, z1 = d.zMax + rad;
    if (lp.y < -0.2 || lp.y > 2.3) return false;
    if (Math.abs(lp.x) < hx && lp.z > z0 && lp.z < z1) {
      const px = hx - Math.abs(lp.x), pz = Math.min(lp.z - z0, z1 - lp.z);
      if (px < pz) lp.x = Math.sign(lp.x || 1) * hx; else lp.z = (lp.z - z0 < z1 - lp.z) ? z0 : z1;
      const wp = car.localToWorld(lp, new V3()); pos.x = wp.x; pos.z = wp.z; return true;
    }
    return false;
  }
  startKick() {
    if (this.playerMode !== 'foot' || this.kick) return;
    this.kick = { t: 0, hit: false }; this.audio.whoosh();
  }
  kickHit() {
    const p = this.player; const f = new V3(Math.sin(p.yaw), 0, Math.cos(p.yaw));
    const foot = p.pos.clone().addS(f, 0.85); foot.y += 0.7;
    let hit = false;
    for (const n of this.npcs) {
      if (!n.active || n.state === 'flying' || n.state === 'lying') continue;
      const d = new V3(n.pos.x - foot.x, 0, n.pos.z - foot.z);
      if (d.len() < 0.95) { this.knock(n, f.clone().scale(5.5).add(new V3(0, 2.2, 0)), p.pos); hit = true; }
    }
    for (const c of this.cones) {
      if (c.pos.dist(new V3(foot.x, c.pos.y + 0.3, foot.z)) < 0.8) { c.vel.copy(f).scale(9).add(new V3(0, 4, 0)); c.ang.set(Math.random() * 10 - 5, 3, Math.random() * 10 - 5); c.rest = false; hit = true; }
    }
    const car = this.car; const lp = car.worldToLocal(foot, new V3());
    if (Math.abs(lp.x) < car.def.halfWidth + 0.15 && lp.z > car.def.zMin - 0.15 && lp.z < car.def.zMax + 0.15 && lp.y < 1.6) {
      car.dent(foot, f, 0.045, 0.35, this.r);
      car.body.applyImpulse(f.clone().scale(900), foot);
      this.fx.impactDust(foot, 2); hit = true;
      this.audio.thump(80, 0.25, 0.8);
    }
    if (hit) { this.audio.kick(); this.shake = Math.max(this.shake, 0.25); }
  }

  // ---------------- spectators ----------------
  knock(n, vel, from) {
    n.state = 'flying'; n.stateT = 0; n.vel.copy(vel);
    n.yaw = Math.atan2(from.x - n.pos.x, from.z - n.pos.z); // face the hit, fall backwards
    n.spin = (Math.random() - 0.5) * 2;
    this.audio.thump(100, 0.2, 0.7);
  }
  updateNPCs(dt) {
    const car = this.car; const cp = car.body.pos; const cv = car.body.vel;
    const drifting = Math.abs(car.driftAngle) > 0.35 && car.speed > 7;
    for (const n of this.npcs) {
      if (!n.active) continue;
      n.t += dt; n.stateT += dt;
      let pose;
      const toCar = new V3(cp.x - n.pos.x, 0, cp.z - n.pos.z); const dist = toCar.len();
      if (n.state === 'idle' || n.state === 'cheer') {
        // dodge a car coming at us
        const rel = -(cv.x * toCar.x + cv.z * toCar.z) / Math.max(dist, 0.1);
        if (dist < 10 && rel > 5 && dist / rel < 1.1) {
          const side = Math.sign((cv.x * toCar.z - cv.z * toCar.x) || 1);
          n.state = 'dodge'; n.stateT = 0; n.dodgeDir = new V3(cv.z, 0, -cv.x).norm().scale(side);
        } else if (drifting && dist < 35) { if (n.state !== 'cheer') { n.state = 'cheer'; n.stateT = 0; } }
        else if (n.state === 'cheer' && n.stateT > 2.5) { n.state = 'idle'; n.stateT = 0; }
        // walk back home slowly if displaced
        const hd = new V3(n.home.x - n.pos.x, 0, n.home.z - n.pos.z);
        if (hd.len() > 0.6 && n.state === 'idle') {
          hd.norm(); n.pos.addS(hd, dt * 1.3); n.yaw = lerpAngle(n.yaw, Math.atan2(hd.x, hd.z), 1 - Math.exp(-dt * 6)); n.phase += dt * 6;
          pose = n.poseWalk(n.phase, false);
        } else {
          n.yaw = lerpAngle(n.yaw, Math.atan2(toCar.x, toCar.z), 1 - Math.exp(-dt * (dist < 40 ? 1.5 : 0.3)));
          pose = n.state === 'cheer' ? n.poseCheer(n.t) : n.poseIdle(n.t);
          pose = n.headLookPose(pose, cp);
        }
      } else if (n.state === 'dodge') {
        const u = n.stateT / 0.65;
        n.pos.addS(n.dodgeDir, dt * 5.5 * (1 - u));
        pose = n.poseStep(u, 1);
        if (u >= 1) { n.state = 'idle'; n.stateT = 0; }
      } else if (n.state === 'flying') {
        n.vel.y -= 9.8 * dt; n.pos.addS(n.vel, dt);
        n.pitch = Math.max(-Math.PI / 2, n.pitch - dt * 4.5);
        n.yaw += n.spin * dt;
        const gy = this.world.heightAt(n.pos.x, n.pos.z, n.pos.y + 1);
        if (n.pos.y <= gy && n.vel.y < 0) {
          n.pos.y = gy;
          if (Math.abs(n.vel.y) > 3) { n.vel.y *= -0.25; n.vel.x *= 0.5; n.vel.z *= 0.5; this.fx.impactDust(n.pos.clone(), 3); this.audio.thump(70, 0.15, 0.4); }
          else { n.state = 'lying'; n.stateT = 0; n.vel.set(0, 0, 0); }
        }
        pose = n.poseFall(n.stateT);
      } else if (n.state === 'lying') {
        n.pitch = -Math.PI / 2;
        pose = n.poseLying(n.t);
        if (n.stateT > 2.6) { n.state = 'getup'; n.stateT = 0; }
      } else if (n.state === 'getup') {
        const u = n.stateT / 1.5;
        n.pitch = -Math.PI / 2 * (1 - ease(u * 1.3));
        pose = n.poseGetUp(u);
        if (u >= 1) { n.state = 'idle'; n.stateT = 0; n.pitch = 0; }
      }
      // collisions with the car body
      if (n.state !== 'flying') {
        const center = new V3(n.pos.x, n.pos.y + 0.9, n.pos.z);
        const lp = car.worldToLocal(center, new V3());
        const d = car.def;
        if (Math.abs(lp.x) < d.halfWidth + 0.35 && lp.z > d.zMin - 0.35 && lp.z < d.zMax + 0.35 && lp.y > -0.3 && lp.y < 2.2) {
          const v = car.body.velAt(center, new V3());
          if (v.len() > 2.5 && n.state !== 'lying') {
            this.knock(n, v.clone().scale(0.85).add(new V3(0, 2.5 + v.len() * 0.12, 0)), cp);
            this.fx.impactDust(center, 4);
            car.body.vel.scale(0.985);
          } else this.pushOutOfCar(n.pos, 0.35);
        }
      }
      if (n.state !== 'flying' && n.state !== 'lying' && n.state !== 'getup') n.pos.y = smooth(n.pos.y, this.world.heightAt(n.pos.x, n.pos.z, n.pos.y + 1), 12, dt);
      n.applyPose(pose || n.poseIdle(n.t));
      const lift = n.state === 'lying' ? 0.12 : n.state === 'getup' ? 0.12 * (1 - n.stateT / 1.5) : 0;
      n.setTransform(new V3(n.pos.x, n.pos.y + lift, n.pos.z), n.yaw, n.pitch);
      n.root.traverse(x => { x.castShadow = dist < 35; });
    }
    // player also gets knocked if run over? (just pushed)
  }

  // ---------------- cones ----------------
  stepCones(dt) {
    const car = this.car; const b = car.body;
    for (const c of this.cones) {
      if (!c.node.visible) continue;
      // car contact
      if (c.pos.dist(b.pos) < 4.5) {
        const center = c.pos.clone(); center.y += 0.35;
        const lp = car.worldToLocal(center, new V3());
        const d = car.def;
        if (Math.abs(lp.x) < d.halfWidth + 0.2 && lp.z > d.zMin - 0.2 && lp.z < d.zMax + 0.2 && lp.y < 1.5) {
          const v = b.velAt(center, new V3());
          if (v.len() > 0.5) {
            c.vel.copy(v).scale(1.25); c.vel.y = 2 + v.len() * 0.25;
            c.ang.set((Math.random() - 0.5) * 14, (Math.random() - 0.5) * 8, (Math.random() - 0.5) * 14); c.rest = false;
            if (!c.hitT || this.time - c.hitT > 0.4) { c.hitT = this.time; this.audio.thump(160, 0.1, 0.35); }
          }
        }
      }
      if (c.rest) continue;
      c.vel.y -= 9.8 * dt; c.pos.addS(c.vel, dt); c.q.integrate(c.ang, dt);
      const gy = this.world.heightAt(c.pos.x, c.pos.z, c.pos.y + 1);
      if (c.pos.y < gy) {
        c.pos.y = gy; if (c.vel.y < 0) c.vel.y *= -0.3; c.vel.x *= 0.9; c.vel.z *= 0.9; c.ang.scale(0.85);
        if (c.vel.len() < 0.4 && c.ang.len() < 0.6) { c.rest = true; }
      }
      c.node.pos.copy(c.pos); c.node.rot.copy(c.q);
    }
  }

  // ---------------- impacts & effects ----------------
  // wheels torn off in a crash roll/bounce away on their own
  updateDebris(dt) {
    const car = this.car;
    if (car.detachEvents && car.detachEvents.length) {
      for (const ev of car.detachEvents) {
        if (ev.door) { // a door ripped off: it tumbles away on its own
          const n = ev.node; if (!n || n.debris) continue;
          n.homeParent = n.parent; n.updateWorld && car.node.updateWorld(null);
          const wp = car.localToWorld(n.pos.clone(), new V3()), q = new Q().copy(car.body.q).mul(n.rot);
          if (n.parent) n.parent.remove(n); n.pos.copy(wp); n.rot.copy(q); n.debris = true; this.scene.add(n);
          const out = new V3().copy(ev.dir).applyQ(car.body.q).scale(-1);
          const vel = car.body.velAt(wp, new V3()).addS(out, 2 + Math.random() * 2); vel.y += 2 + Math.random() * 1.5;
          (this.debris || (this.debris = [])).push({ node: n, vel, ang: new V3((Math.random() - 0.5) * 5, (Math.random() - 0.5) * 4, (Math.random() - 0.5) * 5), r: 0.25, door: true, carKey: car.key });
          this.hud.toast('طار الباب!', 1000); this.audio.crash(14);
          continue;
        }
        const w = ev.w, n = w.node; if (!n) continue;
        const wp = car.localToWorld(new V3().copy(w.pos).add(w.dmgOff), new V3());
        const q = new Q().copy(car.body.q).mul(n.rot);
        if (n.parent) n.parent.remove(n);
        n.pos.copy(wp); n.rot.copy(q); this.scene.add(n);
        const out = new V3().copy(ev.dir).applyQ(car.body.q).scale(-1);
        const vel = car.body.velAt(wp, new V3()).addS(out, 3 + Math.random() * 3); vel.y += 2.5 + Math.random() * 2;
        (this.debris || (this.debris = [])).push({ node: n, vel, ang: new V3((Math.random() - 0.5) * 8, (Math.random() - 0.5) * 6, (Math.random() - 0.5) * 8), r: car.wheelRadius, w, carKey: car.key });
        this.hud.toast('طار الكفر!', 1000);
      }
      car.detachEvents.length = 0;
    }
    if (!this.debris) return;
    for (const d of this.debris) {
      if (d.node.parent !== this.scene) continue;
      d.vel.y -= 9.81 * dt; d.node.pos.addS(d.vel, dt);
      const g = this.world.heightAt(d.node.pos.x, d.node.pos.z, d.node.pos.y + 1);
      if (d.node.pos.y - d.r * 0.55 < g) {
        d.node.pos.y = g + d.r * 0.55; if (d.vel.y < 0) d.vel.y = -d.vel.y * 0.35;
        d.vel.x *= Math.exp(-dt * 0.8); d.vel.z *= Math.exp(-dt * 0.8); d.ang.scale(Math.exp(-dt * 1.5));
        if (Math.abs(d.vel.y) < 0.5 && d.vel.lenSq() < 0.3) d.vel.set(0, 0, 0);
      }
      const al = d.ang.len();
      if (al > 1e-3) { const dq = new Q().setAxisAngle(new V3().copy(d.ang).scale(1 / al), al * dt); d.node.rot.copy(dq.mul(d.node.rot)); }
    }
  }
  clearDebris() {
    for (const d of this.debris || []) { if (d.door) continue; if (d.node.parent) d.node.parent.remove(d.node); if (d.w.homeParent) d.w.homeParent.add(d.node); } // doors go home in car.repair()
    this.debris = [];
  }

  handleImpacts(dt) {
    const car = this.car;
    // how hard the crash really was: the car's sudden change of speed (a 200 km/h wall hit must wreck the car)
    const pv = this._pv || (this._pv = car.body.vel.clone()); const dv = car.body.vel.dist(pv); pv.copy(car.body.vel);
    this._dvPeak = Math.max((this._dvPeak || 0) * Math.exp(-dt * 6), dv);
    if (!car.impacts.length) return;
    // strongest few distinct impacts this frame
    const list = car.impacts.slice().sort((a, b) => b.speed - a.speed);
    car.impacts.length = 0;
    const picked = [];
    for (const im of list) { if (picked.length >= 3) break; if (picked.every(p => p.point.dist(im.point) > 0.6)) picked.push(im); }
    const sev = Math.max(picked[0].speed, (this._dvPeak || 0) * 0.9);
    const s = sev;
    if (s > 3 && this.onCrash) try { this.onCrash(s * 3.6); } catch (e) { }
    if (s > 3 && this.time - this.lastDent > 0.1) {
      this.lastDent = this.time;
      for (const [ii, im] of picked.entries()) {
        const si = ii === 0 ? sev : im.speed; if (si < 3) continue;
        // damage grows faster than the speed: at 100 km/h the front is crushed, at 200 km/h the car folds
        const amount = clamp((si - 2.2) * 0.062 + Math.max(0, si - 14) ** 1.35 * 0.012, 0.03, 1.7);
        const rad = clamp(0.65 + si * 0.055, 0.65, 2.6);
        car.dent(im.point, im.normal, amount, rad, this.r);
        // big hits crumple deeper into the car (a second, tighter, deeper fold)
        if (si > 11) car.dent(im.point.clone().addS(im.normal, 0.25), im.normal, amount * 0.6, rad * 0.55, this.r);
        if (si > 17) { car.dent(im.point.clone().addS(im.normal, 0.5), im.normal, amount * 0.45, rad * 0.4, this.r); this.fx.sparkBurst(im.point, im.normal, si * 1.4); }
        if (si > 28) { car.dent(im.point.clone().addS(im.normal, 0.9), im.normal, amount * 0.5, rad * 0.5, this.r); car.dent(im.point.clone().addS(im.normal, 1.3), im.normal, amount * 0.35, rad * 0.45, this.r); }
        if (si > 40) { car.dent(car.body.pos.clone().addS(im.normal, 0.3), im.normal, amount * 0.35, 2.4, this.r); } // the whole shell bends
        if (si > 5) this.fx.sparkBurst(im.point, im.normal, si);
        this.fx.impactDust(im.point, si);
        // hits near a front wheel knock the steering out of line
        const lp = car.worldToLocal(im.point, new V3());
        if (lp.z > car.def.zMax - 1.4 && Math.abs(lp.x) > car.def.halfWidth - 0.45 && si > 7) car.steerBias = clamp(car.steerBias + Math.sign(lp.x) * -0.012 * (si - 6), -0.12, 0.12);
      }
      const dmg = s < 4 ? 0 : (s - 3) * 4.6 + Math.max(0, s - 20) * 3;
      car.damage = Math.min(100, car.damage + dmg);
      car.engineHealth = clamp(1 - Math.max(0, car.damage - 35) / 100, 0.35, 1);
      this.shake = Math.max(this.shake, clamp(s / 12, 0.15, 1.2));
      if (s > 14) this.hud.toast(car.damage > 80 ? 'السيارة تكسرت!' : 'حادث قوي!', 1200);
      if (this.driftTime > 0.5) { this.hud.driftFail(); this.driftPts = 0; this.driftTime = 0; this.driftCombo = 1; }
    }
    if (s > 2.5 && this.time - this.lastCrashSound > 0.15) { this.lastCrashSound = this.time; this.audio.crash(s); }
  }

  updateEffects(dt) {
    const car = this.car; const b = car.body;
    for (let i = 0; i < car.wheels.length; i++) {
      const w = car.wheels[i];
      if (!w.onGround) { this.fx.wheelTrail(car.key + i, w.contact, UP, 0); continue; }
      const side = new V3(1, 0, 0).applyQ(b.q);
      const onSand = w.tag === 3;
      if (onSand) {
        this.fx.dust(w.contact, b.vel, clamp(car.speed / 10, 0, 1) * 0.9 + w.skid);
        if (car.speed > 12 || w.skid > 0.3) this.fx.dust(w.contact, b.vel, 0.6);
        if (w.slipLong > 0.05) { const bk = car.forward(new V3()).scale(-Math.sign(w.spinVel || 1)); this.fx.sandRoost(w.contact, bk, b.vel, clamp(w.slipLong * 1.4 + (car.throttle > 0.5 ? 0.2 : 0), 0, 1)); }
        this.fx.wheelTrail(car.key + i, w.contact, side, 0);
        this.fx.rutTrail(car.key + i, w.contact, side, car.speed > 0.8 ? 0.55 + w.skid * 0.45 : 0, 0.3);
      } else this.fx.rutTrail(car.key + i, w.contact, side, 0);
      if (!onSand) {
        this.fx.wheelTrail(car.key + i, w.contact, side, w.skid, 0.27);
        this.fx.tyreSmoke(w.contact, b.vel, w.skid * (w.slipLong > 0.3 ? 1.2 : 1));
      }
    }
    if (car.damage > 55 && Math.random() < (car.damage - 50) / 60) {
      const hood = car.localToWorld(new V3((Math.random() - 0.5) * 0.6, 1.25, car.def.zMax - 0.8), new V3());
      this.fx.smoke.emit(hood, new V3(b.vel.x * 0.3, 1.2, b.vel.z * 0.3), { life: 2.2, size: 0.35, grow: 1.1, color: car.damage > 85 ? [0.25, 0.24, 0.23, 0.55] : [0.8, 0.8, 0.8, 0.35], drag: 1, gravity: 0.6 });
    }
    // body scraping (e.g. sliding on the roof)
    if (car.scrape > 3) { const p = car.body.pos.clone(); p.y = Math.max(p.y - 0.6, 0.1); if (Math.random() < 0.6) this.fx.sparkBurst(p, UP, 3); }
    this.fx.update(dt);
  }

  updateScore(dt) {
    const car = this.car;
    const a = Math.abs(car.driftAngle);
    const ok = this.playerMode === 'car' && car.grounded >= 2 && car.speed > 7 && a > 0.32 && a < 1.9;
    if (ok) {
      this.driftTime += dt; this.noDriftT = 0;
      this.driftCombo = 1 + Math.min(4, Math.floor(this.driftTime / 2));
      this.driftPts += car.speed * 3.6 * a * dt * 2.2 * this.driftCombo;
      this.hud.drift(Math.round(this.driftPts), this.driftCombo, a);
    } else if (this.driftTime > 0) {
      this.noDriftT += dt;
      if (this.noDriftT > 0.9) {
        if (this.driftPts > 50) { this.score += Math.round(this.driftPts); this.hud.driftBank(Math.round(this.driftPts)); this.bestDrift = Math.max(this.bestDrift, this.driftPts); if (this.onDrift) try { this.onDrift(Math.round(this.driftPts)); } catch (e) { } }
        else this.hud.drift(0, 1, 0, true);
        this.driftPts = 0; this.driftTime = 0; this.driftCombo = 1;
      }
    }
  }

  resetCar() {
    const car = this.car; car.flooded = false; car.floodMsg = false; car.engineOn = true; const p = car.body.pos.clone();
    const yaw = this.carYaw();
    car.place(p.x, this.world.heightAt(p.x, p.z, p.y + 3) + 0.3, p.z, yaw);
    if (this.playerMode === 'seq') { this.enterSeatNow(); this.seq = null; }
    this.hud.toast('رجّعنا السيارة على كفراتها');
  }

  // tap a place on the big map: jump there (car and driver, or on foot)
  fastTravel(x, z, yaw) {
    if (this.inRoom || this.playerMode === 'ride' || this.seq) return false;
    if (this.drone) this.drone = null;
    const car = this.car;
    if (yaw === undefined) yaw = this.carYaw();
    // stand next to the pad, not on top of the pump/workshop shed
    const off = 7, fx = x - Math.sin(yaw) * off, fz = z - Math.cos(yaw) * off;
    const y = this.world.heightAt(fx, fz, 200);
    if (this.playerMode === 'foot') { this.player.pos.set(fx, y + 0.05, fz); if (this.player.vel) this.player.vel.set(0, 0, 0); }
    else { car.flooded = false; car.place(fx, y + 0.4, fz, yaw); car.body.vel.set(0, 0, 0); car.body.ang.set(0, 0, 0); }
    this.placeCameraBehind(); if (this.playerMode === 'foot') { this.camLook.copy(this.player.pos); }
    return true;
  }

  // ---------------- camera ----------------
  placeCameraBehind() {
    const car = this.car; const f = car.forward(new V3());
    this.camPos.copy(car.body.pos).addS(f, -8).add(new V3(0, 3, 0));
    this.camLook.copy(car.body.pos);
  }
  // drone: free-flying photo camera (the car waits)
  toggleDrone() {
    if (this.drone) { this.drone = null; this.hud.toast('رجعنا للسيارة', 900); return false; }
    const f = new V3().copy(this.camLook).sub(this.camPos); const yaw = Math.atan2(f.x, f.z), pitch = Math.asin(clamp(f.y / (f.len() || 1), -0.9, 0.9));
    this.drone = { pos: this.camPos.clone().add(new V3(0, 1.5, 0)), yaw, pitch };
    this.hud.toast('درون: العصا تطيّرك قدّام وورا ويمين ويسار، ▲▼ فوق وتحت، اسحب الشاشة عشان تلف', 3000); return true;
  }
  droneCam(dt) {
    const inp = this.input, D = this.drone, cam = this.cam;
    if (inp.camDX || inp.camDY) { D.yaw -= inp.camDX * 0.005; D.pitch = clamp(D.pitch - inp.camDY * 0.004, -1.35, 1.2); inp.camDX = 0; inp.camDY = 0; }
    // drone controls: stick = fly forward/back/sideways (level), ▲▼ = up/down, swipe = look around
    const dir = new V3(Math.sin(D.yaw) * Math.cos(D.pitch), Math.sin(D.pitch), Math.cos(D.yaw) * Math.cos(D.pitch));
    const fwd = new V3(Math.sin(D.yaw), 0, Math.cos(D.yaw)), right = new V3(-Math.cos(D.yaw), 0, Math.sin(D.yaw));
    const mv = new V3().addS(fwd, inp.moveY || 0).addS(right, inp.moveX || 0).addS(new V3(0, 1, 0), (inp.droneUp || 0) - (inp.droneDown || 0));
    if (inp.keys && (inp.keys.has('KeyE') || inp.keys.has('KeyQ'))) mv.y += (inp.keys.has('KeyE') ? 1 : 0) - (inp.keys.has('KeyQ') ? 1 : 0);
    D.vel = (D.vel || new V3()); D.vel.lerp(mv.scale(16), 1 - Math.exp(-dt * 4)); D.pos.addS(D.vel, dt);
    const g = this.world.heightAt(D.pos.x, D.pos.z, D.pos.y + 50); if (D.pos.y < g + 0.6) D.pos.y = g + 0.6; if (D.pos.y > 300) D.pos.y = 300;
    const c = this.car.body.pos; const off = D.pos.clone().sub(c); if (off.len() > 400) D.pos.copy(c).addS(off.norm(), 400);
    this.camPos.copy(D.pos); this.camLook.copy(D.pos).add(dir);
    cam.pos.copy(this.camPos); cam.target.copy(this.camLook); cam.near = 0.15; cam.up.set(0, 1, 0);
  }
  updateCamera(dt) {
    const inp = this.input, cam = this.cam, car = this.ride ? this.ride.car : this.car;
    if (this.drone) { this.droneCam(dt); return; }
    if (this.debugCam) { const D = this.debugCam, c = car.body.pos; cam.pos.copy(car.localToWorld(new V3(...D.pos), new V3())); cam.target.copy(car.localToWorld(new V3(...D.target), new V3())); cam.up.set(0, 1, 0); cam.near = 0.1; cam.fov = 50 * Math.PI / 180; this.camPos.copy(cam.pos); this.camLook.copy(cam.target); return; } // test shots
    // user orbit drag
    if (inp.camDX || inp.camDY) {
      const inCab = this.camMode === 3 && this.playerMode === 'car', sg = inCab ? -1 : 1; // inside: swipe right = look right, swipe down = look down
      this.camYawOff -= sg * inp.camDX * 0.006; this.camPitchOff = clamp(this.camPitchOff + sg * inp.camDY * 0.004, -0.3, 0.9);
      inp.camDX = 0; inp.camDY = 0; this.camIdle = 0;
    } else this.camIdle += dt;
    if (!inp.camDragging && this.camIdle > 1.6 && (this.playerMode === 'car' || this.playerMode === 'seq')) {
      this.camYawOff *= Math.exp(-dt * 1.8); this.camPitchOff *= Math.exp(-dt * 1.8);
    }
    let target, desired;
    if (this.playerMode === 'foot') {
      const p = this.player;
      target = p.pos.clone().add(new V3(0, 1.55, 0));
      const yaw = (this.footYaw ?? p.yaw);
      // follow behind the player when moving
      const hs = Math.hypot(p.vel.x, p.vel.z);
      if (this.footYaw === undefined) this.footYaw = p.yaw;
      if (hs > 0.5 && this.camIdle > 0.6) this.footYaw = lerpAngle(this.footYaw, p.yaw, 1 - Math.exp(-dt * 1.2));
      const a = this.footYaw + this.camYawOff; const pitch = 0.28 + this.camPitchOff;
      const dist = 4.2;
      desired = target.clone().add(new V3(-Math.sin(a) * Math.cos(pitch) * dist, Math.sin(pitch) * dist, -Math.cos(a) * Math.cos(pitch) * dist));
      { const dir = desired.clone().sub(target); const dl = dir.len(); dir.scale(1 / dl); const hit = this.world.raycast(target, dir, dl, {}); if (hit) desired = target.clone().addS(dir, Math.max(0.15, hit.t - 0.3)); }
      this.camPos.lerp(desired, 1 - Math.exp(-dt * 8));
      this.camLook.lerp(target, 1 - Math.exp(-dt * 12));
      this.clampCam(target);
    } else {
      this.footYaw = undefined;
      const b = car.body; const f = car.forward(new V3()); f.y = 0; f.norm();
      const vflat = new V3(b.vel.x, 0, b.vel.z); const sp = vflat.len();
      let head = f.clone();
      if (sp > 4 && car.forwardSpeed > 0) { vflat.scale(1 / sp); head.lerp(vflat, 0.55).norm(); }
      if (car.reverse && car.forwardSpeed < -2) head = f.clone();
      const baseYaw = Math.atan2(head.x, head.z) + this.camYawOff;
      if (this.camMode === 2) { // hood cam
        const hp = car.localToWorld(new V3(0, 1.55, car.def.zMax - 1.9), new V3());
        const la = car.localToWorld(new V3(0, 1.45, car.def.zMax + 10), new V3());
        this.camPos.copy(hp); this.camLook.copy(la);
      } else if (this.camMode === 3 && this.playerMode === 'car') { // cockpit: driver's eyes, hands on the wheel in view
        this.cockpitCam(dt);
      } else {
        const cp = this.chaseParams(this.camMode === 3 ? 0 : this.camMode);
        const dist = cp.dist + Math.min(sp, 40) * 0.035;
        const h = cp.h + this.camPitchOff * 4;
        target = b.pos.clone().add(new V3(0, 1.0, 0));
        desired = target.clone().add(new V3(-Math.sin(baseYaw) * dist, h, -Math.cos(baseYaw) * dist));
        // keep camera out of walls
        const dir = desired.clone().sub(target); const dl = dir.len(); dir.scale(1 / dl);
        const hit = this.world.raycast(target, dir, dl, {});
        if (hit) desired = target.clone().addS(dir, Math.max(0.3, hit.t - 0.4));
        const k = 1 - Math.exp(-dt * (this.camDragging ? 14 : 5));
        if (this.camPos.dist(desired) > 40) this.camPos.copy(desired);
        this.camPos.lerp(desired, k);
        this.camPos.y = Math.max(this.camPos.y, this.world.heightAt(this.camPos.x, this.camPos.z, this.camPos.y + 2) + 0.5);
        this.camLook.lerp(target, 1 - Math.exp(-dt * 14));
        this.clampCam(target);
      }
    }
    cam.pos.copy(this.camPos); cam.target.copy(this.camLook);
    const inside = this.camMode === 3 && this.playerMode === 'car';
    cam.near = inside ? 0.03 : 0.15;
    if (inside) cam.up.copy(this.camUp); else cam.up.set(0, 1, 0);
    if (this.shake > 0) {
      const s = this.shake * 0.25; cam.pos.add(new V3((Math.random() - 0.5) * s, (Math.random() - 0.5) * s, (Math.random() - 0.5) * s));
      this.shake = Math.max(0, this.shake - dt * 2.2);
    }
    const spd = this.playerMode === 'car' ? car.speed : 0;
    cam.fov = smooth(cam.fov, ((inside ? 72 : 58) + Math.min(spd, 45) * (inside ? 0.12 : 0.28)) * Math.PI / 180, 3, dt);
  }
  // never let the (smoothed) camera end up behind a wall: re-cast from the target to the final position
  clampCam(target) {
    const dir = this.camPos.clone().sub(target); const dl = dir.len(); if (dl < 1e-3) return; dir.scale(1 / dl);
    const hit = this.world.raycast(target, dir, dl + 0.3, {});
    if (hit && hit.t < dl + 0.3) this.camPos.copy(target).addS(dir, Math.max(0.12, hit.t - 0.3));
  }
  chaseParams(mode) {
    if (mode === 4 && this.camCustom) return this.camCustom;
    return mode === 1 ? { dist: 10, h: 3.4 } : { dist: 6.3, h: 2.2 };
  }
  // eyes of the seated driver; view follows the car's roll/pitch with a little lag + head sway from g-forces
  cockpitCam(dt) {
    this.camYawOff = clamp(this.camYawOff, -1.25, 1.25); this.camPitchOff = clamp(this.camPitchOff, -0.3, 0.35); // can't turn your head into your own shoulders
    const car = this.car, p = this.player, hb = p.bones.head;
    // head position in car space (both matrices from the same frame, so no lag at speed)
    if (!this._inv) this._inv = M4.create();
    M4.invert(this._inv, car.node.world);
    const hl = new V3(hb.world[12], hb.world[13], hb.world[14]).applyM4(this._inv);
    if (!isFinite(hl.x) || hl.len() > 4) hl.set(car.seatPos.x, car.seatPos.y + 0.7, car.seatPos.z);
    this.headLocal = this.headLocal ? this.headLocal.lerp(hl, 0.5) : hl;
    const f = car.forward(new V3()), up = new V3(0, 1, 0).applyQ(car.body.q), right = new V3(1, 0, 0).applyQ(car.body.q);
    const b = car.body;
    // lateral / longitudinal g push the head (weight feel)
    const acc = this.prevVel ? b.vel.clone().sub(this.prevVel).scale(1 / Math.max(dt, 1e-3)) : new V3();
    this.prevVel = b.vel.clone();
    const lat = clamp(acc.dot(right) / 9.81, -1.5, 1.5), lon = clamp(acc.dot(f) / 9.81, -1.5, 1.5);
    this.headSway = this.headSway || new V3();
    this.headSway.lerp(new V3(-lat * 0.045, 0, -lon * 0.03), 1 - Math.exp(-dt * 6));
    const el = this.headLocal.clone().add(new V3(this.headSway.x, 0.0, 0.1 + this.headSway.z));
    const eye = car.localToWorld(el, new V3());
    const yaw = this.camYawOff + car.steer * 0.12;
    const look = f.clone().scale(Math.cos(yaw)).addS(right, -Math.sin(yaw)).addS(up, -0.3 + this.camPitchOff * 0.5);
    this.camPos.copy(eye); this.camLook.copy(eye).addS(look, 10);
    this.camUp = this.camUp || new V3(0, 1, 0);
    this.camUp.lerp(up, 1 - Math.exp(-dt * 10)).norm();
  }
  // editor preview: fixed chase view behind the parked/paused car
  editorCamera(params) {
    const car = this.car, cam = this.cam; const f = car.forward(new V3()); f.y = 0; f.norm();
    const t = car.body.pos.clone().add(new V3(0, 1.0, 0));
    if (params.mode === 2) { cam.pos.copy(car.localToWorld(new V3(0, 1.55, car.def.zMax - 1.9), new V3())); cam.target.copy(car.localToWorld(new V3(0, 1.45, car.def.zMax + 10), new V3())); }
    else if (params.mode === 3) { cam.pos.copy(car.localToWorld(new V3(car.seatPos.x, car.seatPos.y + 0.72, car.seatPos.z + 0.1), new V3())); cam.target.copy(cam.pos).addS(f, 10).add(new V3(0, -1.2, 0)); }
    else { const p = params.mode === 4 ? params : this.chaseParams(params.mode); cam.pos.copy(t).addS(f, -p.dist).add(new V3(0, p.h, 0)); cam.target.copy(t); }
    cam.up.set(0, 1, 0); cam.near = params.mode === 3 ? 0.03 : 0.15; cam.fov = 58 * Math.PI / 180;
    this.r.shadowFocus.copy(car.body.pos);
  }
  updateSaher(dt) {
    const S = this.map.saher; if (!S || this.playerMode !== 'car') return;
    const car = this.car, kmh = Math.abs(car.forwardSpeed) * 3.6;
    this.saherCool = Math.max(0, (this.saherCool || 0) - dt);
    for (const s of S) {
      const dx = s.x - car.body.pos.x, dz = s.z - car.body.pos.z;
      if (dx * dx + dz * dz < 28 * 28 && kmh > 120 && !this.saherCool) {
        this.saherCool = 6; this.hud.flash && this.hud.flash();
        const fine = kmh > 170 ? 'مخالفة ٩٠٠ ريال' : kmh > 150 ? 'مخالفة ٥٠٠ ريال' : 'مخالفة ٣٠٠ ريال';
        this.hud.toast('📸 ساهر صوّرك! ' + Math.round(kmh).toLocaleString('ar-SA') + ' كم/س — ' + fine, 2600);
        if (this.audio.ctx) this.audio.burst({ freq: 3200, dur: 0.05, gain: 0.25 });
      }
    }
  }

  // ---- character select: the chosen character stands in the showroom, playing its animation
  // the animated character: its own copy of the model, driven by the SAME procedural poses as the base man (sit, drive,
  // doors, kick...) with its walk clip blended in while walking
  makeHeroChar() {
    const src = this.assets.hero; if (!src) return null;
    const inner = cloneCharacter(src.root), wrap = new Node('heroModel'); wrap.add(inner);
    wrap.updateWorld(null); let y0 = 1e9, y1 = -1e9, sk = null; inner.traverse(n => { if (n.skin) sk = n.skin; });
    if (sk) for (const jn of sk.joints) { y0 = Math.min(y0, jn.world[13]); y1 = Math.max(y1, jn.world[13]); }
    y1 += (y1 - y0) * 0.07; const h = y1 - y0; const k = h > 0.1 && h < 50 ? 1.76 / h : 1; wrap.scl.set(k, k, k); wrap.pos.set(0, -y0 * k, 0);
    const ch = new Character(wrap, CC_MAP);
    if (src.animations && src.animations[0]) ch.setClip(src.animations[0], inner.userData.cloneMap);
    ch.isHero = true; ch.clipT = 0;
    return ch;
  }
  // draw the animated character once off screen so its shaders are ready before you pick it (no freeze on first use)
  prewarmHero() {
    const h = this.heroChar(); if (!h || h.warm) return; h.warm = true;
    try { const t = this._warmT || (this._warmT = this.r.makeTarget(64, 64)); const tmp = new Node('warm'); const par = h.root.parent; if (par) par.remove(h.root); tmp.add(h.root);
      h.applyPoseClip(h.poseIdle(0), 0, 1); tmp.updateWorld(); const cam = new Camera(); cam.pos.set(0, 1, 3); cam.target.set(0, 1, 0); this.r.render([tmp], cam, { target: t }); tmp.remove(h.root); if (par) par.add(h.root); } catch (e) { console.warn(e); }
  }
