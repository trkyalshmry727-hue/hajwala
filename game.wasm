class SkidMarks {
  constructor(r, maxSeg = 3000, color = [0.05, 0.05, 0.05, 0.8]) {
    this.color = color; this.r = r; this.max = maxSeg; this.head = 0; this.count = 0;
    this.data = new Float32Array(maxSeg * 6 * 4); // 6 verts per segment, xyz + alpha
    const gl = r.gl;
    this.vao = gl.createVertexArray(); gl.bindVertexArray(this.vao);
    this.buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, this.buf);
    gl.bufferData(gl.ARRAY_BUFFER, this.data.byteLength, gl.DYNAMIC_DRAW);
    gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 16, 0);
    gl.enableVertexAttribArray(1); gl.vertexAttribPointer(1, 1, gl.FLOAT, false, 16, 12);
    gl.bindVertexArray(null);
    this.dirtyFrom = -1; this.dirtyTo = -1;
  }
  add(a0, a1, b0, b1, alphaA, alphaB) {
    const i = this.head; const D = this.data; let o = i * 24;
    const put = (p, al) => { D[o++] = p.x; D[o++] = p.y; D[o++] = p.z; D[o++] = al; };
    put(a0, alphaA); put(b0, alphaB); put(b1, alphaB); put(a0, alphaA); put(b1, alphaB); put(a1, alphaA);
    const gl = this.r.gl; gl.bindBuffer(gl.ARRAY_BUFFER, this.buf); gl.bufferSubData(gl.ARRAY_BUFFER, i * 96, D, i * 24, 24);
    this.head = (this.head + 1) % this.max; this.count = Math.min(this.count + 1, this.max);
  }
  clear() { this.count = 0; this.head = 0; }
  draw(cam) {
    if (!this.count) return;
    const r = this.r, gl = r.gl; const p = r.program(S.DECAL_VS, S.DECAL_FS, []);
    gl.useProgram(p.prog); r.setEnvUniforms(p.u, cam);
    gl.uniformMatrix4fv(p.u.uVP, false, cam.vp); gl.uniform4f(p.u.uColor, ...this.color);
    gl.enable(gl.BLEND); gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ZERO, gl.ONE);
    gl.depthMask(false); gl.enable(gl.POLYGON_OFFSET_FILL); gl.polygonOffset(-2, -4); gl.disable(gl.CULL_FACE);
    gl.bindVertexArray(this.vao); gl.drawArrays(gl.TRIANGLES, 0, this.count * 6);
    gl.disable(gl.POLYGON_OFFSET_FILL); gl.depthMask(true); gl.bindVertexArray(null);
  }
}

class FX {
  constructor(r) {
    this.r = r;
    const gl = r.gl;
    this.smoke = new ParticlePool(r, 360, false, makeSmokeTexture(gl));
    this.sparks = new ParticlePool(r, 300, true, makeSparkTexture(gl));
    this.shards = new ParticlePool(r, 420, false, makeShardTexture(gl));   // broken glass and paint chips (they stay on the road a while)
    this.fire = new ParticlePool(r, 160, true, makeSmokeTexture(gl));      // engine fire
    this.skids = new SkidMarks(r);
    this.ruts = new SkidMarks(r, 4000, [0.62, 0.42, 0.26, 0.55]);
    this.rutTrails = new Map();
    this.camRight = new V3(); this.camUp = new V3();
    this.trails = new Map();
    r.custom.push((rr, cam, pass) => {
      const v = cam.view; this.camRight.set(v[0], v[4], v[8]); this.camUp.set(v[1], v[5], v[9]);
      if (pass === 'opaque') { this.skids.draw(cam); this.ruts.draw(cam); }
      else { this.shards.draw(cam, this.camRight, this.camUp); this.smoke.draw(cam, this.camRight, this.camUp); this.fire.draw(cam, this.camRight, this.camUp); this.sparks.draw(cam, this.camRight, this.camUp); }
    });
  }
  update(dt) { this.smoke.update(dt); this.sparks.update(dt); this.shards.update(dt); this.fire.update(dt); }

  rutTrail(key, contact, sideDir, intensity, width = 0.3) { return this.wheelTrail(key, contact, sideDir, intensity, width, this.ruts, this.rutTrails); }
  // per wheel skid trail
  wheelTrail(key, contact, sideDir, intensity, width = 0.26, sys = this.skids, trails = this.trails) {
    let t = trails.get(key);
    const on = intensity > 0.12;
    if (!on) { if (t) t.active = false; return; }
    const a = contact.clone(); a.y += 0.025;
    const l = new V3().copy(a).addS(sideDir, width / 2), rr = new V3().copy(a).addS(sideDir, -width / 2);
    if (t && t.active && t.last.dist(a) < 3) {
      if (t.last.dist(a) > 0.25) {
        sys.add(t.l, t.r, l, rr, t.alpha, Math.min(1, intensity * 1.2));
        t.last = a; t.l = l; t.r = rr; t.alpha = Math.min(1, intensity * 1.2);
      }
    } else { trails.set(key, { last: a, l, r: rr, alpha: Math.min(1, intensity), active: true }); }
  }
  tyreSmoke(pos, carVel, intensity) {
    if (intensity < 0.1) return;
    const n = Math.random() < intensity * 1.2 ? (intensity > 0.6 ? 2 : 1) : 0;
    for (let i = 0; i < n; i++) {
      const v = new V3(carVel.x * 0.25 + (Math.random() - 0.5) * 1.5, 0.6 + Math.random() * 0.9, carVel.z * 0.25 + (Math.random() - 0.5) * 1.5);
      const p = pos.clone(); p.y += 0.25;
      const g = 0.72 + Math.random() * 0.12;
      this.smoke.emit(p, v, { life: 1.8 + Math.random() * 1.2, size: 0.55 + Math.random() * 0.3, grow: 0.9 + intensity * 0.7, color: [g, g, g * 0.98, 0.42 * Math.min(1, intensity + 0.2)], drag: 1.2, gravity: 0.25 });
    }
  }
  dust(pos, carVel, intensity) {
    if (Math.random() > intensity) return;
    const v = new V3(carVel.x * 0.2 + (Math.random() - 0.5), 0.5 + Math.random() * 0.6, carVel.z * 0.2 + (Math.random() - 0.5));
    this.smoke.emit(pos.clone(), v, { life: 2.0, size: 0.6, grow: 1.2, color: [0.78, 0.66, 0.5, 0.45], drag: 1.0, gravity: 0.1 });
  }
  // a spinning tyre in sand throws a rooster tail of sand backwards (heavy grains that fall) plus a light dust cloud
  sandRoost(pos, back, carVel, intensity) {
    const n = Math.random() < intensity ? 1 + (intensity > 0.6 ? 2 : 0) : 0;
    for (let i = 0; i < n; i++) {
      const sp = 3 + intensity * 7 * (0.6 + Math.random() * 0.6);
      const v = new V3(carVel.x * 0.5 + back.x * sp + (Math.random() - 0.5) * 1.6, 1.5 + Math.random() * 2.5 * intensity, carVel.z * 0.5 + back.z * sp + (Math.random() - 0.5) * 1.6);
      const p = pos.clone(); p.y += 0.1;
      const g = 0.85 + Math.random() * 0.1;
      this.smoke.emit(p, v, { life: 0.8 + Math.random() * 0.5, size: 0.14 + Math.random() * 0.12, grow: 0.6, color: [0.78 * g, 0.64 * g, 0.44 * g, 0.9], drag: 0.6, gravity: -9 });
    }
    if (Math.random() < intensity * 0.8) {
      const v = new V3(carVel.x * 0.3 + back.x * 2 + (Math.random() - 0.5), 0.8 + Math.random() * 0.8, carVel.z * 0.3 + back.z * 2 + (Math.random() - 0.5));
      this.smoke.emit(pos.clone(), v, { life: 2.6, size: 0.9, grow: 1.5, color: [0.8, 0.68, 0.52, 0.5], drag: 1.0, gravity: 0.08 });
    }
  }
  // small stones and gravel flicked up by the tyres on dirt (they bounce and lie on the ground for a while)
  gravel(pos, back, carVel, intensity, col) {
    if (Math.random() > intensity * 0.6) return;
    const n = 1 + (Math.random() < intensity ? 1 : 0), c = col || [0.55, 0.47, 0.38];
    for (let i = 0; i < n; i++) {
      const sp = 2 + Math.random() * 5 * intensity, k = 0.55 + Math.random() * 0.5;
      const v = new V3(carVel.x * 0.4 + back.x * sp + (Math.random() - 0.5) * 2.5, 1 + Math.random() * 2.8 * intensity, carVel.z * 0.4 + back.z * sp + (Math.random() - 0.5) * 2.5);
      this.shards.emit(pos.clone().add(new V3(0, 0.08, 0)), v, { life: 4 + Math.random() * 3, size: 0.025 + Math.random() * 0.045, color: [c[0] * k, c[1] * k, c[2] * k, 1], drag: 0.2, gravity: -9.8, spin: 10, floor: pos.y + 0.01, bounce: 0.25 });
    }
  }
  splash(pos, carVel, intensity) {
    if (Math.random() > intensity) return;
    const v = new V3(carVel.x * 0.3 + (Math.random() - 0.5) * 2.5, 2 + Math.random() * 3 * intensity, carVel.z * 0.3 + (Math.random() - 0.5) * 2.5);
    this.smoke.emit(pos, v, { life: 0.9 + Math.random() * 0.5, size: 0.35, grow: 1.2, color: [0.85, 0.92, 0.95, 0.55], drag: 1.0, gravity: -7 });
  }
  sparkBurst(pos, normal, speed) {
    const n = Math.min(40, 6 + speed * 2) | 0;
    for (let i = 0; i < n; i++) {
      const v = new V3((Math.random() - 0.5) * 6 + normal.x * 3, Math.random() * 4 + 1, (Math.random() - 0.5) * 6 + normal.z * 3);
      this.sparks.emit(pos, v, { life: 0.3 + Math.random() * 0.4, size: 0.05 + Math.random() * 0.05, color: [4, 2.6, 1.2, 1], drag: 0.8, gravity: -9 });
    }
  }
  // a window bursts: a shower of glass splinters that bounce and lie glittering on the road
  glassShatter(pos, dir, carVel, n, floor) {
    for (let i = 0; i < n; i++) {
      const sp = 2 + Math.random() * 6;
      const v = new V3(carVel.x * 0.6 + dir.x * sp + (Math.random() - 0.5) * 5, 1 + Math.random() * 4, carVel.z * 0.6 + dir.z * sp + (Math.random() - 0.5) * 5);
      const g = 0.82 + Math.random() * 0.18;
      this.shards.emit(pos.clone().add(new V3((Math.random() - 0.5) * 0.6, (Math.random() - 0.5) * 0.3, (Math.random() - 0.5) * 0.6)), v,
        { life: 7 + Math.random() * 4, size: 0.05 + Math.random() * 0.08, color: [0.8 * g, 0.9 * g, 0.95 * g, 0.95], drag: 0.25, gravity: -9.8, spin: 18, floor: floor + 0.02, bounce: 0.18 });
    }
  }
  // paint and plastic chips knocked off the body
  chips(pos, dir, carVel, n, color, floor) {
    for (let i = 0; i < n; i++) {
      const sp = 1.5 + Math.random() * 5, k = 0.7 + Math.random() * 0.3;
      const v = new V3(carVel.x * 0.5 + dir.x * sp + (Math.random() - 0.5) * 4, 1.5 + Math.random() * 3.5, carVel.z * 0.5 + dir.z * sp + (Math.random() - 0.5) * 4);
      const c = Math.random() < 0.35 ? [0.05, 0.05, 0.05, 1] : [color[0] * k, color[1] * k, color[2] * k, 1];
      this.shards.emit(pos.clone(), v, { life: 8 + Math.random() * 4, size: 0.07 + Math.random() * 0.12, color: c, drag: 0.3, gravity: -9.8, spin: 14, floor: floor + 0.02, bounce: 0.2 });
    }
  }
  // the engine on fire: flames licking out of the bonnet and thick black smoke
  engineFire(pos, carVel, k) {
    if (Math.random() < 0.9 * k) {
      const v = new V3(carVel.x * 0.4 + (Math.random() - 0.5) * 0.8, 1.5 + Math.random() * 1.5, carVel.z * 0.4 + (Math.random() - 0.5) * 0.8);
      this.fire.emit(pos.clone().add(new V3((Math.random() - 0.5) * 0.7, 0, (Math.random() - 0.5) * 0.5)), v, { life: 0.55 + Math.random() * 0.45, size: 0.4 + Math.random() * 0.3, grow: -0.3, color: [1.5, 0.38 + Math.random() * 0.25, 0.04, 1], drag: 1.5, gravity: 2.5, spin: 3 });
    }
    if (Math.random() < 0.7 * k) {
      const v = new V3(carVel.x * 0.3 + (Math.random() - 0.5) * 0.6, 1.6 + Math.random(), carVel.z * 0.3 + (Math.random() - 0.5) * 0.6);
      const g = 0.06 + Math.random() * 0.06;
      this.smoke.emit(pos.clone().add(new V3(0, 0.5, 0)), v, { life: 3 + Math.random() * 1.5, size: 0.5, grow: 1.4, color: [g, g, g, 0.75], drag: 0.8, gravity: 0.8 });
    }
  }
  // a big crash: a flash of flame, a burst of black smoke and a fountain of sparks at the point of impact
  impactBlast(pos, dir, carVel, k) {
    const n = Math.min(14, 4 + k * 8) | 0;
    for (let i = 0; i < n; i++) {
      const v = new V3(carVel.x * 0.3 + dir.x * 2 + (Math.random() - 0.5) * 4, 1 + Math.random() * 3, carVel.z * 0.3 + dir.z * 2 + (Math.random() - 0.5) * 4);
      this.fire.emit(pos.clone().add(new V3((Math.random() - 0.5) * 0.8, Math.random() * 0.5, (Math.random() - 0.5) * 0.8)), v, { life: 0.35 + Math.random() * 0.3, size: 0.7 + Math.random() * 0.6 * k, grow: 1.5, color: [1.8, 0.6 + Math.random() * 0.3, 0.08, 1], drag: 2.5, gravity: 2, spin: 2 });
