  bindTap($('slowBtn'), () => { game.slowManual = !game.slowManual; $('slowBtn').classList.toggle('on', game.slowManual); hud.toast(game.slowManual ? '🐢 بطيء' : 'رجعت السرعة العادية', 1000); });
