  // ---------------- entry test: the highway, 120 km/h, then drift ----------------
  async startTest() {
    this.closeScreen(); if (this.d.handling && this.api.setHandling) this.api.setHandling(this.d.handling);
    this.on = false; this.g.event = this;
    try { await this.api.enter('highway'); } catch (e) { this.g.event = null; this.api.hud.toast('ما قدرنا نفتح الخط السريع', 2000); return; }
    this.reset(); this.on = true; this.mode = 'test'; this.stage = 'speed'; this.drift = 0; this.g.event = this; this.ui();
    this.banner(this.d.canDrift === false ? '🏁 اختبار القبول: دوس بنزين لين توصل ١٢٠ كم/س' : '🏁 اختبار القبول: امش بسرعة ١٢٠ كم/س');
    this.say('اختبار القبول. امش بسرعة مية وعشرين، وبعدين فحّط.');
  }
  // ---------------- entering a hajwala ----------------
  async enter(ev) {
    this.closeScreen(); const g = this.g;
    if (ev.role === 'drifter' && this.d.handling && this.api.setHandling) this.api.setHandling(this.d.handling);
    this.on = false; g.event = this;
    try { await this.api.enter(ev.map); } catch (e) { g.event = null; this.api.hud.toast('ما قدرنا نفتح الماب', 2000); return; }
    this.reset(); this.on = true; this.mode = 'show'; this.ev = ev; this.role = ev.role; g.event = this;
    this.charSel0 = g.charSel; g.charSel = 'base'; try { g.syncCharacter(); } catch (e) { }
    if (g.bots) g.bots.clear();
    { const h = hash(ev.start / 1000 | 0) % 20; this.outcome = ev.role === 'fan' ? (h < 9 ? 'crash' : h < 16 ? 'flip' : 'normal') : 'player'; this.crashPass = (h >> 1) % 2; } // (most hajwalas end badly)
    this.setupRoad(); this.ui(); // (no barrier you can see: an invisible wall keeps you on the spectators' side)
    this.endAt = ev.role === 'fan' ? ev.start + SHOW : 0;
    await this.spawnCrowd();
    if (!this.on) return;
    if (this.role === 'drifter') {
      setLitham(g.baseChar, true);
      // the start: far back from the crowd, so you have the road to build up to 120 before you reach them
      const z0 = this.startZ, car = g.car, cx = this.lo(z0) - 2.6; car.place(cx, this.gy(cx, z0) + 0.3, z0, this.roadYaw(z0, 1)); car.body.vel.set(0, 0, 0);
      this.footAt(cx - 2.2, z0 - 4, Math.PI / 2);
      this.crew = [this.npc(cx - 4.2, z0 - 1, -Math.PI / 2, 'fahad'), this.npc(cx - 3.4, z0 - 7, -Math.PI / 2 + 0.6, 'sattam')];
      this.stage = 'lobby'; this.banner('🧕 روح عند الأشخاص وكلّمهم');
    } else {
      const xs = this.xs(this.zc - 6); const car = g.car, pz = this.myCarZ, px = this.xs(pz) - 5.5; car.place(px, this.gy(px, pz) + 0.3, pz, this.roadYaw(pz, 1)); car.body.vel.set(0, 0, 0);
      this.footAt(xs + 0.5, this.zc - 6, Math.PI / 2);
      this.stage = 'wait';
      const kb = document.getElementById('kickBtn'); if (kb) { this.kickWas = kb.hidden; kb.hidden = true; }
    }
    g.placeCameraBehind && g.placeCameraBehind();
  }
  reset() { this.cleanup(); this.t = 0; this.msgT = 0; this.fans = []; this.fanCars = []; this.crew = []; this.ai = null; this.nodes = []; this.talked = {}; this.flags = {}; }
  // ---------------- the road: from the map's own traffic lanes ----------------
  setupRoad() {
    const g = this.g, m = g.map, all = m.lanes || [], sp = m.spawn || { z: 0 };
    // the main road where you are (a linked map also carries the other cities' short streets)
    const span = l => Math.abs(l.z1 - l.z0), here = all.filter(l => (sp.z || 0) > Math.min(l.z0, l.z1) - 300 && (sp.z || 0) < Math.max(l.z0, l.z1) + 300);
    const long = (here.length ? here : all).filter(l => span(l) > 1200), L = long.length ? long : (here.length ? here : all);
    this.lanes = L;
    const lo = Math.max(...L.map(l => Math.min(l.z0, l.z1))), hi = Math.min(...L.map(l => Math.max(l.z0, l.z1)));
    // the spectators' line (long, along the road) and the drifter's start well back from it
    let line = 340, back = 470; if (hi - lo < 2 * line + back + 260) { line = Math.max(110, (hi - lo - back - 260) / 2); if (hi - lo < 2 * line + back + 260) back = Math.max(220, hi - lo - 2 * line - 260); }
    const a = lo + line + back + 40, b = hi - line - 200;
    let zc = clamp((sp.z || 0) + 160, Math.min(a, b), Math.max(a, b));
    this.cross = (m.name === 'furusiya' || g.mapKey === 'furusiya') ? [-900, 700] : [];
    for (const c of this.cross) if (Math.abs(zc - c) < line + 30) { const up = c + line + 40, dn = c - line - 40; zc = up <= b ? up : dn >= a ? dn : zc; }
    this.zc = zc; this.LINE = line; this.startZ = zc - line - back; this.myCarZ = zc - 48;
  }
  // the spot to keep people around: you (or a little ahead of your car when you're driving)
  focusZ() {
    const g = this.g; if (g.playerMode === 'car' && g.car) { const b = g.car.body; return b.pos.z + clamp(b.vel.z * 2.5, -80, 80); }
    return g.player.pos.z;
  }
  inLine(z) { return Math.abs(z - this.zc) < this.LINE + 12; }
  lanesAt(z) { return this.lanes.filter(l => z > Math.min(l.z0, l.z1) - 60 && z < Math.max(l.z0, l.z1) + 60); }
  lo(z) { let v = 1e9; for (const l of this.lanesAt(z)) v = Math.min(v, l.fx(z)); return v < 1e8 ? v : 0; }
  cw(z, dir) { let s = 0, n = 0; for (const l of this.lanesAt(z)) if (Math.sign(l.dir) === Math.sign(dir)) { s += l.fx(z); n++; } return n ? s / n : this.lo(z) + 3; }
  xb(z) { return this.lo(z) - 4.4; }
  xs(z) { return this.lo(z) - 7; }
  roadYaw(z, dir) { const d = dir >= 0 ? 1 : -1, a = this.cw(z, dir), b = this.cw(z + d * 3, dir); return Math.atan2(b - a, d * 3); }
  gy(x, z) { const rz = this.g.world.heightAt(this.cw(z, 1), z, 60); return this.g.world.heightAt(x, z, rz + 3); }
  buildBarrier() { // (old: a visible barrier; kept for reference, not used)
    const mb = new MB(), red = new MB();
    for (let z = this.zc - 72, i = 0; z < this.zc + 72; z += 3, i++) { const x = this.xb(z + 1.5), y = this.gy(x, z + 1.5); (i % 2 ? red : mb).push().translate(x, y, z + 1.5).rotate(0, 1, 0, this.roadYaw(z, 1)); (i % 2 ? red : mb).box(0, 0.45, 0, 0.45, 0.9, 2.96); (i % 2 ? red : mb).box(0, 0.08, 0, 0.7, 0.16, 2.96); (i % 2 ? red : mb).pop(); }
    const n = new Node('ev_barrier'); n.mesh = { prims: [mb.prim(new Material({ name: 'evBarW', color: [0.9, 0.89, 0.86, 1], roughness: 0.8 })), red.prim(new Material({ name: 'evBarR', color: [0.7, 0.08, 0.06, 1], roughness: 0.7 }))] };
    this.g.scene.add(n); this.nodes.push(n);
  }
  // the player keeps to his side of the barrier (on foot)
  clampFoot(pos) {
    if (!this.on || this.mode !== 'show' || !this.zc) return; if (this.flags.flipped || this.flags.hit || this.police) return; // (chaos: people jump the barrier)
    const z = pos.z; if (!this.inLine(z)) { this.side = null; return; }
    const xb = this.xb(z); if (this.side === undefined || this.side === null) this.side = pos.x < xb ? -1 : 1;
    if (this.side < 0 && pos.x > xb - 0.45) pos.x = xb - 0.45; else if (this.side > 0 && pos.x < xb + 0.45) pos.x = xb + 0.45;
  }
  footAt(x, z, yaw) {
    const g = this.g, p = g.player; if (p.root.parent) p.root.parent.remove(p.root); g.scene.add(p.root); p.root.scl.set(1, 1, 1);
    p.pos.set(x, this.gy(x, z), z); p.yaw = yaw; p.vel.set(0, 0, 0); g.playerMode = 'foot'; g.seq = null; g.wantExit = false; p.setTransform(p.pos, p.yaw); g.car.engineOn = true; g.camYawOff = 0; this.side = null;
  }
  // ---------------- people and cars ----------------
  person(x, z, yaw) {
    const g = this.g, c = new Character(cloneCharacter(g.manSrc)); c.pos.set(x, this.gy(x, z), z); c.yaw = yaw; c.t = Math.random() * 10; c.mv = 0; c.walkBlend = 0; c.phase = 0;
    c.setTransform(c.pos, c.yaw); g.scene.add(c.root); this.nodes.push(c.root); return c;
  }
  npc(x, z, yaw, talk) { const c = this.person(x, z, yaw); c.talk = talk; c.home = { x, z, yaw }; return c; }
  async loadCar(k) { const g = this.g; try { if (!g.pristine[k] && g.ensureCar) await g.ensureCar(k); } catch (e) { } return g.pristine[k] || null; }
  makeCar(k, src, x, z, yaw, paint) {
    const g = this.g, car = new Car(CAR_DEFS[k], cloneModel(src), g.world); car.key = k + '_ev'; if (g.assets.plate) car.addPlates(g.assets.plate); car.snapshotNormals(); car.setNight(!!g.night);
    if (paint) try { car.model.traverse(n => { if (n.mesh) for (const p of n.mesh.prims) { const m = p.material; if (m && m.carPaint) p.material = Object.assign(Object.create(Object.getPrototypeOf(m)), m, { color: [...paint, 1] }); } }); } catch (e) { }
    car.place(x, this.gy(x, z) + 0.3, z, yaw); g.scene.add(car.node); this.nodes.push(car.node); return car;
  }
  async spawnCrowd() {
    const g = this.g; g.botKeys = new Set([...(g.botKeys || []), ...FAN_CARS]);
    const srcs = []; for (const k of FAN_CARS) { const s = await this.loadCar(k); if (s) srcs.push([k, s]); if (!this.on) return; }
    const COL = [[0.92, 0.92, 0.9], [0.1, 0.1, 0.11], [0.62, 0.64, 0.66], [0.55, 0.08, 0.06], [0.85, 0.82, 0.74], [0.08, 0.2, 0.45]];
    const Lz = this.LINE, nearX = (z) => this.cross.some(c => Math.abs(z - c) < 26);
    // spots along the whole line: groups of 1–4 people with gaps, and a parked car every ~38 m behind them
    this.slots = []; for (let z = this.zc - Lz; z < this.zc + Lz;) { const n = 1 + Math.floor(Math.random() * 4);
      for (let i = 0; i < n && z < this.zc + Lz; i++, z += 1.1 + Math.random() * 0.6) { if (nearX(z)) continue; if (this.role === 'fan' && Math.abs(z - (this.zc - 6)) < 1.6) continue;
        this.slots.push({ z, dx: 0.6 + (Math.random() - 0.5) * 1.4, yaw: Math.PI / 2 + (Math.random() - 0.5) * 0.5, used: null }); }
      z += 3 + Math.random() * 6; }
    this.carSlots = []; for (let z = this.zc - Lz + 14; z < this.zc + Lz; z += 38) { if (nearX(z) || (this.role === 'fan' && Math.abs(z - this.myCarZ) < 14)) continue; this.carSlots.push({ z, used: null }); }
    const f0 = this.role === 'fan' ? this.zc - 6 : this.zc - Lz;
    const near = (list, n, fz) => list.map((s, i) => [Math.abs(s.z - fz), i]).sort((a, b) => a[0] - b[0]).slice(0, n).map(a => a[1]);
    let ci = 0; for (const i of near(this.carSlots, CAR_POOL, f0)) { if (!srcs.length) break; const S = this.carSlots[i], x = this.xs(S.z) - 5.5; const [k, s] = srcs[ci % srcs.length];
      const car = this.makeCar(k, s, x, S.z, this.roadYaw(S.z, 1), COL[ci % COL.length]); ci++; const F = { car, k, fans: [], gone: false, driver: null, slot: i }; S.used = F; this.fanCars.push(F); }
    for (const i of near(this.slots, Math.min(POOL, this.slots.length), f0)) { const S = this.slots[i], x = this.xs(S.z) + S.dx;
      const c = this.person(x, S.z, S.yaw); c.fan = true; c.state = 'watch'; c.slot = i; c.homeX = x; c.homeZ = S.z; S.used = c; this.fans.push(c); }
    this.poolT = 0;
    if (this.role === 'fan') { // the drifter's car, parked out of sight at the start of the run
      const k = this.ev.car && CAR_DEFS[this.ev.car] ? this.ev.car : 'caprice'; let s = await this.loadCar(k), kk = k; if (!s) { kk = 'avanza'; s = await this.loadCar(kk); } if (!s || !this.on) return;
      const z = this.zc - Lz - 200, x = this.cw(z, 1); const car = this.makeCar(kk, s, x, z, this.roadYaw(z, 1));
      const man = this.person(0, 0, 0); setLitham(man, true); this.nodes.splice(this.nodes.indexOf(man.root), 1); g.scene.remove(man.root); car.node.add(man.root); man.root.pos.copy(g.seatRoot(car)); man.root.rot.identity(); man.applyPose(man.poseDrive(0));
      this.ai = { car, man, dir: 1, state: 'wait', pass: 0, sw: 0, t: 0 };
    }
  }
  // the people (and parked cars) follow you along the line: the ones far behind move up ahead, out of sight
  updatePool(dt) {
    if (!this.slots || (this.poolT -= dt) > 0) return; this.poolT = 0.35;
    if (this.flags.hit || this.flags.flipped || this.police) return; // (chaos: everyone stays where they are)
    const fz = this.focusZ(), want = (list, n) => new Set(list.map((s, i) => [Math.abs(s.z - fz), i]).sort((a, b) => a[0] - b[0]).slice(0, n).map(a => a[1]));
    const W = want(this.slots, this.fans.length), free = [...W].filter(i => !this.slots[i].used).sort((a, b) => Math.abs(this.slots[a].z - fz) - Math.abs(this.slots[b].z - fz));
    if (free.length) { const mv = this.fans.filter(c => c.state === 'watch' && !c.fly && !c.lying && !c.inCar && c.root.visible && !W.has(c.slot) && Math.abs(c.pos.z - fz) > 60).sort((a, b) => Math.abs(b.pos.z - fz) - Math.abs(a.pos.z - fz));
      for (const c of mv) { const i = free.shift(); if (i === undefined) break; const S = this.slots[i], x = this.xs(S.z) + S.dx; if (this.slots[c.slot]) this.slots[c.slot].used = null;
        S.used = c; c.slot = i; c.pos.set(x, this.gy(x, S.z), S.z); c.yaw = S.yaw; c.homeX = x; c.homeZ = S.z; c.cheerW = 0; c.setTransform(c.pos, c.yaw); } }
    const WC = want(this.carSlots, this.fanCars.length), freeC = [...WC].filter(i => !this.carSlots[i].used);
    for (const F of this.fanCars) { if (!freeC.length) break; if (F.leaving || F.gone || WC.has(F.slot) || Math.abs(F.car.body.pos.z - fz) < 70) continue;
      const i = freeC.shift(), S = this.carSlots[i], x = this.xs(S.z) - 5.5; if (this.carSlots[F.slot]) this.carSlots[F.slot].used = null; S.used = F; F.slot = i;
      F.car.place(x, this.gy(x, S.z) + 0.3, S.z, this.roadYaw(S.z, 1)); F.car.body.vel.set(0, 0, 0); }
  }
  // the nearest parked supporters' car (to run to when it goes wrong)
  carNear(c) { let best = null, bd = 55; for (const F of this.fanCars) { if (F.gone || F.leaving) continue; const d = F.car.body.pos.dist(c.pos); if (d < bd) { bd = d; best = F; } } return best; }
  // ---------------- per frame ----------------
  update(dt) {
    if (!this.on) return; const g = this.g, now = Date.now(); this.t += dt;
    if (this.mode === 'test') return this.updateTest(dt);
    if (this.cheerT > 0) this.cheerT -= dt;
    // people
    this.updatePool(dt);
    for (const c of this.fans) this.updateFan(c, dt);
    for (const c of this.crew) this.updatePerson(c, dt, 'idle');
    if (this.rescued) this.updatePerson(this.rescued, dt, 'idle');
    if (this.ai && this.ai.car.onFire && g.time > this.ai.car.onFire) try { const c = this.ai.car; g.fx.engineFire(c.localToWorld(new V3(0, 0.9, c.def.zMax - 0.8), new V3()), c.body.vel, 0.9); } catch (e) { }
    // hits: the drifting car (yours or the AI's) against the supporters and you
    const dc = this.role === 'fan' ? (this.ai && this.ai.car) : g.car;
    if (dc && (this.role === 'fan' || g.playerMode === 'car')) this.checkHits(dc);
    const left = this.ev.start - now;
    if (this.role === 'fan') this.updateFanRole(dt, left); else this.updateDrifterRole(dt, left);
    this.updatePolice(dt);
    this.updateTimer(now);
    this.updateUI();
  }
  // the countdown at the top: when it starts, then when it ends
  updateTimer(now) {
    let t = '';
    if (this.police || this.flags.end) t = '';
    else if (this.role === 'fan') { if (this.stage === 'wait') t = '⏱ تبدأ الهجولة بعد ' + mmss(this.ev.start - now); else if (!this.flags.hit && !this.flags.flipped) t = '⏱ تنتهي الهجولة بعد ' + mmss(this.endAt - now); }
    else if (this.stage === 'lobby') t = '⏱ تبدأ هجولتك بعد ' + mmss(this.ev.start - now);
    else if (this.stage === 'ride') { const dz = Math.max(0, (this.zc - this.LINE) - this.g.car.body.pos.z); t = '🏁 الجمهور بعد ' + Math.round(dz).toLocaleString('ar-SA') + ' م'; }
    else if (this.stage === 'drift' && this.endAt) t = '⏱ تنتهي الهجولة بعد ' + mmss(this.endAt - now);
    if (this.tmEl) { if (this.tmEl.textContent !== t) this.tmEl.textContent = t; this.tmEl.hidden = !t; }
  }
  fixed(dt) { if (!this.on || this.mode !== 'show') return; if (this.ai) this.stepAI(this.ai, dt); for (const F of this.fanCars) if (F.leaving) this.stepFlee(F, dt); }
  updateFanRole(dt, left) {
    if (this.stage === 'wait') {
      this.banner('🕒 تبدأ هجولة ' + this.ev.name + ' بعد ' + mmss(left) + ' · شجّع مع المعززين');
      if (left <= 0 && this.ai) { this.stage = 'show'; this.ai.state = 'run'; this.banner('🔥 بدت الهجولة! المفحط: ' + this.ev.name); this.say('بدت الهجولة'); this.flash(4); }
    } else if (this.stage === 'show') {
      if (this.ai && this.ai.state === 'done' && !this.flags.end) { this.flags.end = true; this.finish('🏁 خلصت الهجولة على خير — الله يعطيك العافية', 6); }
      if (this.ai && Date.now() > this.endAt + 45000 && !this.flags.end && !this.flags.hit && !this.flags.flipped && !this.police) { this.flags.end = true; this.ai.state = 'stop'; this.finish('🏁 خلصت الهجولة — الله يعطيك العافية', 6); }
      if (!this.msgT) { const near = this.ai && this.ai.car.body.pos.dist(this.g.player.pos) < 60; this.banner(near ? '🔥🔥 ' + this.ev.name + ' يفحط قدامك!' : '🔥 الهجولة شغالة · شجّع!'); }
    }
    // the flipped drifter: pull him out before the police come
    if (this.flags.flipped && !this.rescued && !this.police) {
      const car = this.ai.car, d = car.body.pos.dist(this.g.player.pos), wait = 30 - (this.t - this.flags.flipT);
      this.pullable = this.g.playerMode === 'foot' && d < 4.2;
      if (!this.msgT) this.banner(this.pullable ? '💪 اسحب المفحط! اضغط «اسحب» بسرعة (' + Math.round((this.pull || 0) * 100).toLocaleString('ar-SA') + '٪)' : '🔄 انقلب المفحط! روح ساعده قبل لا تجي الشرطة (' + Math.max(0, Math.ceil(wait)).toLocaleString('ar-SA') + ')');
      if (wait <= 0) this.callPolice('🚓 جات الشرطة! اترك المفحط واركب سيارتك واهرب');
    } else this.pullable = false;
  }
  updateDrifterRole(dt, left) {
    const g = this.g, car = g.car;
    if (this.stage === 'lobby') {
      const c = this.nearTalk(); this.talkable = c && !this.talking ? c : null;
      if (!this.talking && !this.msgT) this.banner(this.talked.fahad ? '🕒 تبدأ هجولتك بعد ' + mmss(left) + (this.talked.sattam ? '' : ' · كلّم سطام بعد') : '🧕 روح عند الأشخاص وكلّمهم (أبو فهد)');
      if (left <= 0) { this.stage = 'ride'; this.closeTalk(); this.banner('🚗 اركب السيارة وامش'); this.say('اركب السيارة وامش'); this.flash(3); }
    } else if (this.stage === 'ride') {
      this.talkable = null;
      const z = car.body.pos.z, kmh = Math.round(Math.abs(car.forwardSpeed) * 3.6);
      if (!this.msgT) this.banner(g.playerMode === 'car' ? '🚗 خذ عزمك! ' + kmh.toLocaleString('ar-SA') + ' كم/س · الجمهور قدام' : '🚗 اركب السيارة وامش');
      if (g.playerMode === 'car' && this.inLine(z + 25)) { this.stage = 'drift'; this.driftStart = this.t; this.endAt = Date.now() + DRIFT_T * 1000; g.score = 0; this.msg('🔥 يالله فحّط الحين يا شنب!', 3); this.say('يالله فحط الحين يا شنب'); this.flash(4); }
    } else if (this.stage === 'drift') {
      const tl = (this.endAt - Date.now()) / 1000;
      if (!this.msgT) this.banner('🔥 فحّط قدام الجمهور · ' + mmss(tl * 1000) + ' · نقاطك ' + Math.round(g.score || 0).toLocaleString('ar-SA'));
      if (car.up(new V3()).y < 0.3) { this.flags.upT = (this.flags.upT || 0) + dt; if (this.flags.upT > 1.5 && !this.flags.flipped) { this.flags.flipped = true; this.flags.flipT = this.t; this.msg('🔄 انقلبت! الشباب جايين يعدّلون سيارتك', 4); for (const c of this.fans.filter(q => q.state === 'watch' && !q.fly && !q.lying).sort((a, b) => a.pos.dist(car.body.pos) - b.pos.dist(car.body.pos)).slice(0, 3)) { c.state = 'help'; c.target = car; } } }
      else this.flags.upT = 0;
      if (this.flags.flipped && this.t - this.flags.flipT > 7 && !this.police) { const p = car.body.pos; car.place(p.x, this.gy(p.x, p.z) + 0.5, p.z, g.carYaw()); this.flags.flipped = false; this.msg('💪 الشباب عدّلوا سيارتك! كمّل', 3); for (const c of this.fans) if (c.state === 'help') c.state = 'back'; }
      if (tl <= 0 && !this.flags.end && !this.police) { this.flags.end = true; this.finish('🏁 هجولة نظيفة! نقاطك ' + Math.round(g.score || 0).toLocaleString('ar-SA') + ' — الجمهور مستانس', 7); }
    }
  }
  // ---------------- the AI drifter ----------------
  stepAI(A, dt) {
    const g = this.g, car = A.car, b = car.body, p = b.pos; A.t += dt;
    if (car.world !== g.world) car.world = g.world;
    const steerTo = (tx, tz, want, hb) => { const loc = car.worldToLocal(new V3(tx, p.y, tz), new V3()).sub(car.com), ang = Math.atan2(loc.x, Math.max(loc.z, 0.5) * (loc.z < 0 ? -1 : 1)); const v = car.forwardSpeed;
      car.step(dt, { throttle: clamp((want - v) * 0.3, 0, 1), brake: v > want + 3 ? clamp((v - want) * 0.12, 0, 1) : 0, steer: clamp(-ang * 2, -1, 1), handbrake: !!hb, surfaceGrip: 1, water: null }); };
    if (A.state === 'wait' || A.state === 'done' || A.state === 'stop') { car.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); car.impacts.length = 0; return; }
    if (A.state === 'flipped' || A.state === 'crashed') { car.step(dt, { throttle: 0, brake: 0.6, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); car.impacts.length = 0;
      if (A.state === 'flipped') { A.ft = (A.ft || 0) + dt; if (A.ft > 2.5 && !A.settled && Math.hypot(b.vel.x, b.vel.z) < 2) { A.settled = true; // (it rolled back onto its wheels: it ends on its roof)
        if (car.up(new V3()).y > 0.3) { const f = car.forward(new V3()), yaw = Math.atan2(f.x, f.z); car.place(p.x, this.gy(p.x, p.z) + 1.7, p.z, yaw); b.q.premul(new Q().setAxisAngle(car.forward(new V3()), Math.PI)); b.updateInertia(); b.vel.set(0, 0, 0); b.ang.set(0, 0, 0); car.syncNode(); } } }
      return; }
    const z = p.z, d = A.dir, inZone = Math.abs(z - this.zc) < this.LINE + 15, fz = clamp(g.player.pos.z, this.zc - this.LINE + 60, this.zc + this.LINE - 60); // (the show happens where you stand)
    if (A.state === 'run' || A.state === 'finish') { // stuck (a kerb, a wall): put it back on its lane
      if (car.speed < 1.5 && A.state === 'run') A.stuck = (A.stuck || 0) + dt; else A.stuck = 0;
      if (A.stuck > 3 || car.up(new V3()).y < 0.3 && A.state === 'run') { const x = this.cw(z, d), yaw = this.roadYaw(z, d); car.place(x, this.gy(x, z) + 0.3, z, yaw); b.vel.set(Math.sin(yaw) * 8, 0, Math.cos(yaw) * 8); A.stuck = 0; }
    }
    if (A.state === 'run') {
      const look = z + d * 22, tx = this.cw(look, d);
      steerTo(tx, look, inZone ? 25 : 31, false);
      if (inZone) this.swing(A, dt, d); else A.sw = 0;
      // what happens this time
      if (this.outcome === 'crash' && A.pass === this.crashPass && d * (z - (fz - d * 50)) > 0 && !this.flags.veer) { // ~50 m before the crowd it loses it towards them
        const ahead = this.fans.filter(c => c.state === 'watch' && d * (c.pos.z - z) > 12 && d * (c.pos.z - z) < 90); ahead.sort((a, b2) => d * (a.pos.z - b2.pos.z));
        if (ahead.length) { this.flags.veer = true; A.state = 'veer'; A.vt = 0; A.target = ahead[0]; } }
      if (this.outcome === 'flip' && A.pass === this.crashPass && d * (z - (fz + 5 * d)) > 0 && !this.flags.flipped) {
        this.flags.flipped = true; this.flags.flipT = this.t; A.state = 'flipped';
        const f = car.forward(new V3()); b.vel.x *= 0.45; b.vel.z *= 0.45; b.vel.y += 5; b.ang.addS(f, (Math.random() < 0.5 ? -1 : 1) * 7.5); g.audio.crash(16); g.shake = Math.max(g.shake || 0, 0.6);
        this.msg('🔄 انقلب المفحط!! بعض الناس راحوا يساعدونه وبعضهم هربوا', 5); this.say('انقلب المفحط');
        let n = 0; for (const c of this.fans.filter(q => q.state === 'watch').sort((a, b2) => a.pos.dist(p) - b2.pos.dist(p))) { if (n++ < 3) { c.state = 'help'; c.target = car; } else if (c.pos.dist(p) < 70) c.state = 'flee'; }
      }
      if (d * (z - (this.zc + d * (this.LINE + 160))) > 0) { A.state = 'turn'; A.turn = 0; }
    } else if (A.state === 'turn') { // far down the road (out of the crowd's sight): slow down and come back on the other side
      const v = Math.hypot(b.vel.x, b.vel.z);
      if (v > 8) car.step(dt, { throttle: 0, brake: 0.9, steer: 0, handbrake: false, surfaceGrip: 1, water: null });
      else { const nd = -d, x = this.cw(z, nd), yaw = this.roadYaw(z, nd); car.place(x, this.gy(x, z) + 0.3, z, yaw); b.vel.set(Math.sin(yaw) * 6, 0, Math.cos(yaw) * 6);
        A.dir = nd; A.pass++; A.stuck = 0; A.state = this.outcome === 'normal' && A.pass >= 2 && this.endAt - Date.now() < 50000 ? 'finish' : 'run'; }
    } else if (A.state === 'finish') { // last pass: slows down and parks in front of the crowd
      const look = z + d * 18, inFront = d * (z - fz) > -30; steerTo(this.cw(look, d), look, inFront ? 0 : inZone ? 14 : 25, false);
      if (inFront && car.speed < 1) A.state = 'done';
    } else if (A.state === 'veer') { // loses it towards the crowd: sliding sideways straight at them
      A.vt += dt; const T = A.target; if (T) steerTo(T.pos.x, T.pos.z, 20, false); else A.state = 'crashed';
      if (T) { const dx = T.pos.x - p.x, dz = T.pos.z - p.z, dl = Math.hypot(dx, dz) || 1, sp = Math.max(15, Math.hypot(b.vel.x, b.vel.z)), k = 1 - Math.exp(-dt * 4);
        b.vel.x = lerp(b.vel.x, dx / dl * sp, k); b.vel.z = lerp(b.vel.z, dz / dl * sp, k); b.ang.y = clamp(b.ang.y + dt * 3 * d, -2.5, 2.5); }
      if (A.vt > 3.5 || (this.flags.hit && A.vt > 1.2)) { A.state = 'crashed'; car.onFire = Math.random() < 0.4 ? g.time + 1 : 0; if (!this.flags.hit) { this.flags.hit = true; this.disaster('🚨 المفحط فقد السيطرة وطلع على الناس! اركب سيارتك واهرب'); } }
    }
    car.impacts.length = 0;
  }
  // hajwala: the tail swings out left and right while the car keeps travelling down the road
  swing(A, dt, d, amp = 0.62) {
    const car = A.car, b = car.body; A.sw = (A.sw || 0) + dt * Math.PI * 2 / 2.5; const a = amp * Math.sin(A.sw);
    const ry = this.roadYaw(b.pos.z, d), want = ry + a, f = car.forward(new V3()), cur = Math.atan2(f.x, f.z);
    b.ang.y = clamp(angleWrap(want - cur) * 5, -2.6, 2.6);
    const sp = Math.max(17, Math.hypot(b.vel.x, b.vel.z)), cx = this.cw(b.pos.z, d), corr = clamp((cx - b.pos.x) * 0.6, -3, 3);
    const k = 1 - Math.exp(-dt * 3); b.vel.x = lerp(b.vel.x, Math.sin(ry) * sp + corr, k); b.vel.z = lerp(b.vel.z, Math.cos(ry) * sp, k);
    const s = Math.abs(Math.sin(A.sw)); if (s > 0.25) { const side = new V3(1, 0, 0).applyQ(b.q); car.wheels.forEach((w, i) => { if (w.front || !w.onGround) return; this.g.fx.tyreSmoke(w.contact, b.vel, 0.9 * s); this.g.fx.wheelTrail(car.key + i, w.contact, side, s, 0.27); }); }
  }
  // ---------------- people ----------------
  moveChar(c, tx, tz, speed, dt) { const dx = tx - c.pos.x, dz = tz - c.pos.z, d = Math.hypot(dx, dz); if (d < 0.35) { c.mv = 0; return true; } const sp = Math.min(speed, d / Math.max(dt, 1e-3)); c.pos.x += dx / d * sp * dt; c.pos.z += dz / d * sp * dt; c.yaw = lerpAngle(c.yaw, Math.atan2(dx, dz), 1 - Math.exp(-dt * 8)); c.mv = sp; return false; }
  animChar(c, dt, extra) {
    c.t += dt; const hs = c.mv || 0; c.walkBlend = smooth(c.walkBlend || 0, hs > 0.15 ? 1 : 0, 7, dt); const run = clamp((hs - 2.2) / 2.6, 0, 1);
    c.phase = (c.phase || 0) + dt * Math.PI * lerp(1.7 + hs * 0.12, 2.6 + hs * 0.07, run) * clamp(hs / 1.2, 0, 1);
    let pose = Character.blend(c.poseIdle(c.t), c.poseWalk(c.phase, run), c.walkBlend);
    if (extra) pose = extra(pose);
    c.applyPose(pose); const y = this.g.world.heightAt(c.pos.x, c.pos.z, c.pos.y + 1.2); c.pos.y = y; c.setTransform(new V3(c.pos.x, y + (c.gaitBob ? c.gaitBob(c.phase, run) * c.walkBlend : 0), c.pos.z), c.yaw);
  }
  updatePerson(c, dt, mode) {
    if (c.fly) return this.updateFly(c, dt);
    c.mv = 0; const g = this.g; const look = g.playerMode === 'foot' ? g.player.pos : g.car.body.pos;
    if (c.talk && c.pos.dist(g.player.pos) < 5) { c.yaw = lerpAngle(c.yaw, Math.atan2(g.player.pos.x - c.pos.x, g.player.pos.z - c.pos.z), 1 - Math.exp(-dt * 4)); }
    this.animChar(c, dt, (p) => c.talking ? Character.add(p, { upperarm_r: [-0.3, 0, -0.5 - 0.25 * Math.sin(c.t * 6)], lowerarm_r: [-0.9, 0, 0] }) : c.headLookPose(p, look));
  }
  updateFan(c, dt) {
    const g = this.g; if (c.fly || c.lying) return this.updateFly(c, dt);
    if (c.inCar) return;
    const dc = this.role === 'fan' ? (this.ai && this.ai.car) : g.car, dp = dc ? dc.body.pos : null;
    if (c.state === 'watch') {
      c.mv = 0; c.acc = (c.acc || 0) + dt; const cam = g.camPos || g.player.pos, far = Math.abs(c.pos.z - cam.z) > 45; if (far && c.acc < 0.12) return; dt = c.acc; c.acc = 0; const drifting = dc && (this.role === 'fan' ? Math.abs(Math.sin(this.ai.sw || 0)) > 0.3 && this.ai.state === 'run' : Math.abs(dc.driftAngle) > 0.3 && dc.speed > 7);
      const near = dp && dp.dist(c.pos) < 45; const cheer = (near && drifting) || (this.cheerT > 0 && c.pos.dist(g.player.pos) < 25);
      c.cheerW = smooth(c.cheerW || 0, cheer ? 1 : 0, 6, dt);
      if (!c.gest) c.gest = FAN_GEST[Math.floor(Math.random() * FAN_GEST.length)];
      const kind = this.cheerT > 0 && this.cheerKind && c.pos.dist(g.player.pos) < 25 ? this.cheerKind : c.gest; // (you start it: the ones near you copy you)
      c.gestureHands(c.cheerW > 0.3 ? kind : null);
      this.animChar(c, dt, (p) => { const b = c.headLookPose(p, dp || g.player.pos); return c.cheerW > 0.01 ? Character.blend(b, c.gesturePose(kind, c.t + c.pos.z, b), c.cheerW) : b; });
    } else if (c.state === 'flee') { // run to the car; the car leaves when its people are in (or after a few seconds)
      if (c.carRef === undefined) { c.carRef = this.carNear(c); if (c.carRef) c.carRef.fans.push(c); }
      const F = c.carRef; if (!F || F.gone || F.leaving) { if (!c.fleeTo) c.fleeTo = { x: c.pos.x - 9, z: c.pos.z - 30 }; const done = this.moveChar(c, c.fleeTo.x, c.fleeTo.z, 5.5, dt); this.animChar(c, dt); if (done) c.root.visible = false; return; }
      const door = F.car.localToWorld(new V3(F.car.def.halfWidth + 0.7, 0, 0.3), new V3());
      const done = this.moveChar(c, door.x, door.z, 5.6, dt); this.animChar(c, dt);
      if (done) { c.inCar = true; c.root.visible = false; if (!F.driver) { F.driver = c; } F.board = (F.board || 0) + 1; if (!F.leaving && (F.board >= F.fans.filter(q => !q.fly && !q.lying).length || this.t - (F.firstT || (F.firstT = this.t)) > 3)) this.leave(F); }
    } else if (c.state === 'help') { // run to the flipped car and pull
      const T = c.target, tp = T.localToWorld(new V3((c.helpSide || (c.helpSide = Math.random() < 0.5 ? 1 : -1)) * (T.def.halfWidth + 0.9), 0, (Math.random() - 0.5) * 0.4), new V3());
      const done = this.moveChar(c, tp.x, tp.z, 5.4, dt); if (done) c.yaw = lerpAngle(c.yaw, Math.atan2(T.body.pos.x - c.pos.x, T.body.pos.z - c.pos.z), 1 - Math.exp(-dt * 6));
      this.animChar(c, dt, done ? (p) => Character.blend(p, this.pullPose(c.t * 2.5), 0.9) : null);
      if (this.police) c.state = 'flee';
    } else if (c.state === 'back') { const done = this.moveChar(c, c.homeX ?? c.pos.x, c.homeZ ?? c.pos.z, 1.6, dt); this.animChar(c, dt); if (done) c.state = 'watch'; }
  }
  pullPose(t) { const s = 0.5 + 0.5 * Math.sin(t * 6); return { spine_01: [-0.25 - 0.15 * s, 0, 0], spine_02: [-0.15, 0, 0], thigh_l: [-0.5, 0, 0], thigh_r: [-0.2, 0, 0], calf_l: [0.6, 0, 0], calf_r: [0.3, 0, 0], upperarm_l: [-1.2 + 0.25 * s, 0, -0.3], upperarm_r: [-1.2 + 0.25 * s, 0, 0.3], lowerarm_l: [-0.4, 0, 0], lowerarm_r: [-0.4, 0, 0] }; }
  updateFly(c, dt) {
    const F = c.fly; c.t += dt;
    if (F) { F.vel.y -= 9.8 * dt; c.pos.addS(F.vel, dt); F.t += dt; c.yaw += F.spin * dt; F.pitch = Math.max(-Math.PI / 2, F.pitch - dt * 5);
      const gy = this.g.world.heightAt(c.pos.x, c.pos.z, c.pos.y + 1); if (c.pos.y <= gy && F.vel.y < 0) { c.pos.y = gy; if (F.vel.y < -3) { F.vel.y *= -0.25; F.vel.x *= 0.5; F.vel.z *= 0.5; } else { c.fly = null; c.lying = true; } }
      c.applyPose(c.poseFall(F.t)); c.setTransform(c.pos, c.yaw, F.pitch); return; }
    c.applyPose(c.poseLying(c.t)); c.setTransform(new V3(c.pos.x, c.pos.y + 0.12, c.pos.z), c.yaw, -Math.PI / 2);
  }
  checkHits(car) {
    const g = this.g, v = car.body.vel, sp = Math.hypot(v.x, v.z); if (sp < 4) return; const hw = car.def.halfWidth + 0.35;
    const hitTest = (pos) => { const l = car.worldToLocal(new V3(pos.x, pos.y + 0.9, pos.z), new V3()); return Math.abs(l.x) < hw && l.z > car.def.zMin - 0.3 && l.z < car.def.zMax + 0.4 && Math.abs(l.y - 0.6) < 1.6; };
    for (const c of this.fans) { if (c.fly || c.lying || c.inCar || !c.root.visible) continue; if (!hitTest(c.pos)) continue;
      c.fly = { vel: new V3(v.x * 0.75, 4.2 + sp * 0.08, v.z * 0.75), t: 0, spin: (Math.random() - 0.5) * 6, pitch: 0 }; c.state = 'hit'; g.audio.thump(80, 0.2, 0.9); g.shake = Math.max(g.shake || 0, 0.4);
      if (!this.flags.hit) { this.flags.hit = true; this.disaster(this.role === 'fan' ? '🚨 المفحط صدم واحد من المعززين! اركب سيارتك واهرب' : '🚨 صدمت واحد من المعززين! اهرب قبل لا تجي الشرطة'); } }
    if (this.role === 'fan' && g.playerMode === 'foot' && !g.pfall && hitTest(g.player.pos)) {
      g.pfall = { state: 'flying', t: 0, pitch: 0, spin: (Math.random() - 0.5) * 3, vel: new V3(v.x * 0.5, 4, v.z * 0.5) }; g.audio.thump(90, 0.25, 0.8); g.hud.toast('😵 صدمك المفحط!', 2200);
      if (!this.flags.hit) { this.flags.hit = true; this.disaster('🚨 المفحط صدمك! قوم واركب سيارتك واهرب'); } }
  }
  disaster(text) {
    this.msg(text, 6); this.say('اهرب'); this.flash(5);
    for (const c of this.fans) if (c.state === 'watch' || c.state === 'help') c.state = Math.random() < 0.75 ? 'flee' : 'watch';
    setTimeout(() => { if (this.on && !this.police) this.callPolice('🚓 جات الشرطة! اركب سيارتك واهرب'); }, 9000);
  }
  leave(F) { F.leaving = true; F.t = 0; const d = F.driver; if (d) { d.root.visible = true; if (d.root.parent) d.root.parent.remove(d.root); F.car.node.add(d.root); d.root.pos.copy(this.g.seatRoot(F.car)); d.root.rot.identity(); d.root.scl.set(1, 1, 1); d.applyPose(d.poseDrive(0)); d.inCar = true; } }
  stepFlee(F, dt) { // drive off down the road, away from the scene
    const car = F.car, p = car.body.pos; F.t += dt; if (car.world !== this.g.world) car.world = this.g.world;
    const tz = p.z - 40, tx = this.xs(tz) - 5; // (along the shoulder behind the barrier, never through it)
    const loc = car.worldToLocal(new V3(tx, p.y, tz), new V3()).sub(car.com), ang = Math.atan2(loc.x, Math.max(loc.z, 0.5) * (loc.z < 0 ? -1 : 1)), v = car.forwardSpeed, want = F.t < 2 ? 6 : 26;
    car.step(dt, { throttle: clamp((want - v) * 0.3, 0, 1), brake: 0, steer: clamp(-ang * 2, -1, 1), handbrake: false, surfaceGrip: 1, water: null }); car.impacts.length = 0;
    if (F.t > 40 && car.node.parent) { car.node.parent.remove(car.node); F.leaving = false; F.gone = true; }
  }
  // ---------------- police ----------------
  callPolice(text) {
    const g = this.g; if (this.police) return; this.police = true; this.msg(text, 6); this.say('جات الشرطة، اهرب'); this.flash(5);
    for (const c of this.fans) if (c.state === 'watch' || c.state === 'help') c.state = 'flee';
    const P = g.police; if (!P) return; P.footOk = true; P.shoot = true; P.result = null;
    const z = this.focusZ() + 300; P.start({ x: this.cw(z, -1), z, hx: 0, hz: 1 });
  }
  updatePolice(dt) {
    if (!this.police || this.flags.end) return; const P = this.g.police;
    if (P && P.on) { if (!this.msgT) this.banner('🚓 الشرطة تلحقك! ابعد عنهم' + (P.lost > 0 ? ' · باقي ' + Math.max(0, Math.ceil(12 - P.lost)).toLocaleString('ar-SA') + ' ث' : '')); return; }
    if (P && P.result) { this.flags.end = true; this.finish(P.result === 'caught' ? '🚓 مسكتك الشرطة وجتك مخالفة' : '😎 هربت من الشرطة! رجعناك للقائمة', 4); }
  }
  // ---------------- the entry test ----------------
  updateTest(dt) {
    const g = this.g, car = g.car; this.updateUI();
    if (this.stage === 'speed') { const kmh = Math.abs(car.forwardSpeed) * 3.6; if (!this.msgT) this.banner('🏁 اختبار القبول: امش ١٢٠ كم/س · الحين ' + Math.round(kmh).toLocaleString('ar-SA'));
      if (kmh >= 118) { this.stage = 'drift'; this.drift = 0; this.msg('✅ ممتاز! الحين فحّط' + (this.d.canDrift === false ? ': لف الدركسون وأنت دايس، وسحبة خفيفة على الهاند بريك' : '!'), 3); this.say('ممتاز، الحين فحط'); } }
    else if (this.stage === 'drift') {
      if (Math.abs(car.driftAngle) > 0.3 && car.speed > 7) this.drift += dt;
      if (!this.msgT) this.banner('🔥 فحّط! ' + Math.min(100, Math.round(this.drift / 3 * 100)).toLocaleString('ar-SA') + '٪');
      if (this.drift >= 3) { this.stage = 'pass'; this.d.qualified = true; const pf = this.d.pref || {}; this.d.own = { map: this.pickMap(pf.map), start: this.ownStart(pf.delay) }; this.save();
        this.msg('✅ انقبلت في المسابقة! موعد هجولتك: ' + MAP_NAME[this.d.own.map] + ' الساعة ' + clock(this.d.own.start), 6); this.say('مبروك انقبلت'); this.flash(4);
        setTimeout(() => { if (this.on && this.mode === 'test') { this.stop(); this.api.toMenu(); this.openScreen(); } }, 5000); }
    }
  }
  // ---------------- UI in the game ----------------
  ui() {
    const hud = document.getElementById('hud'); if (!hud) return;
    if (!this.bEl) { this.bEl = document.createElement('div'); this.bEl.id = 'evBanner'; }
    if (!this.aEl) { this.aEl = document.createElement('div'); this.aEl.id = 'evActs'; }
    if (!this.tmEl) { this.tmEl = document.createElement('div'); this.tmEl.id = 'evTimer'; }
    hud.appendChild(this.bEl); hud.appendChild(this.aEl); hud.appendChild(this.tmEl); this.bEl.hidden = false; this.aEl.hidden = false; this.tmEl.hidden = true; this.tmEl.textContent = ''; this.actsKey = null;
  }
  banner(t) { if (this.bEl && this.bEl.textContent !== t) this.bEl.textContent = t; }
  msg(t, s) { this.banner(t); this.msgT = s; }
  updateUI() {
    if (this.msgT > 0) { this.msgT -= 1 / 60; if (this.msgT <= 0) this.msgT = 0; }
    if (!this.aEl) return; const g = this.g;
    // which buttons: cheering (spectator), talk, pull
    let key = 'none';
    if (this.mode === 'show') { if (this.pullable && !this.rescued) key = 'pull'; else if (this.talkable && !this.talking) key = 'talk'; else if (this.role === 'fan' && g.playerMode === 'foot' && !this.police) key = 'cheer'; }
    if (key === this.actsKey) return; this.actsKey = key; const A = this.aEl; A.innerHTML = '';
    const b = (t, f, cls) => { const e = document.createElement('button'); e.textContent = t; if (cls) e.className = cls; e.addEventListener('pointerdown', (ev) => { ev.preventDefault(); ev.stopPropagation(); f(); }); A.appendChild(e); return e; };
    if (key === 'cheer') for (const [ic, nm, kind] of CHEERS) b(ic + ' ' + nm, () => this.cheer(kind, nm));
    if (key === 'talk') b('💬 تكلّم', () => this.openTalk(this.talkable), 'go');
    if (key === 'pull') b('💪 اسحب', () => this.pullTap(), 'big');
  }
