    mb.jersey.box(BX, 0.45, z + 5, 0.6, 0.9, 10.05); mb.jersey.box(BX, 0.08, z + 5, 0.9, 0.16, 10.05);
    colBox(world, BX, 0.45, z + 5, 0.7, 0.9, 10, 0, 6);
    if (Math.round(z) % 40 === 0) { streetLight(mb.pole, mb.lamp, BX, 0.9, z + 5, 0); colCyl(world, BX, 0.9, z + 5, 0.15, 10, 5); }
  }
  for (let z = -L + 25; z < L; z += 34) for (const side of [-1, 1]) {
    const x = BX + side * 19; if (onRoad(x, z) && Math.abs(x - BX) < 15) continue;
    if ([470, -470, 1400, -1400].some(j => Math.abs(z - j) < 20)) continue;
    palm(mb.trunk, mb.frond, x, 0, z, 8 + r() * 4, r); colCyl(world, x, 0, z, 0.3, 8, 7);
  }
