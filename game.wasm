    map.places.push({ name, x: m.spawn.x + ox, z: m.spawn.z + oz, yaw: m.spawn.yaw });
    for (const L of m.lanes || []) map.lanes.push({ fx: (zz) => L.fx(zz - oz) + ox, dir: L.dir, z0: L.z0 + oz, z1: L.z1 + oz, speed: L.speed });
    return R;
  };
  map.cull = (x, z, d = 3200) => { for (const R of regions) { const dx = Math.max(R.x0 - x, 0, x - R.x1), dz = Math.max(R.z0 - z, 0, z - R.z1); R.dist = Math.hypot(dx, dz); R.wrap.visible = R.dist < d; } };
