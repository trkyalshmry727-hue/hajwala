  const evictCars = () => {
    const keep = new Set([game.carKey, selected, 'shas', ...(game.botKeys || [])]); try { for (const c of (game.police && game.police.cars) || []) if (c && c.key) keep.add(c.key); } catch (e) { }
    const loaded = Object.keys(game.cars); let n = loaded.length;
    for (const k of [...carUse]) {
      if (n <= MAX_CARS) break; if (keep.has(k) || !game.cars[k]) continue;
      const car = game.cars[k]; if (car.node.parent) continue;
      try { renderer.release(car.node); } catch (e) { }
      delete game.cars[k]; delete game.pristine[k]; delete assets[k]; delete carLoads[k]; carUse.splice(carUse.indexOf(k), 1); n--;
      const card = strip.querySelector(`.card[data-key="${k}"]`); if (card && MANIFEST.thumbs && MANIFEST.thumbs[k]) card.querySelector('img').src = MANIFEST.thumbs[k];
    }
  };
