  // ---------------------------------------------------------------- people helpers
  person(x, z, yaw) { const g = this.g, c = new Character(cloneCharacter(g.manSrc)); c.pos.set(x, g.world.heightAt(x, z, 60), z); c.yaw = yaw || 0; c.t = Math.random() * 9; c.mv = 0; c.walkBlend = 0; c.phase = 0; c.setTransform(c.pos, c.yaw); g.scene.add(c.root); return c; },
  walk(c, tx, tz, sp, dt) { const dx = tx - c.pos.x, dz = tz - c.pos.z, d = Math.hypot(dx, dz); if (d < 0.35) { c.mv = 0; return true; } const s = Math.min(sp, d / Math.max(dt, 1e-3)); c.pos.x += dx / d * s * dt; c.pos.z += dz / d * s * dt; c.yaw = lerpAngle(c.yaw, Math.atan2(dx, dz), 1 - Math.exp(-dt * 8)); c.mv = s; return false; },
  anim(c, dt, extra) {
    const g = this.g; c.t += dt; const hs = c.mv || 0; c.walkBlend = smooth(c.walkBlend || 0, hs > 0.15 ? 1 : 0, 7, dt); const run = clamp((hs - 2.2) / 2.6, 0, 1);
    c.phase = (c.phase || 0) + dt * Math.PI * lerp(1.7 + hs * 0.12, 2.6 + hs * 0.07, run) * clamp(hs / 1.2, 0, 1);
    let pose = Character.blend(c.poseIdle(c.t), c.poseWalk(c.phase, run), c.walkBlend); if (extra) pose = extra(pose);
    c.applyPose(pose); const y = g.world.heightAt(c.pos.x, c.pos.z, c.pos.y + 1.2); c.pos.y = y; c.setTransform(new V3(c.pos.x, y, c.pos.z), c.yaw);
  },
  faceTo(c, p, dt) { c.yaw = lerpAngle(c.yaw, Math.atan2(p.x - c.pos.x, p.z - c.pos.z), 1 - Math.exp(-dt * 6)); },
  // bottom buttons for whatever you can do right now (take the order, enter the shop…)
  setActs(list) {
    const k = list.map(a => a[0]).join('|'); if (k === this.actsKey) return; this.actsKey = k; this.acts.innerHTML = '';
    for (const [t, f] of list) { const b = el('button', '', t); b.addEventListener('pointerdown', (e) => { e.preventDefault(); e.stopPropagation(); f(); }); this.acts.appendChild(b); }
  },
  updateActs() {
    const L = [];
    if (this.shopSpot && this.nearShop) L.push(['👕 ادخل محل الملابس', () => this.openShop()]);
    if (this.mode && this.mode.acts) L.push(...this.mode.acts);
    if (this.fuel && this.fuel.acts) L.push(...this.fuel.acts);
    this.setActs(L);
  },
  // ---------------------------------------------------------------- the petrol station attendant
  checkFuelPad() {
    const g = this.g, car = g.car; if (g.playerMode !== 'car' || !g.fuelPads || this.fuelCD > 0) { this.fuelCD = Math.max(0, (this.fuelCD || 0) - 1 / 60); return; }
    const b = car.body.pos, pad = g.fuelPads.find(f => Math.hypot(b.x - f.x, b.z - f.z) < f.r + 1);
    if (!pad || Math.abs(car.speed) > 0.6 || (car.fuel ?? 100) > 96 || !g.manSrc) return;
    const f = car.forward(new V3()), side = new V3(f.z, 0, -f.x);
    const pump = pad.pump ? pad.pump.clone() : new V3(pad.x + side.x * 4.2, 0, pad.z + side.z * 4.2);
    const man = this.person(pump.x + f.x * 6, pump.z + f.z * 6, 0);
    this.fuel = { pad, pump, man, car, stage: 'come', t: 0, acts: null };
    this.api.hud.toast('⛽ العامل جايك…', 1500);
  },
  fuelAsk() {
    const F = this.fuel, g = this.g, k = g.carKey, ok = FUEL_OF(k);
    this.panel((P, btn) => {
      P.append(el('h3', '', '⛽ هلا والله! وش نوع البنزين؟'));
      const r = el('div', 'row'); for (const t of ['91', '95', '98']) r.append(btn('بنزين ' + AR(+t), () => { F.type = t; this.closePanel(); this.fuelAmount(); }, ok.includes(t) ? 'go' : ''));
      P.append(r, el('p', 'note', 'سيارتك تمشي على: ' + ok.map(t => AR(+t)).join(' · ')));
      const r2 = el('div', 'row'); r2.append(btn('لا شكراً', () => { this.closePanel(); this.fuelEnd(false); })); P.append(r2);
    });
  },
  fuelAmount() {
    const F = this.fuel, car = F.car, lit = (100 - (car.fuel ?? 100)) / 100 * TANK, price = FUEL_PRICE[F.type], full = Math.ceil(lit * price);
    this.panel((P, btn) => {
      P.append(el('h3', '', 'كم أعبي لك؟'));
      const r = el('div', 'row'); r.append(btn('فل (' + AR(full) + ' ريال)', () => { F.money = full; this.closePanel(); F.stage = 'toPump'; }, 'go'), btn('أنا أحدد', () => {
        this.closePanel(); let v = Math.min(50, full);
        this.panel((P2, btn2) => { P2.append(el('h3', '', 'حدد المبلغ')); const lab = el('p', '', AR(v) + ' ريال'); const s = el('input'); s.type = 'range'; s.min = 5; s.max = Math.max(5, full); s.step = 5; s.value = v; s.addEventListener('input', () => { v = +s.value; lab.textContent = AR(v) + ' ريال'; });
          const rr = el('div', 'row'); rr.append(btn2('عبّي', () => { F.money = v; this.closePanel(); F.stage = 'toPump'; }, 'go')); P2.append(lab, s, rr); }); }));
      P.append(r);
    });
  },
  fuelPay() {
    const F = this.fuel;
    this.panel((P, btn) => {
      P.append(el('h3', '', 'الحساب'), el('p', '', 'بنزين ' + AR(+F.type) + ' · ' + AR(F.money) + ' ريال'));
      const r = el('div', 'row'); r.append(btn('💵 ادفع', () => { this.api.spend(F.money); this.closePanel(); this.api.say('الله يعطيك العافية'); this.api.hud.toast('دفعت ' + AR(F.money) + ' ريال · الله يعطيك العافية', 2000); this.fuelEnd(true); }, 'go'),
        btn('🏃 اهرب', () => { this.closePanel(); this.fleeT = 3.5; this.api.say('وقف وقف'); this.api.hud.toast('💨 هربت من المحطة!', 1800); F.stage = 'chase'; F.t = 0; }, 'red'));
      P.append(r);
    });
  },
  fuelEnd(paid) { const F = this.fuel; if (!F) return; F.stage = 'leave'; F.t = 0; F.acts = null; F.paid = paid; this.fuelCD = 6; },
  updateFuel(dt) {
    const g = this.g, F = this.fuel, man = F.man, car = F.car; F.t += dt;
    const hw = car.def.halfWidth || 0.9, win = car.localToWorld(new V3(hw + 0.75, 0, (car.doorHinge ? car.doorHinge.z : 0.6) - 0.4), new V3()), filler = car.localToWorld(new V3(hw + 0.55, 0, (car.def.zMin || -2) + 0.9), new V3());
    // drove off before it was done
    if (['come', 'ask', 'toPump', 'nozzle', 'toFill', 'fill', 'back', 'bill'].includes(F.stage) && car.body.pos.dist(new V3(F.pad.x, car.body.pos.y, F.pad.z)) > F.pad.r + 4) {
      this.closePanel(); if (F.added > 0 && F.stage !== 'come' && F.stage !== 'ask') { this.api.hud.toast('💨 مشيت بدون ما تدفع!', 1800); F.stage = 'chase'; F.t = 0; } else { F.stage = 'leave'; F.t = 0; } }
    const nozzle = () => { if (!F.noz) { const mb = new MB(); mb.box(0, 0, 0, 0.06, 0.08, 0.26); F.noz = new Node('nozzle'); F.noz.mesh = { prims: [mb.prim(new Material({ name: 'nozzle', color: [0.05, 0.05, 0.05, 1], roughness: 0.4 }))] }; } if (F.noz.parent !== g.scene) g.scene.add(F.noz); const h = man.bones.hand_r; if (h) { man.root.updateWorld(); F.noz.pos.set(h.world[12], h.world[13], h.world[14]); F.noz.rot.setAxisAngle(UP, man.yaw); } };
    const dropNoz = () => { if (F.noz && F.noz.parent) F.noz.parent.remove(F.noz); };
    if (F.stage === 'come') { if (this.walk(man, win.x, win.z, 1.8, dt)) { F.stage = 'ask'; this.api.say('هلا والله، وش نوع البنزين'); this.fuelAsk(); } this.anim(man, dt); }
    else if (F.stage === 'ask') { this.faceTo(man, car.body.pos, dt); this.anim(man, dt); }
    else if (F.stage === 'toPump') { if (this.walk(man, F.pump.x, F.pump.z, 1.8, dt)) { F.stage = 'nozzle'; F.t = 0; } this.anim(man, dt); }
    else if (F.stage === 'nozzle') { this.anim(man, dt, (p) => Character.add(p, { spine_01: [-0.3 * Math.sin(Math.min(1, F.t) * Math.PI), 0, 0], upperarm_r: [-0.9, 0, 0.3] })); if (F.t > 0.9) { nozzle(); F.stage = 'toFill'; } }
    else if (F.stage === 'toFill') { nozzle(); if (this.walk(man, filler.x, filler.z, 1.6, dt)) { F.stage = 'fill'; F.t = 0; F.added = 0; g.audio.door && g.audio.door(true); } this.anim(man, dt); }
    else if (F.stage === 'fill') { // he opens the fuel flap, puts the nozzle in and leans on the car while it fills
      this.faceTo(man, car.body.pos, dt); nozzle();
      this.anim(man, dt, (p) => Character.add(p, { spine_01: [-0.12, 0.2, 0.15], upperarm_r: [-1.05, 0, 0.55], lowerarm_r: [0, 0.6, 0], upperarm_l: [-0.2, 0, -0.2], thigh_l: [-0.1, 0, 0.12] }));
      const want = F.money / FUEL_PRICE[F.type] / TANK * 100, step = Math.min(dt * 6, want - F.added);
      if (step > 0) { F.added += step; car.fuel = Math.min(100, (car.fuel ?? 0) + step); car.noFuel = false; }
      this.api.hud.bottom('⛽ يعبّي… ' + AR(Math.min(F.money, F.added / 100 * TANK * FUEL_PRICE[F.type])) + ' / ' + AR(F.money) + ' ريال', 400);
      if (F.added >= want - 0.01 || car.fuel >= 100) {
        const ok = FUEL_OF(g.carKey); if (!ok.includes(F.type) && +F.type < +ok[0]) { car.badFuel = true; } else if (F.added > 35) car.badFuel = false;
        F.stage = 'back'; g.audio.door && g.audio.door(false);
      } }
    else if (F.stage === 'back') { nozzle(); if (this.walk(man, F.pump.x, F.pump.z, 1.8, dt)) { dropNoz(); F.stage = 'toBill'; } this.anim(man, dt); }
    else if (F.stage === 'toBill') { if (this.walk(man, win.x, win.z, 1.8, dt)) { F.stage = 'bill'; this.api.say('الحساب ' + Math.round(F.money) + ' ريال'); this.fuelPay(); } this.anim(man, dt); }
    else if (F.stage === 'bill') { this.faceTo(man, car.body.pos, dt); this.anim(man, dt); }
    else if (F.stage === 'chase') { dropNoz(); const p = car.body.pos; this.walk(man, p.x, p.z, 5.2, dt); this.anim(man, dt, (q) => Character.add(q, { upperarm_r: [-0.4, 0, -1.5], lowerarm_r: [-0.6, 0, 0] })); if (F.t > 6) { F.stage = 'leave'; F.t = 0; this.fuelCD = 8; } }
    else if (F.stage === 'leave') { dropNoz(); this.walk(man, F.pump.x + 30, F.pump.z + 30, 1.6, dt); this.anim(man, dt); if (F.t > 6) { if (man.root.parent) man.root.parent.remove(man.root); this.fuel = null; } }
    if (car.badFuel && !car.badMsg) { car.badMsg = true; this.api.hud.toast('⚠️ بنزين غلط! السيارة تطقطق وما تسحب — عبّي النوع الصح', 3500); }
  },
  // ---------------------------------------------------------------- dust storms and a dirty car
  updateDust(dt) {
    const g = this.g; this.dustT -= dt;
    if (this.dustT <= 0) { if (this.dustOn) { this.dustOn = false; this.dustT = 360 + Math.random() * 480; } else if (!g.map.room && g.weather !== 'night') { this.dustOn = true; this.dustT = 90 + Math.random() * 90; this.api.hud.toast('🌪️ جاتنا موجة غبار!', 2500); } else this.dustT = 120; }
    if (g.weather === 'dust') this.dustOn = true;
    const want = this.dustOn ? 1 : 0, was = this.dustK; this.dustK = clamp(this.dustK + clamp(want - this.dustK, -dt * 0.08, dt * 0.08), 0, 1);
    this.dustEl.style.opacity = (this.dustK * 0.85).toFixed(2);
    if (Math.abs(was - this.dustK) > 1e-4 || (this._dk !== undefined && Math.abs(this._dk - this.dustK) > 0.02)) { this._envT = (this._envT || 0) + dt; if (this._envT > 0.5) { this._envT = 0; this._dk = this.dustK; this.applyDustEnv(); } }
    if (this.dustK > 0.2) { const c = g.camPos; for (let i = 0; i < 2; i++) if (Math.random() < this.dustK) g.fx.smoke.emit(new V3(c.x + (Math.random() - 0.5) * 30, c.y - 1 + Math.random() * 3, c.z + (Math.random() - 0.5) * 30), new V3(6 + Math.random() * 3, 0.2, 2), { life: 3, size: 2.5, grow: 1.5, color: [0.72, 0.56, 0.36, 0.22 * this.dustK], drag: 0.2, gravity: 0 }); }
  },
  applyDustEnv() {
    const g = this.g, e = g.r.env, k = this.dustK; if (!g.map || g.map.room) return;
    if (!this._env0 || this._env0.map !== g.map || this._env0.w !== g.weather) { g.applyEnv(); this._env0 = { map: g.map, w: g.weather, skyTop: e.skyTop.slice(), skyHorizon: e.skyHorizon.slice(), sunColor: e.sunColor.slice(), fog: e.fog, ground: e.ground.slice() }; }
    const B = this._env0, mx = (a, b) => a.map((v, i) => v + (b[i] - v) * k);
    e.skyTop = mx(B.skyTop, [0.5, 0.38, 0.24]); e.skyHorizon = mx(B.skyHorizon, [0.78, 0.6, 0.4]); e.sunColor = mx(B.sunColor, [1.3, 1.0, 0.7]); e.ground = mx(B.ground, [0.55, 0.42, 0.28]); e.fog = B.fog + (0.016 - B.fog) * k;
  },
  updateDirt(dt) {
    const g = this.g, car = g.car; if (g.playerMode !== 'car') return;
    const onSand = car.wheels.some(w => w.onGround && w.tag === 3);
    car.dirt = clamp((car.dirt || 0) + dt * ((onSand ? car.speed * 0.0016 : 0) + this.dustK * 0.006), 0, 1);
    if (Math.abs((car._dirtShown || 0) - car.dirt) > 0.02) { car._dirtShown = car.dirt; const D = [0.55, 0.43, 0.3];
      car.model.traverse(n => { if (n.mesh) for (const p of n.mesh.prims) { const m = p.material; if (!m || !m.carPaint) continue; if (!m._clean) m._clean = m.color.slice(); const k = car.dirt * 0.55; m.color = [0, 1, 2].map(i => m._clean[i] + (D[i] - m._clean[i]) * k).concat([m._clean[3]]); } }); }
  },
  washCar(car) { car.dirt = 0; car._dirtShown = 0; car.model.traverse(n => { if (n.mesh) for (const p of n.mesh.prims) { const m = p.material; if (m && m._clean) { m.color = m._clean.slice(); m._clean = null; } } }); },
  // ---------------------------------------------------------------- the bots stop and help you when you roll over
  updateHelp(dt) {
    const g = this.g, car = g.car, B = g.bots; if (!B || !B.units || !B.units.length || g.playerMode !== 'car') { this.helpUp = 0; return; }
    const upside = car.up(new V3()).y < 0.35 && car.speed < 2; this.helpUp = upside ? (this.helpUp || 0) + dt : 0;
    if (this.helpUp > 2.5 && !this.helper) {
      let best = null, bd = 220; for (const U of B.units) { if (U.wreck || !U.man) continue; const d = U.car.body.pos.dist(car.body.pos); if (d < bd) { bd = d; best = U; } }
      if (best) { this.helper = { U, stage: 'drive', t: 0 }; best.mode = 'help'; this.api.hud.toast('🚗 واحد وقف يبي يساعدك', 2000); }
    }
    const H = this.helper; if (!H) return; const U = H.U, uc = U.car; H.t += dt;
    if (H.stage === 'drive') { const tgt = car.localToWorld(new V3(0, 0, -9), new V3()); const d = uc.body.pos.dist(tgt);
      if (d > 6 && H.t < 25) { const loc = uc.worldToLocal(tgt, new V3()).sub(uc.com), ang = Math.atan2(loc.x, Math.max(loc.z, 0.5)); uc.step(dt, { throttle: clamp((Math.min(14, d * 0.5) - uc.forwardSpeed) * 0.3, 0, 1), brake: uc.forwardSpeed > d * 0.6 ? 0.6 : 0, steer: clamp(-ang * 2, -1, 1), handbrake: false, surfaceGrip: 1, water: null }); }
      else { uc.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); if (uc.speed < 0.5) { // he gets out
        const m = U.man; if (m.root.parent) m.root.parent.remove(m.root); const s = uc.localToWorld(new V3(uc.def.halfWidth + 0.8, 0, 0.3), new V3()); m.root.scl.set(1, 1, 1); m.pos.set(s.x, g.world.heightAt(s.x, s.z, s.y + 2), s.z); m.yaw = 0; m.root.rot.identity(); g.scene.add(m.root); H.stage = 'walk'; H.t = 0; this.api.say('ابشر ابشر'); } } }
    else if (H.stage === 'walk') { uc.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); const m = U.man, s = car.localToWorld(new V3(car.def.halfWidth + 1.0, 0, 0), new V3());
      if (this.walk(m, s.x, s.z, 3.5, dt) || H.t > 12) { H.stage = 'pull'; H.t = 0; } this.anim(m, dt); }
    else if (H.stage === 'pull') { uc.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); const m = U.man; this.faceTo(m, car.body.pos, dt);
      const sP = 0.5 + 0.5 * Math.sin(m.t * 6); this.anim(m, dt, (p) => Character.add(p, { spine_01: [-0.35 - 0.15 * sP, 0, 0], thigh_l: [-0.5, 0, 0], calf_l: [0.6, 0, 0], upperarm_l: [-1.2 + 0.25 * sP, 0, -0.3], upperarm_r: [-1.2 + 0.25 * sP, 0, 0.3] }));
      if (H.t > 3.2) { const p = car.body.pos; car.place(p.x, g.world.heightAt(p.x, p.z, p.y + 3) + 0.5, p.z, g.carYaw()); this.api.hud.toast('💪 عدّلوا سيارتك! الله يعطيه العافية', 2200); this.api.say('الله يعطيك العافية'); H.stage = 'back'; H.t = 0; } }
    else if (H.stage === 'back') { uc.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); const m = U.man, s = uc.localToWorld(new V3(uc.def.halfWidth + 0.8, 0, 0.3), new V3());
      if (this.walk(m, s.x, s.z, 1.8, dt) || H.t > 10) { if (m.root.parent) m.root.parent.remove(m.root); uc.node.add(m.root); const ks = uc.def.driverScale || 1; m.root.scl.set(ks, ks, ks); m.root.pos.copy(g.seatRoot(uc)); m.root.rot.identity(); m.applyPose(m.poseDrive(0)); U.mode = 'back'; U.modeT = 0; this.helper = null; } else this.anim(m, dt); }
  },
  // ---------------------------------------------------------------- drifting in front of the police
  updatePoliceDrift(dt) {
    const g = this.g, car = g.car; if (g.playerMode !== 'car' || g.event || (g.police && g.police.active) || this.mode) return; this.polCD = Math.max(0, (this.polCD || 0) - dt); if (this.polCD) return;
    if (!(Math.abs(car.driftAngle) > 0.35 && car.speed > 7)) return; const T = g.map.traffic; if (!T) return;
    const p = car.body.pos; let C = null;
    for (const c of T.checks || []) if (Math.hypot(p.x - c.x, p.z - c.z) < 80) { C = c; break; }
    if (!C) for (const o of g.officers || []) if (o.root.parent && o.pos.dist(p) < 70) { const c = (T.checks || []).reduce((a, q) => !a || Math.hypot(q.x - p.x, q.z - p.z) < Math.hypot(a.x - p.x, a.z - p.z) ? q : a, null); C = c; break; }
    if (!C) return;
    this.polCD = 60; g.hud.toast('🚨 فحطت قدام الشرطة! يلحقونك — اهرب منهم', 2800); this.api.say('فحطت قدام الشرطة');
    g.fine && g.fine('skip'); if (!g.police) return; g.police.start(C);
  },
});

// ============================================================================ part 3: game modes and the shop
const signTex = (lines, bg) => { const c = document.createElement('canvas'); c.width = 256; c.height = 128; const g = c.getContext('2d'); g.fillStyle = bg; g.fillRect(0, 0, 256, 128); g.fillStyle = '#fff'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = 'bold 46px Tahoma, Arial'; g.fillText(lines[0], 128, lines[1] ? 44 : 64); if (lines[1]) { g.font = 'bold 26px Tahoma'; g.fillText(lines[1], 128, 96); } return { image: c, wrapS: 33071, wrapT: 33071, srgb: true, gl: null }; };
Object.assign(Extras.prototype, {
  // a little building with a sign (restaurant, clothes shop)
  booth(x, z, yaw, lines, bg, col) {
    const g = this.g, y = g.world.heightAt(x, z, 60), n = new Node('booth'), mb = new MB(), sg = new MB();
    mb.box(0, 1.5, 0, 4.2, 3, 3.2); mb.box(0, 3.08, 0.3, 4.6, 0.16, 4.0);
    const w = 3.4, h = 1.2, z0 = 1.62, a = sg.v(-w / 2, 2.2, z0, 0, 0, 1, 0, 1), b = sg.v(w / 2, 2.2, z0, 0, 0, 1, 1, 1), c = sg.v(w / 2, 2.2 + h, z0, 0, 0, 1, 1, 0), d = sg.v(-w / 2, 2.2 + h, z0, 0, 0, 1, 0, 0); sg.I.push(a, b, c, a, c, d);
    n.mesh = { prims: [mb.prim(new Material({ name: 'booth', color: [...col, 1], roughness: 0.8 })), sg.prim(new Material({ name: 'boothSign', map: signTex(lines, bg), roughness: 0.5, emissive: [0.15, 0.15, 0.15], doubleSided: true }))] };
    n.pos.set(x, y, z); n.rot.setAxisAngle(UP, yaw); g.scene.add(n); return n;
  },
  pillar(x, z, col) { const g = this.g, n = new Node('xpillar'), mb = new MB(); mb.box(0, 0, 0, 2.2, 60, 2.2); n.mesh = { prims: [mb.prim(new Material({ name: 'xpillar', color: [...col, 0.45], unlit: true, alphaMode: 'BLEND', doubleSided: true }))] }; n.castShadow = false; n.pos.set(x, g.world.heightAt(x, z, 60) + 30, z); g.scene.add(n); return n; },
  // a point on a road near you, d metres along it (left side of the road, off the tarmac)
  roadPoint(from, d, side = 1) {
    const g = this.g, lanes = (g.map && g.map.lanes) || []; let best = null;
    for (const L of lanes) { const z0 = Math.min(L.z0, L.z1), z1 = Math.max(L.z0, L.z1); if (from.z < z0 - 50 || from.z > z1 + 50) continue; const dx = Math.abs(L.fx(clamp(from.z, z0, z1)) - from.x); if (!best || dx < best.dx) best = { L, dx, z0, z1 }; }
    if (!best || best.dx > 300) { const a = Math.random() * 6.28; return new V3(from.x + Math.sin(a) * d, 0, from.z + Math.cos(a) * d); }
    const { L, z0, z1 } = best; let z = from.z + d * side; if (z > z1 - 20 || z < z0 + 20) z = from.z - d * side; z = clamp(z, z0 + 20, z1 - 20);
    let lo = 1e9; for (const L2 of lanes) { if (z < Math.min(L2.z0, L2.z1) || z > Math.max(L2.z0, L2.z1)) continue; lo = Math.min(lo, L2.fx(z)); }
    return new V3((lo < 1e8 ? lo : L.fx(z)) - 8, 0, z);
  },
  // ---------------------------------------------------------------- picking a mode
  openModes(onStart) {
    const g = this.g; if (g.event) return;
    this.panel((P, btn) => {
      P.append(el('h3', '', onStart ? 'وش تبي تلعب في هالماب؟' : '🎮 الطور'));
      const r = el('div', 'row');
      r.append(btn('🚗 حر', () => { this.endMode(); this.closePanel(); }, 'go'), btn('🍔 توصيل طلبات', () => { this.closePanel(); this.startDelivery(); }), btn('🏜️ سباق الطعوس', () => { this.closePanel(); this.startDunes(); }));
      if (this.fleet.length) r.append(btn('🏁 سباق مع سيارتك الثانية', () => { this.closePanel(); this.openRadial('race'); }));
      P.append(r, el('p', 'note', 'التوصيل: جوالك يوديك للمطعم، تاخذ الطلب وتحطه بالحوض أو الشنطة وتوصله قبل لا يخلص الوقت. الطعوس: بوت يسابقك لراس الطعس والدبل معشق إجباري. كل طور يعطيك فلوس.'));
    }, true);
  },
  endMode() {
    const M = this.mode; if (!M) return;
    for (const n of M.nodes || []) if (n.parent) n.parent.remove(n);
    for (const c of M.people || []) if (c.root.parent) c.root.parent.remove(c.root);
    if (M.bot) { if (M.bot.car.node.parent) M.bot.car.node.parent.remove(M.bot.car.node); }
    if (this.phone) { this.phone.remove(); this.phone = null; }
    if (M.lock4 && this.g.car) { this.g.car.lock4 = false; try { this.g.car.applyTune(this.api.tuneOf(this.g.carKey)); } catch (e) { } }
    this.mode = null; this.duneBot = null; this.closePanel();
  },
  updateMode(dt) { const M = this.mode; M.t = (M.t || 0) + dt; if (M.kind === 'delivery') this.updateDelivery(dt); else if (M.kind === 'dunes') this.updateDunes(dt); },
  // ---------------------------------------------------------------- delivery (توصيل طلبات)
  phoneUI() {
    if (this.phone) return this.phone; const P = el('div'); P.id = 'xPhone';
    const cv = el('canvas'); cv.width = 138; cv.height = 170; P.append(el('div', 't', '📱 قوقل ماب'), cv, el('div', 't'), el('div', 's'));
    document.getElementById('hud').appendChild(P); this.phone = P; P.cv = cv; return P;
  },
  phoneDraw(target, title, sub) {
    const g = this.g, P = this.phoneUI(); P.children[2].textContent = title; P.children[3].textContent = sub || '';
    this.phT = (this.phT || 0) - 1; if (this.phT > 0 && P.drawn) return; this.phT = 50; P.drawn = true;
    const cv = P.cv, x = cv.getContext('2d'), me = g.playerMode === 'foot' ? g.player.pos : g.car.body.pos;
    const span = clamp(me.dist(target) * 2.4, 160, 1400);
    try { const R = g.renderMap(cv.width * 2, cv.height * 2, span, me); x.drawImage(R.img, 0, 0, cv.width, cv.height);
      const [ax, ay] = R.proj(me.x, me.y, me.z), [bx, by] = R.proj(target.x, me.y, target.z), s = 0.5;
      x.strokeStyle = '#1a73e8'; x.lineWidth = 4; x.beginPath(); x.moveTo(ax * s, ay * s); x.lineTo(bx * s, by * s); x.stroke();
      x.fillStyle = '#ea4335'; x.beginPath(); x.arc(bx * s, by * s, 6, 0, 7); x.fill(); x.fillStyle = '#1a73e8'; x.beginPath(); x.arc(ax * s, ay * s, 5, 0, 7); x.fill(); x.strokeStyle = '#fff'; x.lineWidth = 2; x.stroke();
    } catch (e) { x.fillStyle = '#e8e2d4'; x.fillRect(0, 0, cv.width, cv.height); }
  },
  startDelivery() {
    const g = this.g; this.endMode(); if (!g.manSrc) return; const me = g.car.body.pos;
    const R = this.roadPoint(me, 260 + Math.random() * 200, Math.random() < 0.5 ? 1 : -1); R.y = g.world.heightAt(R.x, R.z, 60);
    const C = this.roadPoint(R, 500 + Math.random() * 600, Math.random() < 0.5 ? 1 : -1); C.y = g.world.heightAt(C.x, C.z, 60);
    const M = this.mode = { kind: 'delivery', stage: 'toRest', R, C, nodes: [], people: [], t: 0 };
    M.nodes.push(this.booth(R.x - 3, R.z, Math.PI / 2, ['مطعم 🍔', 'البيك والشاورما'], '#b3261e', [0.85, 0.82, 0.74]), this.pillar(R.x, R.z, [1, 0.85, 0.1]));
    const w = this.person(R.x + 0.6, R.z, Math.PI / 2); M.worker = w; M.people.push(w); M.bag = this.bagNode(); this.holdBag(w);
    this.api.hud.toast('📱 جاك طلب! روح للمطعم وخذ الطلب', 2500); this.api.say('جاك طلب جديد');
  },
  bagNode() { const mb = new MB(); mb.box(0, 0, 0, 0.32, 0.3, 0.2); mb.box(0, 0.19, 0, 0.18, 0.05, 0.03); const n = new Node('bag'); n.mesh = { prims: [mb.prim(new Material({ name: 'bag', color: [0.75, 0.58, 0.36, 1], roughness: 0.9 }))] }; return n; },
  holdBag(c) { const M = this.mode; M.holder = c; if (M.bag.parent !== this.g.scene) { if (M.bag.parent) M.bag.parent.remove(M.bag); this.g.scene.add(M.bag); } },
  bagFollow() { const M = this.mode, c = M.holder; if (!c) return; c.root.updateWorld(); const h = c.bones.hand_r; if (h) { M.bag.pos.set(h.world[12], h.world[13] - 0.2, h.world[14]); M.bag.rot.setAxisAngle(UP, c.yaw); } },
  updateDelivery(dt) {
    const g = this.g, M = this.mode, car = g.car, foot = g.playerMode === 'foot', p = foot ? g.player.pos : car.body.pos; M.acts = null;
    for (const c of M.people) if (c !== M.holderPlayer) { this.faceTo(c, p, dt); this.anim(c, dt, M.holder === c ? (q) => Character.add(q, { upperarm_r: [-0.3, 0, 0.6], lowerarm_r: [0, 0.4, 0] }) : null); }
    const rear = car.localToWorld(new V3(0, 0, (car.def.zMin || -2) - 0.9), new V3()), nearRear = foot && Math.hypot(rear.x - p.x, rear.z - p.z) < 2.4;
    const left = () => Math.max(0, M.limit - (M.t - M.t0));
    if (M.holder === g.player) this.bagFollow(); else if (M.holder && M.holder !== 'car') this.bagFollow();
    if (M.stage === 'toRest') {
      this.phoneDraw(M.R, '🍔 المطعم · ' + AR(Math.hypot(M.R.x - p.x, M.R.z - p.z)) + ' م', 'انزل وخذ الطلب من العامل');
      if (foot && M.worker.pos.dist(g.player.pos) < 2.4) M.acts = [['🛍️ خذ الطلب', () => { this.holdBag(g.player); M.stage = 'load'; M.t0 = M.t; const d = Math.hypot(M.C.x - M.R.x, M.C.z - M.R.z); M.limit = Math.round(d / 9 + 45); M.dmg0 = car.damage || 0; this.api.say('تفضل الطلب، بالعافية'); this.api.hud.toast('⏱ عندك ' + AR(M.limit) + ' ثانية — حط الطلب في الحوض أو الشنطة', 2600); }]];
    } else if (M.stage === 'load') {
      this.phoneDraw(M.C, '⏱ ' + AR(left()) + ' ث', 'حط الطلب في الحوض / الشنطة');
      if (nearRear) M.acts = [[M.open ? '📦 حط الطلب' : '🔓 افتح الحوض / الشنطة', () => { if (!M.open) { M.open = true; g.audio.door(true); return; } car.model.add(M.bag); M.bag.pos.set(0, (car.def.lowY || 0.7) + 0.35, (car.def.zMin || -2) + 0.7); M.bag.rot.identity(); M.holder = 'car'; M.open = false; g.audio.door(false); M.stage = 'drive'; this.api.hud.toast('🔒 سكّرت — يالله وصّل الطلب!', 1800); }]];
    } else if (M.stage === 'drive') {
      if (!M.custNode) { M.nodes.push(M.custNode = this.pillar(M.C.x, M.C.z, [0.2, 0.9, 0.3])); const c = this.person(M.C.x, M.C.z, 0); M.cust = c; M.people.push(c); }
      this.phoneDraw(M.C, '⏱ ' + AR(left()) + ' ث · ' + AR(Math.hypot(M.C.x - p.x, M.C.z - p.z)) + ' م', 'الزبون ينتظرك');
      if (nearRear && M.cust.pos.dist(p) < 40) M.acts = [['📦 طلّع الطلب', () => { this.holdBag(g.player); M.stage = 'hand'; g.audio.door(true); setTimeout(() => g.audio.door(false), 500); }]];
    } else if (M.stage === 'hand') {
      this.phoneDraw(M.C, '⏱ ' + AR(left()) + ' ث', 'سلّم الطلب للزبون');
      if (foot && M.cust.pos.dist(g.player.pos) < 2.4) M.acts = [['🤝 سلّم الطلب', () => this.deliveryDone()]];
    }
  },
  deliveryDone() {
    const g = this.g, M = this.mode, car = g.car; this.holdBag(M.cust); M.stage = 'done';
    const used = M.t - M.t0, ratio = clamp(1 - used / M.limit, -1, 1), dmg = (car.damage || 0) - (M.dmg0 || 0);
    let stars = 5; if (ratio < 0) stars -= 2; else if (ratio < 0.15) stars -= 1; if (dmg > 25) stars -= 2; else if (dmg > 8) stars -= 1; stars = clamp(stars, 1, 5);
    const good = [], bad = []; if (ratio >= 0.15) good.push('وصل بسرعة ⚡'); else if (ratio < 0) bad.push('تأخر عن الوقت ⏱'); if (dmg <= 8) good.push('الطلب وصل سليم 👌'); else bad.push('الطلب انخبط بالطريق 🥤'); good.push('السواق محترم 🙏'); if (stars <= 2) bad.push('الأكل برد 🥶');
    const pay = Math.round(80 + Math.hypot(M.C.x - M.R.x, M.C.z - M.R.z) * 0.2 + stars * 25); this.api.earn(pay); this.api.say('الله يعطيك العافية');
    this.panel((P, btn) => { P.append(el('h3', '', '⭐ تقييم الزبون'), el('p', '', '★'.repeat(stars) + '☆'.repeat(5 - stars)), el('p', '', '👍 ' + good.join(' · ')));
      if (bad.length) P.append(el('p', '', '👎 ' + bad.join(' · '))); P.append(el('p', '', '💵 ربحت ' + AR(pay) + ' ريال'));
      const r = el('div', 'row'); r.append(btn('طلب جديد', () => { this.closePanel(); this.startDelivery(); }, 'go'), btn('خلاص', () => { this.endMode(); })); P.append(r); });
  },
  // ---------------------------------------------------------------- dune race (سباق الطعوس) against a bot, 4x4 locked in
  async startDunes() {
    const g = this.g; this.endMode();
    if (!/desert|linked/.test(g.mapKey || '') && !(g.map && g.map.name === 'desert')) { this.api.hud.toast('🏜️ نروح الصحراء…', 1800); try { await this.api.goMap('desert'); } catch (e) { this.api.hud.toast('ما قدرنا نفتح الصحراء', 1800); return; } }
    const car = g.car, me = car.body.pos, f = car.forward(new V3()); f.y = 0; f.norm();
    // the top: the highest point ahead of you within a few hundred metres
    let S = null; for (let d = 120; d <= 480; d += 30) for (let a = -0.9; a <= 0.9; a += 0.15) { const x = me.x + (f.x * Math.cos(a) - f.z * Math.sin(a)) * d, z = me.z + (f.z * Math.cos(a) + f.x * Math.sin(a)) * d, y = g.world.heightAt(x, z, 200); if (!S || y > S.y) S = new V3(x, y, z); }
    const M = this.mode = { kind: 'dunes', S, nodes: [this.pillar(S.x, S.z, [1, 0.85, 0.1])], t: -3.4, lock4: true, won: null };
    car.lock4 = true; car.dblMode = 'high'; car.tuneRear = Math.min(car.def.rearBias || 0.6, 0.6);
    this.api.hud.toast('🏜️ الدبل معشق إجباري — أول واحد يوصل راس الطعس (العمود الأصفر) يفوز', 3000);
    const k = ['rub', 'lcold', 'fj40'].find(x => CAR_DEFS[x]) || 'rub';
    try { await this.api.ensureCar(k); } catch (e) { }
    const pr = g.pristine && g.pristine[k]; if (!pr || this.mode !== M) return;
    const bc = new (car.constructor)(CAR_DEFS[k], this.api.cloneModel(pr), g.world); bc.key = k + '_dune'; if (g.assets.plate) bc.addPlates(g.assets.plate); bc.snapshotNormals(); bc.dblMode = 'high'; bc.fourWD = true; bc.tuneRear = 0.5;
    const s = car.localToWorld(new V3(-5, 0, 0), new V3()); bc.place(s.x, g.world.heightAt(s.x, s.z, s.y + 4) + 0.4, s.z, g.carYaw()); g.scene.add(bc.node);
    const man = new Character(cloneCharacter(g.manSrc)); bc.node.add(man.root); man.root.pos.copy(g.seatRoot(bc)); man.applyPose(man.poseDrive(0));
    M.bot = { car: bc, man, stuck: 0 }; this.duneBot = M.bot; M.nodes.push(bc.node);
  },
  stepDuneBot(dt) {
    const g = this.g, M = this.mode, B = this.duneBot; if (!M || !B) return; const car = B.car;
    if (M.t < 0 || M.won) { car.step(dt, { throttle: 0, brake: 1, steer: 0, handbrake: true, surfaceGrip: 1, water: null }); return; }
    const loc = car.worldToLocal(M.S, new V3()).sub(car.com), ang = Math.atan2(loc.x, Math.max(loc.z, 0.5)); let th = 1, steer = clamp(-ang * 2, -1, 1);
    if (car.speed < 1 && M.t > 3) B.stuck += dt; else B.stuck = 0; if (B.stuck > 2.5) { car.body.vel.addS(car.forward(new V3()), 4); car.body.vel.y += 1.5; B.stuck = 0; }
    car.step(dt, { throttle: th, brake: 0, steer, handbrake: false, surfaceGrip: 1.15, water: null });
    if (car.speed < 9 && M.t > 2) car.body.vel.addS(car.forward(new V3()), dt * 2.2); // (the bot knows its dunes)
    try { Bots.prototype.bump.call(null, g.car, car); } catch (e) { } car.impacts.length = 0;
  },
  updateDunes(dt) {
    const g = this.g, M = this.mode; if (M.t < 0) { const n = Math.ceil(-M.t); if (n !== M.cd && n <= 3) { M.cd = n; this.bigText(n.toLocaleString('ar-SA'), 800); g.audio.burst && g.audio.burst({ freq: 900, dur: 0.12, gain: 0.25 }); } return; }
    if (!M.go) { M.go = true; this.bigText('دعـــس!', 900); g.audio.burst && g.audio.burst({ freq: 1500, dur: 0.3, gain: 0.3 }); }
    g.car.dblMode = 'high';
    const top = (q) => Math.hypot(q.x - M.S.x, q.z - M.S.z) < 14 && q.y > M.S.y - 4;
    if (!M.won) { if (top(g.car.body.pos)) M.won = 'me'; else if (M.bot && top(M.bot.car.body.pos)) M.won = 'bot';
      if (M.won) { const win = M.won === 'me', pay = win ? 2000 : 200; this.api.earn(pay); this.bigText(win ? '🏆 فزت!' : '😅 سبقك', 2500); this.api.say(win ? 'كفو يا ذيب' : 'سبقك البوت');
        setTimeout(() => { if (this.mode !== M) return; this.panel((P, btn) => { P.append(el('h3', '', win ? '🏆 وصلت راس الطعس أول!' : '😅 البوت وصل قبلك'), el('p', '', '💵 ربحت ' + AR(pay) + ' ريال'));
          const r = el('div', 'row'); r.append(btn('مرة ثانية', () => { this.closePanel(); this.startDunes(); }, 'go'), btn('خلاص', () => this.endMode())); P.append(r); }); }, 2200); } }
    const d = Math.hypot(g.car.body.pos.x - M.S.x, g.car.body.pos.z - M.S.z); if (!M.won) this.api.hud.bottom('🏜️ راس الطعس بعد ' + AR(d) + ' م', 400);
  },
  // ---------------------------------------------------------------- the clothes shop (محل ملابس)
  placeShop() {
    const g = this.g; if (this.shopNode && this.shopNode.parent) this.shopNode.parent.remove(this.shopNode); this.shopSpot = null;
    const sp = g.map && g.map.spawn; if (!sp || g.map.room) return; const yaw = sp.yaw || 0, c = Math.cos(yaw), s = Math.sin(yaw);
    let x = sp.x - c * 14 + s * 4, z = sp.z + s * 14 + c * 4; if (g.map.padsLeft) { x = sp.x + c * 14 + s * 4; z = sp.z - s * 14 + c * 4; }
    this.shopNode = this.booth(x, z, yaw + Math.PI / 2, ['محل ملابس 👕', 'كاب · لطمة · نظارات'], '#1b2a4a', [0.9, 0.88, 0.84]);
    const fz = new V3(Math.sin(yaw + Math.PI / 2), 0, Math.cos(yaw + Math.PI / 2)); this.shopSpot = new V3(x + fz.x * 2.6, 0, z + fz.z * 2.6);
  },
  updateShop() { const g = this.g; if (this.shopMap !== g.map) { this.shopMap = g.map; this.placeShop(); } this.nearShop = !!this.shopSpot && g.playerMode === 'foot' && Math.hypot(g.player.pos.x - this.shopSpot.x, g.player.pos.z - this.shopSpot.z) < 3.2; },
  openShop(cat) {
    const g = this.g, me = g.player, wear = this.api.wear(), owned = this.api.wearOwned(); this.preview = this.preview || { ...wear };
    applyOutfit(me, this.preview); cat = cat || this.shopCat || 'cap'; this.shopCat = cat;
    this.panel((P, btn) => {
      P.append(el('h3', '', '👕 محل الملابس'));
      const tabs = el('div', 'row'); for (const C of SHOP) tabs.append(btn(C.name, () => this.openShop(C.id), C.id === cat ? 'on' : '')); P.append(tabs);
      const C = SHOP.find(q => q.id === cat), grid = el('div', 'grid');
      const none = el('div', 'card'); none.append(el('div', '', 'بدون'), btn(this.preview[cat] ? 'جرّب' : '✔', () => { this.preview[cat] = null; this.openShop(cat); })); if (cat !== 'thobe') grid.append(none);
      for (const [nm, price] of C.items) { const c = el('div', 'card'), has = owned.includes(cat + ':' + nm) || price === 0, on = this.preview[cat] === nm || (cat === 'thobe' && !this.preview.thobe && nm === 'ثوب');
        c.append(el('div', '', nm), el('div', 'note', has ? 'عندك' : '🪙 ' + AR(price)));
        c.append(btn(on ? '✔ لابسه' : 'جرّب', () => { this.preview[cat] = nm === 'ثوب' ? null : nm; this.openShop(cat); }, on ? 'on' : ''));
        if (on && !has) c.append(btn('اشتر', () => { if (!this.api.spend(price)) { this.api.hud.toast('ما عندك فلوس كفاية', 1500); return; } this.api.addWear(cat + ':' + nm); this.api.hud.toast('اشتريت ' + nm + ' ✅', 1500); this.openShop(cat); }, 'go'));
        grid.append(c); }
      P.append(grid);
      const r = el('div', 'row'); r.append(btn('💾 البس اللي اشتريته واطلع', () => this.leaveShop(true), 'go'), btn('اطلع بدون', () => this.leaveShop(false))); P.append(r);
      P.append(el('p', 'note', 'تقدر تجرّب أي شي. إذا طلعت، اللي ما اشتريته يختفي.'));
    });
  },
  leaveShop(save) {
    const owned = this.api.wearOwned(), W = {}; const P = this.preview || {};
    for (const k in P) if (P[k] && (owned.includes(k + ':' + P[k]) || (SHOP.find(c => c.id === k).items.find(i => i[0] === P[k]) || [0, 1])[1] === 0)) W[k] = P[k];
    const keep = save ? W : this.api.wear(); this.api.setWear(keep); applyOutfit(this.g.player, keep); this.preview = null; this.closePanel();
    if (save) this.api.hud.toast('👌 لبست', 1200);
  },
});

// ============================================================================ part 4: the number plate you write yourself
const AR_LAT = { 'ا': 'A', 'ب': 'B', 'ح': 'J', 'د': 'D', 'ر': 'R', 'س': 'S', 'ص': 'X', 'ط': 'T', 'ع': 'E', 'ق': 'G', 'ك': 'K', 'ل': 'L', 'م': 'Z', 'ن': 'N', 'هـ': 'H', 'و': 'U', 'ى': 'V' };
const LAT_AR = Object.fromEntries(Object.entries(AR_LAT).map(([a, l]) => [l, a]));
const AR_DIG = '٠١٢٣٤٥٦٧٨٩';
function plateCanvas(P) {
