  for (const [cx, cy] of [[128, 128], [60, 190], [200, 70]]) {
    for (let k = 0; k < 14; k++) { const a = k / 14 * Math.PI * 2 + r() * 0.3; let x = cx, y = cy; g.beginPath(); g.moveTo(x, y); for (let t = 0; t < 6; t++) { x += Math.cos(a + (r() - 0.5) * 0.6) * (14 + r() * 18); y += Math.sin(a + (r() - 0.5) * 0.6) * (14 + r() * 18); g.lineTo(x, y); } g.stroke(); }
    for (let ring = 1; ring < 5; ring++) { g.beginPath(); for (let k = 0; k <= 14; k++) { const a = k / 14 * Math.PI * 2, rr = ring * 16 + r() * 8; g.lineTo(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr); } g.stroke(); }
  }
  return (_crackTex = { image: c, wrapS: 10497, wrapT: 10497, srgb: true, gl: null });
}

