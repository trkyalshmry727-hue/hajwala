    if (driveCmd === 0 && rpmRoad < 1200) rpmT = Math.max(850, rpmRoad);
    this.rpm += (rpmT - this.rpm) * (1 - Math.exp(-dt * 10));
    if (this.rpm > d.redline) this.rpm = d.redline;
    this.shiftTimer -= dt; this.sinceUp = (this.sinceUp || 0) + dt;
    if (!this.reverse && this.shiftTimer <= 0) {
