      if (best.speed > 3 && g.time - (B.lastDent || 0) > 0.1) { B.lastDent = g.time; car.dent(best.point, best.normal, clamp((best.speed - 2.2) * 0.062, 0.03, 1.05), clamp(0.65 + best.speed * 0.055, 0.65, 2.2), g.r); if (best.speed > 5) g.fx.sparkBurst(best.point, best.normal, best.speed); car.damage = Math.min(100, car.damage + (best.speed - 3) * 4.6); }
