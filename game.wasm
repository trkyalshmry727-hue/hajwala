  const specs = Object.fromEntries(Object.entries(CAR_DEFS).map(([k, d]) => [k, d.spec]));
  const WEATHERS = [['day', 'نهار'], ['night', 'ليل'], ['cloudy', 'غيوم'], ['sunset', 'المغرب'], ['dusk', 'الشفق الأحمر'], ['cycle', 'غيوم متحركة (ليل ونهار)'], ['dust', 'غبار']];
  const MAPS = { riyadh: { name: 'الرياض', sp: 'وسط الرياض الحقيقي · برج المملكة والفيصلية والراجحي' }, furu: { name: 'الفروسية', sp: 'ماب الفروسية من ملفك · الطريق والمطبات والكفرات والأعمدة' }, furusiya: { name: 'الفروسية من تصنيعي', sp: 'شارع الفروسية بالرياض · ٣ مسارات كل جهة · ميدان الفروسية والجنادرية · جمهور' }, city: { name: 'المدينة', sp: 'حارة وتقاطعات وأقماع' }, highway: { name: 'الطريق السريع', sp: '٨ كم · ساهر · جسور ومحطة' }, desert: { name: 'الصحراء', sp: 'طعوس وبيت شعر وتطعيس' }, test: { name: 'التجارب', sp: 'مطبات · درج · كفرين · مويه · طعس · تزحلق · حوادث' }, tram: { name: 'حي الترام', sp: 'حي سكني بعماير شعبية وخط ترام بالنص · طرق وأرصفة' }, spa: { name: 'حلبة سبا', sp: 'حلبة سبا فرانكورشان في بلجيكا · ٧ كم · طلعات ونزلات' }, linked: { name: 'بين المدن', sp: 'التجارب ← المدينة ← الرياض ← الصحراء · كلها ماب واحد وبينها طرق سريعة · محطات وورش على الطريق' } };
  let mapSel = load('hajwala.map', 'city'); if (!MAPS[mapSel]) mapSel = 'city';
