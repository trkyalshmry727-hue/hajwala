}

// ---- traffic fines (ساهر / إشارة / تفتيش): kept until paid, each with a payment deadline
Economy.prototype.addFine = function (kind, amount, name) {
  const t = Date.now(); this.d.fines = this.d.fines || [];
  this.d.fines.unshift({ id: t.toString(36) + Math.random().toString(36).slice(2, 5), kind, name, amount, t, due: t + 30 * 864e5 });
  if (this.d.fines.length > 200) this.d.fines.length = 200;
