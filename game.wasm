#evTimer{position:absolute;top:calc(env(safe-area-inset-top,0px) + 62px);left:50%;transform:translateX(-50%);z-index:9;background:rgba(120,20,14,.88);border:1px solid #ff9a7a;color:#fff;font-weight:900;font-size:18px;padding:5px 14px;border-radius:12px;pointer-events:none;direction:rtl;white-space:nowrap;font-variant-numeric:tabular-nums}
#evBanner{position:absolute;top:calc(env(safe-area-inset-top,0px) + 104px);left:50%;transform:translateX(-50%);z-index:9;background:rgba(15,12,8,.82);border:1px solid rgba(245,194,75,.5);color:#f8d77c;font-weight:800;font-size:17px;padding:8px 16px;border-radius:14px;max-width:80vw;text-align:center;pointer-events:none;direction:rtl}
#evActs{position:absolute;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);left:50%;transform:translateX(-50%);z-index:9;display:flex;gap:8px;direction:rtl}
