        const mix = (a, b, t) => { const n = src.position.length / 3; for (const k of names) { const sz2 = p.attrs[k].size; for (let c = 0; c < sz2; c++) src[k].push(src[k][a * sz2 + c] + (src[k][b * sz2 + c] - src[k][a * sz2 + c]) * t); } return n; };
        const fan = (poly, dst) => { for (let q = 1; q + 1 < poly.length; q++) dst.push(poly[0], poly[q], poly[q + 1]); };
        for (let i = 0; i < I.length; i += 3) {
