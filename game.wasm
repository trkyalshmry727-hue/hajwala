          if (!game.cars[selected]) { hud.toast('نحمّل ' + CAR_DEFS[selected].name + '…', 1500); await ensureCar(selected); }
          if (screen === 'garage') goPlay();
        } catch (e) { hud.toast('ما قدرنا نحمّل السيارة، جرّب مرة ثانية'); }
        startWait = false;
      })();
    }
    else goPlay();
  });
  $('soundBtn').addEventListener('click', () => setMute(!muted));
