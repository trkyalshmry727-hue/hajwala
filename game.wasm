    if (dist > 70 || car.body.pos.y < -20) { const y = g.world.heightAt(tgt.x, tgt.z, tgt.y + 5); car.place(tgt.x, y + 0.1, tgt.z, g.carYaw()); for (const w of car.wheels) w.spinVel = 0; car.body.vel.copy(me.body.vel); return; }
