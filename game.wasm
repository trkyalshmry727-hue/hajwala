      btn('⏱ بعد ٥ دقايق', () => { const e = this.quickEvent(5); this.renderScreen(); if (this.api.hud) this.api.hud.toast('لقينا لك هجولة ' + e.name + ' في ' + MAP_NAME[e.map] + ' الساعة ' + clock(e.start), 2600); }, 'btn ghost'));
