  desert: '<svg class="art" viewBox="0 0 180 100"><defs><linearGradient id="dsk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fc0de"/><stop offset="1" stop-color="#f0d9b0"/></linearGradient></defs><rect width="180" height="100" fill="url(#dsk)"/><circle cx="140" cy="24" r="10" fill="#fff4d6"/><path d="M0 64c30-22 60-22 90 0s60 18 90-6v42H0z" fill="#d9a766"/><path d="M0 80c40-18 70-10 100 4s60 4 80-6v22H0z" fill="#e8bf82"/><path d="M40 60l10-8 10 8z" fill="#3a2d22"/><path d="M130 72v-12M124 62c3-4 9-4 12 0" stroke="#5b6b35" stroke-width="3" fill="none"/></svg>',
};

function pedalSVG(w, h, grooves, kind) {
  const r = 12; let g = '';
  for (let i = 0; i < grooves; i++) { const y = 16 + i * (h - 34) / (grooves - 1); g += `<rect x="12" y="${y.toFixed(1)}" width="${w - 24}" height="5" rx="2.5" fill="#15130f"/>`; }
  const top = kind === 'gas' ? '#9ea3a8' : '#a9a49b';
  return `<svg viewBox="0 0 ${w} ${h + 18}"><defs><linearGradient id="pg${kind}" x1="0" x2="1"><stop offset="0" stop-color="#6b6f73"/><stop offset=".45" stop-color="${top}"/><stop offset="1" stop-color="#55595d"/></linearGradient></defs>
  <rect x="${w / 2 - 7}" y="${h - 4}" width="14" height="22" fill="#2a2724"/>
  <rect x="2" y="2" width="${w - 4}" height="${h - 4}" rx="${r}" fill="url(#pg${kind})" stroke="#23211d" stroke-width="3"/>
  <rect x="7" y="7" width="${w - 14}" height="${h - 14}" rx="${r - 4}" fill="#2c2a26"/>${g}
  <rect x="7" y="7" width="${w - 14}" height="${h - 14}" rx="${r - 4}" fill="none" stroke="${kind === 'gas' ? '#6ea04a' : '#d4412f'}" stroke-width="2.5" opacity=".9"/></svg>`;
}
// on-screen steering wheel, drawn in the style of each car's real wheel (no badges)
function wheelSVG(style = 'lc') {
  const defs = `<defs><radialGradient id="rim" cx=".5" cy=".4" r=".6"><stop offset="0" stop-color="#3d3a35"/><stop offset="1" stop-color="#141311"/></radialGradient>
  <linearGradient id="lea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4a4640"/><stop offset=".5" stop-color="#23211e"/><stop offset="1" stop-color="#191816"/></linearGradient>
  <linearGradient id="sil" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9dde1"/><stop offset="1" stop-color="#7d8388"/></linearGradient></defs>`;
  const mark = '<rect x="94" y="8" width="12" height="20" rx="3" fill="#f5a524"/>';
  if (style === 'lc') // Land Cruiser 70 (Shas / Rub'): wood + grey rim, four spokes, big round horn pad
    return defs + `<defs><linearGradient id="wood" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7a2e14"/><stop offset=".5" stop-color="#4a170a"/><stop offset="1" stop-color="#6b2410"/></linearGradient></defs>
    <circle cx="100" cy="100" r="85" fill="none" stroke="url(#lea)" stroke-width="20"/>
    <path d="M 40 40 A 85 85 0 0 1 160 40" fill="none" stroke="url(#wood)" stroke-width="20"/><path d="M 40 160 A 85 85 0 0 0 160 160" fill="none" stroke="url(#wood)" stroke-width="20"/>
    <path d="M30 88 L70 92 L70 110 L30 112 Z M170 88 L130 92 L130 110 L170 112 Z" fill="url(#rim)"/><path d="M62 160 L82 122 L92 128 L76 170 Z M138 160 L118 122 L108 128 L124 170 Z" fill="url(#rim)"/>
    <ellipse cx="100" cy="106" rx="36" ry="30" fill="url(#rim)" stroke="#56514a" stroke-width="2"/><ellipse cx="100" cy="104" rx="13" ry="9" fill="none" stroke="url(#sil)" stroke-width="2.5"/><ellipse cx="100" cy="104" rx="5" ry="9" fill="none" stroke="url(#sil)" stroke-width="2"/>` + mark;
  if (style === 'changan') // Changan: three spokes, the lower one split in a V, silver inserts, logo
    return defs + `<circle cx="100" cy="100" r="84" fill="none" stroke="url(#lea)" stroke-width="17"/>
    <path d="M22 100 L68 96 L70 114 L24 116 Z M178 100 L132 96 L130 114 L176 116 Z" fill="url(#rim)"/><path d="M84 128 L96 130 L80 176 L66 170 Z M116 128 L104 130 L120 176 L134 170 Z" fill="url(#rim)"/>
    <path d="M88 134 L74 170 M112 134 L126 170" stroke="url(#sil)" stroke-width="2.5"/><path d="M30 106 L66 104 M170 106 L134 104" stroke="url(#sil)" stroke-width="2"/>
    <path d="M70 84 Q100 72 130 84 L128 128 Q100 138 72 128 Z" fill="url(#rim)" stroke="#4d4944" stroke-width="2"/><path d="M90 98 L100 110 L110 98 M86 102 L100 116 L114 102" fill="none" stroke="url(#sil)" stroke-width="2.5"/>` + mark;
  if (style === 'elantra' || style === 'sport') // Elantra 2024: 'H' four spokes (two horizontal, two lower verticals)
    return defs + `<circle cx="100" cy="100" r="84" fill="none" stroke="url(#lea)" stroke-width="17"/>
    <path d="M20 96 L70 92 L70 112 L22 114 Z M180 96 L130 92 L130 112 L178 114 Z" fill="url(#rim)"/><path d="M76 124 L90 124 L88 180 L74 178 Z M124 124 L110 124 L112 180 L126 178 Z" fill="url(#rim)"/>
    <path d="M78 130 L77 172 M122 130 L123 172" stroke="url(#sil)" stroke-width="2"/><rect x="68" y="80" width="64" height="50" rx="16" fill="url(#rim)" stroke="#4d4944" stroke-width="2"/>
    <ellipse cx="100" cy="104" rx="15" ry="9" fill="none" stroke="url(#sil)" stroke-width="2.5"/><path d="M93 99 L93 109 M107 99 L107 109 M93 104 L107 104" stroke="url(#sil)" stroke-width="2"/>` + mark;
  if (style === 'camry') // Camry 2025: three spokes with silver bezels and buttons
    return defs + `<circle cx="100" cy="100" r="84" fill="none" stroke="url(#lea)" stroke-width="16"/>
    <path d="M22 100 L70 94 L72 118 L24 118 Z M178 100 L130 94 L128 118 L176 118 Z" fill="url(#rim)"/><path d="M86 130 L114 130 L108 176 L92 176 Z" fill="url(#rim)"/>
    <rect x="34" y="98" width="30" height="14" rx="5" fill="none" stroke="url(#sil)" stroke-width="2"/><rect x="136" y="98" width="30" height="14" rx="5" fill="none" stroke="url(#sil)" stroke-width="2"/>
    <rect x="68" y="80" width="64" height="54" rx="20" fill="url(#rim)" stroke="#4d4944" stroke-width="2"/><ellipse cx="100" cy="106" rx="15" ry="10" fill="none" stroke="url(#sil)" stroke-width="2.5"/><ellipse cx="100" cy="106" rx="5" ry="10" fill="none" stroke="url(#sil)" stroke-width="2"/>` + mark;
  if (style === 'avanza') // Avanza: plain three-spoke Toyota wheel with a big pad
    return defs + `<circle cx="100" cy="100" r="85" fill="none" stroke="url(#lea)" stroke-width="18"/>
    <path d="M22 98 L66 96 L68 118 L24 118 Z M178 98 L134 96 L132 118 L176 118 Z" fill="url(#rim)"/><path d="M84 132 L116 132 L112 178 L88 178 Z" fill="url(#rim)"/>
    <rect x="62" y="76" width="76" height="62" rx="24" fill="url(#rim)" stroke="#4d4944" stroke-width="2"/><ellipse cx="100" cy="106" rx="16" ry="11" fill="none" stroke="url(#sil)" stroke-width="2.5"/><ellipse cx="100" cy="106" rx="5.5" ry="11" fill="none" stroke="url(#sil)" stroke-width="2"/>` + mark;
  if (style === 'hilux') // Hilux: three spokes with silver trim and buttons
    return defs + `<circle cx="100" cy="100" r="85" fill="none" stroke="url(#lea)" stroke-width="18"/>
    <path d="M22 100 L66 96 L70 116 L24 118 Z M178 100 L134 96 L130 116 L176 118 Z" fill="url(#rim)"/><path d="M88 128 L112 128 L110 176 L90 176 Z" fill="url(#rim)"/>
    <path d="M40 104 L64 102 M160 104 L136 102" stroke="url(#sil)" stroke-width="3"/><rect x="66" y="80" width="68" height="56" rx="22" fill="url(#rim)" stroke="#5c5750" stroke-width="2"/>
    <circle cx="48" cy="110" r="4" fill="#8a8f94"/><circle cx="152" cy="110" r="4" fill="#8a8f94"/>` + mark;
  if (style === 'sport') // Elantra N: flat-bottom sport wheel, red stitching and drive-mode buttons
    return defs + `<path d="M100 15 A85 85 0 0 1 176 140 L160 172 L40 172 L24 140 A85 85 0 0 1 100 15 Z" fill="none" stroke="url(#lea)" stroke-width="18" stroke-linejoin="round"/>
    <path d="M100 15 A85 85 0 0 1 176 140" fill="none" stroke="#c0282d" stroke-width="1.6" stroke-dasharray="4 4" opacity=".9"/><path d="M100 15 A85 85 0 0 0 24 140" fill="none" stroke="#c0282d" stroke-width="1.6" stroke-dasharray="4 4" opacity=".9"/>
    <path d="M24 104 L68 98 L72 120 L28 124 Z M176 104 L132 98 L128 120 L172 124 Z" fill="url(#rim)"/><path d="M84 132 L116 132 L112 168 L88 168 Z" fill="url(#rim)"/>
    <rect x="70" y="86" width="60" height="48" rx="12" fill="url(#rim)" stroke="#55504a" stroke-width="2"/><circle cx="48" cy="112" r="6" fill="#1f5fd1"/><circle cx="152" cy="112" r="6" fill="#1f5fd1"/>` + mark;
  // modern sedan (Changan): three slim spokes with silver accents
  return defs + `<circle cx="100" cy="100" r="84" fill="none" stroke="url(#lea)" stroke-width="16"/>
    <path d="M24 102 L70 100 L72 114 L26 116 Z M176 102 L130 100 L128 114 L174 116 Z" fill="url(#rim)"/><path d="M92 126 L108 126 L106 172 L94 172 Z" fill="url(#rim)"/>
    <path d="M30 108 L68 107 M170 108 L132 107 M100 132 L100 166" stroke="url(#sil)" stroke-width="2.5"/><ellipse cx="100" cy="106" rx="30" ry="24" fill="url(#rim)" stroke="url(#sil)" stroke-width="2"/>` + mark;
}
// round analog speedometer + tacho arc (real speed, 0-220 km/h)
function speedoSVG() {
  let t = '';
  for (let v = 0; v <= 220; v += 10) {
    const a = (-225 + v / 220 * 270) * Math.PI / 180, big = v % 20 === 0;
    const r1 = big ? 70 : 74, r2 = 82;
    t += `<line x1="${100 + Math.cos(a) * r1}" y1="${100 + Math.sin(a) * r1}" x2="${100 + Math.cos(a) * r2}" y2="${100 + Math.sin(a) * r2}" stroke="${v >= 180 ? '#d4412f' : '#ecdcbc'}" stroke-width="${big ? 3 : 1.5}"/>`;
    if (v % 40 === 0) t += `<text x="${100 + Math.cos(a) * 58}" y="${100 + Math.sin(a) * 58 + 5}" fill="#ecdcbc" font-size="14" font-weight="700" text-anchor="middle" font-family="Readex Pro,Tahoma,sans-serif">${v.toLocaleString('ar-SA')}</text>`;
  }
  return `<defs><radialGradient id="dial" cx=".5" cy=".45" r=".6"><stop offset="0" stop-color="#2b2821"/><stop offset="1" stop-color="#0f0e0b"/></radialGradient></defs>
  <circle cx="100" cy="100" r="96" fill="url(#dial)" stroke="#57524a" stroke-width="3"/>
  <path id="rpmArc" d="" fill="none" stroke="#f5a524" stroke-width="5" stroke-linecap="round" opacity=".85"/>
  ${t}
  <text x="100" y="136" fill="#ecdcbc" font-size="30" font-weight="700" text-anchor="middle" font-family="Lalezar,Readex Pro,Tahoma,sans-serif" id="spd">٠</text>
  <text x="100" y="152" fill="#b9a888" font-size="11" text-anchor="middle" font-family="Readex Pro,Tahoma,sans-serif">كم/س</text>
  <text x="100" y="80" fill="#f5a524" font-size="20" font-weight="700" text-anchor="middle" font-family="Lalezar,Readex Pro,Tahoma,sans-serif" id="gear">N</text>
  <rect id="dmgBar" x="70" y="164" width="0" height="4" rx="2" fill="#d4412f"/>
  <g id="needle"><path d="M97 100 L100 26 L103 100 Z" fill="#d4412f"/><circle cx="100" cy="100" r="9" fill="#2a2724" stroke="#ecdcbc" stroke-width="2"/></g>`;
}

// ---------------- HUD ----------------
class HUD {
  constructor() { this.tt = null; this.driftHide = null; }
  toast(msg, ms = 1800) { const t = $('toast'); t.textContent = msg; t.classList.add('on'); clearTimeout(this.tt); this.tt = setTimeout(() => t.classList.remove('on'), ms); }
  setNearDoor(on) { $('enterBtn').classList.toggle('hot', !!on); }
  drift(pts, combo, a, cancel) {
    const b = $('driftBox');
    if (cancel) { b.classList.remove('on'); return; }
    clearTimeout(this.driftHide);
    b.classList.remove('fail'); b.classList.add('on');
    $('driftLbl').textContent = a > 1.1 ? 'تفحيط خطير!' : a > 0.7 ? 'هجولة!' : 'زحلقة';
    $('driftPts').textContent = pts.toLocaleString('ar-SA'); $('driftX').textContent = '×' + combo;
  }
  driftBank(pts) {
    $('driftLbl').textContent = 'انحسبت!'; $('driftPts').textContent = '+' + pts.toLocaleString('ar-SA');
    clearTimeout(this.driftHide); this.driftHide = setTimeout(() => $('driftBox').classList.remove('on'), 1400);
  }
  driftFail() {
    const b = $('driftBox'); b.classList.add('fail', 'on'); $('driftLbl').textContent = 'خربت الهجولة'; $('driftPts').textContent = '0';
    clearTimeout(this.driftHide); this.driftHide = setTimeout(() => b.classList.remove('on', 'fail'), 1400);
  }
}

// ---------------- asset loading ----------------
// several models can ship inside one pack file: 'pack.wasm#offset:length' (one download, sliced here)
const PACKS = {};
async function fetchPacked(url, onBytes) {
  const [file, range] = url.split('#'); const [off, len] = range.split(':').map(Number);
  if (!PACKS[file] && file === 'embedded' && window.__PACK__) { // models shipped inside the game file itself (base64)
    const bs = atob(window.__PACK__); const u8 = new Uint8Array(bs.length); for (let i = 0; i < bs.length; i++) u8[i] = bs.charCodeAt(i);
    window.__PACK__ = null; PACKS[file] = Promise.resolve(u8.buffer);
  }
  if (!PACKS[file]) PACKS[file] = fetch(file).then(r => { if (!r.ok) throw new Error('تعذر تحميل ' + file + ' (' + r.status + ')'); return r.arrayBuffer(); });
  let buf; try { buf = await PACKS[file]; } catch (e) { delete PACKS[file]; throw e; }
  onBytes(len); return new Uint8Array(buf, off, len);
}
async function fetchParts(parts, onBytes) {
  const bufs = [];
  for (const url of parts) {
    if (url.includes('#')) { bufs.push(await fetchPacked(url, onBytes)); continue; }
    const res = await fetch(url);
    if (!res.ok) throw new Error('تعذر تحميل ' + url + ' (' + res.status + ')');
    if (res.body && res.body.getReader) {
      const rd = res.body.getReader(); const chunks = []; let n = 0;
      for (;;) { const { done, value } = await rd.read(); if (done) break; chunks.push(value); n += value.length; onBytes(value.length); }
      const out = new Uint8Array(n); let o = 0; for (const c of chunks) { out.set(c, o); o += c.length; } bufs.push(out);
    } else { const b = new Uint8Array(await res.arrayBuffer()); onBytes(b.length); bufs.push(b); }
  }
  if (bufs.length === 1) return bufs[0].buffer.slice(bufs[0].byteOffset, bufs[0].byteOffset + bufs[0].byteLength);
  const total = bufs.reduce((a, b) => a + b.length, 0); const out = new Uint8Array(total); let o = 0; for (const b of bufs) { out.set(b, o); o += b.length; }
  return out.buffer;
}

async function boot() {
  const MANIFEST = window.__MANIFEST__;
  const hud = new HUD();
  const canvas = $('view');
  let renderer;
  try { renderer = new Renderer(canvas); }
  catch (e) { $('loadErr').hidden = false; $('loadErr').textContent = 'جهازك ما يدعم WebGL2 — جرّب متصفح سفاري أو كروم محدّث.'; return; }
  const isMobile = /iPhone|iPad|Android|Mobile/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && window.innerWidth < 1100);
  const QUALITY = {
    ultra: { pr: 2, shadow: 4096, range: 80, post: true },
    high: { pr: isMobile ? 1.6 : 2, shadow: 2048, range: 55 },
    mid: { pr: isMobile ? 1.25 : 1.5, shadow: 2048, range: 45 },
    low: { pr: 1, shadow: 1024, range: 35 },
  };
  let quality = 'high', resScale = 1, dynT = 0, dynN = 0;
  try { resScale = +(localStorage.getItem('hajwala.res') || 1) || 1; } catch (e) { }
  try { quality = localStorage.getItem('hajwala.q') || (isMobile ? 'mid' : 'high'); } catch (e) { quality = isMobile ? 'mid' : 'high'; }
  const applyQuality = (q) => {
    quality = q = QUALITY[q] ? q : 'high'; const Q = QUALITY[q]; renderer.post = !!Q.post; renderer.pixelRatio = Math.min(window.devicePixelRatio || 1, Q.pr) * resScale; renderer.shadowRange = Q.range;
    if (renderer.shadowSize !== Q.shadow) { renderer.shadowSize = Q.shadow; renderer.initShadow(); }
    try { localStorage.setItem('hajwala.q', q); localStorage.setItem('hajwala.res', String(resScale)); } catch (e) { }
  };
  applyQuality(quality);

  // loading slideshow with pictures from the game
  let shotTimer = null;
  if (MANIFEST.shots && MANIFEST.shots.length) {
    const box = $('shots'); const imgs = MANIFEST.shots.map((u, i) => { const im = document.createElement('img'); im.alt = ''; im.decoding = 'async'; im.src = u; if (!i) im.className = 'on'; box.append(im); return im; });
    let k = 0; shotTimer = setInterval(() => { imgs[k].classList.remove('on'); k = (k + 1) % imgs.length; imgs[k].classList.add('on'); }, 3200);
  }
  // load the map, the character and only the car you drive; the other cars follow in the background after the menu is up
  let startCar = 'shas'; try { const s0 = localStorage.getItem('hajwala.car'); if (s0 && CAR_DEFS[s0]) startCar = s0; } catch (e) { }
  const LATER = new Set(Object.keys(CAR_DEFS).filter(k => k !== startCar && k !== 'shas' && MANIFEST.files[k]));
  { const intOf = (k) => CAR_DEFS[k] && CAR_DEFS[k].extInt && CAR_DEFS[k].extInt.asset; const now = new Set([intOf(startCar), intOf('shas')].filter(Boolean));
    for (const k of [...LATER]) { const a = intOf(k); if (a && !now.has(a) && MANIFEST.files[a]) LATER.add(a); } }
  const sizeOf = (k) => MANIFEST.sizes && MANIFEST.sizes[k] || 0;
  const total = Object.keys(MANIFEST.files).filter(k => !(MANIFEST.lazy && k in MANIFEST.lazy) && !LATER.has(k)).reduce((a, k) => a + (sizeOf(k) || 1), 0); let got = 0;
  const bar = $('loadBar'), txt = $('loadText');
  const onBytes = (n) => { got += n; const p = Math.min(1, got / total); bar.style.width = (p * 100).toFixed(1) + '%'; txt.textContent = `نحمّل السيارات والمدينة… ${Math.round(p * 100)}٪`; };
  const assets = {};
  try {
    const entries = Object.entries(MANIFEST.files).filter(([k]) => !(MANIFEST.lazy && k in MANIFEST.lazy) && !LATER.has(k));
    const bufs = await Promise.all(entries.map(([k, parts]) => fetchParts(parts, onBytes)));
    txt.textContent = 'نجهّز الجرافيكس…';
    for (let i = 0; i < entries.length; i++) assets[entries[i][0]] = await parseGLB(bufs[i]);
  } catch (e) {
    console.error(e); $('loadErr').hidden = false; $('loadErr').textContent = 'صار خطأ في التحميل: ' + e.message + ' — حدّث الصفحة وجرّب مرة ثانية.'; return;
  }

  const audio = new Audio();
  const fx = new FX(renderer);
  const input = new Input();
  Car.assets = assets; // (cabins fitted into cars at load time)
  const game = new Game(renderer, audio, fx, assets, input, hud);
  window.__game = game;
  try { const w = localStorage.getItem('hajwala.night'); if (w && w !== 'day') game.setWeather(w); } catch (e) { }
  try { if (localStorage.getItem('hajwala.people') === 'off') game.setPeople(false); } catch (e) { }
  try { Car.handling = localStorage.getItem('hajwala.handling') === 'new' ? 'new' : 'old'; } catch (e) { }

  // ---------- UI wiring ----------
  $('carsBtn').innerHTML = ICON.car + '<span>السيارات</span>';
  $('soundBtn').innerHTML = ICON.sound; $('settingsBtn').innerHTML = ICON.gear; $('backBtn').innerHTML = ICON.back;
  $('pauseBtn').innerHTML = ICON.menu; $('resetBtn').innerHTML = ICON.reset; $('hornBtn').innerHTML = ICON.horn; $('repairBtn').innerHTML = ICON.wrench; $('camBtn2').innerHTML = ICON.camera; $('droneBtn').innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="5" cy="6" r="2.5"/><circle cx="19" cy="6" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><rect x="9" y="9.5" width="6" height="5" rx="1.5"/><path d="M7 8l2 2M17 8l-2 2M7 16l2-2M17 16l-2-2"/></svg>'; $('shotBtn').innerHTML = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>';
  $('doorBtn').innerHTML = ICON.door; $('enterBtn').innerHTML = ICON.enter; $('kickBtn').innerHTML = ICON.kick; $('handbrake').innerHTML = ICON.handbrake;
  $('gas').innerHTML = pedalSVG(78, 150, 7, 'gas'); $('brake').innerHTML = pedalSVG(112, 96, 4, 'brake');
  $('wheel').innerHTML = wheelSVG(CAR_DEFS.shas.wheelStyle);
  $('speedo').innerHTML = speedoSVG();
  const arrowIcon = (d) => `<svg viewBox="0 0 32 32"><path d="${d > 0 ? 'M11 6l12 10-12 10z' : 'M21 6L9 16l12 10z'}" fill="#ecdcbc"/></svg>`;
  $('stL').innerHTML = arrowIcon(-1); $('stR').innerHTML = arrowIcon(1);

  let muted = false;
  try { muted = localStorage.getItem('hajwala.mute') === '1'; } catch (e) { }
  const setMute = (m) => { muted = m; audio.setMuted(m); $('soundBtn').innerHTML = m ? ICON.mute : ICON.sound; try { localStorage.setItem('hajwala.mute', m ? '1' : '0'); } catch (e) { } };
  setMute(muted);
  const unlockAudio = () => { audio.init(); audio.setMuted(muted); };
  window.addEventListener('pointerdown', unlockAudio, { capture: true });
  window.addEventListener('keydown', unlockAudio, { capture: true });

  const steering = bindSteering($('wheel'), input);
  try { input.pedalFull = localStorage.getItem('hajwala.pedal') === 'full'; } catch (e) { }
  const gasP = bindPedal($('gas'), input, 'touchGas'), brakeP = bindPedal($('brake'), input, 'touchBrake');
  const arrows = bindArrows($('stL'), $('stR'), input);
  // never leave a pedal or the wheel stuck when the app loses focus or a touch gets lost
  const releaseAll = () => { gasP.release(); brakeP.release(); arrows.release(); steering.reset(); input.touchHB = false; $('handbrake').classList.remove('down'); };
  document.addEventListener('visibilitychange', releaseAll); window.addEventListener('blur', releaseAll);
  window.addEventListener('touchend', (e) => { if (!e.touches.length) releaseAll(); }, { passive: true });
  bindHold($('handbrake'), () => { input.touchHB = true; }, () => { input.touchHB = false; });
  bindHold($('kickBtn'), () => input.pressed.add('kick'));
  bindHold($('dUp'), () => { input.droneUp = 1; }, () => { input.droneUp = 0; });
  bindHold($('dDown'), () => { input.droneDown = 1; }, () => { input.droneDown = 0; });
  bindTap($('doorBtn'), () => input.pressed.add('door'));
  bindTap($('enterBtn'), () => input.pressed.add('door'));
  bindTap($('resetBtn'), () => input.pressed.add('reset'));
  bindTap($('repairBtn'), () => input.pressed.add('repair'));
  bindTap($('camBtn2'), () => input.pressed.add('camera'));
  bindTap($('droneBtn'), () => { const on = game.toggleDrone(); $('droneBtn').classList.toggle('on', on); $('shotBtn').hidden = !on; });
  bindTap($('shotBtn'), () => { game.snap = true; });
  bindTap($('moveCarBtn'), () => { // drone: drop the car under the drone
    const D = game.drone; if (!D) return; const car = game.car; const f = new V3(Math.sin(D.yaw), 0, Math.cos(D.yaw));
    const x = D.pos.x + f.x * 6, z = D.pos.z + f.z * 6, y = game.world.heightAt(x, z, D.pos.y + 5);
    car.place(x, y + 0.4, z, D.yaw); for (const w of car.wheels) { w.spinVel = 0; w.sink = 0; }
    hud.toast('نقلنا السيارة 👍', 1200);
  });
  // tyre pressure (on foot next to a wheel)
  let hiss = null;
  const hissOn = (on) => {
    const ctx = audio.ctx; if (!ctx) return;
    if (on && !hiss) { const len = ctx.sampleRate; const buf = ctx.createBuffer(1, len, ctx.sampleRate); const d = buf.getChannelData(0); for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = buf; src.loop = true; const f = ctx.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = 2500; const g = ctx.createGain(); g.gain.value = 0.18;
      src.connect(f); f.connect(g); g.connect(ctx.destination); src.start(); hiss = { src, g }; }
    else if (!on && hiss) { try { hiss.src.stop(); } catch (e) { } hiss = null; }
  };
  const tyreUI = () => {
    const near = screen === 'play' && game.playerMode === 'foot' && game.nearWheel >= 0 && !game.drone;
    $('tyreBtn').hidden = !near || !$('tyrePanel').hidden;
    if (!$('tyrePanel').hidden) { if (!near) { $('tyrePanel').hidden = true; game.deflating = false; hissOn(false); } else { const w = game.car.wheels[game.nearWheel]; $('psiVal').textContent = Math.round(w.psi).toLocaleString('ar-SA'); } }
    $('moveCarBtn').hidden = !game.drone;
  };
  setInterval(tyreUI, 120);
  bindTap($('tyreBtn'), () => { $('tyrePanel').hidden = false; tyreUI(); });
  bindTap($('tyreClose'), () => { $('tyrePanel').hidden = true; game.deflating = false; hissOn(false); });
  { const b = $('deflateBtn'); const on = (e) => { e.preventDefault(); game.deflating = true; hissOn(true); }, off = () => { game.deflating = false; hissOn(false); };
    b.addEventListener('pointerdown', on); for (const t of ['pointerup', 'pointercancel', 'pointerleave']) b.addEventListener(t, off); }
  bindHold($('hornBtn'), () => { audio.horn(true); }, () => { audio.horn(false); });
  bindJoystick($('joy'), $('joyKnob'), input);
  bindCameraDrag(canvas, input);

  const show = (id, on) => { $(id).hidden = !on; };
  const econ = new Economy(); window.__econ = econ;
  let selected = 'shas';
  try { const s = localStorage.getItem('hajwala.car'); if (s && CAR_DEFS[s]) selected = s; } catch (e) { }
  if (!econ.owns(selected) && !(CAR_PRICE[selected] || {}).own) selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas';

  // ---------- persisted settings ----------
  const load = (k, d) => { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } };
  const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } };
  const nf = (x, d = 1) => Number(x).toLocaleString('ar-SA', { minimumFractionDigits: d, maximumFractionDigits: d });

  const steerCfg = Object.assign({ sens: 5, ret: 7, curve: 1, size: 1, mode: 'wheel' }, load('hajwala.steer2', {}));
  const applySteer = () => {
    STEER_OPTS.max = 3 * Math.PI * clamp(1.4 - (steerCfg.sens - 1) * 0.1, 0.4, 1.5); STEER_OPTS.ret = steerCfg.ret; STEER_OPTS.curve = steerCfg.curve;
    $('wheelWrap').style.width = $('wheelWrap').style.height = `calc(min(42vh, 210px) * ${steerCfg.size})`;
    input.useArrows = steerCfg.mode === 'arrows';
    $('wheelWrap').hidden = input.useArrows; $('arrows').hidden = !input.useArrows;
    save('hajwala.steer2', steerCfg);
  };
  applySteer();
  const camCfg = Object.assign({ mode: 0, custom: null }, load('hajwala.cam', {}));
  let savedCams = load('hajwala.cams', []); if (!Array.isArray(savedCams)) savedCams = [];
  game.camMode = camCfg.mode; game.camCustom = camCfg.custom;
  if (game.camMode === 4 && !game.camCustom) game.camMode = 0;
  const saveCam = () => { camCfg.mode = game.camMode; camCfg.custom = game.camCustom; save('hajwala.cam', camCfg); };

  // ---------- garage: cars + maps as a compact bottom strip ----------
  const specs = Object.fromEntries(Object.entries(CAR_DEFS).map(([k, d]) => [k, d.spec]));
  const WEATHERS = [['day', 'نهار'], ['night', 'ليل'], ['cloudy', 'غيوم'], ['sunset', 'المغرب'], ['dusk', 'الشفق الأحمر']];
  const MAPS = { riyadh: { name: 'الرياض', sp: 'وسط الرياض الحقيقي · برج المملكة والفيصلية والراجحي' }, city: { name: 'المدينة', sp: 'حارة وتقاطعات وأقماع' }, highway: { name: 'الطريق السريع', sp: '٨ كم · ساهر · جسور ومحطة' }, desert: { name: 'الصحراء', sp: 'طعوس وبيت شعر وتطعيس' }, test: { name: 'التجارب', sp: 'مطبات · درج · كفرين · مويه · طعس · تزحلق · حوادث' }, linked: { name: 'بين المدن', sp: 'التجارب ← المدينة ← الرياض ← الصحراء · كلها ماب واحد وبينها طرق سريعة · محطات وورش على الطريق' } };
  let mapSel = load('hajwala.map', 'city'); if (!MAPS[mapSel]) mapSel = 'city';
  let mapBusy = false;
  const LAZY_FOR = { riyadh: ['riyadh', 'mall'], linked: ['riyadh', 'mall'], hero: ['hero'], caravan: ['caravan'] };
  const ensureMapAssets = async (key, onP) => {
    for (const k of LAZY_FOR[key] || []) {
      if (assets[k]) continue;
      const total = MANIFEST.lazy[k]; let got = 0;
      const buf = await fetchParts(MANIFEST.files[k], (n) => { got += n; onP(Math.min(1, got / total)); });
      assets[k] = await parseGLB(buf);
    }
  };
  const strip = $('carStrip'), mstrip = $('mapStrip');
  for (const key of Object.keys(CAR_DEFS)) {
    const card = document.createElement('button'); card.className = 'card'; card.dataset.key = key;
    const img = document.createElement('img'); img.alt = CAR_DEFS[key].name;
    if (game.cars[key]) { try { img.src = game.thumbnail(key); } catch (e) { console.warn(e); } } else if (MANIFEST.thumbs && MANIFEST.thumbs[key]) img.src = MANIFEST.thumbs[key]; else card.classList.add('loading');
    card.append(img);
    const nm = document.createElement('div'); nm.className = 'nm'; nm.textContent = CAR_DEFS[key].name; card.append(nm);
    const lk = document.createElement('div'); lk.className = 'lock'; card.append(lk);
    card.addEventListener('click', async () => {
      if (!game.cars[key]) { hud.toast('نحمّل ' + CAR_DEFS[key].name + '…', 1500); try { await ensureCar(key); } catch (e) { hud.toast('ما قدرنا نحمّل السيارة، جرّب مرة ثانية'); return; } }
      selected = key; try { localStorage.setItem('hajwala.car', key); } catch (e) { } refreshCards(); game.showroom(key); game.mode = 'garage';
    });
    strip.append(card);
  }
  // thumbnails again once textures/shaders are ready (on some phones the first pass comes out empty/blue)
  const reThumb = () => { for (const img of strip.querySelectorAll('img')) { const k = img.closest('.card').dataset.key; if (!game.cars[k]) continue; try { img.src = game.thumbnail(k); } catch (e) { } } };
  setTimeout(reThumb, 2500); setTimeout(reThumb, 8000);
  // ---- the other cars: loaded one by one in the background, or right away when you pick one ----
  const carLoads = {};
  const ensureCar = (k) => {
    if (game.cars[k]) return Promise.resolve(game.cars[k]);
    if (!carLoads[k]) carLoads[k] = (async () => {
      const ia = CAR_DEFS[k].extInt && CAR_DEFS[k].extInt.asset;
      if (ia && !assets[ia] && MANIFEST.files[ia]) { if (!carLoads[ia]) carLoads[ia] = fetchParts(MANIFEST.files[ia], () => { }).then(parseGLB).then(g => { assets[ia] = g; }); await carLoads[ia]; }
      const buf = await fetchParts(MANIFEST.files[k], () => { });
      assets[k] = await parseGLB(buf); const car = game.addCar(k);
      try { const T = load('hajwala.tune', {})[k]; if (T) car.applyTune(T); } catch (e) { }
      const card = strip.querySelector(`.card[data-key="${k}"]`); if (card) { card.classList.remove('loading'); try { card.querySelector('img').src = game.thumbnail(k); } catch (e) { } }
      return car;
    })().catch(e => { delete carLoads[k]; throw e; });
    return carLoads[k];
  };
  game.needCar = (k) => { if (CAR_DEFS[k] && !game.cars[k]) ensureCar(k).catch(() => { }); };
  // the other cars and the animated character come in right after the menu shows, a few at a time
  (async () => {
    await new Promise(r => setTimeout(r, 300));
    const heroP = ensureMapAssets('hero', () => { }).then(() => game.prewarmHero()).catch(() => { });
    const q = [...LATER]; const worker = async () => { while (q.length) { const k = q.shift(); try { await ensureCar(k); } catch (e) { console.warn(e); } await new Promise(r => setTimeout(r, 30)); } };
    await Promise.all([worker(), worker(), worker(), heroP]);
  })();
  for (const key of Object.keys(MAPS)) {
    const card = document.createElement('button'); card.className = 'card'; card.dataset.key = key;
    card.innerHTML = MAP_ART[key] + `<div class="nm">${MAPS[key].name}</div>`;
    card.addEventListener('click', async () => {
      if (mapSel === key || mapBusy) return;
      mapBusy = true;
      try {
        await ensureMapAssets(key, (p) => { $('gSpec').textContent = `نحمّل ${MAPS[key].name}… ${Math.round(p * 100).toLocaleString('ar-SA')}٪`; });
        $('gSpec').textContent = 'نجهّز الخريطة…';
        await new Promise(r => setTimeout(r, 40));
        game.loadMap(key); mapSel = key; save('hajwala.map', key);
        game.showroom(selected); game.mode = 'garage';
      } catch (e) { console.error(e); hud.toast('ما قدرنا نحمّل الخريطة، جرّب مرة ثانية'); }
      mapBusy = false; refreshCards();
    });
    mstrip.append(card);
  }
  let gTab = 'cars';
  const LOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="#ecdcbc" stroke-width="2.2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
  const COIN = '<svg viewBox="0 0 24 24" width="18" height="18" style="vertical-align:-3px"><circle cx="12" cy="12" r="10" fill="#b8bec6" stroke="#6d737b" stroke-width="1.5"/><path d="M12 8v8M9.5 10.5h5" stroke="#6d737b" stroke-width="1.6" stroke-linecap="round"/></svg>';
  const KEYI = '<svg viewBox="0 0 24 24" width="18" height="18" style="vertical-align:-3px"><circle cx="8" cy="12" r="5" fill="none" stroke="#f4c542" stroke-width="2.6"/><path d="M12.5 12H22M18.5 12v3.5" stroke="#f4c542" stroke-width="2.6" stroke-linecap="round"/></svg>';
  const priceHTML = (st) => st.store ? '🛒 المتجر' : st.keys ? KEYI + ' ' + fmt(st.keys) : st.money !== undefined ? COIN + ' ' + fmt(st.money) : '';
  const carState = (k) => { const st = econ.carState(k); if (UNLIMITED && st.needLevel) { const P = CAR_PRICE[k]; return { ...st, needLevel: 0, lvlNote: P.level, keys: P.keys, money: P.keys ? undefined : P.money || 0 }; } return st; };
  const refreshCards = () => {
    strip.querySelectorAll('.card').forEach(c => { const st = carState(c.dataset.key), lk = c.querySelector('.lock'); if (!lk) return; lk.hidden = st.owned;
      if (!st.owned) lk.innerHTML = LOCK + '<span>' + (st.needLevel ? 'مستوى ' + st.needLevel.toLocaleString('ar-SA') : priceHTML(st)) + '</span>' + (st.lvlNote ? '<small style="opacity:.7">مستوى ' + st.lvlNote.toLocaleString('ar-SA') + '</small>' : ''); });
    strip.querySelectorAll('.card').forEach(c => c.classList.toggle('sel', c.dataset.key === selected));
    mstrip.querySelectorAll('.card').forEach(c => c.classList.toggle('sel', c.dataset.key === mapSel));
    $('gTitle').textContent = gTab === 'cars' ? 'اختار سيارتك' : 'اختار الماب'; $('startBtn2').textContent = gTab === 'cars' ? 'التالي' : 'يلا نبدأ';
    if (gTab === 'cars') { const st = carState(selected); if (!st.owned) $('startBtn2').innerHTML = st.store ? 'اذهب إلى المتجر' : st.needLevel ? 'مستوى ' + st.needLevel.toLocaleString('ar-SA') + ' 🔒' : 'اشترها ' + priceHTML(st); }
    strip.hidden = gTab !== 'cars'; mstrip.hidden = gTab !== 'maps';
    $('gName').textContent = gTab === 'cars' ? CAR_DEFS[selected].name : MAPS[mapSel].name;
    $('gSpec').textContent = gTab === 'cars' ? specs[selected] || '' : MAPS[mapSel].sp;
  };
  if (mapSel !== 'city') { if (LAZY_FOR[mapSel]) { const want = mapSel; mapSel = 'city'; ensureMapAssets(want, () => { }).then(() => { if (mapSel === 'city' && screen !== 'play') { game.loadMap(want); mapSel = want; if (screen !== 'play') { game.showroom(selected); if (screen === 'garage') game.mode = 'garage'; } refreshCards(); } }).catch(() => { }); } else game.loadMap(mapSel); }

  let screen = 'menu';
  const dropDrone = () => { game.drone = null; $('shotBtn').hidden = true; $('droneBtn').classList.remove('on'); };
  const goMenu = () => { game.chal = null; game.tuneView = false; show('tune', false); show('chars', false); game.menuHold = false; dropDrone(); if (game.net) game.net.leaveSession(); screen = 'menu'; game.paused = false; game.showroom(selected); show('menu', true); show('garage', false); $('hud').classList.remove('on'); show('pause', false); };
  const goGarage = (tab) => { dropDrone(); if (game.net) game.net.leaveSession(); gTab = tab === 'maps' ? 'maps' : 'cars'; screen = 'garage'; game.paused = false; game.showroom(selected); game.mode = 'garage'; refreshCards(); show('menu', false); show('pause', false); $('hud').classList.remove('on'); show('garage', true); };
  const goPlay = () => {
    if (typeof carState === 'function' && !carState(selected).owned) selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas';
    game.tuneView = false; show('tune', false); show('chars', false); screen = 'play'; unlockAudio(); show('menu', false); show('garage', false); show('pause', false); $('hud').classList.add('on');
    $('wheel').innerHTML = wheelSVG(CAR_DEFS[selected].wheelStyle);
    game.showroom(selected); game.start();
    hud.toast(mapSel === 'highway' ? 'انتبه لساهر فوق ١٢٠!' : 'دوس بنزين وتوكل على الله', 2200);
    try { navigator.wakeLock && navigator.wakeLock.request('screen').catch(() => { }); } catch (e) { }
  };
  hud.flash = () => { const f = $('flash'); f.classList.add('on'); requestAnimationFrame(() => requestAnimationFrame(() => f.classList.remove('on'))); };
  $('carsBtn').addEventListener('click', () => { garageFrom = 'menu'; goGarage('cars'); });
  $('backBtn').addEventListener('click', () => { if (gTab === 'maps' && garageFrom === 'cars') { gTab = 'cars'; refreshCards(); } else goMenu(); });
  let garageFrom = 'menu';
  $('startBtn').addEventListener('click', () => { if (!carState(selected).owned) { selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas'; } garageFrom = 'menu'; goGarage('maps'); });
  $('startBtn2').addEventListener('click', () => {
    if (gTab === 'cars') {
      const st = carState(selected);
      if (!st.owned) {
        if (st.store) { openStore('cars'); return; }
        if (st.needLevel) { hud.toast('توصل المستوى ' + st.needLevel.toLocaleString('ar-SA') + ' وتقدر تشتريها', 2000); return; }
        const why = UNLIMITED ? (econ.grant(selected), '') : econ.buyCar(selected);
        if (why === 'money') { hud.toast('فلوسك ما تكفي — اشتر فلوس من المتجر', 2200); return; }
        if (why === 'keys') { hud.toast('مفاتيحك ما تكفي — المتجر فيه مفاتيح', 2200); return; }
        refreshCards(); showGift(selected); return;
      }
      garageFrom = 'cars'; gTab = 'maps'; refreshCards();
    } else goPlay();
  });
  $('soundBtn').addEventListener('click', () => setMute(!muted));
  const pauseGame = () => { if (screen === 'play') { game.paused = true; show('pause', true); } };
  $('pauseBtn').addEventListener('click', pauseGame);
  $('resumeBtn').addEventListener('click', () => { show('pause', false); game.paused = false; });
  $('toGarageBtn').addEventListener('click', () => { garageFrom = 'menu'; goGarage('cars'); });

  // ---------- settings screen: categories on the side, options in the centre ----------
  let setCat = 'gfx', setFrom = null;
  const CATS = { gfx: ['الجرافيكس', ICON.gfx], drive: ['التوجيه', ICON.move], steer: ['الدركسون', ICON.steer], cam: ['الكاميرا', ICON.camera] };
  document.querySelectorAll('#setNav button').forEach(b => { b.innerHTML = CATS[b.dataset.cat][1] + '<span>' + CATS[b.dataset.cat][0] + '</span>'; b.addEventListener('click', () => { setCat = b.dataset.cat; renderSettings(); }); });
  $('setClose').innerHTML = ICON.back;
  const openSettings = (cat) => { setFrom = screen === 'play' ? 'pause' : 'menu'; if (cat) setCat = cat; show('pause', false); show('settings', true); renderSettings(); };
  const closeSettings = () => { show('settings', false); if (setFrom === 'pause') show('pause', true); };
  $('settingsBtn').addEventListener('click', () => openSettings());
  $('toSettingsBtn').addEventListener('click', () => openSettings());

  // ---------- online: search by name / invitations / friends / requests ----------
  const net = new Net(game); game.net = net;
  const CHALS = [['none', 'بدون تحدي، بس نلعب'], ['drift', 'تحدي التفحيط'], ['race', 'سباق'], ['point', 'أوصل للنقطة']];
  let pickWx = null;
  let onTab = 'search', onFrom = null, pickFor = null, pickMap = null, searchRes = null, searching = false;
  const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt !== undefined) e.textContent = txt; return e; };
  const btn = (txt, fn, ghost) => { const b = el('button', 'sbtn' + (ghost ? ' ghost' : ''), txt); b.addEventListener('click', fn); return b; };
  // host: someone already in this session whose car we should spawn beside (not on top of)
  const hostOf = (sess) => net.others().find(o => o.sess === sess && Array.isArray(o.st));
  const playSession = async (map, wx, guest, ch) => {
    try {
      if (!assets[map] && LAZY_FOR[map]) { hud.toast('نحمّل الخريطة…', 1500); await ensureMapAssets(map, () => { }); }
      if (game.mapKey !== map) { game.loadMap(map); mapSel = map; save('hajwala.map', map); }
    } catch (e) { hud.toast('ما قدرنا نحمّل الخريطة'); return; }
    try { if (wx) game.setWeather(wx); } catch (e) { console.warn(e); }
    show('online', false); show('menu', false); show('garage', false); show('pause', false);
    const keep = net.me.sess, keepMap = net.me.map; goPlay(); net.joinSession(keep, keepMap, wx, ch); setupChal(ch, keep);
    const h = hostOf(keep);
    if (h && game.car) { // park next to the friend, 4.5 m to their right, facing the same way
      const st = h.st, q = new Q(st[3], st[4], st[5], st[6]), right = new V3(-1, 0, 0).applyQ(q), fwd = new V3(0, 0, 1).applyQ(q); right.y = 0; right.norm();
      const x = st[0] + right.x * 4.6, z = st[2] + right.z * 4.6, y = game.world.heightAt(x, z, st[1] + 3);
      game.car.place(x, y + 0.15, z, Math.atan2(fwd.x, fwd.z));
    }
    else if (guest && game.car) { // host not visible yet: still never on the same spot as them
      const b = game.car.body, r = game.car.localToWorld(new V3(-5, 0, 0), new V3()); const y = game.world.heightAt(r.x, r.z, b.pos.y + 3);
      game.car.place(r.x, y + 0.15, r.z, Math.atan2(game.car.forward(new V3()).x, game.car.forward(new V3()).z));
    }
  };
  const refreshBadges = () => {
    const ni = net.ok ? net.incomingInvites().length : 0, nr = net.ok ? net.incomingRequests().length : 0;
    const set = (b, n) => { if (!b) return; b.hidden = !n; b.textContent = n.toLocaleString('ar-SA'); };
    set($('onBadge'), ni + nr);
    const bs = document.querySelectorAll('#onNav .badge'); set(bs[0], ni); set(bs[1], nr);
    $('myName').textContent = '👤 ' + net.name; $('onName').textContent = net.name;
    requestAnimationFrame(() => { const w = $('myName').getBoundingClientRect().width; if (w) document.documentElement.style.setProperty('--nameW', Math.round(w) + 'px'); });
  };
  const statusLine = () => {
    const st = net.status;
    if (st === 'on') return null;
    if (st === 'taken') return 'اسمك مستخدم من لاعب ثاني. اضغط «غيّر» فوق واختر اسم ثاني.';
    if (st === 'failed') return 'الأونلاين ما يشتغل هنا. افتح اللعبة من الرابط في المتصفح (سفاري أو قوقل كروم).';
    return 'نتصل بالأونلاين… تأكد إن النت شغال.';
  };
  const mapPicker = (onGo) => {
    const wrap = el('div', 'step');
    wrap.append(el('h4', '', '١) اختار الماب'));
    const box = el('div', 'maps');
    for (const k of Object.keys(MAPS)) { const b = btn(MAPS[k].name, () => { pickMap = k; renderOnline.jump = true; renderOnline(); }, pickMap !== k); box.append(b); }
    wrap.append(box);
    if (pickMap) {
      wrap.append(el('h4', '', '٢) اختار الجو'));
      const wb = el('div', 'maps');
      for (const [k, n] of WEATHERS) wb.append(btn(n, () => { pickWx = k; renderOnline.jump = true; renderOnline(); }, pickWx !== k));
      wrap.append(wb);
      if (pickWx) {
        wrap.append(el('h4', '', '٣) تبي تحدي؟'));
        const cb = el('div', 'maps');
        for (const [k, n] of CHALS) cb.append(btn(n, () => { const m = pickMap, w = pickWx; pickFor = null; pickMap = null; pickWx = null; onGo(m, w, k); }));
        wrap.append(cb);
      }
    }
    return wrap;
  };
  const renderOnline = () => {
    refreshBadges();
    if ($('online').hidden) return;
    document.querySelectorAll('#onNav button').forEach(b => b.classList.toggle('on', b.dataset.t === onTab));
    const main = $('onMain'); const keepScroll = main.scrollTop; main.innerHTML = '';
    requestAnimationFrame(() => { main.scrollTop = keepScroll; if (renderOnline.jump) { renderOnline.jump = false; const st = main.querySelector('.step'); if (st && st.lastElementChild) st.lastElementChild.scrollIntoView({ block: 'nearest' }); } }); // keep the list where it was (it refreshes by itself)
    const sl = statusLine(); if (sl) { const d = el('div', 'empty', sl); main.append(d); if (net.status !== 'connecting' || onTab !== 'friends') { if (onTab !== 'friends') return; } }
    const orow = (o, extra, sub) => { const r = el('div', 'row'); const d = el('span', 'dot' + (net.online(o.uid) ? ' on' : '')); const n = el('div', 'nm', o.name || 'لاعب'); if (sub) n.append(el('span', 'sub', sub)); r.append(d, n, ...extra); return r; };
    if (onTab === 'search') {
      main.append(el('div', 'empty', 'اكتب اسم خويك بالضبط مثل ما يطلع فوق في لعبته (جنب 👤)، وخويك لازم يكون فاتح اللعبة.'));
      const inp = document.createElement('input'); inp.placeholder = 'اسم خويك…'; inp.value = renderOnline.q || ''; inp.enterKeyHint = 'search';
      const go = btn(searching ? 'ندوّر…' : 'ابحث', async () => {
        const q = inp.value.trim(); if (!q || searching) return; renderOnline.q = q; searching = true; searchRes = null; renderOnline();
        const r = await net.find(q); searching = false; searchRes = r === 'me' ? 'me' : r || 'none'; renderOnline();
      });
      inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); inp.blur(); go.click(); } });
      const row = el('div', 'btns'); row.append(go); main.append(inp, row);
      if (searchRes === 'none') main.append(el('div', 'empty', 'ما لقينا أحد بهالاسم فاتح اللعبة الحين. تأكد من الاسم (حتى الأرقام) وإن خويك فاتح اللعبة.'));
      else if (searchRes === 'me') main.append(el('div', 'empty', 'هذا اسمك أنت 😄'));
      else if (searchRes) {
        const o = net.online(searchRes.uid) || searchRes;
        const act = net.isFriend(o.uid) ? [btn('ادعُه', () => { onTab = 'friends'; pickFor = o.uid; renderOnline(); })] : [btn('أضف صديق', () => { net.requestFriend(o); hud.toast('أرسلنا الطلب لـ ' + o.name, 2000); renderOnline(); })];
        main.append(orow(o, act, o.sess ? 'يلعب الحين' : 'متصل'));
      }
    } else if (onTab === 'inv') {
      const inv = net.incomingInvites(), jn = net.joinable();
      if (!inv.length && !jn.length) main.append(el('div', 'empty', 'ما عندك دعوات. لما خويك يعزمك تطلع هنا وتدخل معه على طول.'));
      for (const i of inv) main.append(orow(i.from, [btn('ادخل معه', () => { net.joinSession(i.sess, i.map, i.wx, i.ch); playSession(i.map, i.wx, true, i.ch); })], 'يعزمك على ' + (MAPS[i.map] ? MAPS[i.map].name : i.map)));
      for (const o of jn) if (!inv.some(i => i.from.uid === o.uid)) main.append(orow(o, [btn('ادخل معه', () => { net.joinSession(o.sess, o.map, o.wx, o.ch); playSession(o.map, o.wx, true, o.ch); })], 'يلعب الحين في ' + (MAPS[o.map] ? MAPS[o.map].name : o.map)));
    } else if (onTab === 'friends') {
      for (const f of net.allFriends()) {
        const on = net.online(f.uid);
        const acts = [];
        if (on) acts.push(btn('ادعُه', () => { pickFor = pickFor === f.uid ? null : f.uid; pickMap = null; pickWx = null; renderOnline(); }));
        if (on && on.sess && on.sess !== net.me.sess && !f.bot) acts.push(btn('ادخل معه', () => { net.joinSession(on.sess, on.map, on.wx, on.ch); playSession(on.map, on.wx, true, on.ch); }, true));
        if (!on) acts.push(el('span', 'sub', 'مو متصل'));
        if (!f.bot) acts.push(btn('حذف', () => net.removeFriend(f.uid), true));
        main.append(orow(f, acts, f.bot ? 'للتجربة: يلحقك وين ما رحت ويصدم معك' : on ? (on.sess ? 'يلعب الحين في ' + (MAPS[on.map] ? MAPS[on.map].name : '') : 'متصل') : ''));
        if (pickFor === f.uid) main.append(mapPicker((m, wx, ch) => { net.invite(f.uid, m, wx, ch); hud.toast('أرسلنا الدعوة لـ ' + f.name + ' — ادخل وانتظره', 2500); playSession(m, wx, false, ch); }));
      }
      if (net.friends.length === 0) main.append(el('div', 'empty', 'تبي تضيف خويك؟ روح «بحث» واكتب اسمه.'));
    } else {
      const rq = net.incomingRequests();
      if (!rq.length) main.append(el('div', 'empty', 'ما فيه طلبات صداقة.'));
      for (const o of rq) main.append(orow(o, [btn('قبول', () => net.accept(o)), btn('رفض', () => net.reject(o), true)], 'يبي يضيفك'));
    }
  };
  net.onChange = () => { const ae = document.activeElement; if (ae && ae.tagName === 'INPUT' && !$('online').hidden) { refreshBadges(); return; } renderOnline(); };
  const openOnline = (tab) => { onFrom = screen === 'play' ? 'pause' : 'menu'; if (tab) onTab = tab; show('pause', false); show('online', true); renderOnline(); };
  $('onClose').innerHTML = ICON.back;
  $('onClose').addEventListener('click', () => { show('online', false); if (onFrom === 'pause') show('pause', true); });
  document.querySelectorAll('#onNav button').forEach(b => b.addEventListener('click', () => { onTab = b.dataset.t; renderOnline(); }));
  $('onlineBtn').addEventListener('click', () => openOnline());
  $('toOnlineBtn').addEventListener('click', () => openOnline());
  const rename = () => { const n = prompt('اكتب اسمك (يشوفه أصدقاؤك):', net.name); if (n) { net.setName(n); refreshBadges(); } };
  $('myName').addEventListener('click', rename); $('onRename').addEventListener('click', rename);
  refreshBadges(); net.init().then(refreshBadges);
  // the page must never zoom or slide (iOS ignores user-scalable=no for pinch unless we stop the gesture)
  for (const ev of ['gesturestart', 'gesturechange', 'gestureend']) document.addEventListener(ev, (e) => e.preventDefault(), { passive: false });
  document.addEventListener('dblclick', (e) => e.preventDefault(), { passive: false });
  window.addEventListener('scroll', () => { if (window.scrollX || window.scrollY) window.scrollTo(0, 0); });
  document.addEventListener('focusout', () => setTimeout(() => window.scrollTo(0, 0), 50));

  $('setClose').addEventListener('click', closeSettings);
  // full screen (where the browser allows it inside the page) so a small browser window isn't a small game
  { const fb = $('fsBtn'), de = document.documentElement, can = document.fullscreenEnabled || document.webkitFullscreenEnabled;
    if (fb && can) { fb.hidden = false; fb.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>';
      fb.addEventListener('click', () => { try { if (document.fullscreenElement || document.webkitFullscreenElement) (document.exitFullscreen || document.webkitExitFullscreen).call(document); else (de.requestFullscreen || de.webkitRequestFullscreen).call(de); } catch (e) { } }); } }

  const seg = (items, cur, onPick) => {
    const d = document.createElement('div'); d.className = 'seg';
    for (const [v, label] of items) { const b = document.createElement('button'); b.textContent = label; b.classList.toggle('on', v === cur); b.addEventListener('click', () => { onPick(v); renderSettings(); }); d.append(b); }
    return d;
  };
  const opt = (title, valText, body) => {
    const o = document.createElement('div'); o.className = 'opt';
    o.innerHTML = `<div class="row"><h3>${title}</h3>${valText !== null ? `<b>${valText}</b>` : ''}</div>`; o.append(body); return o;
  };
  const slider = (min, max, step, val, onInput, fmt, valEl) => {
    const r = document.createElement('input'); r.type = 'range'; r.min = min; r.max = max; r.step = step; r.value = val;
    const paint = () => r.style.setProperty('--p', ((r.value - min) / (max - min) * 100) + '%'); paint();
    r.addEventListener('input', () => { paint(); onInput(+r.value); if (valEl()) valEl().textContent = fmt(+r.value); });
    return r;
  };
  const renderSettings = () => {
    document.querySelectorAll('#setNav button').forEach(b => b.classList.toggle('on', b.dataset.cat === setCat));
    const m = $('setMain'); m.innerHTML = '';
    if (setCat === 'gfx') {
      m.append(opt('جودة الجرافيكس', null, seg([['ultra', 'واقعي'], ['high', 'عالي'], ['mid', 'متوسط'], ['low', 'خفيف']], quality, (q) => applyQuality(q))));
      const rs = opt('دقة الشاشة', Math.round(resScale * 100).toLocaleString('ar-SA') + '٪', slider(0.6, 1, 0.05, resScale, (v) => { resScale = v; applyQuality(quality); }, (v) => Math.round(v * 100).toLocaleString('ar-SA') + '٪', () => rs.querySelector('b')));
      m.append(rs);
      { const box = el('div'); box.style.cssText = 'display:flex;flex-direction:column;gap:8px'; box.className = 'tpanel-lite'; renderPower(box, selected); m.append(opt('القوة · ' + CAR_DEFS[selected].name, null, box)); }
      m.append(opt('الدواسة', null, seg([['full', 'كامل'], ['analog', 'بكيفي']], input.pedalFull ? 'full' : 'analog', (v) => { input.pedalFull = v === 'full'; try { localStorage.setItem('hajwala.pedal', v); } catch (e) { } })));
      m.append(opt('الوزنية', null, seg([['old', 'الوزنية القديمة'], ['new', 'الوزنية الجديدة']], Car.handling === 'new' ? 'new' : 'old', (v) => { Car.handling = v; try { localStorage.setItem('hajwala.handling', v); } catch (e) { } })));
      m.append(opt('الناس في الشوارع', null, seg([['on', 'فيه ناس'], ['off', 'بدون ناس']], game.people === false ? 'off' : 'on', (v) => { game.setPeople(v === 'on'); try { localStorage.setItem('hajwala.people', v); } catch (e) { } })));
      m.append(opt('الجو', null, seg(WEATHERS, game.weather || (game.night ? 'night' : 'day'), (v) => { game.setWeather(v); try { localStorage.setItem('hajwala.night', v); } catch (e) { } })));
      const n = document.createElement('div'); n.className = 'note'; n.textContent = 'الليل: أنوار السيارات تنوّر الطريق والنجوم تطلع. إذا الجوال يسخن أو اللعبة تقطّع، نزّل الجودة أو الدقة. العالي فيه ظلال أدق وانعكاسات أوضح على الصبغ. «واقعي»: أعلى دقة وظلال ٤ أضعاف وتنعيم وتوضيح للصورة (شبيه بتقنيات DLSS) ولمعة وألوان سينمائية — يبي جوال قوي.'; m.append(n);
    } else if (setCat === 'drive') {
      m.append(opt('طريقة التوجيه', null, seg([['wheel', 'دركسون'], ['arrows', 'أسهم يمين ويسار']], steerCfg.mode, (v) => { steerCfg.mode = v; applySteer(); })));
      const lb = document.createElement('button'); lb.className = 'btn primary wide'; lb.textContent = 'تغيير أماكن الأزرار'; lb.addEventListener('click', openLayout); m.append(lb);
      const n = document.createElement('div'); n.className = 'note'; n.textContent = 'تقدر تسحب الدركسون والدواسات والهاند بريك وعداد السرعة وتحطها وين ما تبي، وتنحفظ على جوالك.'; m.append(n);
    } else if (setCat === 'steer') {
      const s1 = opt('حساسية الدركسون', steerCfg.sens.toLocaleString('ar-SA'), slider(1, 10, 1, steerCfg.sens, (v) => { steerCfg.sens = v; applySteer(); }, (v) => v.toLocaleString('ar-SA'), () => s1.querySelector('b')));
      const s2 = opt('رجعة الدركسون للنص', null, seg([[3.5, 'بطيئة'], [7, 'عادية'], [13, 'سريعة']], steerCfg.ret, (v) => { steerCfg.ret = v; applySteer(); }));
      const s3 = opt('الاستجابة', null, seg([[1, 'مباشرة'], [1.6, 'ناعمة بالنص']], steerCfg.curve, (v) => { steerCfg.curve = v; applySteer(); }));
      const s4 = opt('حجم الدركسون', null, seg([[0.8, 'صغير'], [1, 'وسط'], [1.2, 'كبير']], steerCfg.size, (v) => { steerCfg.size = v; applySteer(); }));
      m.append(s1, s2, s3, s4);
      const n = document.createElement('div'); n.className = 'note'; n.textContent = 'الحساسية العالية = لفة صغيرة تعطيك لف كامل. الناعمة بالنص تساعدك تمسك الهجولة بدون ما تفلت.'; m.append(n);
    } else {
      const grid = document.createElement('div'); grid.className = 'camgrid';
      const presets = [[0, 'قريبة', 'near', 'ورا السيارة'], [1, 'بعيدة', 'far', 'تشوف الطريق'], [2, 'على الكبوت', 'hood', ''], [3, 'داخلية', 'cockpit', 'من عيون السواق']];
      if (game.camCustom) presets.push([4, 'كاميرتك', 'custom', nf(game.camCustom.dist) + ' م']);
      for (const [v, label, art, sub] of presets) {
        const b = document.createElement('button'); b.innerHTML = CAM_ART[art] + `<span>${label}</span>` + (sub ? `<small>${sub}</small>` : '');
        b.classList.toggle('on', game.camMode === v); b.addEventListener('click', () => { game.camMode = v; saveCam(); renderSettings(); }); grid.append(b);
      }
      m.append(opt('نوع الكاميرا', null, grid));
      const eb = document.createElement('button'); eb.className = 'btn primary wide'; eb.textContent = 'تحكم في بعد الكاميرا بنفسك'; eb.addEventListener('click', openEditor);
      m.append(eb);
      if (savedCams.length) { const ab = document.createElement('button'); ab.className = 'btn ghost wide'; ab.textContent = 'كل مقاساتي (' + savedCams.length.toLocaleString('ar-SA') + ')'; ab.addEventListener('click', () => openCamList(false)); m.append(ab); }
    }
  };

  // ---------- button layout editor ----------
  let layout = load('hajwala.layout', {}); if (typeof layout !== 'object' || !layout) layout = {};
  const layEls = () => [...document.querySelectorAll('#hud [data-lay]')];
  const applyLayout = () => {
    for (const el of layEls()) {
      const p = layout[el.dataset.lay];
      if (p) { el.style.left = (p.x * window.innerWidth).toFixed(0) + 'px'; el.style.top = (p.y * window.innerHeight).toFixed(0) + 'px'; el.style.right = 'auto'; el.style.bottom = 'auto'; }
      else { el.style.left = el.style.top = el.style.right = el.style.bottom = ''; }
    }
  };
  applyLayout(); window.addEventListener('resize', applyLayout);
  let layBack = null;
  function openLayout() {
    layBack = { hud: $('hud').classList.contains('on'), menu: !$('menu').hidden, cls: $('hud').className };
    show('settings', false); show('menu', false);
    $('hud').className = 'layer on mode-car layout';
    input.layoutMode = window.__layoutMode = true; show('layoutBar', true);
  }
  const closeLayout = () => {
    input.layoutMode = window.__layoutMode = false; show('layoutBar', false);
    $('hud').className = layBack.cls; if (!layBack.hud) $('hud').classList.remove('on'); if (layBack.menu) show('menu', true);
    show('settings', true); renderSettings();
  };
  { let drag = null;
    $('hud').addEventListener('pointerdown', (e) => {
      if (!input.layoutMode) return; const el = e.target.closest('[data-lay]'); if (!el) return;
      const r = el.getBoundingClientRect(); drag = { el, id: e.pointerId, dx: e.clientX - r.left, dy: e.clientY - r.top };
      try { $('hud').setPointerCapture(e.pointerId); } catch (x) { } e.preventDefault(); e.stopPropagation();
    }, true);
    $('hud').addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return; const el = drag.el; const r = el.getBoundingClientRect();
      const x = clamp(e.clientX - drag.dx, 0, window.innerWidth - r.width), y = clamp(e.clientY - drag.dy, 0, window.innerHeight - r.height);
      layout[el.dataset.lay] = { x: x / window.innerWidth, y: y / window.innerHeight }; applyLayout();
    });
    $('hud').addEventListener('pointerup', () => { drag = null; });
  }
  $('laySave').addEventListener('click', () => { save('hajwala.layout', layout); closeLayout(); });
  $('layReset').addEventListener('click', () => { layout = {}; save('hajwala.layout', layout); applyLayout(); });

  // ---------- custom camera editor ----------
  const ce = { open: false, cur: { dist: 6.3, h: 2.2 }, start: null, old: null, comparing: false };
  const ceSync = () => {
    $('ceDist').value = ce.cur.dist; $('ceH').value = ce.cur.h;
    for (const id of ['ceDist', 'ceH']) { const r = $(id); r.style.setProperty('--p', ((r.value - r.min) / (r.max - r.min) * 100) + '%'); }
    const show2 = ce.comparing ? (ce.old.mode === 4 || ce.old.mode <= 1 ? game.chaseParams(ce.old.mode) : null) : ce.cur;
    $('ceVal').innerHTML = (show2 ? nf(show2.dist) : '—') + '<small> م</small>'; $('ceHv').textContent = nf(ce.cur.h);
  };
  function openEditor() {
    ce.old = { mode: game.camMode };
    const base = game.camMode === 4 || game.camMode <= 1 ? game.chaseParams(game.camMode) : game.chaseParams(0);
    ce.cur = { dist: base.dist, h: base.h }; ce.start = { ...ce.cur };
    ce.open = true; ce.comparing = false; ce.hudWas = $('hud').classList.contains('on');
    show('settings', false); show('menu', false); show('garage', false); $('hud').classList.remove('on'); show('camEdit', true); ceSync();
  }
  const closeEditor = () => {
    ce.open = false; show('camEdit', false); show('camList', false);
    if (ce.hudWas) $('hud').classList.add('on'); else if (screen === 'menu') show('menu', true);
    show('settings', true); renderSettings();
  };
  $('ceClose').innerHTML = ICON.close; $('ceClose').addEventListener('click', closeEditor);
  $('ceDist').addEventListener('input', () => { ce.cur.dist = +$('ceDist').value; ceSync(); });
  $('ceH').addEventListener('input', () => { ce.cur.h = +$('ceH').value; ceSync(); });
  const stepD = (d) => { ce.cur.dist = clamp(Math.round((ce.cur.dist + d) * 10) / 10, 3, 16); ceSync(); };
  $('ceMinus').addEventListener('click', () => stepD(-0.5)); $('cePlus').addEventListener('click', () => stepD(0.5));
  $('ceSave').addEventListener('click', () => {
    const c = { dist: ce.cur.dist, h: ce.cur.h };
    if (!savedCams.some(s => Math.abs(s.dist - c.dist) < 0.05 && Math.abs(s.h - c.h) < 0.05)) { savedCams.unshift({ ...c, t: Date.now() }); savedCams = savedCams.slice(0, 12); save('hajwala.cams', savedCams); }
    game.camCustom = c; game.camMode = 4; saveCam(); closeEditor();
  });
  bindHold($('ceCmp'), () => { ce.comparing = true; $('camEdit').classList.add('comparing'); ceSync(); }, () => { ce.comparing = false; $('camEdit').classList.remove('comparing'); ceSync(); });
  $('ceRevert').addEventListener('click', () => { ce.cur = { ...ce.start }; ceSync(); });
  const openCamList = (inEditor) => {
    const box = $('camItems'); box.innerHTML = '';
    if (!savedCams.length) box.innerHTML = '<div class="note" style="text-align:center">ما حفظت أي مقاس للحين</div>';
    savedCams.forEach((c, i) => {
      const it = document.createElement('div'); it.className = 'camItem';
      it.innerHTML = `<div class="t">مقاس ${(i + 1).toLocaleString('ar-SA')}<small>البعد ${nf(c.dist)} م · الارتفاع ${nf(c.h)} م</small></div>`;
      const use = document.createElement('button'); use.className = 'use'; use.textContent = 'استخدم';
      use.addEventListener('click', () => {
        if (ce.open) { ce.cur = { dist: c.dist, h: c.h }; ceSync(); closeCamList(); }
        else { game.camCustom = { dist: c.dist, h: c.h }; game.camMode = 4; saveCam(); show('camList', false); renderSettings(); }
      });
      const del = document.createElement('button'); del.textContent = 'احذف';
      del.addEventListener('click', () => { savedCams.splice(i, 1); save('hajwala.cams', savedCams); openCamList(inEditor); });
      it.append(use, del); box.append(it);
    });
    show('camList', true);
  };
  $('ceAll').addEventListener('click', () => { show('camEdit', false); openCamList(true); });
  const closeCamList = () => { show('camList', false); if (ce.open) show('camEdit', true); };
  $('camListClose').addEventListener('click', closeCamList);

  document.addEventListener('gesturestart', e => e.preventDefault());
  document.addEventListener('contextmenu', e => e.preventDefault());

  $('loading').hidden = true; if (shotTimer) clearInterval(shotTimer);
  goMenu();

  // ---------- main loop ----------
  let last = performance.now(), acc = 0; const STEP = 1 / 120;
  let fpsT = 0, fpsN = 0, hudKmh = 0;
  const hudEl = $('hud');
  const manual = /manual/.test(location.search);
  const frame = (now, fixedDt, noRender) => {
    if (!manual) requestAnimationFrame(frame);
    let dt = fixedDt || Math.min(0.05, (now - last) / 1000); last = now;
    // keep it smooth on weaker phones: if frames get slow, draw a bit fewer pixels (and more again when it's fast)
    if (!manual && !fixedDt && screen === 'play' && !game.paused) {
      dynT += dt; dynN++;
      if (dynT > 1.5) { const avg = dynT / dynN; dynT = 0; dynN = 0;
        const Q = QUALITY[quality], base = Math.min(window.devicePixelRatio || 1, Q.pr) * resScale, lo = Math.max(0.75, base * 0.55);
        let pr = renderer.pixelRatio;
        if (avg > 1 / 40) pr = Math.max(lo, pr * 0.85); else if (avg < 1 / 55) pr = Math.min(base, pr * 1.08);
        if (Math.abs(pr - renderer.pixelRatio) > 0.01) renderer.pixelRatio = pr; }
    }
    input.update(dt);
    steering.tick(dt); arrows.tick(dt); if (input.keyActive && !input.steerHeld) steering.showKb(input.steer);
    if (input.take('pause') && screen === 'play' && !ce.open && $('settings').hidden) { game.paused = !game.paused; show('pause', game.paused); }
    if (ce.open) {
      game.editorCamera(ce.comparing ? (ce.old.mode === 4 ? { mode: 4, ...game.chaseParams(4) } : { mode: ce.old.mode }) : { mode: 4, ...ce.cur });
    } else if (screen === 'play' && !game.paused) {
      acc += dt; let n = 0;
      while (acc >= STEP && n < 8) { game.fixedStep(STEP); acc -= STEP; n++; }
      if (n >= 8) acc = 0;
      game.update(dt);
      // HUD
      const car = game.car;
      hudEl.className = 'layer on mode-' + (game.drone ? 'drone' : game.playerMode);
      const kmh = Math.abs(car.forwardSpeed) * 3.6;
      hudKmh += (kmh - hudKmh) * Math.min(1, dt * 8);
      $('spd').textContent = Math.round(kmh).toLocaleString('ar-SA');
      $('needle').setAttribute('transform', `rotate(${(-135 + clamp(hudKmh, 0, 220) / 220 * 270).toFixed(1)} 100 100)`);
      $('gear').textContent = game.playerMode !== 'car' ? 'P' : car.reverse ? 'R' : car.speed < 0.3 && car.throttle < 0.05 ? 'N' : car.gear;
      { const f = clamp(car.rpm / car.def.redline, 0, 1); const a0 = -225 * Math.PI / 180, a1 = a0 + f * 270 * Math.PI / 180, R = 90; const big = f * 270 > 180 ? 1 : 0;
        $('rpmArc').setAttribute('d', f < 0.01 ? '' : `M${100 + Math.cos(a0) * R} ${100 + Math.sin(a0) * R} A${R} ${R} 0 ${big} 1 ${100 + Math.cos(a1) * R} ${100 + Math.sin(a1) * R}`); }
      $('dmgBar').setAttribute('width', (car.damage * 0.6).toFixed(0));
      $('score').textContent = game.score.toLocaleString('ar-SA');
      if (game.camMode !== camCfg.mode) saveCam();
    } else if (screen !== 'play') {
      game.update(dt);
    }
    if (!noRender) { if (game.map && game.map.cull) game.map.cull(game.cam.pos.x, game.cam.pos.z); renderer.render(game.roots(), game.cam); }
    if (game.snap && !noRender) { game.snap = false; // photo from the drone: share / save the picture
      try { renderer.gl.canvas.toBlob(async (b) => { if (!b) return; const f = new File([b], 'hajwala-' + Date.now() + '.png', { type: 'image/png' });
        try { if (navigator.canShare && navigator.canShare({ files: [f] })) { await navigator.share({ files: [f] }); return; } } catch (e) { if (e && e.name === 'AbortError') return; }
        const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = f.name; document.body.append(a); a.click(); a.remove(); hud.toast('انحفظت الصورة 📸', 1500); }, 'image/png'); } catch (e) { hud.toast('ما قدرنا نحفظ الصورة'); } }
    // adaptive resolution on slow devices
    fpsT += dt; fpsN++;
    if (fpsT > 3) {
      const fps = fpsN / fpsT; fpsT = 0; fpsN = 0;
      if (!manual && fps < 24 && renderer.pixelRatio > 0.8) renderer.pixelRatio = Math.max(0.8, renderer.pixelRatio * 0.85);
      window.__fps = fps;
    }
  };
  if (!manual) requestAnimationFrame(frame);
  window.__tick = (n = 1, dt = 1 / 30) => { for (let i = 0; i < n; i++) frame(performance.now(), dt, i < n - 1); };

  // =================== challenges with a friend ===================
  const hashStr = (t) => { let h = 2166136261; for (const c of String(t)) h = Math.imul(h ^ c.charCodeAt(0), 16777619); return (h >>> 0) / 4294967296; };
  const setupChal = (ch, sess) => {
    game.chal = null; $('chal').hidden = true; if (!ch || ch === 'none') return;
    const sp = game.map.spawn; const C = { type: ch, t0: performance.now(), score: 0, base: game.score || 0 };
    if (ch === 'race' || ch === 'point') {
      const a = ch === 'race' ? sp.yaw : hashStr(sess) * Math.PI * 2, dist = ch === 'race' ? 320 : 200;
      let x = sp.x + Math.sin(a) * dist, z = sp.z + Math.cos(a) * dist;
      if (game.map.roadX && ch === 'race') x = game.map.roadX(z) - 4;
      C.target = { x, z };
    }
    game.chal = C; $('chal').hidden = false;
    hud.toast(ch === 'drift' ? 'تحدي التفحيط: ٩٠ ثانية، اللي يجمع نقاط أكثر يفوز!' : ch === 'race' ? 'سباق! أول واحد يوصل للعمود الأصفر يفوز' : 'أوصل للعمود الأصفر قبل خويك!', 3500);
  };
  game.myTune = () => { const T = tunes[selected] || {}; return { color: T.color, parts: T.parts, hide: T.hide, hf: T.hf, hr: T.hr }; };
  game.onChalDone = () => { hud.toast('وصلت! 🏁', 2000); };
  setInterval(() => {
    const C = game.chal; if (!C || screen !== 'play') { if (!C) $('chal').hidden = true; return; }
    const mates = net.others().filter(o => o.sess && o.sess === net.me.sess);
    const fmt = (n) => Math.round(n).toLocaleString('ar-SA');
    if (C.type === 'drift') {
      const left = Math.max(0, 90 - (performance.now() - C.t0) / 1000); if (left > 0) C.score = Math.max(0, (game.score || 0) - C.base);
      const best = mates.reduce((a, o) => Math.max(a, o.cs || 0), 0);
      $('chal').textContent = left > 0 ? `⏱ ${fmt(left)}ث · أنت ${fmt(C.score)} · خويك ${fmt(best)}` : (C.score >= best ? `🏆 فزت! ${fmt(C.score)} ضد ${fmt(best)}` : `خسرت 😅 ${fmt(C.score)} ضد ${fmt(best)}`);
    } else {
      const b = game.car.body.pos, d = Math.hypot(b.x - C.target.x, b.z - C.target.z);
      const winner = mates.find(o => o.cw && (!net.me.cw || o.cw < net.me.cw));
      if (net.me.cw && !winner) $('chal').textContent = '🏆 فزت! وصلت أول';
      else if (winner) $('chal').textContent = '🏁 ' + (winner.name || 'خويك') + ' وصل قبلك' + (net.me.cw ? '' : ' · باقي ' + fmt(d) + 'م');
      else $('chal').textContent = '🎯 العمود الأصفر · ' + fmt(d) + 'م';
    }
  }, 250);

  // =================== tuning (التعديل) ===================
  const ENGINES = { lcold: [6, 8], fortuner: [4, 6], prado: [4, 6], sierra: [6, 8], datsun: [4, 6], gmcold: [8], caprice: [6, 8], hilux07: [4, 6], camry20: [4, 6], hilux: [4], hilux2: [4], tahoe: [4, 6, 8], elantra: [4], camry: [4], shas: [4, 6], rub: [4, 6], avanza: [4], yukon: [8], changan: [4] };
  const PAINTS = [['#f4f4f2', 'أبيض'], ['#101012', 'أسود'], ['#b9bbbe', 'فضي'], ['#5d6166', 'رمادي'], ['#c9b48a', 'بيج'], ['#b0121b', 'أحمر'], ['#0f3b8c', 'أزرق'], ['#2c6e3a', 'أخضر'], ['#e8b40f', 'أصفر'], ['#e36a12', 'برتقالي'], ['#d65fa0', 'وردي'], ['#5b2a86', 'بنفسجي'], ['#6b4226', 'بني'], ['#1b9aa8', 'تركواز']];
  const hex = (h) => [parseInt(h.slice(1, 3), 16) / 255, parseInt(h.slice(3, 5), 16) / 255, parseInt(h.slice(5, 7), 16) / 255].map(v => v ** 2.2);
  const tunes = load('hajwala.tune', {});
  const tuneOf = (k) => (tunes[k] || (tunes[k] = {}));
  const saveTune = (k) => { save('hajwala.tune', tunes); try { game.cars[k].applyTune(tunes[k]); } catch (e) { console.warn(e); } };
  for (const k of Object.keys(CAR_DEFS)) if (tunes[k] && game.cars[k]) try { game.cars[k].applyTune(tunes[k]); } catch (e) { }
  const sprays = {}; // car -> list of [p, n, color, size] (kept while the game is open)
  let tTab = 'parts', paintMode = 'color', paintPart = 'all', sprayColor = PAINTS[5][0], spraySize = 0.07, pickedHex = null;
  const tpanel = $('tPanel');
  const chip = (txt, on, fn, lock) => { const b = el('button', 'chip2' + (on ? ' on' : '') + (lock ? ' lock' : ''), txt); b.addEventListener('click', fn); return b; };
  const renderTune = () => {
    const k = selected, T = tuneOf(k), d = CAR_DEFS[k], car = game.cars[k];
    document.querySelectorAll('#tTabs button').forEach(b => b.classList.toggle('on', b.dataset.t === tTab));
    tpanel.innerHTML = ''; $('sprayHint').hidden = !(tTab === 'paint' && paintMode === 'spray');
    tpanel.append(el('h4', '', d.name + ' · الفلوس: ∞'));
    if (tTab === 'parts') {
      tpanel.append(el('div', 'note', 'اضغط على القطعة عشان تفكّها أو ترجّعها.'));
      const { PART_NAMES } = window.__tuneMod; car && window.__tuneMod.splitParts(car, k);
      const row = el('div', 'row2'); T.hide = T.hide || {};
      for (const [pk, nm] of Object.entries(PART_NAMES)) { if (!car.parts || !car.parts[pk]) continue; row.append(chip((T.hide[pk] ? '➕ ' : '✖ ') + nm, !!T.hide[pk], () => { T.hide[pk] = !T.hide[pk]; saveTune(k); renderTune(); })); }
      tpanel.append(row, chip('رجّع كل القطع', false, () => { T.hide = {}; saveTune(k); renderTune(); }));
    } else if (tTab === 'engine') {
      const base = (d.engineVoice && d.engineVoice.cyl) || 4, ok = ENGINES[k] || [base], cur = T.cyl || base;
      tpanel.append(el('div', 'note', 'اختار المكينة. الأقوى تزيد العزم والسرعة.'));
      const row = el('div', 'row2');
      for (const c of [4, 6, 8]) { const lock = !ok.includes(c); row.append(chip(c.toLocaleString('ar-SA') + ' سلندر' + (lock ? ' 🔒' : ''), cur === c, () => { if (lock) { hud.toast('هذي السيارة ما تدعم هذا النوع من المكينة', 2000); return; } T.cyl = c; saveTune(k); renderTune(); }, lock)); }
      tpanel.append(row);
      tpanel.append(el('h4', '', 'تيربو'));
      const r2 = el('div', 'row2'); r2.append(chip('بدون', !T.turbo, () => { T.turbo = false; saveTune(k); renderTune(); }), chip('تيربو', !!T.turbo, () => { T.turbo = true; saveTune(k); renderTune(); })); tpanel.append(r2);
      const tq = Math.round((d.torque || 300) * ((car && car.tuneTorque) || 1)); tpanel.append(el('div', 'note', 'العزم الحين: ' + tq.toLocaleString('ar-SA') + ' نيوتن·متر'));
    } else if (tTab === 'paint') {
      const r0 = el('div', 'row2'); r0.append(chip('🎨 لون', paintMode === 'color', () => { paintMode = 'color'; renderTune(); }), chip('🖌️ بخاخ', paintMode === 'spray', () => { paintMode = 'spray'; renderTune(); })); tpanel.append(r0);
      const sw = (onPick, curHex) => { const r = el('div', 'row2'); for (const [h, n] of PAINTS) { const b = el('button', 'sw' + (curHex === h ? ' on' : '')); b.style.background = h; b.title = n; b.addEventListener('click', () => onPick(h)); r.append(b); } return r; };
      if (paintMode === 'color') {
        tpanel.append(el('h4', '', 'وش تلوّن؟'));
        const { PART_NAMES } = window.__tuneMod; car && window.__tuneMod.splitParts(car, k);
        const r1 = el('div', 'row2'); r1.append(chip('السيارة كاملة', paintPart === 'all', () => { paintPart = 'all'; renderTune(); }));
        for (const [pk, nm] of Object.entries(PART_NAMES)) { if (pk === 'glass' || pk === 'lamps' || !car.parts || !car.parts[pk] || !car.parts[pk].some(p => p.material && p.material.carPaint)) continue; r1.append(chip(nm, paintPart === pk, () => { paintPart = pk; renderTune(); })); }
        tpanel.append(r1, el('h4', '', 'اللون'));
        const curHex = paintPart === 'all' ? T.colorHex : (T.partsHex || {})[paintPart];
        tpanel.append(sw((h) => { if (paintPart === 'all') { T.colorHex = h; T.color = hex(h); T.parts = {}; T.partsHex = {}; } else { T.partsHex = T.partsHex || {}; T.parts = T.parts || {}; T.partsHex[paintPart] = h; T.parts[paintPart] = hex(h); } saveTune(k); renderTune(); }, curHex));
        tpanel.append(chip('↩️ رجّع الألوان الأصلية', false, () => { delete T.color; delete T.colorHex; T.parts = {}; T.partsHex = {}; saveTune(k); renderTune(); }));
      } else {
        tpanel.append(el('div', 'note', 'اضغط «الكاميرا» وحرّك بإصبعك للزاوية اللي تبيها، وبعدين اضغط «بخ» واسحب على السيارة.'));
        const r3 = el('div', 'row2'); r3.append(chip(sprayCam ? '🎥 الكاميرا (شغالة)' : '🎥 الكاميرا', sprayCam, () => { sprayCam = !sprayCam; renderTune(); }), chip('🖌️ بخ', !sprayCam, () => { sprayCam = false; renderTune(); })); tpanel.append(r3);
        tpanel.append(el('h4', '', 'لون البخاخ'), sw((h) => { sprayColor = h; renderTune(); }, sprayColor));
        const sl = document.createElement('input'); sl.type = 'range'; sl.min = 0.03; sl.max = 0.2; sl.step = 0.01; sl.value = spraySize; sl.addEventListener('input', () => { spraySize = +sl.value; });
        tpanel.append(el('h4', '', 'حجم البخ'), sl, chip('🧽 امسح البخ', false, () => { window.__tuneMod.clearSpray(car); sprays[k] = []; }));
      }
    } else if (tTab === 'stance') {
      tpanel.append(el('div', 'note', 'ارفع ونزّل الكفرات الأمامية والخلفية. الأمامي فوق والخلفي تحت = وزنية التفحيط.'));
      const slider2 = (label, key) => { const w = el('div'); const lab = el('h4', '', label + ': ' + Math.round((T[key] || 0) * 100) + ' سم'); const sl = document.createElement('input'); sl.type = 'range'; sl.min = -0.1; sl.max = 0.16; sl.step = 0.01; sl.value = T[key] || 0; sl.addEventListener('input', () => { T[key] = +sl.value; lab.textContent = label + ': ' + Math.round(T[key] * 100) + ' سم'; saveTune(k); }); w.append(lab, sl); return w; };
      tpanel.append(slider2('الكفرات الأمامية', 'hf'), slider2('الكفرات الخلفية', 'hr'));
      const r = el('div', 'row2'); r.append(chip('وزنية تفحيط (قدام فوق)', false, () => { T.hf = 0.08; T.hr = -0.04; saveTune(k); renderTune(); }), chip('طعوس (فوق)', false, () => { T.hf = 0.12; T.hr = 0.12; saveTune(k); renderTune(); }), chip('ستاندر', false, () => { T.hf = 0; T.hr = 0; saveTune(k); renderTune(); })); tpanel.append(r);
    } else if (tTab === 'power') {
      renderPower(tpanel, k);
    }
  };
  const renderPower = (box, k) => {
    const T = tuneOf(k);
    box.append(el('h4', '', 'الدبل'));
    const fw = game.cars[k] ? game.cars[k].fourWD : true, cur = T.dbl === 'off' ? '2h' : T.dbl || (fw ? 'high' : '2h');
    const r1 = el('div', 'row2'); for (const [v, n] of [['2h', '2H بدون دبل (خلفي بس، للتفحيط)'], ['high', 'دبل عالي 4H (للطعوس)'], ['low', 'دبل واطي 4L (عزم وحش، سرعة قليلة)']]) r1.append(chip(n, cur === v, () => { T.dbl = v; saveTune(k); box.innerHTML = ''; renderPower(box, k); updPwr(); })); box.append(r1);
    box.append(el('h4', '', 'الدفع'));
    const r2 = el('div', 'row2'); for (const [v, n] of [['', 'الأصلي'], ['rwd', 'خلفي'], ['fwd', 'أمامي'], ['awd', 'رباعي']]) r2.append(chip(n, (T.drive || '') === v, () => { T.drive = v; saveTune(k); box.innerHTML = ''; renderPower(box, k); updPwr(); })); box.append(r2);
    box.append(el('h4', '', 'الدفلوك'));
    const r3 = el('div', 'row2'); for (const [v, n] of [['', 'بدون (مفتوح)'], ['rear', 'خلفي'], ['front', 'أمامي'], ['both', 'قدام وورا']]) r3.append(chip(n, (T.diff || '') === v, () => { T.diff = v; saveTune(k); box.innerHTML = ''; renderPower(box, k); updPwr(); })); box.append(r3);
    box.append(el('div', 'note', '2H: الكفرات الورا بس تدف، تغرز بسرعة في الرمل إذا دعست قوي. 4H: الأربع تدف. 4L: عزم وحش وسرعة لين ٦٠ تقريباً، الكفر يلف بشويش فما يحفر. الدفلوك: الكفرين يلفون مع بعض ١٠٠٪ حتى لو واحد رافع أو غارز. تنسيم الكفر يساعدك تطلع.'));
  };
  // quick 4x4 panel while driving: the button shows the current mode (2H / 4H / 4L, 🔒 = difflock)
  const updPwr = () => { const c = game.cars[selected]; if (!c) return; $('pwrBtn').textContent = (c.dblMode === 'low' ? '4L' : c.dblMode === 'high' ? '4H' : '2H') + (c.tuneDiff ? '🔒' : ''); };
  $('pwrBtn').addEventListener('click', () => { const b = $('pwrBox'); b.innerHTML = ''; renderPower(b, selected); $('pwrPanel').hidden = false; if (screen === 'play') game.paused = true; }); // the car waits while you choose
  $('pwrClose').addEventListener('click', () => { $('pwrPanel').hidden = true; if (screen === 'play' && $('pause').hidden) game.paused = false; });
  setInterval(updPwr, 1000);
  let sprayCam = false;
  const openTune = () => { if (!carState(selected).owned) { selected = econ.owns(econ.d.fav) ? econ.d.fav : 'shas'; refreshCards(); } show('menu', false); screen = 'tune'; game.showroom(selected); game.mode = 'garage'; game.menuHold = false; game.tuneView = true; show('tune', true); renderTune(); };
  $('tBack').innerHTML = ICON.back; $('tBack').addEventListener('click', () => { show('tune', false); game.menuHold = false; goMenu(); });
  document.querySelectorAll('#tTabs button').forEach(b => b.addEventListener('click', () => { tTab = b.dataset.t; renderTune(); }));
  $('tuneBtn').addEventListener('click', openTune);
  // drag to orbit the car / spray on it
  { const cv = renderer.gl.canvas; let drag = null, spraying = false;
    const ray = (e) => { const r = cv.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width * 2 - 1, y = 1 - (e.clientY - r.top) / r.height * 2; const m = game.cam.invVP;
      const un = (z) => { const X = m[0] * x + m[4] * y + m[8] * z + m[12], Y = m[1] * x + m[5] * y + m[9] * z + m[13], Z = m[2] * x + m[6] * y + m[10] * z + m[14], W = m[3] * x + m[7] * y + m[11] * z + m[15]; return new V3(X / W, Y / W, Z / W); };
      const a = un(-1), b = un(1); return [a, b.sub(a).norm()]; };
    const doSpray = (e) => { const car = game.car; const [o, d] = ray(e); const hit = window.__tuneMod.pickCar(car, o, d); if (!hit) return; window.__tuneMod.sprayDot(car, hit, hex(sprayColor), spraySize); (sprays[selected] || (sprays[selected] = [])).push(1); };
    cv.addEventListener('pointerdown', (e) => { if (screen !== 'tune' && screen !== 'chars') return; if (screen === 'tune' && tTab === 'paint' && paintMode === 'spray' && !sprayCam) { spraying = true; doSpray(e); return; } drag = { x: e.clientX, a: game.menuA || 0 }; game.menuHold = true; });
    cv.addEventListener('pointermove', (e) => { if (spraying) { doSpray(e); return; } if (drag) game.menuA = drag.a - (e.clientX - drag.x) * 0.008; });
    const up = () => { drag = null; spraying = false; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);
  }

  // =================== character (الشخصية) ===================
  let charSel = load('hajwala.char', 'base'); game.charSel = charSel;
  const CHARS = [['base', 'الأساسية', '🧍'], ['hero', 'الجديدة (أنميشن)', '🏃']];
  const renderChars = () => { const st = $('charStrip'); st.innerHTML = '';
    for (const [k, n, ic] of CHARS) { const c = el('button', 'card' + (charSel === k ? ' on' : '')); const pic = el('div', 'pic', ic); c.append(pic, el('div', 'nm', n)); c.addEventListener('click', async () => { if (k === 'hero' && !assets.hero) { hud.toast('نحمّل الشخصية…', 1500); try { await ensureMapAssets('hero', (pp) => { c.querySelector('.nm').textContent = 'نحمّل… ' + Math.round(pp * 100).toLocaleString('ar-SA') + '٪'; }); game.prewarmHero(); } catch (e) { hud.toast('ما قدرنا نحمّلها'); return; } } charSel = k; game.charSel = k; save('hajwala.char', k); if (screen === 'chars') { game.showChar(k); renderChars(); } }); st.append(c); } };
  const openChars = async () => { show('menu', false); screen = 'chars'; show('chars', true); if (charSel === 'hero' && !assets.hero) { game.showChar('base'); renderChars(); try { await ensureMapAssets('hero', () => { }); game.prewarmHero(); } catch (e) { charSel = 'base'; } } if (screen !== 'chars') return; game.showChar(charSel); renderChars(); }; // (left the screen while it loaded: don't pull the game back to it)
  $('cBack').innerHTML = ICON.back; $('cBack').addEventListener('click', () => { show('chars', false); goMenu(); });
  $('charBtn').addEventListener('click', openChars);
  if (charSel === 'hero') ensureMapAssets('hero', () => { }).then(() => game.prewarmHero()).catch(() => { });
  { let asked = false; game.needHero = () => { if (asked || assets.hero) return; asked = true; ensureMapAssets('hero', () => { }).catch(() => { asked = false; }); }; } // a friend plays the animated character

  // =================== wallet, profile, store, gift ===================
  const thumbOf = (k) => { try { if (game.cars[k]) return game.thumbnail(k); } catch (e) { } return (MANIFEST.thumbs && MANIFEST.thumbs[k]) || ''; };
  const updWallet = () => { $('wMoney').textContent = fmt(econ.money); $('wKeys').textContent = fmt(econ.keys); $('wLevel').textContent = econ.level.toLocaleString('ar-SA'); };
  econ.on(updWallet); updWallet();
  // the gift box: shakes, opens, the car comes out with confetti
  const showGift = (k) => {
    const g = $('gift'); g.classList.remove('open'); g.hidden = false; $('giftImg').src = thumbOf(k); $('giftName').textContent = CAR_DEFS[k] ? CAR_DEFS[k].name : '';
    for (const c of g.querySelectorAll('.conf')) c.remove();
    try { audio.click && audio.click(); } catch (e) { }
    setTimeout(() => {
      g.classList.add('open');
      const cols = ['#ffbd45', '#e8453a', '#4fc3f7', '#8bc34a', '#fff', '#f4c542'];
      for (let i = 0; i < 70; i++) { const c = document.createElement('i'); c.className = 'conf'; c.style.left = Math.random() * 100 + '%'; c.style.background = cols[i % cols.length]; c.style.animationDelay = (Math.random() * 0.8).toFixed(2) + 's'; c.style.animationDuration = (1.8 + Math.random() * 1.4).toFixed(2) + 's'; g.append(c); }
    }, 1500);
  };
  $('giftOk').addEventListener('click', () => { $('gift').hidden = true; refreshCards(); if (screen === 'garage') { $('gName').textContent = CAR_DEFS[selected].name; } });
  // store
  let storeTab = 'cars', storeFrom = 'menu';
  const openStore = (tab) => { if (tab) storeTab = tab; storeFrom = screen; show('store', true); renderStore(); };
  const closeStore = () => { show('store', false); refreshCards(); updWallet(); };
  $('storeClose').innerHTML = ICON.back; $('storeClose').addEventListener('click', closeStore);
  $('storeBtn').addEventListener('click', () => openStore());
  document.querySelectorAll('#storeNav button').forEach(b => b.addEventListener('click', () => { storeTab = b.dataset.tab; renderStore(); }));
  const sitem = (inner, btnTxt, fn, done) => { const d = el('div', 'sitem'); d.innerHTML = inner; const b = btn(btnTxt, fn, !!done); if (done) b.disabled = true; d.append(b); return d; };
  const renderStore = () => {
    document.querySelectorAll('#storeNav button').forEach(b => b.classList.toggle('on', b.dataset.tab === storeTab));
    const m = $('storeMain'); m.innerHTML = ''; const grid = el('div', 'store-grid');
    if (storeTab === 'gold') {
      m.append(el('h3', null, 'مفاتيح ذهبية — تشتري فيها سيارات وفلوس'));
      for (const P of GOLD_PACKS) grid.append(sitem('<div class="big">' + KEYI.replace(/18/g, '34') + ' ' + P.keys.toLocaleString('ar-SA') + '</div><div>مفتاح ذهبي</div>', 'شراء', () => { econ.addKeys(P.keys); hud.toast('وصلتك ' + P.keys.toLocaleString('ar-SA') + ' مفتاح 🔑', 1600); renderStore(); }));
    } else if (storeTab === 'money') {
      m.append(el('h3', null, 'فلوس رصاصي — تشتريها بالمفاتيح الذهبية'));
      for (const P of MONEY_PACKS) grid.append(sitem('<div class="big">' + COIN.replace(/18/g, '34') + ' ' + P.money.toLocaleString('ar-SA') + '</div><div>بـ ' + KEYI + ' ' + P.keys.toLocaleString('ar-SA') + '</div>', 'شراء', () => { const w = econ.buyMoney(P); if (w) { hud.toast('مفاتيحك ما تكفي', 1500); return; } hud.toast('وصلتك الفلوس 🪙', 1400); renderStore(); }));
    } else if (storeTab === 'subs') {
      m.append(el('h3', null, 'الاشتراكات'));
      for (const P of SUBS) { const on = P.id === 'noads' && econ.d.noAds; grid.append(sitem('<div class="big">🚫📺</div><b>' + P.name + '</b><div>' + P.desc + '</div>', on ? 'مشترك ✓' : 'اشترك', () => { econ.setSub(P.id, true); hud.toast('اشتركت: ' + P.name, 1500); renderStore(); }, on)); }
    } else {
      m.append(el('h3', null, 'سيارات المتجر'));
      for (const k of Object.keys(CAR_PRICE).filter(k => CAR_PRICE[k].store && CAR_DEFS[k])) {
        const own = econ.owns(k);
        grid.append(sitem('<img src="' + thumbOf(k) + '" alt=""><b>' + CAR_DEFS[k].name + '</b>', own ? 'عندك ✓' : 'شراء', () => { econ.grant(k); renderStore(); show('store', false); selected = k; try { localStorage.setItem('hajwala.car', k); } catch (e) { } showGift(k); ensureCar(k).then(() => { if (screen === 'garage' || screen === 'menu') game.showroom(k); refreshCards(); }).catch(() => { }); }, own));
      }
    }
    m.append(grid);
    if (UNLIMITED) m.append(el('div', 'note', 'نسخة التجربة: الفلوس والمفاتيح بلا حد، وكل شي تشتريه يوصلك على طول.'));
  };
  // profile
  const openProfile = () => { show('profile', true); renderProfile(); };
  $('profileClose').innerHTML = ICON.back; $('profileClose').addEventListener('click', () => show('profile', false));
  $('profileBtn').addEventListener('click', openProfile);
  $('avatarPick').addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0]; if (!f) return; const rd = new FileReader();
    rd.onload = () => { const im = new Image(); im.onload = () => { const c = document.createElement('canvas'); c.width = c.height = 160; const x = c.getContext('2d'); const sz = Math.min(im.width, im.height); x.drawImage(im, (im.width - sz) / 2, (im.height - sz) / 2, sz, sz, 0, 0, 160, 160); econ.d.avatar = c.toDataURL('image/jpeg', 0.82); econ.changed(); renderProfile(); }; im.src = rd.result; };
    rd.readAsDataURL(f); e.target.value = '';
  });
  const renderProfile = () => {
    const m = $('profileMain'); m.innerHTML = '';
    const top = el('div', 'pf-top');
    const av = el('div', 'pf-av'); if (econ.d.avatar) av.style.backgroundImage = 'url(' + econ.d.avatar + ')'; else av.textContent = '🧔🏻'; av.append(el('small', null, 'غيّر الصورة'));
    av.addEventListener('click', () => $('avatarPick').click());
    const info = el('div'); info.style.display = 'grid'; info.style.gap = '6px';
    const nm = el('div', 'pf-name', net.name);
    const row = el('div'); row.style.display = 'flex'; row.style.gap = '8px'; row.style.flexWrap = 'wrap';
    row.append(btn('✏️ عدّل الاسم', () => { rename(); renderProfile(); }, true));
    const idb = el('div', 'pf-id', 'ID: ' + econ.d.id);
    row.append(btn('📋 انسخ الآي دي', () => { try { navigator.clipboard.writeText(econ.d.id); hud.toast('نسخنا الآي دي', 1200); } catch (e) { } }, true));
    const lp = econ.levelProgress(); const lv = el('div', null, 'المستوى ' + lp.level.toLocaleString('ar-SA') + ' · ' + Math.floor(econ.d.xp).toLocaleString('ar-SA') + ' / ' + lp.to.toLocaleString('ar-SA') + ' نقطة');
    const bar = el('div', 'pf-bar'); const bi = el('i'); bi.style.width = Math.round(lp.t * 100) + '%'; bar.append(bi);
    info.append(nm, idb, lv, bar, row); top.append(av, info); m.append(top);
    const wal = el('div'); wal.innerHTML = '<span class="wchip money">' + COIN + ' <b>' + fmt(econ.money) + '</b></span> <span class="wchip keys">' + KEYI + ' <b>' + fmt(econ.keys) + '</b></span> <span class="wchip lvl">🛣️ <b>' + econ.d.km.toFixed(1) + '</b> كم</span> <span class="wchip lvl">🏁 <b>' + Math.floor(econ.d.pts).toLocaleString('ar-SA') + '</b> نقطة</span>'; m.append(wal);
    // favourite car + my cars
    const sec1 = el('div', 'pf-sec'); sec1.append(el('h3', null, 'سياراتي (اضغط على سيارة تخليها المفضلة ⭐)'));
    const mc = el('div', 'mycars');
    for (const k of econ.d.owned) { if (!CAR_DEFS[k]) continue; const c = el('button', 'card' + (econ.d.fav === k ? ' fav' : '')); const im = el('img'); im.src = thumbOf(k); im.alt = ''; c.append(im, el('div', 'nm', (econ.d.fav === k ? '⭐ ' : '') + CAR_DEFS[k].name)); c.addEventListener('click', () => { econ.d.fav = k; econ.changed(); renderProfile(); }); mc.append(c); }
    sec1.append(mc); m.append(sec1);
    const fav = CAR_DEFS[econ.d.fav]; if (fav) m.append(el('div', null, 'سيارتك المفضلة: ' + fav.name));
    const sec2 = el('div', 'pf-sec'); sec2.append(el('h3', null, 'الإنجازات (' + econ.d.ach.length.toLocaleString('ar-SA') + ' / ' + ACHIEVEMENTS.length.toLocaleString('ar-SA') + ')'));
    const ag = el('div', 'pf-grid');
    for (const A of ACHIEVEMENTS) { const d = el('div', 'ach' + (econ.d.ach.includes(A.id) ? ' on' : '')); d.innerHTML = '<i>' + A.icon + '</i><b>' + A.name + '</b><span>' + A.desc + '</span>'; ag.append(d); }
    sec2.append(ag); m.append(sec2);
  };
  // people in the streets: one tap on the menu
  const updPeople = () => { $('peopleBtn').textContent = game.people === false ? '👤' : '👥'; };
  updPeople();
  $('peopleBtn').addEventListener('click', () => { const on = game.people === false; game.setPeople(on); try { localStorage.setItem('hajwala.people', on ? 'on' : 'off'); } catch (e) { } updPeople(); hud.toast(on ? 'فيه ناس بالشوارع 👥' : 'لحالك بالشوارع 👤', 1400); });
  // play: points -> xp (level up), distance, big crashes
  game.onDrift = (pts) => { const up = econ.onDrift(pts); if (up) hud.toast('⭐ وصلت المستوى ' + up.toLocaleString('ar-SA') + '!', 2400); else if (econ.newAch) { const A = ACHIEVEMENTS.find(a => a.id === econ.newAch); if (A) hud.toast(A.icon + ' إنجاز جديد: ' + A.name, 2200); } econ.newAch = null; };
  game.onCrash = (kmh) => { if (econ.onCrash(kmh)) hud.toast('💥 إنجاز جديد: حادث قوي', 2200); };
  setInterval(() => { if (screen === 'play' && game.car && game.playerMode === 'car' && !game.paused) econ.onDistance(Math.min(60, game.car.speed) * 0.5); }, 500);

  // =================== caravan (walk in from the Shas) ===================
  game.onRoom = async (enter) => {
    const f = $('fade'); f.style.opacity = 1; await new Promise(r => setTimeout(r, 450));
    try { if (enter) { if (!assets.caravan) { hud.toast('نفتح الكرفان…', 1500); await ensureMapAssets('caravan', () => { }); } game.enterRoom(); hud.toast('الكرفان · امشِ للنقطة الصفرا عشان تطلع', 2500); } else game.exitRoom(); }
    catch (e) { console.warn(e); hud.toast('ما قدرنا نفتح الكرفان'); }
    await new Promise(r => setTimeout(r, 250)); f.style.opacity = 0; setTimeout(() => { game.roomBusy = false; }, 1500);
  };

  // =================== map + fuel HUD ===================
  $('mapBtn').innerHTML = '<svg viewBox="0 0 32 32" fill="none" stroke="#ecdcbc" stroke-width="2.2" stroke-linejoin="round"><path d="M4 8l8-3 8 3 8-3v19l-8 3-8-3-8 3z"/><path d="M12 5v19M20 8v19"/></svg>';
  $('mapClose').innerHTML = ICON.back;
  // big map: drag to move it, pinch / + − to zoom, tap a pump / workshop / city to jump there
  const MV = { cx: 0, cz: 0, span: 320, img: null, proj: null, marks: [], W: 0, H: 0, dx: 0, dz: 0, k: 1 };
  const mapCv = $('mapCanvas'); window.__mv = MV;
  const mapRender = () => {
    const cv = mapCv, vw = Math.max(320, cv.clientWidth || innerWidth), vh = Math.max(240, cv.clientHeight || innerHeight);
    const sc = Math.min(1.5, 1400 / vw); const W = Math.round(vw * sc), H = Math.round(vh * sc);
    if (cv.width !== W || cv.height !== H) { cv.width = W; cv.height = H; }
    MV.W = W; MV.H = H;
    const { img, proj } = game.renderMap(W, H, MV.span, { x: MV.cx, z: MV.cz }); MV.img = img; MV.proj = proj;
    const y0 = game.world.heightAt(MV.cx, MV.cz, 300), p0 = proj(MV.cx, y0, MV.cz), px = proj(MV.cx + 100, y0, MV.cz), pz = proj(MV.cx, y0, MV.cz + 100);
    MV.ax = [(px[0] - p0[0]) / 100, (px[1] - p0[1]) / 100]; MV.az = [(pz[0] - p0[0]) / 100, (pz[1] - p0[1]) / 100];
    const mk = []; const add = (x, z, col, r, label, kind, yaw) => { const [qx, qy] = proj(x, game.world.heightAt(x, z, 300), z); mk.push({ x, z, px: qx, py: qy, col, r, label, kind, yaw }); };
    for (const w of game.workshops && game.workshops.length ? game.workshops : game.workshop ? [game.workshop] : []) add(w.x, w.z, '#9b40f2', 12, 'ورشة', 'go');
    for (const f of game.fuelPads || []) add(f.x, f.z, '#f5c518', 11, 'بنزين', 'go');
    for (const pl of (game.map && game.map.places) || []) add(pl.x, pl.z, '#f2f2f2', 13, pl.name, 'go', pl.yaw);
    if (game.chal && game.chal.target) add(game.chal.target.x, game.chal.target.z, '#ff3b30', 12, 'الهدف');
    for (const o of net.others()) if (o.st && o.map === game.mapKey) add(o.st[0], o.st[2], '#ff8c1a', 10, o.name);
    if (net.bot) add(net.bot.car.body.pos.x, net.bot.car.body.pos.z, '#ff8c1a', 10, 'خويك الوهمي');
    const me = game.playerMode === 'foot' ? game.player.pos : game.car.body.pos; add(me.x, me.z, '#2f8cff', 11, 'أنت');
    MV.marks = mk; mapPaint(0, 0, 1);
  };
  const mapPaint = (ox, oy, k) => {
    const g2 = mapCv.getContext('2d'), W = MV.W, H = MV.H; g2.fillStyle = '#1b1712'; g2.fillRect(0, 0, W, H);
    if (!MV.img) return;
    g2.save(); g2.translate(W / 2 + ox, H / 2 + oy); g2.scale(k, k); g2.drawImage(MV.img, -W / 2, -H / 2); g2.restore();
    const fs = Math.round(Math.max(16, W / 60));
    for (const m of MV.marks) { const px = W / 2 + ox + (m.px - W / 2) * k, py = H / 2 + oy + (m.py - H / 2) * k; if (px < -40 || py < -40 || px > W + 40 || py > H + 40) continue;
      g2.fillStyle = m.col; g2.strokeStyle = '#000'; g2.lineWidth = 3; g2.beginPath(); g2.arc(px, py, m.r * fs / 18, 0, 7); g2.fill(); g2.stroke();
      if (m.label) { g2.font = 'bold ' + fs + 'px sans-serif'; g2.fillStyle = '#fff'; g2.strokeText(m.label, px + m.r + 4, py + 6); g2.fillText(m.label, px + m.r + 4, py + 6); } }
  };
  const mapToCanvas = (e) => { const b = mapCv.getBoundingClientRect(); return [(e.clientX - b.left) * MV.W / b.width, (e.clientY - b.top) * MV.H / b.height]; };
  const pixToWorld = (dx, dy) => { const [a, b] = MV.ax, [c, d] = MV.az, det = a * d - b * c || 1; return [(dx * d - dy * c) / det, (a * dy - b * dx) / det]; }; // pixel offset → metres (x, z)
  { const P = new Map(); let start = null, moved = false;
    const state = () => { const pts = [...P.values()]; if (pts.length >= 2) { const [p, q] = pts; return { x: (p[0] + q[0]) / 2, y: (p[1] + q[1]) / 2, d: Math.hypot(p[0] - q[0], p[1] - q[1]) }; } const p = pts[0]; return { x: p[0], y: p[1], d: 0 }; };
    const cur = () => { const s2 = state(); const k = start.d > 0 && s2.d > 0 ? Math.max(0.2, Math.min(5, s2.d / start.d)) : 1; return { ox: s2.x - start.x, oy: s2.y - start.y, k }; };
    mapCv.addEventListener('pointerdown', (e) => { mapCv.setPointerCapture(e.pointerId); P.set(e.pointerId, mapToCanvas(e)); if (start && P.size > 1) { const c0 = cur(); commit(c0, false); } start = state(); if (P.size === 1) moved = false; else moved = true; });
    mapCv.addEventListener('pointermove', (e) => { if (!P.has(e.pointerId) || !start) return; P.set(e.pointerId, mapToCanvas(e)); const c0 = cur(); if (Math.hypot(c0.ox, c0.oy) > 8 || c0.k !== 1) moved = true; if (moved) mapPaint(c0.ox, c0.oy, c0.k); });
    const commit = (c0, redraw = true) => { const [mx, mz] = pixToWorld(-c0.ox, -c0.oy); MV.cx += mx; MV.cz += mz; MV.span = Math.max(80, Math.min(40000, MV.span / c0.k)); if (redraw) mapRender(); };
    const up = (e) => { if (!P.has(e.pointerId)) return; const c0 = cur(); const pt = P.get(e.pointerId); P.delete(e.pointerId);
      if (!moved) { // tap: the nearest place you can jump to
        let best = null, bd = 44 * MV.W / (mapCv.getBoundingClientRect().width || MV.W); for (const m of MV.marks) { if (m.kind !== 'go') continue; const d = Math.hypot(m.px - pt[0], m.py - pt[1]); if (d < bd) { bd = d; best = m; } }
        if (best) { if (game.fastTravel(best.x, best.z, best.yaw)) { show('mapView', false); if (screen === 'play' && $('pause').hidden) game.paused = false; hud.toast('نقلناك ' + (best.label === 'بنزين' ? 'للبنزين ⛽' : best.label === 'ورشة' ? 'للورشة 🔧' : 'لـ' + best.label), 1600); } else hud.toast('ما تقدر تنتقل الحين'); }
        start = null; return; }
      if (P.size === 0) { commit(c0); start = null; } else { commit(c0, false); start = state(); mapRender(); } };
    mapCv.addEventListener('pointerup', up); mapCv.addEventListener('pointercancel', up);
    mapCv.addEventListener('wheel', (e) => { e.preventDefault(); MV.span = Math.max(80, Math.min(40000, MV.span * (e.deltaY > 0 ? 1.25 : 0.8))); mapRender(); }, { passive: false });
  }
  const mapCenterMe = () => { const me = game.playerMode === 'foot' ? game.player.pos : game.car.body.pos; MV.cx = me.x; MV.cz = me.z; };
  bindTap($('mapBtn'), () => { try { show('mapView', true); if (screen === 'play') game.paused = true; mapCenterMe(); MV.span = game.mapKey === 'linked' ? 900 : 360; mapRender(); } catch (e) { console.warn(e); hud.toast('ما قدرنا نرسم الخريطة'); } });
  $('mapZin').addEventListener('click', () => { MV.span = Math.max(80, MV.span / 1.6); mapRender(); });
  $('mapZout').addEventListener('click', () => { MV.span = Math.min(40000, MV.span * 1.6); mapRender(); });
  $('mapMe').addEventListener('click', () => { mapCenterMe(); mapRender(); });
  $('mapClose').addEventListener('click', () => { show('mapView', false); if (screen === 'play' && $('pause').hidden) game.paused = false; });
  setInterval(() => { const f = game.car ? (game.car.fuel ?? 100) : 100; $('fuelFill').style.transform = 'scaleX(' + (f / 100).toFixed(3) + ')'; $('fuelTxt').textContent = '⛽ ' + Math.round(f).toLocaleString('ar-SA') + '٪'; }, 300);

  window.__ui = { ensure: ensureMapAssets, ensureCar, assets, select: k => { selected = k; if (!econ.owns(k)) econ.d.owned.push(k); }, goPlay, goGarage, goMenu, input, game, openSettings, openEditor, ce, pauseGame };
  if (manual) frame(performance.now(), 1 / 30);
  window.ready = true;
}

boot();

return {  };
})();
